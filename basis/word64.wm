  word64ToNumber as primToNumber: Word64.Word -> Number,
  word64Notb: Word64.Word -> Word64.Word,
  word64Andb: (Word64.Word, Word64.Word) -> Word64.Word,
  word64Orb: (Word64.Word, Word64.Word) -> Word64.Word,
  word64Xorb: (Word64.Word, Word64.Word) -> Word64.Word,
  word64Add: (Word64.Word, Word64.Word) -> Word64.Word,
  word64Sub: (Word64.Word, Word64.Word) -> Word64.Word,
  word64Mul: (Word64.Word, Word64.Word) -> Word64.Word,
  word64Div: (Word64.Word, Word64.Word) -> Word64.Word,
  word64Mod: (Word64.Word, Word64.Word) -> Word64.Word,
  word64ShiftLeft: (Word64.Word, Number) -> Word64.Word,
  word64ShiftRight: (Word64.Word, Number) -> Word64.Word,
  word64ShiftRightArithmetic: (Word64.Word, Number) -> Word64.Word
