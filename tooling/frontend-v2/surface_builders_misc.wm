from "./generated/surface_types.wm" import {
  Span, AuthoredValue, DirectiveNode, PanicExpressionNode, BarePanicExpressionNode,
  InterpolatedStringExpressionNode, InterpolatedStringTextNode, StringInterpolationNode
};
from "./surface_parse_value.wm" import {
  ParseValue, EmptyParseValue, TokenParseValue, SequenceParseValue, ChoiceParseValue,
  NodeParseValue, RuleParseValue
};
from "./surface_builder_support.wm" import {
  token, collectNodes, collectTokens, firstTokenWithText, lastTokenWithText, firstNode,
  surfaceValue
};

let buildDirective = (value: ParseValue, span: Span) => {
  let tokens = collectTokens(value);
  match(tokens) {
    [atToken, name, semicolon] => {
      NodeParseValue(
        DirectiveNode(atToken, name, surfaceValue(semicolon), span)
      )
    },
    _ => { RuleParseValue("Directive", value, span) },
  }
};

let buildParenthesizedPanic = (value: ParseValue, span: Span) => {
  let tokens = collectTokens(value);
  match((
    firstTokenWithText(tokens, "Panic"),
    firstTokenWithText(tokens, "("),
    firstNode(value),
    lastTokenWithText(tokens, ")", None)
  )) {
    (Some(panicToken), Some(open), Some(message), Some(close)) => {
      NodeParseValue(
        PanicExpressionNode(
          panicToken,
          surfaceValue(open),
          message,
          surfaceValue(close),
          span,
        )
      )
    },
    _ => { RuleParseValue("PanicExpr", value, span) },
  }
};

let buildPanic = (value: ParseValue, span: Span) => {
  match(value) {
    ChoiceParseValue(1, SequenceParseValue([
      TokenParseValue(panicToken), EmptyParseValue, EmptyParseValue,
      NodeParseValue(message),
    ])) => { NodeParseValue(BarePanicExpressionNode(panicToken, message, span)) },
    _ => { buildParenthesizedPanic(value, span) },
  }
};

let buildInterpolatedStringText = (source: String, span: Span) => {
  NodeParseValue(
    InterpolatedStringTextNode(
      token(source, span.start, span.end, "InterpolatedStringText"),
      span,
    )
  )
};

let buildStringInterpolation = (value: ParseValue, span: Span) => {
  match(value) {
    SequenceParseValue([
      TokenParseValue(open),
      EmptyParseValue,
      NodeParseValue(expression),
      EmptyParseValue,
      TokenParseValue(close),
    ]) => {
      NodeParseValue(
        StringInterpolationNode(open, expression, surfaceValue(close), span)
      )
    },
    _ => { RuleParseValue("StringInterpolation", value, span) },
  }
};

let buildInterpolatedString = (value: ParseValue, span: Span) => {
  let tokens = collectTokens(value);
  match((
    firstTokenWithText(tokens, "`"),
    lastTokenWithText(tokens, "`", None)
  )) {
    (Some(open), Some(close)) => {
      NodeParseValue(
        InterpolatedStringExpressionNode(
          open,
          collectNodes(value),
          surfaceValue(close),
          span,
        )
      )
    },
    _ => { RuleParseValue("InterpolatedString", value, span) },
  }
};
