from "./generated/surface_types.wm" import {
  Span, SurfaceToken, SurfaceNode, AuthoredValue, LongNameNode, NameExpressionNode,
  LiteralExpressionNode,
  ExplicitCallNode, SpaceCallNode, PostfixFieldNode, ArgumentPlaceholderNode,
  BinaryExpressionNode,
  UnaryExpressionNode, PipeExpressionNode, PipeMemberNode, IfExpressionNode, PipeConditionalNode,
  CarrierLiftExpressionNode, LiftTupleExpressionNode,
  JsonObjectExpressionNode, JsonArrayExpressionNode, JsonObjectFieldNode,
  RecordExpressionNode, NamedRecordExpressionNode, NestedRecordExpressionNode, RecordFieldNode, RecordSpreadNode,
  TupleExpressionNode, GroupedExpressionNode, ListExpressionNode
};
from "./surface_parse_value.wm" import { ParseValue, EmptyParseValue, TokenParseValue, SequenceParseValue, ChoiceParseValue, OptionalParseValue, RepeatedParseValue, NodeParseValue, NodeListParseValue, TokenListParseValue, RuleParseValue };
from "./surface_builder_support.wm" import {
  reverseInto, firstSyntax, collectNodes, collectTokens, firstTokenWithText,
  lastTokenWithText, firstNode, surfaceValue
};

let buildPrimary = (value: ParseValue, span: Span) => {
  match(firstSyntax(value)) {
    Some(NodeParseValue(LongNameNode(parts, separators, nameSpan))) => {
      NodeParseValue(
        NameExpressionNode(LongNameNode(parts, separators, nameSpan), span)
      )
    },
    Some(NodeParseValue(node)) => { NodeParseValue(node) },
    Some(TokenParseValue(value)) => {
      NodeParseValue(LiteralExpressionNode(value, span))
    },
    _ => { RuleParseValue("Primary", value, span) },
  }
};

let buildExplicitCall = (value: ParseValue, span: Span) => {
  let tokens = collectTokens(value);
  match((firstTokenWithText(tokens, "("), lastTokenWithText(tokens, ")", None))) {
    (Some(open), Some(close)) => {
      NodeParseValue(
        ExplicitCallNode(
          surfaceValue(open),
          collectNodes(value),
          surfaceValue(close),
          span,
        )
      )
    },
    _ => { RuleParseValue("ExplicitCall", value, span) },
  }
};

let buildArgumentPlaceholder = (value: ParseValue, span: Span) => {
  match(firstTokenWithText(collectTokens(value), "_")) {
    Some(token) => { NodeParseValue(ArgumentPlaceholderNode(token, span)) },
    None => { RuleParseValue("ArgumentPlaceholder", value, span) },
  }
};

let buildSpaceCall = (value: ParseValue, span: Span) => {
  match(firstNode(value)) {
    Some(argument) => { NodeParseValue(SpaceCallNode(argument, span)) },
    None => { RuleParseValue("SpaceCall", value, span) },
  }
};

let buildPostfixField = (value: ParseValue, span: Span) => {
  match(collectTokens(value)) {
    [dot, name] => { NodeParseValue(PostfixFieldNode(dot, name, span)) },
    _ => { RuleParseValue("PostfixField", value, span) },
  }
};

let buildUnary = (value: ParseValue, span: Span) => {
  match(value) {
    ChoiceParseValue(0, inner) => {
      match((collectTokens(inner), firstNode(inner))) {
        ([operator], Some(operand)) => {
          NodeParseValue(UnaryExpressionNode(operator, operand, span))
        },
        _ => { RuleParseValue("Unary", value, span) },
      }
    },
    ChoiceParseValue(1, inner) => {
      match(firstNode(inner)) {
        Some(node) => { NodeParseValue(node) },
        None => { RuleParseValue("Unary", value, span) },
      }
    },
    _ => { RuleParseValue("Unary", value, span) },
  }
};

let buildPipeMember = (value: ParseValue, span: Span) => {
  let tokens = collectTokens(value);
  match(firstTokenWithText(tokens, ".")) {
    Some(dot) => {
      let names = tokens
        :> List.filter((value: SurfaceToken) => { value.kind == "MemberName" });
      let call = match((
        firstTokenWithText(tokens, "("),
        lastTokenWithText(tokens, ")", None)
      )) {
        (Some(open), Some(close)) => {
          Some(
            ExplicitCallNode(
              surfaceValue(open),
              collectNodes(value),
              surfaceValue(close),
              span,
            )
          )
        },
        _ => { None },
      };
      NodeParseValue(PipeMemberNode(dot, names, call, span))
    },
    None => { RuleParseValue("PipeMember", value, span) },
  }
};

let rec foldPipeItems = match(items, left, span) => {
  ([], Var(left), Var(span)) => { Some(left) },
  ([value, ..rest], Var(left), Var(span)) => {
    match((firstTokenWithText(collectTokens(value), ":>"), firstNode(value))) {
      (Some(operator), Some(right)) => {
        foldPipeItems(rest, PipeExpressionNode(left, operator, right, span), span)
      },
      _ => { None },
    }
  },
};

let buildPipe = (value: ParseValue, span: Span) => {
  match(value) {
    SequenceParseValue([
      NodeParseValue(left),
      RepeatedParseValue(items),
    ]) => {
      match(foldPipeItems(items, left, span)) {
        Some(node) => { NodeParseValue(node) },
        None => { RuleParseValue("Pipe", value, span) },
      }
    },
    _ => { RuleParseValue("Pipe", value, span) },
  }
};

let buildCarrierLift = (value: ParseValue, span: Span) => {
  match(value) {
    SequenceParseValue([
      NodeParseValue(carrier),
      EmptyParseValue,
      TokenParseValue(open),
      EmptyParseValue,
      NodeListParseValue(arguments),
      EmptyParseValue,
      TokenParseValue(close),
    ]) => {
      NodeParseValue(
        CarrierLiftExpressionNode(
          carrier,
          open,
          arguments,
          surfaceValue(close),
          span,
        )
      )
    },
    _ => { RuleParseValue("CarrierLiftTupleExpr", value, span) },
  }
};

let buildLiftTuple = (value: ParseValue, span: Span) => {
  match(value) {
    SequenceParseValue([
      TokenParseValue(open),
      EmptyParseValue,
      NodeListParseValue(arguments),
      EmptyParseValue,
      TokenParseValue(close),
    ]) => {
      NodeParseValue(
        LiftTupleExpressionNode(open, arguments, surfaceValue(close), span)
      )
    },
    _ => { RuleParseValue("LiftTupleExpr", value, span) },
  }
};

let buildRecordExprField = (value: ParseValue, span: Span) => {
  match(value) {
    ChoiceParseValue(0, SequenceParseValue([
      TokenParseValue(spread),
      EmptyParseValue,
      NodeParseValue(expression),
    ])) => {
      NodeParseValue(RecordSpreadNode(spread, expression, span))
    },
    ChoiceParseValue(1, SequenceParseValue([
      TokenParseValue(name),
      EmptyParseValue,
      TokenParseValue(equalsToken),
      EmptyParseValue,
      expressionValue,
    ])) => {
      match(firstNode(expressionValue)) { Some(expression) => { NodeParseValue(
        RecordFieldNode(
          name,
          Some(surfaceValue(equalsToken)),
          Some(expression),
          span,
        )
      ) }, None => { RuleParseValue("RecordExprField", value, span) } }
    },
    ChoiceParseValue(2, TokenParseValue(name)) => {
      NodeParseValue(RecordFieldNode(name, None, None, span))
    },
    _ => { RuleParseValue("RecordExprField", value, span) },
  }
};

let buildRecordExpr = (value: ParseValue, span: Span) => {
  match(value) {
    SequenceParseValue([
      TokenParseValue(dot),
      EmptyParseValue,
      TokenParseValue(open),
      EmptyParseValue,
      fieldsValue,
      EmptyParseValue,
      TokenParseValue(close),
    ]) => {
      NodeParseValue(
        RecordExpressionNode(
          dot,
          surfaceValue(open),
          collectNodes(fieldsValue),
          surfaceValue(close),
          span,
        )
      )
    },
    _ => { RuleParseValue("RecordExpr", value, span) },
  }
};

let buildNamedRecordExpr = (value: ParseValue, span: Span) => {
  match(value) {
    SequenceParseValue([
      targetValue,
      EmptyParseValue,
      TokenParseValue(open),
      EmptyParseValue,
      fieldsValue,
      EmptyParseValue,
      TokenParseValue(close),
    ]) => {
      match(firstNode(targetValue)) {
        Some(target) => {
          NodeParseValue(
            NamedRecordExpressionNode(
              target,
              surfaceValue(open),
              collectNodes(fieldsValue),
              surfaceValue(close),
              span,
            )
          )
        },
        None => { RuleParseValue("NamedRecordExpr", value, span) },
      }
    },
    _ => { RuleParseValue("NamedRecordExpr", value, span) },
  }
};

let buildNestedRecordExpr = (value: ParseValue, span: Span) => {
  match(value) {
    SequenceParseValue([
      TokenParseValue(open), EmptyParseValue, fieldsValue, EmptyParseValue, TokenParseValue(close)
    ]) => {
      NodeParseValue(NestedRecordExpressionNode(
        surfaceValue(open), collectNodes(fieldsValue), surfaceValue(close), span
      ))
    },
    _ => { RuleParseValue("NestedRecordExpr", value, span) },
  }
};

let buildJsonObjectField = (value: ParseValue, span: Span) => {
  match((collectTokens(value), firstNode(value))) {
    ([key, colon], Some(expression)) => {
      NodeParseValue(
        JsonObjectFieldNode(key, surfaceValue(colon), expression, span)
      )
    },
    _ => { RuleParseValue("JsonObjectField", value, span) },
  }
};

let buildJsonExpr = (value: ParseValue, span: Span) => {
  let tokens = collectTokens(value);
  let items = collectNodes(value);
  match(value) {
    ChoiceParseValue(0, inner) => {
      match((
        firstTokenWithText(tokens, "JSON"),
        firstTokenWithText(tokens, "{"),
        lastTokenWithText(tokens, "}", None)
      )) {
        (Some(jsonToken), Some(open), Some(close)) => {
          NodeParseValue(
            JsonObjectExpressionNode(
              jsonToken,
              surfaceValue(open),
              items,
              surfaceValue(close),
              span,
            )
          )
        },
        _ => { RuleParseValue("JsonExpr", value, span) },
      }
    },
    ChoiceParseValue(1, inner) => {
      match((
        firstTokenWithText(tokens, "JSON"),
        firstTokenWithText(tokens, "["),
        lastTokenWithText(tokens, "]", None)
      )) {
        (Some(jsonToken), Some(open), Some(close)) => {
          NodeParseValue(
            JsonArrayExpressionNode(
              jsonToken,
              surfaceValue(open),
              items,
              surfaceValue(close),
              span,
            )
          )
        },
        _ => { RuleParseValue("JsonExpr", value, span) },
      }
    },
    _ => { RuleParseValue("JsonExpr", value, span) },
  }
};

record BinaryOperand = { node: SurfaceNode, span: Span };
record BinaryItem = { operator: SurfaceToken, operand: BinaryOperand };

// How tightly an operator binds, loosest first. The grammar has already accepted the text.
let binaryLevel = (operator: SurfaceToken) => {
  match(operator.text) {
    "||" => { 0 },
    "&&" => { 1 },
    "==" => { 2 },
    "!=" => { 2 },
    "++" => { 4 },
    "+" => { 4 },
    "-" => { 4 },
    "*" => { 5 },
    "/" => { 5 },
    "%" => { 5 },
    _ => { 3 },
  }
};

// The items before the first operator at `level`, and the rest starting at that operator.
let rec tighterBinaryItems = (level: Number, items: List<BinaryItem>, reversed: List<BinaryItem>) => {
  match(items) {
    [] => { (reverseInto(reversed, []), []) },
    [item, ..rest] => {
      if (binaryLevel(item.operator) == level) {
        (reverseInto(reversed, []), items)
      } else {
        tighterBinaryItems(level, rest, [item, ..reversed])
      }
    },
  }
};

let rec lastBinaryEnd = (items: List<BinaryItem>, end: Number) => {
  match(items) {
    [] => { end },
    [item, ..rest] => { lastBinaryEnd(rest, item.operand.span.end) },
  }
};

// Every node of one level's run gets the span of the whole run.
let rec foldBinaryLevel = (level: Number, head: BinaryOperand, items: List<BinaryItem>) => {
  match(items) {
    [] => { head },
    _ => {
      let (inside, after) = tighterBinaryItems(level, items, []);
      let left = foldBinaryLevel(level + 1, head, inside);
      let span: Span = .{ start = head.span.start, end = lastBinaryEnd(items, head.span.end) };
      foldBinaryRun(level, left, after, span)
    },
  }
}
and foldBinaryRun = (level: Number, left: BinaryOperand, items: List<BinaryItem>, span: Span) => {
  match(items) {
    [] => { left },
    [item, ..rest] => {
      let (inside, after) = tighterBinaryItems(level, rest, []);
      let right = foldBinaryLevel(level + 1, item.operand, inside);
      let node = BinaryExpressionNode(left.node, item.operator, right.node, span);
      let folded: BinaryOperand = .{ node = node, span = span };
      foldBinaryRun(level, folded, after, span)
    },
  }
};

let binaryOperand = (value: ParseValue) => {
  match(value) {
    RuleParseValue("BinaryOperand", NodeParseValue(node), span) => {
      let operand: BinaryOperand = .{ node = node, span = span };
      Some(operand)
    },
    RuleParseValue("PipelineOperand", NodeParseValue(node), span) => {
      let operand: BinaryOperand = .{ node = node, span = span };
      Some(operand)
    },
    _ => { None },
  }
};

let rec binaryItemOperand = (values: List<ParseValue>) => {
  match(values) {
    [] => { None },
    [value, ..rest] => {
      match(binaryOperand(value)) {
        Some(operand) => { Some(operand) },
        None => { binaryItemOperand(rest) },
      }
    },
  }
};

let binaryItem = (value: ParseValue) => {
  match(value) {
    SequenceParseValue(values) => {
      match((collectTokens(value), binaryItemOperand(values))) {
        ([operator], Some(operand)) => {
          let item: BinaryItem = .{ operator = operator, operand = operand };
          Some(item)
        },
        _ => { None },
      }
    },
    _ => { None },
  }
};

let rec binaryItems = (values: List<ParseValue>, reversed: List<BinaryItem>) => {
  match(values) {
    [] => { Some(reverseInto(reversed, [])) },
    [value, ..rest] => {
      match(binaryItem(value)) {
        Some(item) => { binaryItems(rest, [item, ..reversed]) },
        None => { None },
      }
    },
  }
};

let buildBinary = (value: ParseValue, span: Span) => {
  match(value) {
    SequenceParseValue([left, RepeatedParseValue(values)]) => {
      match((binaryOperand(left), binaryItems(values, []))) {
        (Some(head), Some(items)) => {
          NodeParseValue(foldBinaryLevel(0, head, items).node)
        },
        _ => { RuleParseValue("Binary", value, span) },
      }
    },
    _ => { RuleParseValue("Binary", value, span) },
  }
};

let buildIf = (value: ParseValue, span: Span) => {
  let tokens = collectTokens(value);
  match(collectNodes(value)) {
    [condition, thenExpression, elseExpression] => {
      match((
        firstTokenWithText(tokens, "if"),
        firstTokenWithText(tokens, "("),
        firstTokenWithText(tokens, ")"),
        firstTokenWithText(tokens, "else")
      )) {
        (Some(ifToken), Some(open), Some(close), Some(elseToken)) => {
          NodeParseValue(
            IfExpressionNode(
              ifToken,
              surfaceValue(open),
              condition,
              surfaceValue(close),
              thenExpression,
              elseToken,
              elseExpression,
              span,
            )
          )
        },
        _ => { RuleParseValue("IfExpr", value, span) },
      }
    },
    _ => { RuleParseValue("IfExpr", value, span) },
  }
};

let buildPipeConditional = (value: ParseValue, span: Span) => {
  match(value) {
    SequenceParseValue([
      TokenParseValue(ifToken), EmptyParseValue,
      NodeParseValue(thenExpression), EmptyParseValue,
      TokenParseValue(elseToken), EmptyParseValue,
      NodeParseValue(elseExpression),
    ]) => {
      NodeParseValue(PipeConditionalNode(ifToken, thenExpression, elseToken, elseExpression, span))
    },
    _ => { RuleParseValue("PipeConditional", value, span) },
  }
};

let buildTupleOrGroup = (value: ParseValue, span: Span) => {
  let tokens = collectTokens(value);
  match((
    firstTokenWithText(tokens, "("),
    collectNodes(value),
    lastTokenWithText(tokens, ")", None)
  )) {
    (Some(open), [only], Some(close)) => {
      match(firstTokenWithText(tokens, ",")) {
        Some(comma) => {
          NodeParseValue(
            TupleExpressionNode(
              surfaceValue(open),
              [only],
              surfaceValue(close),
              span,
            )
          )
        },
        None => {
          NodeParseValue(
            GroupedExpressionNode(
              surfaceValue(open),
              only,
              surfaceValue(close),
              span,
            )
          )
        },
      }
    },
    (Some(open), [first, second, ..rest], Some(close)) => {
      NodeParseValue(
        TupleExpressionNode(
          surfaceValue(open),
          [first, second, ..rest],
          surfaceValue(close),
          span,
        )
      )
    },
    _ => { RuleParseValue("TupleOrGroup", value, span) },
  }
};

let rec splitLastNode = match(nodes, reversed) => {
  ([last], Var(reversed)) => { Some((reverseInto(reversed, []), last)) },
  ([first, second, ..rest], Var(reversed)) => {
    splitLastNode([second, ..rest], [first, ..reversed])
  },
  _ => { None },
};

let buildListExpr = (value: ParseValue, span: Span) => {
  let tokens = collectTokens(value);
  let nodes = collectNodes(value);
  match((
    firstTokenWithText(tokens, "["),
    lastTokenWithText(tokens, "]", None)
  )) {
    (Some(open), Some(close)) => {
      match(firstTokenWithText(tokens, "..")) {
        Some(spread) => {
          match(splitLastNode(nodes, [])) {
            Some((Var(items), Var(tail))) => {
              NodeParseValue(
                ListExpressionNode(
                  surfaceValue(open),
                  items,
                  Some(tail),
                  surfaceValue(close),
                  span,
                )
              )
            },
            None => { RuleParseValue("ListExpr", value, span) },
          }
        },
        None => {
          NodeParseValue(
            ListExpressionNode(
              surfaceValue(open),
              nodes,
              None,
              surfaceValue(close),
              span,
            )
          )
        },
      }
    },
    _ => { RuleParseValue("ListExpr", value, span) },
  }
};
