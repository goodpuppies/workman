from "./generated/compiled_probe_types.wm" import {
  ClassPart, SingleCode, CodeRange
};

from js.global("String.prototype.charCodeAt") import unsafe {
  call as charCodeAt: (String, Number) -> Number
};
from js.host("table") import * as Table;

type CompiledCapture =
  | EmptyCompiledCapture
  | TokenCompiledCapture<String, Number, Number>
  | MissingCompiledCapture<String, Number, String>
  | SequenceCompiledCapture<List<CompiledCapture>>
  | ChoiceCompiledCapture<Number, CompiledCapture>
  | OptionalCompiledCapture<Option<CompiledCapture>>
  | RepeatedCompiledCapture<List<CompiledCapture>>
  | RuleCompiledCapture<String, CompiledCapture, Number, Number>;

record CompiledParseFailure = {
  offset: Number,
  expected: String,
  rule: String,
};

type CompiledProbeMatch =
  | CompiledProbeMatched<Number, CompiledCapture, Option<CompiledParseFailure>>
  | CompiledProbeNoMatch<Number, String, String>;

let textLength = (text: String) => {
  text :> .length :> Result.getOr(0)
};

-- JavaScript's charCodeAt gives NaN past the end, which compares false against everything, so a negated
-- character class would keep matching forever. NaN also fails `>= 0`, which maps it to -1 without
-- reading the length on every character.
let codeAt = (source: String, offset: Number) => {
  let code = charCodeAt(source, offset);
  if (code >= 0) { code } else { -1 }
};

let failurePriority = (rule: String) => {
  if (rule == "MatchFnArms") {
    4
  } else {
    if (
      rule == "Whitespace" || rule == "Comment" || rule == "BlockComment" || rule == "_" || rule == "__" ||
      rule == "<choice>" || rule == "<lookahead>"
    ) {
      0
    } else {
      if (
        rule == "Expr" || rule == "Pattern" || rule == "LetPattern" ||
        rule == "ParamPattern" || rule == "TypeAtom" || rule == "TypeDeclBody" ||
        rule == "ImportDecl" || rule == "ExportImportDecl" || rule == "JsImportDecl"
      ) {
        3
      } else {
        1
      }
    }
  }
};

let fartherFailure = match(left, right) => {
  (
    CompiledProbeNoMatch(leftAt, leftExpected, leftRule),
    CompiledProbeNoMatch(rightAt, rightExpected, rightRule),
  ) => {
    if (rightAt > leftAt) {
      CompiledProbeNoMatch(rightAt, rightExpected, rightRule)
    } else {
      if (leftAt > rightAt || failurePriority(leftRule) >= failurePriority(rightRule)) {
        CompiledProbeNoMatch(leftAt, leftExpected, leftRule)
      } else {
        CompiledProbeNoMatch(rightAt, rightExpected, rightRule)
      }
    }
  },
  (Var(left), _) => { left },
};

let bestFailure = match(left, right) => {
  (None, Var(right)) => { right },
  (Var(left), None) => { left },
  (Some(leftFailure), Some(rightFailure)) => {
    match(fartherFailure(
      CompiledProbeNoMatch(
        leftFailure.offset,
        leftFailure.expected,
        leftFailure.rule,
      ),
      CompiledProbeNoMatch(
        rightFailure.offset,
        rightFailure.expected,
        rightFailure.rule,
      ),
    )) {
      CompiledProbeNoMatch(offset, expected, rule) => {
        let failure: CompiledParseFailure = .{
          offset = offset,
          expected = expected,
          rule = rule,
        };
        Some(failure)
      },
      CompiledProbeMatched(next, capture, latent) => { None },
    }
  },
};

let failureOption = (offset: Number, expected: String, rule: String) => {
  let failure: CompiledParseFailure = .{
    offset = offset,
    expected = expected,
    rule = rule,
  };
  Some(failure)
};

let trackedFailure = (
  diagnose: Bool,
  offset: Number,
  expected: String,
  rule: String,
) => {
  if (diagnose) { failureOption(offset, expected, rule) } else { None }
};

let failureWithBest = (best, offset: Number, expected: String, rule: String) => {
  match(bestFailure(best, failureOption(offset, expected, rule))) {
    Some(bestFailure) => {
      CompiledProbeNoMatch(
        bestFailure.offset,
        bestFailure.expected,
        bestFailure.rule,
      )
    },
    None => { CompiledProbeNoMatch(offset, expected, rule) },
  }
};

-- Every failure while not diagnosing. Without diagnostics, failures only decide which alternative
-- runs next and nothing reads their contents, so one value serves them all.
let unobservedFailure = CompiledProbeNoMatch(0, "unobserved", "<unobserved>");

let friendlyRuleExpectation = match(name) => {
  "Expr" => { Some("an expression") },
  "Pattern" => { Some("a pattern") },
  "LetPattern" => { Some("a binding pattern") },
  "ParamPattern" => { Some("a parameter pattern") },
  "TypeAtom" => { Some("a type") },
  "TypeDeclBody" => { Some("a type declaration body") },
  "ImportDecl" => { Some("an import declaration") },
  "ExportImportDecl" => { Some("an export declaration") },
  "JsImportDecl" => { Some("a JavaScript import declaration") },
  _ => { None },
};

-- Where the literal ends when it matches at `offset`; otherwise `-1 - failedAt`, which is negative.
let rec literalEnd = match(source, codes, offset) => {
  (Var(source), [], Var(offset)) => { offset },
  (Var(source), [expected, ..rest], Var(offset)) => {
    let code = codeAt(source, offset);
    if (code >= expected && code <= expected) {
      literalEnd(source, rest, offset + 1)
    } else {
      -1 - offset
    }
  },
};

let rec classContains = match(parts, code) => {
  ([], Var(code)) => { false },
  ([part, ..rest], Var(code)) => {
    match(part) {
      SingleCode(expected) => {
        if (code == expected) { true } else { classContains(rest, code) }
      },
      CodeRange(start, end) => {
        if (code >= start && code <= end) { true } else { classContains(rest, code) }
      },
    }
  },
};

let matchLiteral = (
  codes: List<Number>,
  expectedText: String,
  rule: String,
  diagnose: Bool,
  source: String,
  offset: Number,
) => {
  let end = literalEnd(source, codes, offset);
  if (end >= 0) {
    CompiledProbeMatched(end, TokenCompiledCapture("literal", offset, end), None)
  } else {
    if (diagnose) { CompiledProbeNoMatch(-1 - end, expectedText, rule) } else { unobservedFailure }
  }
};

let matchRecoverableLiteral = (
  codes: List<Number>,
  expectedText: String,
  site: String,
  recover: Bool,
  diagnose: Bool,
  source: String,
  offset: Number,
) => {
  let result = matchLiteral(codes, expectedText, site, diagnose, source, offset);
  match(result) {
    CompiledProbeMatched(_, _, _) => { result },
    CompiledProbeNoMatch(_, _, _) => {
      if (recover) {
        CompiledProbeMatched(
          offset,
          MissingCompiledCapture(expectedText, offset, site),
          None,
        )
      } else {
        result
      }
    },
  }
};

-- Code-unit lists for literals matched by this runtime, built once rather than on every call.
let openBraceCodes = [123];
let jsonCodes = [74, 83, 79, 78];
let arrowCodes = [61, 62];

let matchRecoverableOpeningBrace = (
  site: String,
  recover: Bool,
  diagnose: Bool,
  source: String,
  offset: Number,
) => {
  let result = matchLiteral(openBraceCodes, "{", site, diagnose, source, offset);
  match(result) {
    CompiledProbeMatched(_, _, _) => { result },
    CompiledProbeNoMatch(_, _, _) => {
      let nextCode = codeAt(source, offset);
      if (
        recover && nextCode >= 0 &&
        nextCode != 41 && nextCode != 44 && nextCode != 59 &&
        nextCode != 93 && nextCode != 125
      ) {
        CompiledProbeMatched(
          offset,
          MissingCompiledCapture("{", offset, site),
          None,
        )
      } else {
        result
      }
    },
  }
};

-- Recovery only runs without diagnostics, so which failure comes back doesn't matter.
let matchCommittedRule = (parser, recover: Bool) => {
  if (recover) {
    let strict = parser(false);
    match(strict) {
      CompiledProbeMatched(_, _, _) => { strict },
      CompiledProbeNoMatch(_, _, _) => { parser(true) },
    }
  } else {
    parser(false)
  }
};

let isIdentifierPartCode = (code: Number) => {
  (code >= 65 && code <= 90) ||
  (code >= 97 && code <= 122) ||
  (code >= 48 && code <= 57) ||
  code == 95 ||
  code == 36
};

-- `JSON` is also a legal constructor name, so a damaged `JSON { ... }`
-- production needs this explicit keyword-boundary commitment annotation.
let commitsJsonPrimaryRecovery = (source: String, offset: Number) => {
  let end = literalEnd(source, jsonCodes, offset);
  end >= 0 && !isIdentifierPartCode(codeAt(source, end))
};

let skipOptionalRule = (name: String, source: String, offset: Number, parseRule) => {
  match(parseRule(name, source, offset, false, false)) {
    CompiledProbeMatched(next, ignoredCapture, ignoredLatent) => { next },
    CompiledProbeNoMatch(ignoredAt, ignoredExpected, ignoredRule) => { offset },
  }
};

-- Parameters followed by a written `=>` are a lambda, even if its body is unfinished. Without this
-- commitment the strict probe of `(x) => { x` fails at the lambda and then succeeds on the group `(x)`,
-- so recovery would never reach the lambda. `=>` itself is never recovered, so this can't invent one.
let commitsLambdaPrimaryRecovery = (source: String, offset: Number, parseRule) => {
  match(parseRule("ParamList", source, offset, false, false)) {
    CompiledProbeMatched(afterParams, ignoredCapture, ignoredLatent) => {
      let afterAnnotation = skipOptionalRule("LambdaReturnAnnotation", source, afterParams, parseRule);
      let afterCapture = skipOptionalRule("CaptureClause", source, afterAnnotation, parseRule);
      let arrow = skipOptionalRule("_", source, afterCapture, parseRule);
      literalEnd(source, arrowCodes, arrow) >= 0
    },
    CompiledProbeNoMatch(ignoredAt, ignoredExpected, ignoredRule) => { false },
  }
};

let matchCharacterClass = (
  parts: List<ClassPart>,
  inverted: Bool,
  expectedText: String,
  rule: String,
  diagnose: Bool,
  source: String,
  offset: Number,
) => {
  let code = codeAt(source, offset);
  if (code >= 0 && classContains(parts, code) != inverted) {
    CompiledProbeMatched(
      offset + 1,
      TokenCompiledCapture("class", offset, offset + 1),
      None,
    )
  } else {
    if (diagnose) { CompiledProbeNoMatch(offset, expectedText, rule) } else { unobservedFailure }
  }
};

let matchAnyCharacter = (rule: String, diagnose: Bool, source: String, offset: Number) => {
  if (codeAt(source, offset) >= 0) {
    CompiledProbeMatched(
      offset + 1,
      TokenCompiledCapture("any", offset, offset + 1),
      None,
    )
  } else {
    if (diagnose) { CompiledProbeNoMatch(offset, "a character", rule) } else { unobservedFailure }
  }
};

let ensureProgress = (before: Number, after: Number) => {
  after > before
};

let rec reverseInto = match(items, output) => {
  ([], Var(output)) => { output },
  ([item, ..rest], Var(output)) => { reverseInto(rest, [item, ..output]) },
};

let rec matchSequenceInto = match(parsers, diagnose, source, offset, reversed, best) => {
  ([], Var(diagnose), Var(source), Var(offset), Var(reversed), Var(best)) => {
    CompiledProbeMatched(
      offset,
      SequenceCompiledCapture(reverseInto(reversed, [])),
      best,
    )
  },
  (
    [parser, ..rest],
    Var(diagnose),
    Var(source),
    Var(offset),
    Var(reversed),
    Var(best),
  ) => {
    match(parser(source, offset)) {
      CompiledProbeMatched(next, capture, latent) => {
        matchSequenceInto(
          rest,
          diagnose,
          source,
          next,
          [capture, ..reversed],
          if (diagnose) { bestFailure(best, latent) } else { None },
        )
      },
      CompiledProbeNoMatch(failedAt, expected, rule) => {
        failureWithBest(best, failedAt, expected, rule)
      },
    }
  },
};

let matchSequence = (parsers, diagnose: Bool, source: String, offset: Number) => {
  matchSequenceInto(parsers, diagnose, source, offset, [], None)
};

-- Called only after `match (identifiers) =>` has matched. A complete first
-- arm header or an authored brace means the error is inside an intended match
-- body; preserve its ordinary diagnostic rather than suggesting another form.
let matchNamedMatchArms = (source: String, offset: Number, result: CompiledProbeMatch, parseRule) => {
  match(result) {
    CompiledProbeNoMatch(failedAt, expected, rule) => {
      if (codeAt(source, offset) == 123) { result } else {
        let header = matchSequence([
          (source, offset) => { parseRule("Pattern", source, offset, false, false) },
          (source, offset) => { parseRule("_", source, offset, false, false) },
          (source, offset) => { matchLiteral(arrowCodes, "=>", "MatchArm", false, source, offset) },
        ], false, source, offset);
        match(header) {
          CompiledProbeMatched(_, _, _) => { result },
          CompiledProbeNoMatch(_, _, _) => {
            CompiledProbeNoMatch(failedAt, "a match arm after named parameters", "MatchFnArms")
          },
        }
      }
    },
    _ => { result },
  }
};

let rec matchChoiceAt = match(parsers, diagnose, source, offset, index, best) => {
  ([], Var(diagnose), Var(source), Var(offset), Var(index), Var(best)) => {
    failureWithBest(best, offset, "valid syntax", "<choice>")
  },
  ([parser, ..rest], Var(diagnose), Var(source), Var(offset), Var(index), Var(best)) => {
    match(parser(source, offset)) {
      CompiledProbeMatched(next, capture, latent) => {
        CompiledProbeMatched(
          next,
          ChoiceCompiledCapture(index, capture),
          if (diagnose) { bestFailure(best, latent) } else { None },
        )
      },
      CompiledProbeNoMatch(failedAt, expected, rule) => {
        matchChoiceAt(
          rest,
          diagnose,
          source,
          offset,
          index + 1,
          bestFailure(best, trackedFailure(diagnose, failedAt, expected, rule)),
        )
      },
    }
  },
};

let matchChoice = (parsers, diagnose: Bool, source: String, offset: Number) => {
  matchChoiceAt(parsers, diagnose, source, offset, 0, None)
};

let matchOptional = (
  result: CompiledProbeMatch,
  diagnose: Bool,
  offset: Number,
) => {
  match(result) {
    CompiledProbeMatched(next, capture, latent) => {
      CompiledProbeMatched(next, OptionalCompiledCapture(Some(capture)), latent)
    },
    CompiledProbeNoMatch(failedAt, expected, rule) => {
      CompiledProbeMatched(
        offset,
        OptionalCompiledCapture(None),
        trackedFailure(diagnose, failedAt, expected, rule),
      )
    },
  }
};

let rec matchRepeatedInto = match(parser, diagnose, source, offset, reversed, best) => {
  (Var(parser), Var(diagnose), Var(source), Var(offset), Var(reversed), Var(best)) => {
    match(parser(source, offset)) {
      CompiledProbeMatched(next, capture, latent) => {
        let nextBest = if (diagnose) { bestFailure(best, latent) } else { None };
        if (!ensureProgress(offset, next)) {
          CompiledProbeMatched(
            offset,
            RepeatedCompiledCapture(reverseInto(reversed, [])),
            nextBest,
          )
        } else {
          matchRepeatedInto(
            parser,
            diagnose,
            source,
            next,
            [capture, ..reversed],
            nextBest,
          )
        }
      },
      CompiledProbeNoMatch(failedAt, expected, rule) => {
        CompiledProbeMatched(
          offset,
          RepeatedCompiledCapture(reverseInto(reversed, [])),
          bestFailure(best, trackedFailure(diagnose, failedAt, expected, rule)),
        )
      },
    }
  },
};

let matchRepeated = (parser, diagnose: Bool, source: String, offset: Number) => {
  matchRepeatedInto(parser, diagnose, source, offset, [], None)
};

let matchOneOrMore = (parser, diagnose: Bool, source: String, offset: Number) => {
  let first = parser(source, offset);
  match(first) {
    CompiledProbeMatched(next, capture, latent) => {
      if (!ensureProgress(offset, next)) {
        CompiledProbeNoMatch(offset, "one or more repetitions", "<repetition>")
      } else {
        matchRepeatedInto(parser, diagnose, source, next, [capture], latent)
      }
    },
    CompiledProbeNoMatch(_, _, _) => { first },
  }
};

let matchNegativeLookahead = (result: CompiledProbeMatch, offset: Number) => {
  match(result) {
    CompiledProbeMatched(next, capture, latent) => {
      CompiledProbeNoMatch(offset, "negative lookahead", "<lookahead>")
    },
    CompiledProbeNoMatch(ignoredAt, ignoredExpected, ignoredRule) => {
      CompiledProbeMatched(offset, EmptyCompiledCapture, None)
    },
  }
};

let matchText = (result: CompiledProbeMatch, offset: Number) => {
  match(result) {
    CompiledProbeMatched(next, capture, latent) => {
      CompiledProbeMatched(next, TokenCompiledCapture("text", offset, next), latent)
    },
    CompiledProbeNoMatch(_, _, _) => { result },
  }
};

let matchSemanticPredicate = (actionId: String, rule: String, offset: Number) => {
  if (actionId == "Start:root.expression.elements.0") {
    CompiledProbeMatched(offset, EmptyCompiledCapture, None)
  } else {
    CompiledProbeNoMatch(offset, "semantic predicate", rule)
  }
};

let wrapCompiledRule = (
  name: String,
  start: Number,
  diagnose: Bool,
  result: CompiledProbeMatch,
) => {
  match(result) {
    CompiledProbeMatched(next, capture, latent) => {
      CompiledProbeMatched(
        next,
        RuleCompiledCapture(name, capture, start, next),
        latent,
      )
    },
    CompiledProbeNoMatch(failedAt, expected, rule) => {
      if (diagnose) {
        match(friendlyRuleExpectation(name)) {
          Some(friendly) => {
            if (failedAt == start) { CompiledProbeNoMatch(failedAt, friendly, name) } else { result }
          },
          None => { result },
        }
      } else {
        result
      }
    },
  }
};

let isCompleteProbe = (source: String, result: CompiledProbeMatch) => {
  match(result) {
    CompiledProbeMatched(offset, capture, latent) => { offset == textLength(source) },
    CompiledProbeNoMatch(ignoredAt, ignoredExpected, ignoredRule) => { false },
  }
};

let completedCapture = (source: String, result: CompiledProbeMatch) => {
  match(result) {
    CompiledProbeMatched(offset, capture, latent) => {
      if (offset == textLength(source)) { Some(capture) } else { None }
    },
    CompiledProbeNoMatch(ignoredAt, ignoredExpected, ignoredRule) => { None },
  }
};

let compiledFailure = (source: String, result: CompiledProbeMatch) => {
  match(result) {
    CompiledProbeMatched(offset, capture, latent) => {
      if (offset == textLength(source)) {
        None
      } else {
        bestFailure(latent, failureOption(offset, "end of input", "Start"))
      }
    },
    CompiledProbeNoMatch(offset, expected, rule) => {
      let failure: CompiledParseFailure = .{
        offset = offset,
        expected = expected,
        rule = rule,
      };
      Some(failure)
    },
  }
};
