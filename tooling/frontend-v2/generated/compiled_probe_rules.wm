and enter_ListPattern = (parser: CompiledParser, source: String, offset: Number, diagnose: Bool, recover: Bool): CompiledProbeMatch => {
  let slot = compiledRuleSlot(97, offset, diagnose, recover);
  match(Table.getAt(parser.memo, slot)) {
    Some(cached) => { cached },
    None => {
      let result = wrapCompiledRule("ListPattern", offset, if (recover) {
        rule_ListPattern(source, offset, true, diagnose, parser)
      } else {
        rule_ListPattern(source, offset, false, diagnose, parser)
      });
      Table.setAt(parser.memo, slot, result);
      result
    },
  }
}
