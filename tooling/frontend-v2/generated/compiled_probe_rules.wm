    Some(cached) => { cached },
    None => {
      let result = wrapCompiledRule("ListLetPattern", offset, diagnose, if (recover) {
        rule_ListLetPattern(source, offset, true, diagnose, parser)
      } else {
        rule_ListLetPattern(source, offset, false, diagnose, parser)
      });
      Table.setAt(parser.memo, slot, result);
      result
    },
  }
}
