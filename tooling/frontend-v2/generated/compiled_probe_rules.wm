and enter_ListExpr = (parser: CompiledParser, source: String, offset: Number, diagnose: Bool, recover: Bool): CompiledProbeMatch => {
  let slot = compiledRuleSlot(98, offset, diagnose, recover);
  match(Table.getAt(parser.memo, slot)) {
    Some(cached) => { cached },
    None => {
      let result = wrapCompiledRule("ListExpr", offset, diagnose, if (recover) {
        rule_ListExpr(source, offset, true, diagnose, parser)
      } else {
        rule_ListExpr(source, offset, false, diagnose, parser)
      });
      Table.setAt(parser.memo, slot, result);
      result
    },
  }
}
