and enter_PatternCore = (parser: CompiledParser, source: String, offset: Number, diagnose: Bool, recover: Bool): CompiledProbeMatch => {
  let slot = compiledRuleSlot(87, offset, diagnose, recover);
  match(Table.getAt(parser.memo, slot)) {
    Some(cached) => { cached },
    None => {
      let result = wrapCompiledRule("PatternCore", offset, diagnose, if (recover) {
        rule_PatternCore(source, offset, true, diagnose, parser)
      } else {
        rule_PatternCore(source, offset, false, diagnose, parser)
      });
      Table.setAt(parser.memo, slot, result);
      result
    },
  }
}
