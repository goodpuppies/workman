and enter_Primary = (parser: CompiledParser, source: String, offset: Number, diagnose: Bool, recover: Bool): CompiledProbeMatch => {
  let slot = compiledRuleSlot(67, offset, diagnose, recover);
  match(Table.getAt(parser.memo, slot)) {
    Some(cached) => { cached },
    None => {
      let result = wrapCompiledRule("Primary", offset, diagnose, if (recover) {
        if (commitsJsonPrimaryRecovery(source, offset) || commitsLambdaPrimaryRecovery(source, offset, (name, source, offset, diagnose, recover) => { parseRuleByName(parser, name, source, offset, diagnose, recover) })) { rule_Primary(source, offset, true, diagnose, parser) } else { matchCommittedRule((activeRecover) => { rule_Primary(source, offset, activeRecover, diagnose, parser) }, true) }
      } else {
        rule_Primary(source, offset, false, diagnose, parser)
      });
      Table.setAt(parser.memo, slot, result);
      result
    },
  }
}
and rule_WonExpr = (source: String, offset: Number, recover: Bool, diagnose: Bool, parser: CompiledParser): CompiledProbeMatch => {
