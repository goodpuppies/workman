and enter_LetPattern = (parser: CompiledParser, source: String, offset: Number, diagnose: Bool, recover: Bool): CompiledProbeMatch => {
  let slot = compiledRuleSlot(16, offset, diagnose, recover);
  match(Table.getAt(parser.memo, slot)) {
    Some(cached) => { cached },
    None => {
      let result = wrapCompiledRule("LetPattern", offset, if (recover) {
        rule_LetPattern(source, offset, true, diagnose, parser)
      } else {
        rule_LetPattern(source, offset, false, diagnose, parser)
      });
      Table.setAt(parser.memo, slot, result);
      result
    },
  }
}
