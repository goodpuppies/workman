  ("String", Var(source), Var(offset), Var(diagnose), true) => { wrapCompiledRule("String", offset, Probe13.rule_String(source, offset, true, diagnose, parseRecoveringCompiledRule)) },
  ("QuotedString", Var(source), Var(offset), Var(diagnose), true) => { wrapCompiledRule("QuotedString", offset, Probe13.rule_QuotedString(source, offset, true, diagnose, parseRecoveringCompiledRule)) },
  ("MultilineString", Var(source), Var(offset), Var(diagnose), true) => { wrapCompiledRule("MultilineString", offset, Probe13.rule_MultilineString(source, offset, true, diagnose, parseRecoveringCompiledRule)) },
  ("QuotedChar", Var(source), Var(offset), Var(diagnose), true) => { wrapCompiledRule("QuotedChar", offset, Probe13.rule_QuotedChar(source, offset, true, diagnose, parseRecoveringCompiledRule)) },
  ("MultilineChar", Var(source), Var(offset), Var(diagnose), true) => { wrapCompiledRule("MultilineChar", offset, Probe13.rule_MultilineChar(source, offset, true, diagnose, parseRecoveringCompiledRule)) },
  ("LineTerminator", Var(source), Var(offset), Var(diagnose), true) => { wrapCompiledRule("LineTerminator", offset, Probe13.rule_LineTerminator(source, offset, true, diagnose, parseRecoveringCompiledRule)) },
  ("Bool", Var(source), Var(offset), Var(diagnose), true) => { wrapCompiledRule("Bool", offset, Probe13.rule_Bool(source, offset, true, diagnose, parseRecoveringCompiledRule)) },
  ("Void", Var(source), Var(offset), Var(diagnose), true) => { wrapCompiledRule("Void", offset, Probe13.rule_Void(source, offset, true, diagnose, parseRecoveringCompiledRule)) },
  ("Wildcard", Var(source), Var(offset), Var(diagnose), true) => { wrapCompiledRule("Wildcard", offset, Probe13.rule_Wildcard(source, offset, true, diagnose, parseRecoveringCompiledRule)) },
  ("Identifier", Var(source), Var(offset), Var(diagnose), true) => { wrapCompiledRule("Identifier", offset, Probe13.rule_Identifier(source, offset, true, diagnose, parseRecoveringCompiledRule)) },
  ("Constructor", Var(source), Var(offset), Var(diagnose), true) => { wrapCompiledRule("Constructor", offset, Probe13.rule_Constructor(source, offset, true, diagnose, parseRecoveringCompiledRule)) },
  ("Name", Var(source), Var(offset), Var(diagnose), true) => { wrapCompiledRule("Name", offset, Probe13.rule_Name(source, offset, true, diagnose, parseRecoveringCompiledRule)) },
  ("MemberName", Var(source), Var(offset), Var(diagnose), true) => { wrapCompiledRule("MemberName", offset, Probe13.rule_MemberName(source, offset, true, diagnose, parseRecoveringCompiledRule)) },
  ("FieldName", Var(source), Var(offset), Var(diagnose), true) => { wrapCompiledRule("FieldName", offset, Probe13.rule_FieldName(source, offset, true, diagnose, parseRecoveringCompiledRule)) },
  ("LongName", Var(source), Var(offset), Var(diagnose), true) => { wrapCompiledRule("LongName", offset, Probe14.rule_LongName(source, offset, true, diagnose, parseRecoveringCompiledRule)) },
  ("LongConstructor", Var(source), Var(offset), Var(diagnose), true) => { wrapCompiledRule("LongConstructor", offset, Probe14.rule_LongConstructor(source, offset, true, diagnose, parseRecoveringCompiledRule)) },
  ("IdentPart", Var(source), Var(offset), Var(diagnose), true) => { wrapCompiledRule("IdentPart", offset, Probe14.rule_IdentPart(source, offset, true, diagnose, parseRecoveringCompiledRule)) },
  ("Keyword", Var(source), Var(offset), Var(diagnose), true) => { wrapCompiledRule("Keyword", offset, Probe14.rule_Keyword(source, offset, true, diagnose, parseRecoveringCompiledRule)) },
  ("__", Var(source), Var(offset), Var(diagnose), true) => { wrapCompiledRule("__", offset, Probe14.rule___(source, offset, true, diagnose, parseRecoveringCompiledRule)) },
  ("_", Var(source), Var(offset), Var(diagnose), true) => { wrapCompiledRule("_", offset, Probe14.rule__(source, offset, true, diagnose, parseRecoveringCompiledRule)) },
  ("Whitespace", Var(source), Var(offset), Var(diagnose), true) => { wrapCompiledRule("Whitespace", offset, Probe14.rule_Whitespace(source, offset, true, diagnose, parseRecoveringCompiledRule)) },
  ("Comment", Var(source), Var(offset), Var(diagnose), true) => { wrapCompiledRule("Comment", offset, Probe14.rule_Comment(source, offset, true, diagnose, parseRecoveringCompiledRule)) },
  ("EOF", Var(source), Var(offset), Var(diagnose), true) => { wrapCompiledRule("EOF", offset, Probe14.rule_EOF(source, offset, true, diagnose, parseRecoveringCompiledRule)) },
  (Var(name), Var(source), Var(offset), Var(diagnose), Var(recover)) => { CompiledProbeNoMatch(offset, "known grammar rule", name) },
};

let recognizeCompiled = (source: String) => {
  isCompleteProbe(source, parseStrictCompiledRule("Start", source, 0, false, false))
};

let parseCompiledCapture = (source: String): Option<CompiledCapture> => {
  completedCapture(source, parseStrictCompiledRule("Start", source, 0, false, false))
};

let parseRecoveringCompiledCapture = (source: String): Option<CompiledCapture> => {
  completedCapture(source, parseRecoveringCompiledRule("Start", source, 0, false, true))
};

let parseCompiledFailure = (source: String): Option<CompiledParseFailure> => {
  compiledFailure(source, parseStrictCompiledRule("Start", source, 0, true, false))
};
