from js.module("node:buffer") import { Buffer };
from js.module("node:zlib") import { inflateSync };
from js.global("Deno") import unsafe * as Deno;

let envString = (name) => {
  match(Deno.env.get(name)) {
    Err(_) => { "" },
    Ok(None) => { "" },
    Ok(Some(value)) => { value },
  }
};

let main = () => {
  let b64 = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==";
  match(Buffer.from(b64, "base64")) {
    Err(_) => { print("buf err") },
    Ok(buf) => {
      let len = buf :> .length :> Result.withDefault(0);
      let w = buf :> .readUInt32BE(16) :> Result.withDefault(0);
      let h = buf :> .readUInt32BE(20) :> Result.withDefault(0);
      print("len=" ++ Result.textOf(len) ++ " wh=" ++ Result.textOf(w) ++ "x" ++ Result.textOf(h));
      print("TERM=" ++ envString("TERM"));
      print("KITTY=" ++ envString("KITTY_WINDOW_ID"));
      print("COLORTERM=" ++ envString("COLORTERM"));
      print("TERM_PROGRAM=" ++ envString("TERM_PROGRAM"));
      print("GHOSTTY=" ++ envString("GHOSTTY_RESOURCES_DIR"));
      let b0 = buf :> .readUInt8(0) :> Result.withDefault(0);
      print("sig0=" ++ Result.textOf(b0));
      let ihdrLen = buf :> .readUInt32BE(8) :> Result.withDefault(0);
      print("ihdrLen=" ++ Result.textOf(ihdrLen));
      let pos = 8 + 4 + 4 + ihdrLen + 4;
      print("nextChunkAt=" ++ Result.textOf(pos));
      let chunkLen = buf :> .readUInt32BE(pos) :> Result.withDefault(0);
      let t0 = buf :> .readUInt8(pos + 4) :> Result.withDefault(0);
      let t1 = buf :> .readUInt8(pos + 5) :> Result.withDefault(0);
      let t2 = buf :> .readUInt8(pos + 6) :> Result.withDefault(0);
      let t3 = buf :> .readUInt8(pos + 7) :> Result.withDefault(0);
      print("chunk len=" ++ Result.textOf(chunkLen) ++ " type " ++ Result.textOf(t0) ++ "," ++ Result.textOf(t1) ++ "," ++ Result.textOf(t2) ++ "," ++ Result.textOf(t3));
      match(buf :> .subarray(pos + 8, pos + 8 + chunkLen)) {
        Err(_) => { print("sub fail") },
        Ok(idat) => {
          match(inflateSync(idat)) {
            Err(_) => { print("inflate fail") },
            Ok(raw) => {
              let olen = raw :> .length :> Result.withDefault(0);
              print("pixels+filter=" ++ Result.textOf(olen));
              let f0 = raw :> .readUInt8(0) :> Result.withDefault(-1);
              let r = raw :> .readUInt8(1) :> Result.withDefault(-1);
              let g = raw :> .readUInt8(2) :> Result.withDefault(-1);
              let b = raw :> .readUInt8(3) :> Result.withDefault(-1);
              print("row0 filter=" ++ Result.textOf(f0) ++ " rgb=" ++ Result.textOf(r) ++ "," ++ Result.textOf(g) ++ "," ++ Result.textOf(b))
            },
          }
        },
      }
    },
  }
};
