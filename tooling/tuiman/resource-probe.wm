from "./resource.wm" import * as Resource;

let double = Monad.lift Resource (value) => {
  Resource.Ready(value * 2)
};

let main = () => {
  let ready = Resource.Ready(3) :> double :> Resource.map((value) => { value + 1 });
  let pending = Resource.Pending :> Resource.map((value) => { value + 1 });
  let loading = Resource.Loading :> Resource.map((value) => { value + 1 });
  let paired = Resource|Resource.Ready("ok"), Resource.Ready(7)|;
  let resolved = Resource.resolve(ready, "pending", (_) => { "failed" }, Result.textOf);
  let pendingText = Resource.resolve(pending, "pending", (_) => { "failed" }, Result.textOf);
  let loadingText = Resource.resolve(loading, "pending", (_) => { "failed" }, Result.textOf);
  match(paired) {
    Resource.Ready(values) => {
      let (label, number) = values;
      if (resolved == "7" && pendingText == "pending" && loadingText == "pending" && label == "ok" && number == 7) {
        print("resource carrier ok")
      } else {
        print("resource carrier mismatch")
      }
    },
    _ => { print("resource carrier mismatch") },
  }
};
