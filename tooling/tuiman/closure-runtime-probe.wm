-- Reduction: generic runtime callbacks close over an ordinary environment.

from "./draw.wm" import * as Draw;
from "./command.wm" import * as Command;
from "./event.wm" import * as Event;
from "./geometry.wm" import * as Geometry;
from "./probe-environment.wm" import * as Probe;
from "./runtime.wm" import * as Runtime;

record ClosureState = {
  selected: Number,
};

let update = match(count, key, state) => {
  (_, Event.Character("q"), _) => { Command.Quit },
  (_, Event.CtrlC, _) => { Command.Quit },
  _ => {
    Command.Continue(ClosureState(Geometry.clamp(0, count, state.selected + 1)))
  },
};

let render = (environment: Probe.Environment, _, state: ClosureState, size: Geometry.Size) => {
  Draw.beginFrame ++ Draw.text(
    Geometry.rect(0, 0, size.width, 1),
    environment.label ++ " " ++ Text.of(state.selected),
    Draw.plain,
  )
};

let start = (environment: Probe.Environment) => {
  Runtime.run(
    ClosureState(0),
    (key, state: ClosureState) => { update(environment.count, key, state) },
    (previous, state: ClosureState, size: Geometry.Size) => {
      render(environment, previous, state, size)
    },
  )
};

let main = () => {
  Task.succeed(Probe.Environment("closure", 4, [Probe.Item("a"), Probe.Item("b")]))
    :> Task.map(start)
};
