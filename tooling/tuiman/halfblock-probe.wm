from "./geometry.wm" import * as Geometry;
from "./halfblock.wm" import * as HalfBlock;
from "./kitty.wm" import * as Kitty;
from "./png.wm" import * as Png;

let main = () => {
  let base64 = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==";
  match(Png.decode(base64)) {
    Err(_) => { print("png decode failed") },
    Ok(pixels) => {
      let (red, green, blue, alpha) = Png.rgba(pixels, 0, 0);
      let rendered = HalfBlock.render(Geometry.rect(0, 0, 1, 1), Kitty.Fill, Kitty.Image(base64, "", 1, 1, Some(pixels)));
      if (pixels.width == 1 && pixels.height == 1 && red == 255 && green == 0 && blue == 0 && alpha == 127 && rendered != "") {
        print("half-block png ok")
      } else {
        print(`half-block png mismatch ${Text.of(pixels.width)}x${Text.of(pixels.height)} rgba=${Text.of(red)},${Text.of(green)},${Text.of(blue)},${Text.of(alpha)}`)
      }
    },
  }
};
