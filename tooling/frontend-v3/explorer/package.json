{
  "name": "workman-frontend-v3-explorer",
  "private": true,
  "type": "module",
  "scripts": {
    "server": "deno run --config ../../../deno.json --allow-read --allow-write --allow-env --allow-run --allow-net=127.0.0.1 server.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": { "react": "19.2.0", "react-dom": "19.2.0" },
  "devDependencies": {
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
