from "./character.wm" import * as Char;
from "./token.wm" import * as Token;
from "./source.wm" import * as Source;

type Mode = Default | Ident;

let try = match(in) => {
  Ok(x) => {x},
  Err(e) => {Panic("f")}
};

let textLength = (text) => {
  text :> .length :> try
};

type Char = String;

type ReadValue =
  | StringVal<String>
  | NumVal<Number>
  | CharVal<Char>;


record ReadResult = {
  tokens: List<Token.Token>,
  newPosition: Source.Position
};


let lex = (source) => {
  let length = textLength(source);
  if (length ==0) {?} else {};

  let peekByOne = (index) => {
    //peek the index to get the character
    if (index < 0 || index >= length) {
      None
    } else {
      Some(source 
        :> .slice(index, index + 1) 
        :> Result.debug
      )
    }
  };
  let peekBy = (index, amount) => {
    if (index<0 || index >= length) {
      None
    } else {
      Some(source
        :> .slice(index, index + amount)
        :> Result.debug
      )
    }
  };

  //#region helpers
  //advance position based on character
  let advancePosition = (pos, ch) => {
    let next: Source.Position = .{
      index = pos.index + 1,
      line = if (ch == "\n") {pos.line + 1} else {pos.line},
      col = if (ch == "\n") {1} else {pos.col + 1}
    };
    next
  };

  //Generic pure reader: consume characters from `pos` while `keepGoing(ch, pos)`
  //holds, stopping *before* the first character that fails (or at EOF).
  //Returns (text, endPos).
  let rec readTillEnd = (pos, keepGoing, kinds) => {
    match(peekByOne(pos.index)) {
      Some(ch) => {
        if (keepGoing(ch, pos, kinds)) {
          let (rest, endPos) = readTillEnd(advancePosition(pos, ch), keepGoing, kinds);
          (ch ++ rest, endPos)
        } else {
          ("", pos)
        }
      },
      None => {
        //EOF terminates any read
        ("", pos)
      }
    }
  };

  //A word character: letter (which includes `_`, see asciiClasses) or digit.

  let isKind = (ch, pos, kinds) => {
    let cls = Char.classify(Char.codeAt(source, pos.index));
    //TODO std add List.contains
    List.any(kinds, (c) => { c == cls })
  };
  let wordKinds = [Char.classLetter, Char.classDigit];
  

  //Advance exactly n characters, threading line/col through each one.
  let rec advanceN = (pos, n) => {
    if (n <= 0) {
      pos
    } else {
      let ch = match(peekByOne(pos.index)) {
        Some(c) => {c},
        None => {""}
      };
      advanceN(advancePosition(pos, ch), n - 1)
    }
  };

  let widthToN = match(width) => {
    Token.OneWide => {1},
    Token.TwoWide => {2}
  };

  let kindReadToEnd = (pos, kind, thing) => {
    match(Token.fixedWidth(kind)) {
      Some(width) => {
        advanceN(pos, widthToN(width))
      },
      None => {
        match(kind) {
          Token.CommentStartToken => {
            advancePosition(advancePosition(pos, thing), "-")
          },
          Token.LineComment => {
            //read until end of line; EOF terminates too
            let (commentText, endPos) =
              //TODO JANK
              readTillEnd(pos, (ch, p, _) => {ch != "\n"}, None);
            --print(`line comment: ${commentText}`);
            endPos
          },
          Token.LowerIdentifierToken => {
            let (_, endPos) = readTillEnd(pos, isKind, wordKinds);
            endPos
          },
          Token.UpperIdentifierToken => {
            let (_, endPos) = readTillEnd(pos, isKind, wordKinds);
            endPos
          },
          Token.IntegerToken => {
            let (_, endPos) = readTillEnd(pos, isKind, [Char.classDigit]);
            endPos
          },
          Var(x) => {Panic(`missing read to end for type ${x}`)}
        }
      }
    }
  };
  let makeSpan = (pos, kind:Token.TokenKind, txt): Source.Span => {
    --print(`print start pos from make span: ${pos}`);
    --pri nt("printing kind: ", kind);
    let endPose = kindReadToEnd(pos, kind, txt);
    --print(`print end   pos from make span: ${endPose}`);
    .{
      startPos= pos,
      endPos= endPose
    }
  };

  let makeToken = (tt:Token.TokenKind, pos, txt):(Token.Token, Source.Position) => {
    let span = makeSpan(pos, tt, txt);
    (Token.Token(
      tt,
      span,
      Token.NoMate,
      []
    ),
    span.endPos)
  };
  let makeTokSimpleSymbol = (tokkind, pos, txt) => {
    let (tok, nextPos) = makeToken(
      tokkind,
      pos, 
      txt
    );
    .{
      tokens = [tok],
      newPosition = nextPos
    }
  };

  //#region mate bookkeeping (single-pass delimiter pairing)

  //Forward pass mating: openers push (index, group) onto the stack; closers
  //pop it, learn their opener immediately, and record the pair for later.
  //No rewriting of acc happens here - openers get their Mate stamped at EOF,
  //in the same walk that reverses acc into source order.
  //TODO mismatched-group and stray closers should become LexicalMarks here
  //instead of passing through silently.
  let mateStep = (tok, idx, stack, pairs) => {
    match(Token.pairRole(tok.kind)) {
      None => {
        (tok, stack, pairs)
      },
      Some(Token.PairRole(group, Token.Open)) => {
        (tok, [(idx, group), ..stack], pairs)
      },
      Some(Token.PairRole(group, Token.Close)) => {
        match(stack) {
          [(Var(openIdx), Var(openGroup)), ..restStack] => {
            if (openGroup == group) {
              //closer knows its opener right away; opener waits for EOF
              (.{..tok, mateIdx = Token.Mate(openIdx)}, restStack, [(openIdx, idx), ..pairs])
            } else {
              //mismatched group: TODO LexicalMark
              (tok, stack, pairs)
            }
          },
          [] => {
            //stray closer: TODO LexicalMark
            (tok, stack, pairs)
          }
        }
      }
    }
  };

  let rec findCloseFor = (pairs, openIdx) => {
    match(pairs) {
      [] => {None},
      [(Var(o), Var(c)), ..rest] => {
        if (o == openIdx) {
          Some(c)
        } else {
          findCloseFor(rest, openIdx)
        }
      }
    }
  };

  //Final walk: reverse acc (newest-first) into source order, stamping every
  //opener with its closer's index from `pairs`. Replaces plain List.reverse.
  let rec reverseAndStamp = (items, i, pairs, out) => {
    match(items) {
      [] => {out},
      [tok, ..rest] => {
        let tok2 = match(Token.pairRole(tok.kind)) {
          Some(Token.PairRole(_, Token.Open)) => {
            match(findCloseFor(pairs, i)) {
              Some(closeIdx) => {.{..tok, mateIdx = Token.Mate(closeIdx)}},
              None => {tok} //unclosed opener: TODO LexicalMark
            }
          },
          _ => {tok}
        };
        reverseAndStamp(rest, i - 1, pairs, [tok2, ..out])
      }
    }
  };
  //#endregion

  let rec skipWhitespace = (pos: Source.Position) => {
    if (pos.index < length) {
      let chNum = Char.codeAt(source, pos.index);
      if (chNum == 32 || chNum == 10 || chNum == 13 || chNum == 9) {
        let next: Source.Position = .{
          index = pos.index + 1,
          line = if (chNum == 10) {pos.line + 1} else {pos.line},
          col = if (chNum == 10) {1} else {pos.col + 1}
        };
        skipWhitespace(next)
      } else {
        pos
      }
    } else {
      pos
    }
  };

  let printPos = (pos) =>{
    let x = peekBy(pos.index, 1);
    match(x) {
      Some(x) => {print x},
      _ => {print "eof i think"}
    }
  };

  let readFromSymbol = (pos):ReadResult => {
    --printPos(pos);
    let txt = match(peekByOne(pos.index)) {
      Some(x) => {x},
      None => {
        //#TODO we should not have to check this earlier ascii check knows something here
        Panic("unreachable")
      }
    };


    let readResult = match(txt) {
      "-" => {
        match(peekByOne(pos.index + 1)) {
          Some("-") => {
            let (cStartTok, afterpos) = makeToken(Token.CommentStartToken, pos, txt);
            let (lineCommentTok, endPos) = makeToken(Token.LineComment, afterpos, txt);
            .{
              tokens = [cStartTok, lineCommentTok],
              newPosition = endPos
            }
          },
          Some(">") => {
            (Token.PunctuationToken(Token.ThinArrow), pos, txt) :> makeTokSimpleSymbol
          },
          _ => {
            (Token.OperatorToken(Token.Subtract), pos, txt) :> makeTokSimpleSymbol
          }
        }
      },
      "/" => {
        match(peekByOne(pos.index + 1)) {
          Some("/") => {
            let (cStartTok, afterpos) = makeToken(Token.CommentStartToken, pos, txt);
            let (lineCommentTok, endPos) = makeToken(Token.LineComment, afterpos, txt);
            .{
              tokens = [cStartTok, lineCommentTok],
              newPosition = endPos
            }
          },
          _ => {
            (Token.OperatorToken(Token.Divide), pos, txt) :> makeTokSimpleSymbol
          }
        }
      },
      "<" => {
        (Token.PunctuationToken(Token.LessThan), pos, txt) :> makeTokSimpleSymbol
      },
      ">" => {
        (Token.PunctuationToken(Token.GreaterThan), pos, txt) :> makeTokSimpleSymbol
      },
      "," => {
        (Token.PunctuationToken(Token.Comma), pos, txt) :> makeTokSimpleSymbol
      },
      "=" => {
        match (peekByOne(pos.index + 1)) {
          Some(">") => {
            (Token.PunctuationToken(Token.FatArrow), pos, txt) :> makeTokSimpleSymbol
          },
          Some("=") => {
            (Token.OperatorToken(Token.Equal), pos, txt) :> makeTokSimpleSymbol
          },
          _ => {  
            (Token.PunctuationToken(Token.Equals), pos, txt) :> makeTokSimpleSymbol
          }
        }
      },
      "|" => {
        match (peekByOne(pos.index + 1)) {
          Some("|") => {
            (Token.OperatorToken(Token.BooleanOr), pos, txt) :> makeTokSimpleSymbol
          },
          _ => {  
            (Token.PunctuationToken(Token.Pipe), pos, txt) :> makeTokSimpleSymbol
          }
        }
      },
      ":" => {
        match (peekByOne(pos.index + 1)) {
          Some(">") => {
            (Token.PunctuationToken(Token.PipeForward), pos, txt) :> makeTokSimpleSymbol
          },
          _ => {  
            (Token.PunctuationToken(Token.Colon), pos, txt) :> makeTokSimpleSymbol
          }
        }
      },
      ";" => {
        (Token.PunctuationToken(Token.Semicolon), pos, txt) :> makeTokSimpleSymbol
      },
      "{" => {
        (Token.PunctuationToken(Token.LeftBrace), pos, txt) :> makeTokSimpleSymbol
      },
      "}" => {
        (Token.PunctuationToken(Token.RightBrace), pos, txt) :> makeTokSimpleSymbol
      },
      "(" => {
        (Token.PunctuationToken(Token.LeftParen),pos,txt ):>makeTokSimpleSymbol
      },
      ")" => {
        (Token.PunctuationToken(Token.RightParen),pos,txt ):>makeTokSimpleSymbol
      },
      "." => {
        match (peekByOne(pos.index + 1)) {
          Some("{") => {
            (Token.PunctuationToken(Token.DotLeftBrace),pos,txt):>makeTokSimpleSymbol
          },
          Some(".") => {
            (Token.PunctuationToken(Token.DoubleDot),pos,txt):>makeTokSimpleSymbol
          },
          _ => {
            (Token.PunctuationToken(Token.Dot),pos,txt):>makeTokSimpleSymbol
          }
        }
      },
      "*"=> {
        (Token.OperatorToken(Token.Multiply)) :> makeTokSimpleSymbol
      },
      Var(x) => {
        print(`whats this "${x}"`);
        ?
      }
    };
    readResult
  };

  let readFromLetter = (pos): ReadResult => {
    let (word, endPos) = readTillEnd(pos, isKind, wordKinds);
    let firstCode = Char.codeAt(word, 0);
    //A-Z starts an upper (constructor/type) identifier, anything else lower
    let kind = if (Char.isUpperCode(firstCode)) {
      Token.UpperIdentifierToken
    } else {
      Token.LowerIdentifierToken
    };
    let (tok, _) = makeToken(kind, pos, word);
    .{
      tokens = [tok],
      newPosition = endPos
    }
  };
  
  let readFromDigit = (pos):ReadResult => {
    let (number, endPos) = 
      readTillEnd(pos, isKind, [Char.classDigit]);
    let (tok, _) = makeToken(Token.IntegerToken, pos, number);
    .{
      tokens = [tok],
      newPosition = endPos
    }
  };
    
  let readFromStringLit = (pos): ReadResult => {
    // 1. Get the starting quote character (usually `"`)
    let quoteCh = match(peekByOne(pos.index)) {
      Some(c) => { c },
      None => { ? } // Fallback, though we shouldn't hit this
    };

    let posAfterQuote = advancePosition(pos, quoteCh);

    // 2. Recursively read characters until we find the unescaped closing quote
    let rec readBody = (currPos, isEscaping, accText) => {
      match(peekByOne(currPos.index)) {
        Some(ch) => {
          if (isEscaping) {
            // The previous char was '\', so consume this one unconditionally
            readBody(advancePosition(currPos, ch), false, accText ++ ch)
          } else {
            if (ch == "\\") {
              // Found a backslash, enter escape mode for the next character
              readBody(advancePosition(currPos, ch), true, accText ++ ch)
            } else {
              if (ch == quoteCh) {
                // Found the closing quote!
                let endPos = advancePosition(currPos, ch);
                (accText ++ ch, endPos)
              } else {
                // Normal character inside the string
                readBody(advancePosition(currPos, ch), false, accText ++ ch)
              }
            }
          }
        },
        None => {
          // Reached EOF before the string was closed
          (accText, currPos)
        }
      }
    };

    // Start reading the body after the initial quote. 
    // `accText` starts with the opening quote.
    let (fullText, endPos) = readBody(posAfterQuote, false, quoteCh);

    // 3. Create the span and token manually (so we don't crash in kindReadToEnd)
    let span: Source.Span = .{
      startPos = pos,
      endPos = endPos
    };

    let tok = Token.Token(
      Token.QuotedStringToken, // NOTE: Change this if your variant is named differently (e.g. StringLiteralToken)
      span,
      Token.NoMate,
      []
    );

    .{
      tokens = [tok],
      newPosition = endPos
    }
  };
  
  
  
  let readCharToEnd = (startPosition: Source.Position) => {
    let p = peekByOne(startPosition.index);
    match (p) {
      Some(ch) => {

      },
      None => {
        Panic("fuck ")
      }
    }
  };
  //#endregion

  //Only the open-bracket stack is mate-specific state; acc stays a plain arg.
  //The token index used for mates is derived inside mateStep from acc length,
  //since every token is appended to acc exactly once.

  //Mating state: the open-bracket stack plus recorded (openIdx, closeIdx)
  //pairs waiting to be stamped during the final reverse at EOF.
  record Mates = {
    stack: List<(Number, Token.PairGroup)>,
    pairs: List<(Number, Number)>,
  };

  let rec loop = (pos, m, acc, mates: Mates) => {
    if (pos.index < length) {
      let pos = skipWhitespace(pos);
      --printPos(pos);
      let class = Char.classify(Char.codeAt(source, pos.index));
      let bumpPos = (p) => {
        .{..p, index= p.index +1}
      };
      
      let someAbstract = (res) => {
        match(res.tokens) {
          [tok] => {
            let (tok2, stack2, pairs2) =
              mateStep(tok, List.length(acc), mates.stack, mates.pairs);
            loop(
              res.newPosition,
              Default,
              [tok2, ..acc],
              .{stack = stack2, pairs = pairs2}
            )
          },
          _ => {
            //comment batches carry no pairs yet pass them trough
            loop(
              res.newPosition,
              Default,
              List.append(List.reverse(res.tokens), acc),
              mates
            )
          }
        }
      };
        
      //did skipping whitespace go to eof?
      if (pos.index >= length) {
        loop(pos, Default, acc, mates)
      } else {
        match(class) {
          Char.classSpace  => {Panic("todoSpace")},
          Char.classLetter => {readFromLetter(pos) :> someAbstract},
          Char.classDigit  => {readFromDigit(pos) :> someAbstract},
          Char.classStrQuo => {readFromStringLit(pos) :> someAbstract},
          Char.classSymbol => {readFromSymbol(pos) :> someAbstract},
          Char.classOther  => {?},
          _                => {Panic("unreachable")}
        }
      }
    } else {
      //eof
      let eofSpan = Source.Span(pos,pos);
      let eofToken = Token.Token(
        Token.EndOfFileToken,
        eofSpan,
        Token.NoMate,
        []
      );
      //TODO: leftover `mt.stack` entries are unclosed delimiters -> LexicalMarks
      match(m) {
        Ident => {
          let fakeIndent = Token.Token(
            Token.LowerIdentifierToken,
            eofSpan,
            Token.NoMate,
            []
          );
          reverseAndStamp(
            [eofToken,fakeIndent,..acc],
            List.length(acc) + 1,
            mates.pairs,
            []
          )
        },
        Default => {
          reverseAndStamp(
            [eofToken, ..acc],
            List.length(acc),
            mates.pairs, []
          )
        },
      }
    }
  };

  loop(Source.Position(0, 0, 0), Default, [], .{stack = [], pairs = []})
};
