from "../../testman/test.wm" import *;
from "../src/parser/program.wm" import * as Parser;
from "../src/surface/ast.wm" import * as Ast;
from "../src/lexer/token.wm" import * as Token;
from "../src/editor/view.wm" import * as View;
from "../lib/subsetml/subset_utf16_source.wm" import * as TextSource;
from "../lib/subsetml/subset_result.wm" import * as R;

let source = (text: String) => {
  match(TextSource.fromNativeUnits(text)) {
    R.Ok(value) => {value}, R.Err(_) => {Panic("unreachable")} // Fixture strings expose UTF-16 units.
  }
};
let withValue = (input, check) => {
  let document = Parser.parse(source("let x=" ++ input));
  match(document.phrases) {
    [Ast.BindingStatement(binding, _)] => {check(binding.value)},
    _ => {fail("operator fixture was not one binding")}
  }
};
let projectedEquals = (input, expected) => {
  match(View.render(Parser.parse(source(input)), false, 256)) {
    R.Err(_) => {fail("operator view failed")},
    R.Ok(value) => {assertEqual(TextSource.toUnits(value.projection.text), TextSource.toUnits(source(expected)))}
  }
};
let tests = [
  test("multiplication binds inside addition", () => {
    withValue("a+b*c", (value) => {
      match(value) {
        Ast.InfixExpr(_, _, operator, Ast.InfixExpr(_, _, inner, _)) => {
          checks([assert(operator.kind == Token.OperatorToken(Token.Add), "outer operator is not addition"),
            assert(inner.kind == Token.OperatorToken(Token.Multiply), "inner operator is not multiplication")])
        },
        _ => {fail("multiplication was not nested on the right")}
      }
    })
  }),
  test("same-tier operators associate to the left", () => {
    withValue("a-b-c", (value) => {
      match(value) {
        Ast.InfixExpr(_, Ast.InfixExpr(_, _, _, _), _, _) => {pass()},
        _ => {fail("subtraction was not left associated")}
      }
    })
  }),
  test("boolean, comparison and arithmetic tiers match current WM", () => {
    projectedEquals("let x=a+b*c<=d==true&&e||f", "let x = a + b * c <= d == true && e || f;\n")
  }),
  test("prefix operators bind over calls and preserve source spelling", () => {
    checks([projectedEquals("let x=-f(a)+!!b", "let x = -f(a) + !!b;\n"),
      projectedEquals("let x=-0x2a%5", "let x = -0x2a % 5;\n")])
  }),
  test("missing operands become virtual expression holes without consuming the next operator", () => {
    checks([projectedEquals("let x=a+", "let x = a + ?;\n"),
      projectedEquals("let x=a*+b", "let x = a * ? + b;\n"),
      projectedEquals("let x=a+*b", "let x = a + ? * b;\n"),
      projectedEquals("let x=*b", "let x = ? * b;\n"),
      projectedEquals("let x=!", "let x = !?;\n")])
  }),
  test("a missing operand preserves a later binding", () => {
    projectedEquals("let x=a+\nlet y=1", "let x = a + ?;\nlet y = 1;\n")
  }),
  test("lambda operands receive marked grouping instead of an alternate grammar", () => {
    projectedEquals("let x=1+x=>x", "let x = 1 + ((x) => { x });\n")
  })
];
