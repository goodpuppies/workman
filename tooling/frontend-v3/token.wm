from "./mark.wm" import * as Mark;
from "./source.wm" import * as Source;

// Lossless lexical layer for the handwritten Surface AST.
// Token categories are closed. Authored spelling is addressed by source spans.

// The kind of non-code content that can appear between tokens.
// Trivia is recorded so tooling (formatting, LSP, lossless round-trips)
// can reproduce the source exactly.
type TriviaKind =
  | HorizontalWhitespace  // spaces and tabs on one line
  | LineBreak             // a newline (possibly with surrounding CRs)
  | DashLineComment       // `--` line comment
  | SlashLineComment      // `//` line comment
  | BlockComment;         // nested `/* ... */` comment

// Bracketing/separating symbols that structure the syntax but do not compute.
type Punctuation =
  | LeftParen        // `(`
  | RightParen       // `)`
  | LeftBrace        // `{`
  | DotLeftBrace     // `.{`
  | RightBrace       // `}`
  | LeftBracket      // `[`
  | RightBracket     // `]`
  | LessThan         // `<`   - also opens type applications
  | GreaterThan      // `>`
  | Comma            // `,`
  | Semicolon        // `;`
  | Colon            // `:`   - type ascription / record fields
  | Dot              // `.`   - qualified names, receiver access
  | DoubleDot        // `..`  - spread / rest patterns
  | AtSign           // `@`   - attributes/directives
  | Equals           // `=`   - definition, not comparison
  | FatArrow         // `=>`  - functions / match arms
  | ThinArrow        // `->`  - function types
  | Pipe             // `|`   - variant/pattern alternatives
  | PipeForward;     // `:>`  - pipe into call

// Symbols that combine values; each has fixed precedence in the parser.
type Operator =
  | BooleanOr        // `||`
  | BooleanAnd       // `&&`
  | Equal            // `==`
  | NotEqual         // `!=`
  | LessOrEqual      // `<=`
  | GreaterOrEqual   // `>=`
  | Add              // `+`
  | Subtract         // `-`
  | Multiply         // `*`
  | Divide           // `/`
  | Remainder        // `%`
  | Concatenate      // `++`
  | BooleanNot       // `!`
  | Hole;            // `?`

// The closed set of token categories the lexer emits.
type TokenKind =
  | PunctuationToken<Punctuation>     // structural symbol, e.g. `(`, `=>`
  | OperatorToken<Operator>           // computing symbol, e.g. `+`, `==`
  | LowerIdentifierToken              // lowercase-starting name: `lex`, `foo_bar`
  | UpperIdentifierToken              // uppercase-starting name: `Result`, `List`
  | IntegerToken                      // integer literal: `42`, `0x2a`
  | WordToken                         // word literal: `0w42`, `0wx2a`
  | FloatToken                        // real literal: `3.14`, `3e-7`
  | QuotedStringToken                 // `"..."` string literal
  | CharacterToken                    // single Unicode scalar in single quotes
  | MultilineStringStartToken         // opening backtick of a multiline string
  | MultilineStringTextToken          // raw text chunk inside a multiline string
  | InterpolationStartToken           // `${` inside an interpolated string
  | InterpolationEndToken             // closing `}` of an interpolation
  | MultilineStringEndToken           // closing backtick of a multiline string
  | UnknownToken                      // anything unrecognizable (kept for recovery)
  | EndOfFileToken;                   // synthetic EOF sentinel

// Delimiter families that must pair up: every opener expects a closer from
// the same group (and vice versa).
type PairGroup =
  | ParenGroup     // ( )
  | BraceGroup     // { }   (also closes record literals `.{`)
  | BracketGroup   // [ ]
  | TemplateGroup
  | InterpolationGroup;

// Whether a kind opens or closes its group.
type PairSide =
  | Open
  | Close;

// The pairing role of a token kind: its group and side.
type PairRole =
  | PairRole<PairGroup, PairSide>;

// Token metadata: which delimiter family a kind belongs to and on which
// side. None for everything that does not participate in pairing.
let pairRole = match(kind) => {
  PunctuationToken(punctuation) => {
    match(punctuation) {
      LeftParen => {Some(PairRole(ParenGroup, Open))},
      RightParen => {Some(PairRole(ParenGroup, Close))},
      DotLeftBrace => {Some(PairRole(BraceGroup, Open))},
      LeftBrace => {Some(PairRole(BraceGroup, Open))},
      RightBrace => {Some(PairRole(BraceGroup, Close))},
      LeftBracket => {Some(PairRole(BracketGroup, Open))},
      RightBracket => {Some(PairRole(BracketGroup, Close))},
      LessThan => {None},
      GreaterThan => {None},
      Comma => {None},
      Semicolon => {None},
      Colon => {None},
      Dot => {None},
      DoubleDot => {None},
      AtSign => {None},
      Equals => {None},
      FatArrow => {None},
      ThinArrow => {None},
      Pipe => {None},
      PipeForward => {None},
    }
  },
  // Operators combine values; they never delimit structure.
  OperatorToken(_) => {None},
  LowerIdentifierToken => {None},
  UpperIdentifierToken => {None},
  IntegerToken => {None},
  WordToken => {None},
  FloatToken => {None},
  QuotedStringToken => {None},
  CharacterToken => {None},
  MultilineStringStartToken => {Some(PairRole(TemplateGroup, Open))},
  MultilineStringTextToken => {None},
  MultilineStringEndToken => {Some(PairRole(TemplateGroup, Close))},
  UnknownToken => {None},
  EndOfFileToken => {None},
  InterpolationStartToken => {Some(PairRole(InterpolationGroup, Open))},
  InterpolationEndToken => {Some(PairRole(InterpolationGroup, Close))}
};

// What went wrong during lexing. Recorded, never thrown, so the parser can
// keep going and report everything at once.
type LexicalProblem =
  | InvalidSourceUnit            // input is not even parseable as a unit
  | UnknownCharacter             // character outside the language's alphabet
  | MalformedNumber              // missing digits or an invalid identifier suffix
  | InvalidEscape                // bad `\x` sequence in a string
  | UnterminatedQuotedString     // no closing `"`
  | UnterminatedMultilineString  // no closing backtick
  | UnterminatedBlockComment     // no closing `*/`
  | InvalidUnicodeScalar         // unpaired UTF-16 surrogate in literal text
  | InvalidCharacterLength<Number> // decoded literal contains other than one scalar
  | UnterminatedCharacter
  | UnmatchedDelimiter<PairGroup, PairSide> // authored delimiter has no recorded pair
  | UnterminatedInterpolation;   // no closing `}` after `${`

// Which delimiter was expected to end a lexeme; used by recovery to guess
// where a malformed token should have stopped.
type LexemeTerminator =
  | QuoteTerminator               // expected `"`
  | CharacterTerminator
  | BacktickTerminator            // expected a backtick
  | InterpolationBraceTerminator; // expected `}`

// How the lexer repairs around a problem while preserving as much of the
// original text as possible.
type LexicalRecovery =
  | RetainedUnknownToken                        // keep the junk as UnknownToken
  | RetainedMalformedToken<TokenKind>           // keep a damaged token of this kind
  | RetainedMalformedTrivia<TriviaKind>         // keep damaged trivia through its boundary
  | RetainedUnpairedDelimiter                    // preserve delimiter without inventing a mate
  | AssumedLexemeTerminator<LexemeTerminator>   // pretend a missing closer existed
  | SplitMalformedToken;                        // cut one bad token into several

// A (problem, recovery) pair attached to the token or trivia it affects.
type LexicalMark = Mark.Mark<LexicalProblem, LexicalRecovery>;

// One piece of trivia: its exact spelling, source location, and lexical problems.
record Trivia = {
  kind: TriviaKind,
  text: String,
  span: Source.Span,
  marks: List<LexicalMark>,
};

// Pairing index for delimiters that must match up: every open bracket records
// the index of its closer and vice versa (filled in a later pass). NoMate
// means the token has no mate - most tokens don't.
type Mate = Mate<Number> | NoMate;

// The base token: what it is, exactly where it came from, its delimiter
// pairing info, and any lexical problems attached to it.
record Token = {
  kind: TokenKind,
  span: Source.Span,
  mateIdx: Mate,
  marks: List<LexicalMark>,
  leadingTrivia: List<Trivia>,
};

// The full result of lexing a source file: all tokens plus all marks,
// ready for the parser.
record LexicalDocument = {
  tokens: List<Token>,
  marks: List<LexicalMark>,
};
