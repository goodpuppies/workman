from "./cursor.wm" import * as Cursor;
from "../lexer/token.wm" import * as Token;
from "../source/mark.wm" import * as Marks;
from "../surface/ast.wm" import * as Surface;
from "../../lib/subsetml/subset_list.wm" import * as Lists;

// Whole-parse identities. Lexer IDs are already consecutive in the supplied document.
record State = {
  cursor: Cursor.Cursor,
  lexicalMarks: List<Token.LexicalMark>,
  syntaxMarksRev: List<Surface.SyntaxMark>,
  nextMarkId: Number,
  nextNodeId: Number,
  nextDelimiterId: Number,
  consumedEnd: Number,
};

type Expected = ExpectedType | ExpectedUpperName | ExpectedCloser<Token.TokenKind>
  | ExpectedTupleCommaOrArrow | ExpectedEnd;
record Failure = {
  expected: Expected,
  stoppedState: State,
};
type Outcome<T> = Parsed<T, State> | Rejected<Failure>;

let fromDocument = (source, document: Token.LexicalDocument) => {
  State(Cursor.fromDocument(source, document), document.marks, [],
    Lists.length(document.marks), 0, 0, 0)
};
let reject = (state, expected) => {Rejected(Failure(expected, state))};

// Only grammatical helpers that have established a non-EOF token call consume.
let consume = (state: State) => {
  match(Cursor.take(state.cursor)) {
    Cursor.TokenTaken(token, cursor) => {
      (token, State { ..state, cursor = cursor, consumedEnd = token.span.endPos.index })
    },
    Cursor.ReachedEnd(_) => {Panic("unreachable")}
  }
};
let node = (state: State, start) => {
  (Surface.Node(Surface.NodeId(state.nextNodeId),
    Marks.SourceSpan(Marks.SourceOffset(start), Marks.SourceOffset(state.consumedEnd))),
    State { ..state, nextNodeId = state.nextNodeId + 1 })
};
let delimited = (state: State, open, content, close) => {
  (Surface.Delimited(Surface.DelimiterId(state.nextDelimiterId), open, content, close),
    State { ..state, nextDelimiterId = state.nextDelimiterId + 1 })
};
let rec owns = (boundaries, kind) => {
  match(boundaries) {
    [] => {false},
    [boundary, ..rest] => {boundary == kind || owns(rest, kind)}
  }
};
let atBoundary = (state: State, boundaries) => {
  let token = Cursor.current(state.cursor);
  token.kind == Token.EndOfFileToken || owns(boundaries, token.kind)
};

// Missing closers are the only recovery currently agreed. The caller's token is kept.
let close = (state: State, expected, boundaries) => {
  if (Cursor.isKind(state.cursor, expected)) {
    let (token, next) = consume(state);
    Parsed(Marks.AuthoredSlot(token), next)
  } else {
    if (atBoundary(state, boundaries)) {
      let offset = Cursor.offset(state.cursor);
      let id = Marks.MarkId(state.nextMarkId);
      let expectation = Surface.ExpectedTokenKind(expected);
      let mark = Marks.Mark(id, Surface.MissingToken(expectation),
        Marks.RecoveredWith(Surface.InsertedToken(expectation)), Marks.SourceOffset(offset),
        Marks.SourceSpan(Marks.SourceOffset(offset), Marks.SourceOffset(offset)),
        None); // No causal link has been established to any lexical damage.
      Parsed(Marks.MissingSlot(id, expectation), State { ..state,
        syntaxMarksRev = [mark, ..state.syntaxMarksRev], nextMarkId = state.nextMarkId + 1,
        consumedEnd = offset })
    } else {reject(state, ExpectedCloser(expected))}
  }
};
let marks = (state: State) => {
  Lists.append(Lists.map(state.lexicalMarks, (mark) => {Surface.LexicalSurfaceMark(mark)}),
    Lists.map(Lists.reverse(state.syntaxMarksRev), (mark) => {Surface.SyntaxSurfaceMark(mark)}))
};
