from "../source/mark.wm" import * as Marks;
from "../lexer/token.wm" import * as Token;
from "basis/utf16_source.wm" import * as Text;

// Minimal canonical slice, deliberately not a declaration of complete WM coverage.
// Every required structural terminal is authored or marked in the same shape.
type NodeId = | NodeId<I32>;
type DelimiterId = | DelimiterId<I32>;
record Node = {
  nodeId: NodeId,
  authoredSpan: Marks.SourceSpan,
};
type Expectation = ExpectedPunctuation<Token.Punctuation> | ExpectedWord<List<I32>>;
type TokenSlot = Marks.Slot<Token.Token, Expectation>;
type SyntaxProblem = MissingToken<Expectation> | MissingExpression | MissingBindingPattern | UnassembledSyntax;
type SyntaxRecovery = CompletedToken | InsertedExpressionHole | InsertedWildcardPattern | RetainedOpaqueSyntax;
type SyntaxMark = Marks.Mark<SyntaxProblem, SyntaxRecovery>;

record Delimited<T> = {
  delimiterId: DelimiterId,
  openSlot: TokenSlot,
  contents: T,
  closeSlot: TokenSlot,
};
record SeparatedItem<T> = {
  separator: TokenSlot,
  nextItem: T,
};
record Separated<T> = {
  firstItem: T,
  following: List<SeparatedItem<T>>,
  trailingComma: Option<Token.Token>,
};
// Empty is a genuine empty list; missing list delimiters are still required slots.
type Items<T> = EmptyItems | NonemptyItems<Separated<T>>;
record TupleBody<T> = {
  tupleFirst: T,
  firstComma: TokenSlot,
  tupleRest: Items<T>,
};
record SpreadTail<T> = {
  beforeSpread: Option<TokenSlot>,
  spread: Token.Token,
  tailValue: T,
  trailingComma: Option<Token.Token>,
};
record ListBody<T> = {
  listItems: Items<T>,
  spreadTail: Option<SpreadTail<T>>,
};
type HoleOrigin = AuthoredHole<Token.Token> | VirtualHole<Marks.MarkId>;
type NameRole = BindingName | ReferenceName | ConstructorName;
type Feature = TypeSyntax | PatternSyntax | DeclarationSyntax | ExpressionSyntax;
type FragmentStatus = DamagedFragment<Marks.MarkId> | UnimplementedFragment<Feature>;
record Opaque = {
  opaqueNode: Node,
  tokenRun: List<Token.Token>,
  fragmentStatus: FragmentStatus,
};

record Binding<P, E> = {
  bindingNode: Node,
  letSlot: TokenSlot,
  pattern: P,
  equalsSlot: TokenSlot,
  value: E,
};
record BlockBody<S, E> = {
  statements: List<S>,
  result: Option<E>,
};
record Block<S, E> = {
  blockNode: Node,
  braces: Delimited<BlockBody<S, E>>,
};

type Pattern = NamePattern<Node, NameRole, Token.Token>
  | WildcardPattern<Node, Token.Token>
  | MissingPattern<Node, Marks.MarkId>;
type Expr = NameExpr<Node, Token.Token>
  | LiteralExpr<Node, Token.Token>
  | HoleExpr<Node, HoleOrigin>
  | PrefixExpr<Node, Token.Token, Expr>
  | InfixExpr<Node, Expr, Token.Token, Expr>
  | GroupExpr<Node, Delimited<Expr>>
  | TupleExpr<Node, Delimited<TupleBody<Expr>>>
  | ListExpr<Node, Delimited<ListBody<Expr>>>
  | CallExpr<Node, Expr, Delimited<Items<Expr>>>
  | LambdaExpr<Node, Delimited<Items<Pattern>>, TokenSlot, Block<Statement, Expr>>
  | BlockExpr<Block<Statement, Expr>>
  | OpaqueExpr<Opaque>
and Statement = BindingStatement<Binding<Pattern, Expr>, TokenSlot>
  | ExpressionStatement<Expr, TokenSlot>
  | OpaqueStatement<Opaque>;

record Program = {
  source: Text.Source,
  phrases: List<Statement>,
  eof: Token.Token,
  lexicalMarks: List<Token.LexicalMark>,
  syntaxMarks: List<SyntaxMark>,
};
