from "../../src/editor/preview.wm" import * as Preview;
from "../../src/editor/diff.wm" import * as Diff;
from "../../src/editor/inlays.wm" import * as Inlays;
from "../../src/editor/hints.wm" import * as Hints;
from "../../lib/subsetml/subset_utf16_source.wm" import * as Text;
from "../../lib/subsetml/subset_result.wm" import * as R;
from "../../lib/subsetml/subset_list.wm" import * as Lists;

let source = (value: String) => {
  match(Text.fromNativeUnits(value)) {
    R.Ok(text) => {text},
    R.Err(_) => {Panic("unreachable")} // Host strings expose only 16-bit source units.
  }
};

// Host fixtures use a WM list of (id, original UTF-16 offset, label) tuples.
let render = (original: String, hints, marked: Bool) => {
  let insertions = Lists.map(hints, (hint) => {
    let (id, anchor, label) = hint;
    Preview.Insertion(id, anchor, source(label))
  });
  Preview.render(source(original), insertions, marked)
};
let units = Text.toUnits;
let compare = (original: String, projected: String, limit: Number) => {
  Diff.compare(source(original), source(projected), limit)
};
let renderDifference = (difference: Diff.Difference, marked: Bool) => {
  Preview.render(difference.original, Inlays.additions(difference), marked)
};
let inlineHints = Hints.fromPreview;
