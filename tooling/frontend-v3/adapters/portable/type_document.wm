from "./document.wm" import * as Lexical;
from "../../src/parser/state.wm" import * as State;
from "../../src/surface/ast.wm" import * as Surface;
from "../../src/source/mark.wm" import * as Marks;
from "../../lib/subsetml/subset_list.wm" import * as Lists;
from "../../lib/subsetml/subset_utf16_source.wm" import * as Text;
from "../../lib/subsetml/subset_result.wm" import * as R;

// ASCII snapshot of the type-parser slice. Keep complete tokens, slots and mark IDs.
let number = Lexical.number;
let array = Lexical.array;
let tag = Lexical.tag;
let span = (value: Marks.SourceSpan) => {array([Lexical.offset(value.start), Lexical.offset(value.end)])};
let node = (value: Surface.Node) => {
  let Surface.NodeId(id) = value.id;
  array([number(id), span(value.span)])
};
let expectation = match {
  Surface.ExpectedTokenKind(kind) => {tag("ExpectedTokenKind", [Lexical.kind(kind)])},
  Surface.ExpectedKeyword(word) => {
    match(Text.fromNativeUnits(word)) {
      R.Ok(text) => {tag("ExpectedKeyword", [array(Lists.map(Text.toUnits(text), number))])},
      R.Err(_) => {Panic("unreachable")} // Grammar keyword spellings are ASCII in both runtimes.
    }
  }
};
let slot = match {
  Marks.AuthoredSlot(token) => {tag("AuthoredSlot", [Lexical.token(token)])},
  Marks.MissingSlot(id, expected) => {tag("MissingSlot", [Lexical.id(id), expectation(expected)])}
};
let name = (value: Surface.LongIdentifier) => {
  array([array(Lists.map(value.qualifiers, Lexical.token)), array(Lists.map(value.dots, slot)), Lexical.token(value.base)])
};
let rec phrase = match {
  Surface.TypeVariable(n, token) => {tag("TypeVariable", [node(n), Lexical.token(token)])},
  Surface.TypeName(n, identifier, arguments) => {
    let args = match(arguments) {
      None => {"null"}, // This authored name has no type-argument delimiters.
      Some(value) => {separatedDelimiter(value.argumentAngles)}
    };
    tag("TypeName", [node(n), name(identifier), args])
  },
  Surface.TypeTuple(n, components) => {tag("TypeTuple", [node(n), separatedDelimiter(components)])},
  Surface.TypeFunction(n, domain, arrow, result) => {tag("TypeFunction", [node(n), phrase(domain), slot(arrow), phrase(result)])},
  Surface.TypeParenthesized(n, value) => {
    let Surface.DelimiterId(id) = value.id;
    tag("TypeParenthesized", [node(n), array([number(id), slot(value.open), phrase(value.content), slot(value.close)])])
  },
  // These schema variants are not emitted by this slice. They are not source errors
  // or snapshot defaults; extending the parser to emit them requires extending this codec.
  Surface.TypeHole(_) => {Panic("type snapshot does not support holes")},
  Surface.TypeMarked(_) => {Panic("type snapshot does not support marked phrases")},
  Surface.TypeError(_, _) => {Panic("type snapshot does not support error islands")}
}
and separatedDelimiter = (value: Surface.Delimited<Surface.Separated<Surface.SurfaceType>>) => {
  let Surface.DelimiterId(id) = value.id;
  let content = value.content;
  let trailing = match(content.trailingSeparator) {
    None => {"null"}, // No trailing comma was authored.
    Some(token) => {slot(token)}
  };
  array([number(id), slot(value.open),
    array([array(Lists.map(content.items, phrase)), array(Lists.map(content.separators, slot)), trailing]), slot(value.close)])
};
let syntaxMark = (value: Surface.SyntaxMark) => {
  let expected = match(value.problem) {
    Surface.MissingToken(expected) => {expected},
    // This slice creates missing-token marks only. Other parser policies remain open.
    Surface.MissingPhrase(_) => {Panic("type snapshot does not support missing phrases")},
    Surface.UnexpectedTokens => {Panic("type snapshot does not support unexpected tokens")},
    Surface.UnassembledFragments => {Panic("type snapshot does not support fragments")}
  };
  let recovery = match(value.recovery) {
    Marks.RecoveredWith(Surface.InsertedToken(expected)) => {tag("RecoveredWith", [tag("InsertedToken", [expectation(expected)])])},
    // Every mark from State.close records its missing slot as recovered with InsertedToken.
    Marks.NotRecovered => {Panic("unreachable")},
    Marks.RecoveredWith(Surface.InsertedHole(_)) => {Panic("type snapshot does not support inserted holes")},
    Marks.RecoveredWith(Surface.RetainedErrorIsland) => {Panic("type snapshot does not support error islands")},
    Marks.RecoveredWith(Surface.RetainedUnassembledFragments) => {Panic("type snapshot does not support fragments")}
  };
  array([Lexical.id(value.id), tag("MissingToken", [expectation(expected)]), recovery,
    Lexical.offset(value.anchor), span(value.affectedSpan), Lexical.cause(value.causedBy)])
};
let mark = match {
  Surface.LexicalSurfaceMark(value) => {tag("LexicalSurfaceMark", [Lexical.mark(value)])},
  Surface.SyntaxSurfaceMark(value) => {tag("SyntaxSurfaceMark", [syntaxMark(value)])}
};
let state = (value: State.State) => {
  array([number(value.cursor.tokenIndex), array(Lists.map(value.cursor.remainingTokens, Lexical.token)),
    array(Lists.map(State.marks(value), mark)), number(value.nextMarkId), number(value.nextNodeId),
    number(value.nextDelimiterId), number(value.consumedEnd)])
};
let expected = match {
  State.ExpectedType => {tag("ExpectedType", [])},
  State.ExpectedUpperName => {tag("ExpectedUpperName", [])},
  State.ExpectedCloser(kind) => {tag("ExpectedCloser", [Lexical.kind(kind)])},
  State.ExpectedTupleCommaOrArrow => {tag("ExpectedTupleCommaOrArrow", [])},
  State.ExpectedEnd => {tag("ExpectedEnd", [])}
};
let encode = match {
  State.Parsed(value, after) => {tag("Parsed", [phrase(value), state(after)])},
  State.Rejected(failure) => {tag("Rejected", [expected(failure.expected), state(failure.stoppedState)])}
};
