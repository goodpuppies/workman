from "./lexer.wm" import { lex };
from "./token.wm" import * as Token;
from js.global("Deno") import { readTextFileSync };
from js.module("jsr:@std/fs/walk") import { walkSync };
from js.global("Array") import { from as arrayFrom };

let getTokText = (t: Token.Token, source) => {
  source 
    :> .slice(t.span.startPos.index, t.span.endPos.index)
    :> Result.debug
};

let printToken = (tok: Token.Token, source) => {
  let text = getTokText(tok, source);
  
  // Extract line and col for easy debugging
  let line = tok.span.startPos.line;
  let col = tok.span.startPos.col;
  
  // Format the output. Wrapping the text in single quotes helps visualize 
  // whitespace or empty strings (like the EOF token).
  print(`[Ln ${line}, Col ${col}] ${tok.kind} -> '${text}'`);
};


let printToks = (list, sourceText) => {
  let rec listPrinter = (l) => {
    match(l) {
      [] => { void },
      [tok, ..rest] => {
        printToken(tok, sourceText);
        listPrinter(rest)
      }
    }
  };
  
  print("=== TOKEN STREAM ===");
  listPrinter(list);
  print("====================");
};


let processFilesSync = (
  dir,
  postfix,
  fn,
): Void => {
  let iterator = walkSync(dir, JSON{ exts: JSON[postfix], includeDirs: false })
    :> Result.debug;
  let entryArray = arrayFrom(iterator) :> Result.debug;

  let rec step = (index) => {
    match(entryArray :> .at(index) :> Result.debug) {
      None => { void },
      Some(entry) => {
        let path = entry.path :> Result.debug;
        let content = readTextFileSync(path) :> Result.debug;
        fn(content, path);
        step(index + 1)
      }
    }
  };

  step(0);
};

let lex_all = () => {
  processFilesSync(".", ".wm", (source, path) => {
    print(`lexing ${path}`);
    let _tokens = lex(source);
    void
  })
};

let main = () => {
  lex_all()
};
