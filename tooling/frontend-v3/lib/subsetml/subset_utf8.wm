/* @subsetml
from "./subset_unicode.sml" import * as SubsetUnicode;
from "./subset_result.sml" import * as SubsetResult;
from "./subset_list.sml" import * as SubsetList;
from "./subset_char.sml" import * as SubsetChar;
*/

// Strict UTF-8 over byte characters and numeric Unicode scalars.

from "./subset_unicode.wm" import * as SubsetUnicode;
from "./subset_result.wm" import * as SubsetResult;
from "./subset_list.wm" import * as SubsetList;
from "./subset_char.wm" import * as SubsetChar;

let encodeOne = (code, index) => {
  if (SubsetUnicode.isScalar(code)) {
    let (a, b) = SubsetUnicode.split(code, 64);
    let (c, d) = SubsetUnicode.split(a, 64);
    let (e, f) = SubsetUnicode.split(c, 64);
    let codes = if (code < 128) { [code] } else {
      if (code < 2048) { [192 + a, 128 + b] } else {
        if (code < 65536) { [224 + c, 128 + d, 128 + b] } else { [240 + e, 128 + f, 128 + d, 128 + b] }
      }
    };
    SubsetUnicode.encodeCodes(codes, index)
  } else {
    SubsetResult.Err(SubsetUnicode.Error(SubsetUnicode.scalarError(code), index))
  }
};

let encode = (scalars) => {
  let rec go = match {
    ([], Var(index), Var(acc)) => { SubsetResult.Ok(SubsetList.reverse(acc)) },
    ([code, ..rest], Var(index), Var(acc)) => {
      match(encodeOne(code, index)) {
        SubsetResult.Err(error) => { SubsetResult.Err(error) },
        SubsetResult.Ok(bytes) => { go(rest, index + 1, SubsetList.reverseAppend(bytes, acc)) }
      }
    }
  };
  go(scalars, 0, [])
};

let decodeOne = (bytes, offset) => {
  match(bytes) {
    [] => {
      SubsetResult.Err(SubsetUnicode.Error(SubsetUnicode.Truncated, offset))
    },
    [lead, ..rest] => {
      match(SubsetChar.toCode(lead)) {
        SubsetResult.Err(error) => {
          SubsetResult.Err(SubsetUnicode.Error(SubsetUnicode.InvalidByte, offset))
        },
        SubsetResult.Ok(first) => {
          let continuation = (count, initial, minimum) => {
            let rec go = (remaining, input, code, consumed) => {
              if (remaining <= 0) {
                if (code < minimum) {
                  SubsetResult.Err(SubsetUnicode.Error(SubsetUnicode.Overlong, offset))
                } else {
                  if (SubsetUnicode.isScalar(code)) { SubsetResult.Ok(code, input, consumed) } else {
                    SubsetResult.Err(SubsetUnicode.Error(SubsetUnicode.scalarError(code), offset))
                  }
                }
              } else {
                match(input) {
                  [] => {
                    SubsetResult.Err(SubsetUnicode.Error(SubsetUnicode.Truncated, offset + consumed))
                  },
                  [c, ..tail] => {
                    match(SubsetChar.toCode(c)) {
                      SubsetResult.Err(error) => {
                        SubsetResult.Err(SubsetUnicode.Error(SubsetUnicode.InvalidByte, offset + consumed))
                      },
                      SubsetResult.Ok(value) => {
                        if (if (value >= 128) { value <= 191 } else { false }) {
                          go(remaining - 1, tail, code * 64 + value - 128, consumed + 1)
                        } else {
                          SubsetResult.Err(SubsetUnicode.Error(SubsetUnicode.InvalidContinuation, offset + consumed))
                        }
                      }
                    }
                  }
                }
              }
            };
            go(count, rest, initial, 1)
          };
          if (first < 128) { SubsetResult.Ok(first, rest, 1) } else {
            if (if (first >= 194) { first <= 223 } else { false }) { continuation(1, first - 192, 128) } else {
              if (if (first >= 224) { first <= 239 } else { false }) { continuation(2, first - 224, 2048) } else {
                if (if (first >= 240) { first <= 244 } else { false }) { continuation(3, first - 240, 65536) } else {
                  SubsetResult.Err(SubsetUnicode.Error(SubsetUnicode.InvalidLeadingByte, offset))
                }
              }
            }
          }
        }
      }
    }
  }
};

let decode = (bytes) => {
  let rec go = match {
    ([], Var(offset), Var(acc)) => { SubsetResult.Ok(SubsetList.reverse(acc)) },
    (Var(input), Var(offset), Var(acc)) => {
      match(decodeOne(input, offset)) {
        SubsetResult.Err(error) => { SubsetResult.Err(error) },
        SubsetResult.Ok(decoded) => {
          let (code, rest, consumed) = decoded;
          go(rest, offset + consumed, [code, ..acc])
        }
      }
    }
  };
  go(bytes, 0, [])
};
