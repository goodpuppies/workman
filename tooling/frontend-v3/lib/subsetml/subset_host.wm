// CLI and canonical filesystem identity. Representation adaptation stays at this boundary.
from "./subset_result.wm" import * as SubsetResult;
from js.module("./subset_host.js") import {
  canonicalPath as rawCanonicalPath: String -> String,
  readFile as rawReadFile: String -> String,
  writeFile as rawWriteFile: (String, String) -> Void,
  writeStdout as rawWriteStdout: String -> Void,
  writeStderr as rawWriteStderr: String -> Void,
  arguments as rawArguments: Void -> Js.Array<String>
};
from js.module("./subset_host.js") import unsafe { exit as rawExit: Bool -> Void };
let convert = (result) => {
  match(result) {
    Ok(value) => { SubsetResult.Ok(value) },
    Err(Js.Error(message)) => { SubsetResult.Err(message) },
    Err(Js.Unknown) => { SubsetResult.Err("unknown host error") }
  }
};
let readFile = (path) => { convert(rawReadFile(path)) };
let canonicalPath = (path) => { convert(rawCanonicalPath(path)) };
let writeFile = (data, path) => { convert(rawWriteFile(data, path)) };
let writeStdout = (data) => { convert(rawWriteStdout(data)) };
let writeStderr = (data) => { convert(rawWriteStderr(data)) };
let arguments = () => {
  match(rawArguments(void)) {
    Ok(values) => { SubsetResult.Ok(Js.Array.toList(values)) },
    Err(Js.Error(message)) => { SubsetResult.Err(message) },
    Err(Js.Unknown) => { SubsetResult.Err("unknown host error") }
  }
};
let exit = (success) => { rawExit(success) };
