let isSpaceChars = ['\t', '\n', '\u000b', '\u000c', '\r', ' '];
let isSpace = (c) => { member(c, isSpaceChars) };
let isAlpha = (c) => { if (isLower(c)) { true } else { isUpper(c) } };
let isAlphaNum = (c) => { if (isAlpha(c)) { true } else { isDigit(c) } };
let isHexDigit = (c) => {
  if (isDigit(c)) { true } else {
    member(c, ['a', 'b', 'c', 'd', 'e', 'f', 'A', 'B', 'C', 'D', 'E', 'F'])
  }
};
let isPunct = (c) => { if (isGraph(c)) { !isAlphaNum(c) } else { false } };

// Only ASCII has a source-defined order here. Other characters are rejected.
let compareAscii = (left, right) => {
  if (if (isAscii(left)) { isAscii(right) } else { false }) {
    let rec go = match {
      [] => { SubsetResult.Err(NonAscii) },
      [c, ..rest] => {
        if (c == left) {
          SubsetResult.Ok(if (left == right) { SubsetOrder.Equal } else { SubsetOrder.Less })
        } else {
          if (c == right) { SubsetResult.Ok(SubsetOrder.Greater) } else { go(rest) }
        }
      }
    };
    go(isAsciiChars)
  } else { SubsetResult.Err(NonAscii) }
};

