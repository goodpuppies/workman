let toCode = (c) => {
  let rec go = match {
    ([], Var(code)) => { SubsetResult.Err(NonByteCharacter) },
    ([x, ..xs], Var(code)) => {
      if (c == x) { SubsetResult.Ok(code) } else { go(xs, code + 1) }
    }
  };
  go(byteChars, 0)
};

// Range comparisons reject NaN/infinities; countdown rejects fractional codes.
let fromCode = (code: Number) => {
  if (if (code >= 0) { code <= 255 } else { false }) {
    let rec go = match {
      ([], Var(remaining)) => { SubsetResult.Err(InvalidCode) },
      ([c, ..rest], Var(remaining)) => {
        if (remaining <= 0) {
          if (remaining >= 0) { SubsetResult.Ok(c) } else { SubsetResult.Err(InvalidCode) }
        } else { go(rest, remaining - 1) }
      }
    };
    go(byteChars, code)
  } else { SubsetResult.Err(InvalidCode) }
};

let rec member = (c: Char, chars) => {
  match(chars) {
    [] => { false },
    [x, ..xs] => { if (c == x) { true } else { member(c, xs) } }
  }
};

let contains = (chars, c) => { member(c, chars) };

