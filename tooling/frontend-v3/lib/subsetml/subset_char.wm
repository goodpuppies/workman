let convert = (c, sourceChars, targetChars) => {
  let rec go = match {
    ([x, ..xs], [y, ..ys]) => { if (c == x) { y } else { go(xs, ys) } },
    ([], Var(ys)) => { c },
    (Var(xs), []) => { c }
  };
  go(sourceChars, targetChars)
};

let toLower = (c) => { convert(c, upper, lower) };
let toUpper = (c) => { convert(c, lower, upper) };
