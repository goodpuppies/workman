/* @subsetml
from "./subset_result.sml" import * as SubsetResult;
from "./subset_list.sml" import * as SubsetList;
from "./subset_char.sml" import * as SubsetChar;
*/

// Shared source-only Unicode arithmetic and codec errors. No host numeric library.

from "./subset_result.wm" import * as SubsetResult;
from "./subset_list.wm" import * as SubsetList;
from "./subset_char.wm" import * as SubsetChar;

type Reason =
  | InvalidScalar
  | InvalidByte
  | InvalidLeadingByte
  | InvalidContinuation
  | Truncated
  | Overlong
  | Surrogate
  | OutOfRange
  | OddLength
  | UnpairedSurrogate;
type Error = | Error<Reason, I32>;

// Internal: nonnegative scalar codes and a positive integer divisor.
let split = (value: I32, base: I32) => { (I32.div(value, base), I32.mod(value, base)) };

let isScalar = (value: I32) => {
  if (if (if (value >= (0: I32)) { value <= (1114111: I32) } else { false }) {
    !(if (value >= (55296: I32)) { value <= (57343: I32) } else { false })
  } else { false }) {
    let (whole, residue) = split(value, (1: I32));
    residue <= (0: I32)
  } else { false }
};

let scalarError = (value) => {
  if (if (value >= (55296: I32)) { value <= (57343: I32) } else { false }) { Surrogate } else {
    if (value > (1114111: I32)) { OutOfRange } else { InvalidScalar }
  }
};

let encodeCodes = (codes, index) => {
  SubsetResult.mapError(
    SubsetList.traverse(codes, SubsetChar.fromCode),
    (error) => { Error(InvalidByte, index) }
  )
};
