let fromNative = (value) => {
  let rec go = match {
    ([], Var(offset), Var(bytes)) => { SubsetResult.Ok(SubsetList.reverse(bytes)) },
    ([code, ..rest], Var(offset), Var(bytes)) => {
      match(SubsetChar.fromCode(code)) {
        SubsetResult.Err(error) => { SubsetResult.Err(NonByte(offset)) },
        SubsetResult.Ok(c) => { go(rest, offset + (1: I32), [c, ..bytes]) }
      }
    }
  };
  go(SubsetTextHost.codes(value), (0: I32), [])
};

let compare = (left, right) => {
  SubsetResult.andThen(
    fromNative(left),
    (xs) => {
      SubsetResult.andThen(
        fromNative(right),
        (ys) => {
          SubsetBytes.compareWith(xs, ys, (offset) => { NonByte(offset) })
        }
      )
    }
  )
};

let rec concat = (pieces) => {
  match(pieces) {
    [] => { "" },
    [value] => { value },
    [first, second, ..rest] => {
      let rec pairs = match {
        ([], Var(acc)) => { SubsetList.reverse(acc) },
        ([value], Var(acc)) => { SubsetList.reverse([value, ..acc]) },
        ([left, right, ..tail], Var(acc)) => { pairs(tail, [left ++ right, ..acc]) }
      };
      concat(pairs(pieces, []))
    }
  }
};

let concatWith = (pieces, separator) => {
  match(pieces) {
    [] => { "" },
    [first, ..rest] => {
      let rec go = match {
        ([], Var(acc)) => { concat(SubsetList.reverse(acc)) },
        ([piece, ..tail], Var(acc)) => { go(tail, [piece, separator, ..acc]) }
      };
      go(rest, [first])
    }
  }
};

let toNative = (bytes) => {
  let rec literal = (c, entries) => {
    match(entries) {
      [] => { None },
      [(Var(byte), Var(text)), ..rest] => { if (c == byte) { Some(text) } else { literal(c, rest) } }
    }
  };
  let rec go = match {
    ([], Var(offset), Var(pieces)) => { SubsetResult.Ok(concat(SubsetList.reverse(pieces))) },
    ([c, ..rest], Var(offset), Var(pieces)) => {
      match(literal(c, literals)) {
        None => { SubsetResult.Err(NonByte(offset)) },
        Some(text) => { go(rest, offset + (1: I32), [text, ..pieces]) }
      }
    }
  };
  go(bytes, (0: I32), [])
};
