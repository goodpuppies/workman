/* @subsetml
from "./subset_result.sml" import * as SubsetResult;
*/

/* Custom Basis lists. No host library calls, references or exceptions.
   Adapted from the existing portable SmlList algorithms; callbacks take data first. */

from "./subset_result.wm" import * as SubsetResult;

type Error = EmptyList | InvalidCount | InvalidIndex | OutOfBounds;

let isEmpty = match {
  [] => { true },
  [x, ..xs] => { false }
};

let rec reverseAppend = (xs, ys) => {
  match(xs) {
    [] => { ys },
    [x, ..rest] => { reverseAppend(rest, [x, ..ys]) }
  }
};
let reverse = (xs) => { reverseAppend(xs, []) };
let append = (xs, ys) => { reverseAppend(reverse(xs), ys) };

let rec foldLeft = (xs, initial, f) => {
  match(xs) {
    [] => { initial },
    [x, ..rest] => { foldLeft(rest, f(x, initial), f) }
  }
};
let foldRight = (xs, initial, f) => { foldLeft(reverse(xs), initial, f) };
let concat = (lists) => {
  reverse(foldLeft(lists, [], (xs, acc) => { reverseAppend(xs, acc) }))
};

let rec forEach = (xs, f) => {
  match(xs) {
    [] => { void },
    [x, ..rest] => {
      let void = f(x);
      forEach(rest, f)
    }
  }
};
let map = (xs, f) => { reverse(foldLeft(xs, [], (x, acc) => { [f(x), ..acc] })) };
let filterMap = (xs, f) => {
  reverse(foldLeft(
    xs,
    [],
    (x, acc) => {
      match(f(x)) {
        None => { acc },
        Some(y) => { [y, ..acc] }
      }
    }
  ))
};
let filter = (xs, predicate) => {
  reverse(foldLeft(xs, [], (x, acc) => { if (predicate(x)) { [x, ..acc] } else { acc } }))
};
let partition = (xs, predicate) => {
  let (yes, no) = foldLeft(
    xs,
    ([], []),
    (x, (yes, no)) => {
      if (predicate(x)) { ([x, ..yes], no) } else { (yes, [x, ..no]) }
    }
  );
  (reverse(yes), reverse(no))
};

let rec find = (xs, predicate) => {
  match(xs) {
    [] => { None },
    [x, ..rest] => { if (predicate(x)) { Some(x) } else { find(rest, predicate) } }
  }
};
let rec exists = (xs, predicate) => {
  match(xs) {
    [] => { false },
    [x, ..rest] => { if (predicate(x)) { true } else { exists(rest, predicate) } }
  }
};
let rec all = (xs, predicate) => {
  match(xs) {
    [] => { true },
    [x, ..rest] => { if (predicate(x)) { all(rest, predicate) } else { false } }
  }
};

let length = (xs) => { foldLeft(xs, 0, (x, count) => { count + 1 }) };
let rec dropWhile = (xs, predicate) => {
  match(xs) {
    [] => { [] },
    [x, ..rest] => { if (predicate(x)) { dropWhile(rest, predicate) } else { xs } }
  }
};

/* Counts must be exact nonnegative integers below 2^53. Check integrality with
   bounded binary weights before allocating; no numeric floor primitive is needed. */
let validCount = (count: Number) => {
  let rec integral = (remaining, weight) => {
    if (weight < 1) { if (remaining <= 0) { remaining >= 0 } else { false } } else {
      integral(if (remaining >= weight) { remaining - weight } else { remaining }, weight / 2)
    }
  };
  if (if (count >= 0) { count < 9007199254740992 } else { false }) { integral(count, 4503599627370496) } else { false }
};

let repeat = (value, count) => {
  let rec build = (remaining, acc) => {
    if (remaining <= 0) { acc } else { build(remaining - 1, [value, ..acc]) }
  };
  if (validCount(count)) { SubsetResult.Ok(build(count, [])) } else { SubsetResult.Err(InvalidCount) }
};

let splitAt = (xs, index) => {
  let rec go = (rest, remaining, acc) => {
    if (remaining <= 0) { SubsetResult.Ok(reverse(acc), rest) } else {
      match(rest) {
        [] => { SubsetResult.Err(OutOfBounds) },
        [x, ..tail] => { go(tail, remaining - 1, [x, ..acc]) }
      }
    }
  };
  if (validCount(index)) { go(xs, index, []) } else { SubsetResult.Err(InvalidIndex) }
};
let at = (xs, index) => {
  SubsetResult.andThen(
    splitAt(xs, index),
    (prefix, rest) => {
      match(rest) {
        [] => { SubsetResult.Err(OutOfBounds) },
        [x, ..tail] => { SubsetResult.Ok(x) }
      }
    }
  )
};
let take = (xs, count) => {
  SubsetResult.map(splitAt(xs, count), (prefix, rest) => { prefix })
};
let drop = (xs, count) => {
  SubsetResult.map(splitAt(xs, count), (prefix, rest) => { rest })
};
let tabulate = (count, f) => {
  let rec go = (index, acc) => {
    if (index >= count) { SubsetResult.Ok(reverse(acc)) } else { go(index + 1, [f(index), ..acc]) }
  };
  if (validCount(count)) { go(0, []) } else { SubsetResult.Err(InvalidCount) }
};

let head = match {
  [] => { SubsetResult.Err(EmptyList) },
  [x, ..xs] => { SubsetResult.Ok(x) }
};
let tail = match {
  [] => { SubsetResult.Err(EmptyList) },
  [x, ..xs] => { SubsetResult.Ok(xs) }
};
let rec last = match {
  [] => { SubsetResult.Err(EmptyList) },
  [x] => { SubsetResult.Ok(x) },
  [x, ..rest] => { last(rest) }
};

// Invoke callbacks left to right, stopping at the first Err.
let traverse = (xs, f) => {
  let rec go = match {
    ([], Var(acc)) => { SubsetResult.Ok(reverse(acc)) },
    ([x, ..rest], Var(acc)) => {
      match(f(x)) {
        SubsetResult.Err(error) => { SubsetResult.Err(error) },
        SubsetResult.Ok(y) => { go(rest, [y, ..acc]) }
      }
    }
  };
  go(xs, [])
};
