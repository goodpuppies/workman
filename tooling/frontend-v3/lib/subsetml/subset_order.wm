/* @subsetml
from "./subset_result.sml" import * as SubsetResult;
*/

// Custom ordering is ordinary source data, shared with generated Workman.

from "./subset_result.wm" import * as SubsetResult;

type Order = Less | Equal | Greater;
type Error = | Unordered;

// IEEE comparisons are unordered when either operand is NaN.
let compareReal = (left: Number, right: Number) => {
  if (left < right) { SubsetResult.Ok(Less) } else {
    if (left > right) { SubsetResult.Ok(Greater) } else {
      if (left <= right) { SubsetResult.Ok(Equal) } else { SubsetResult.Err(Unordered) }
    }
  }
};

let reverse = match {
  Less => { Greater },
  Equal => { Equal },
  Greater => { Less }
};
