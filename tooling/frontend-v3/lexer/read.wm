from "../character.wm" import * as Char;
from "../token.wm" import * as Token;
from "../source.wm" import * as Source;
from "./util.wm" import * as Util;

record ReadResult = {
  tokens: List<Token.Token>,
  newPosition: Source.Position,
};

let wordKinds = [Char.classLetter, Char.classDigit];

let isKind = (reader: Util.Reader, pos, kinds) => {
  let cls = Char.classify(Char.codeAt(reader.source, pos.index));
  List.any(kinds, (candidate) => {candidate == cls})
};

let widthToNumber = match(width) => {
  Token.OneWide => {1},
  Token.TwoWide => {2}
};

let makeSpan = (reader: Util.Reader, pos, kind: Token.TokenKind, text): Source.Span => {
  let endPos = match(Token.fixedWidth(kind)) {
    Some(width) => {Util.advance(reader, pos, widthToNumber(width))},
    None => {
      match(kind) {
        Token.CommentStartToken => {Util.bumpPosition(Util.bumpPosition(pos, text), "-")},
        Token.LineComment => {
          let (_, endPos) = Util.readWhile(reader, pos, (ch, _) => {ch != "\n"});
          endPos
        },
        Token.LowerIdentifierToken => {
          let (_, endPos) = Util.readWhile(
            reader,
            pos,
            (_, current) => {isKind(reader, current, wordKinds)}
          );
          endPos
        },
        Token.UpperIdentifierToken => {
          let (_, endPos) = Util.readWhile(
            reader,
            pos,
            (_, current) => {isKind(reader, current, wordKinds)}
          );
          endPos
        },
        Token.IntegerToken => {
          let (_, endPos) = Util.readWhile(
            reader,
            pos,
            (_, current) => {isKind(reader, current, [Char.classDigit])}
          );
          endPos
        },
        Var(missing) => {Panic(`missing span reader for token kind ${missing}`)}
      }
    }
  };
  .{startPos = pos, endPos = endPos}
};

let makeToken = (reader: Util.Reader, kind: Token.TokenKind, pos, text) => {
  let span = makeSpan(reader, pos, kind, text);
  (
    Token.Token(kind, span, Token.NoMate, []),
    span.endPos
  )
};

let simpleToken = (reader: Util.Reader, kind, pos, text): ReadResult => {
  let (token, nextPos) = makeToken(reader, kind, pos, text);
  .{tokens = [token], newPosition = nextPos}
};

let readFromSymbol = (reader: Util.Reader, pos): ReadResult => {
  let text = match(Util.peekByOne(reader, pos.index)) {
    Some(value) => {value},
    None => {Panic("symbol reader reached end of source")}
  };
  match(text) {
    "-" => {
      match(Util.peekByOne(reader, pos.index + 1)) {
        Some("-") => {
          let (startToken, afterStart) = makeToken(reader, Token.CommentStartToken, pos, text);
          let (commentToken, endPos) = makeToken(reader, Token.LineComment, afterStart, text);
          .{tokens = [startToken, commentToken], newPosition = endPos}
        },
        Some(">") => {simpleToken(reader, Token.PunctuationToken(Token.ThinArrow), pos, text)},
        _ => {simpleToken(reader, Token.OperatorToken(Token.Subtract), pos, text)}
      }
    },
    "/" => {
      match(Util.peekByOne(reader, pos.index + 1)) {
        Some("/") => {
          let (startToken, afterStart) = makeToken(reader, Token.CommentStartToken, pos, text);
          let (commentToken, endPos) = makeToken(reader, Token.LineComment, afterStart, text);
          .{tokens = [startToken, commentToken], newPosition = endPos}
        },
        _ => {simpleToken(reader, Token.OperatorToken(Token.Divide), pos, text)}
      }
    },
    "<" => {simpleToken(reader, Token.PunctuationToken(Token.LessThan), pos, text)},
    ">" => {simpleToken(reader, Token.PunctuationToken(Token.GreaterThan), pos, text)},
    "," => {simpleToken(reader, Token.PunctuationToken(Token.Comma), pos, text)},
    "=" => {
      match(Util.peekByOne(reader, pos.index + 1)) {
        Some(">") => {simpleToken(reader, Token.PunctuationToken(Token.FatArrow), pos, text)},
        Some("=") => {simpleToken(reader, Token.OperatorToken(Token.Equal), pos, text)},
        _ => {simpleToken(reader, Token.PunctuationToken(Token.Equals), pos, text)}
      }
    },
    "|" => {
      match(Util.peekByOne(reader, pos.index + 1)) {
        Some("|") => {simpleToken(reader, Token.OperatorToken(Token.BooleanOr), pos, text)},
        _ => {simpleToken(reader, Token.PunctuationToken(Token.Pipe), pos, text)}
      }
    },
    ":" => {
      match(Util.peekByOne(reader, pos.index + 1)) {
        Some(">") => {simpleToken(reader, Token.PunctuationToken(Token.PipeForward), pos, text)},
        _ => {simpleToken(reader, Token.PunctuationToken(Token.Colon), pos, text)}
      }
    },
    ";" => {simpleToken(reader, Token.PunctuationToken(Token.Semicolon), pos, text)},
    "{" => {simpleToken(reader, Token.PunctuationToken(Token.LeftBrace), pos, text)},
    "}" => {simpleToken(reader, Token.PunctuationToken(Token.RightBrace), pos, text)},
    "(" => {simpleToken(reader, Token.PunctuationToken(Token.LeftParen), pos, text)},
    ")" => {simpleToken(reader, Token.PunctuationToken(Token.RightParen), pos, text)},
    "." => {
      match(Util.peekByOne(reader, pos.index + 1)) {
        Some("{") => {simpleToken(reader, Token.PunctuationToken(Token.DotLeftBrace), pos, text)},
        Some(".") => {simpleToken(reader, Token.PunctuationToken(Token.DoubleDot), pos, text)},
        _ => {simpleToken(reader, Token.PunctuationToken(Token.Dot), pos, text)}
      }
    },
    "[" => {simpleToken(reader, Token.PunctuationToken(Token.LeftBracket), pos, text)},
    "]" => {simpleToken(reader, Token.PunctuationToken(Token.RightBracket), pos, text)},
    "*" => {simpleToken(reader, Token.OperatorToken(Token.Multiply), pos, text)},
    "+" => {simpleToken(reader, Token.OperatorToken(Token.Add), pos, text)},
    "@" => {simpleToken(reader, Token.PunctuationToken(Token.AtSign), pos, text)},
    "!" => {
      match(Util.peekByOne(reader, pos.index + 1)) {
        Some("=") => {simpleToken(reader, Token.OperatorToken(Token.NotEqual), pos, text)},
        _ => {simpleToken(reader, Token.OperatorToken(Token.BooleanNot), pos, text)}
      }
    },
    "%" => {simpleToken(reader, Token.OperatorToken(Token.Remainder), pos, text)},
    "&" => {
      match(Util.peekByOne(reader, pos.index + 1)) {
        Some("&") => {simpleToken(reader, Token.OperatorToken(Token.BooleanAnd), pos, text)},
        _ => {?}
      }
    },
    "?" => {simpleToken(reader, Token.OperatorToken(Token.Hole), pos, text)},
    Var(unknown) => {
      print(`whats this "${unknown}"`);
      ?
    }
  }
};

let readFromLetter = (reader: Util.Reader, pos): ReadResult => {
  let (word, endPos) = Util.readWhile(
    reader,
    pos,
    (_, current) => {isKind(reader, current, wordKinds)}
  );
  let kind = if (Char.isUpperCode(Char.codeAt(word, 0))) {
    Token.UpperIdentifierToken
  } else {
    Token.LowerIdentifierToken
  };
  let (token, _) = makeToken(reader, kind, pos, word);
  .{tokens = [token], newPosition = endPos}
};

let readFromDigit = (reader: Util.Reader, pos): ReadResult => {
  let (number, endPos) = Util.readWhile(
    reader,
    pos,
    (_, current) => {isKind(reader, current, [Char.classDigit])}
  );
  let (token, _) = makeToken(reader, Token.IntegerToken, pos, number);
  .{tokens = [token], newPosition = endPos}
};

let readFromStringLit = (reader: Util.Reader, pos): ReadResult => {
  let quote = match(Util.peekByOne(reader, pos.index)) {
    Some(value) => {value},
    None => {?}
  };
  let afterQuote = Util.bumpPosition(pos, quote);
  let rec readBody = (current, escaping, text) => {
    match(Util.peekByOne(reader, current.index)) {
      Some(ch) => {
        if (escaping) {
          readBody(Util.bumpPosition(current, ch), false, text ++ ch)
        } else {
          if (ch == "\\") {
            readBody(Util.bumpPosition(current, ch), true, text ++ ch)
          } else {
            if (ch == quote) {
              (text ++ ch, Util.bumpPosition(current, ch))
            } else {
              readBody(Util.bumpPosition(current, ch), false, text ++ ch)
            }
          }
        }
      },
      None => {(text, current)}
    }
  };
  let (_, endPos) = readBody(afterQuote, false, quote);
  let span: Source.Span = .{startPos = pos, endPos = endPos};
  let token = Token.Token(Token.QuotedStringToken, span, Token.NoMate, []);
  .{tokens = [token], newPosition = endPos}
};
