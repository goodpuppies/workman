from "../character.wm" import * as Char;
from "../source.wm" import * as Source;

// Immutable source context shared by lexer dispatch and individual lexeme readers.
record Reader = {
  source: String,
  length: Number,
};

let peekByOne = (reader, index) => {
  if (index < 0 || index >= reader.length) {
    None
  } else {
    Some(
      reader.source :> .slice(index, index + 1)
      :> Result.debug
    )
  }
};

let printPos = (reader, pos) => {
  let debugChar = (ch) => {
    let code = Char.codeAt(ch, 0);
    if (code == 10) {
      "\\n"
    } else {
      if (code == 13) {
        "\\r"
      } else {
        if (code == 9) {
          "\\t"
        } else {
          ch
        }
      }
    }
  };

  let rec debugPreview = (index, remaining) => {
    if (remaining <= 0 || index >= reader.length) {
      ""
    } else {
      match(peekByOne(reader, index)) {
        Some(ch) => {debugChar(ch) ++ debugPreview(index + 1, remaining - 1)},
        None => {Panic("unreachable")} // The bounds check above guarantees a source unit.
      }
    }
  };
  let preview = debugPreview(pos.index, 32);
  match(peekByOne(reader, pos.index)) {
    Some(ch) => {
      let code = Char.codeAt(reader.source, pos.index);
      let class = Char.classify(code);
      print(
        `[source] offset=${pos.index}/${reader.length} line=${pos.line} col=${pos.col} ` ++
        `class=${class} code=${code} char="${debugChar(ch)}" next="${preview}"`
      )
    },
    None => {
      print(
        `[source] offset=${pos.index}/${reader.length} line=${pos.line} col=${pos.col} <eof>`
      )
    }
  }
};


let create = (source) => {
  let length = source :> .length :> Result.debug;
  Reader(source, length)
};


// Positions use UTF-16 offsets and zero-based lines/columns, matching editor buffers.
let bumpPosition = (reader, pos, ch) => {
  let code = Char.codeAt(ch, 0);
  let crlf = code == 10 && pos.index > 0 && Char.codeAt(reader.source, pos.index - 1) == 13;
  let newline = code == 13 || code == 10;
  Source.Position(
    pos.index + 1,
    if (newline && !crlf) {pos.line + 1} else {pos.line},
    if (newline) {0} else {pos.col + 1}
  )
};

let rec advance = (reader, pos, amount) => {
  match(peekByOne(reader, pos.index)) {
    Some(ch) => {
      if (amount > 0) {
        advance(reader, bumpPosition(reader, pos, ch), amount - 1)
      } else {pos}
    },
    None => {pos}
  }
};

let rec readEnd = (reader, pos, keepGoing) => {
  match(peekByOne(reader, pos.index)) {
    Some(ch) => {
      if (keepGoing(ch, pos)) {
        readEnd(reader, bumpPosition(reader, pos, ch), keepGoing)
      } else {pos}
    },
    None => {pos}
  }
};

let textBetween = (reader, start, end) => {
  reader.source :> .slice(start.index, end.index) :> Result.debug
};
