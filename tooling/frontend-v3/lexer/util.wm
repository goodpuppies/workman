from "../character.wm" import * as Char;
from "../source.wm" import * as Source;

-- Immutable source context shared by lexer dispatch and individual lexeme readers.
record Reader = {
  source: String,
  length: Number,
};

let peekByOne = (reader: Reader, index) => {
  if (index < 0 || index >= reader.length) {
    None
  } else {
    Some(
      reader.source :> .slice(index, index + 1)
      :> match {
        Ok(value) => {value},
        Err(_) => {Panic("could not slice lexer source")}
      }
    )
  }
};

let debugChar = (ch) => {
  let code = Char.codeAt(ch, 0);
  if (code == 10) {
    "\\n"
  } else {
    if (code == 13) {
      "\\r"
    } else {
      if (code == 9) {
        "\\t"
      } else {
        ch
      }
    }
  }
};

let printPos = (reader: Reader, pos) => {
  let rec debugPreview = (index, remaining) => {
    if (remaining <= 0 || index >= reader.length) {
      ""
    } else {
      match(peekByOne(reader, index)) {
        Some(ch) => {debugChar(ch) ++ debugPreview(index + 1, remaining - 1)},
        None => {""}
      }
    }
  };
  let preview = debugPreview(pos.index, 32);
  match(peekByOne(reader, pos.index)) {
    Some(ch) => {
      let code = Char.codeAt(reader.source, pos.index);
      let class = Char.classify(code);
      print(
        `[source] offset=${pos.index}/${reader.length} line=${pos.line} col=${pos.col} ` ++
        `class=${class} code=${code} char="${debugChar(ch)}" next="${preview}"`
      )
    },
    None => {
      print(
        `[source] offset=${pos.index}/${reader.length} line=${pos.line} col=${pos.col} <eof>`
      )
    }
  }
};


let create = (source) => {
  let length = source :> .length :> match {
    Ok(value) => {value},
    Err(_) => {Panic("could not read source length")}
  };
  Reader(source, length)
};


let bumpPosition = (pos, ch) => {
  .{
    index = pos.index + 1,
    line = if (ch == "\n") {pos.line + 1} else {pos.line},
    col = if (ch == "\n") {1} else {pos.col + 1}
  }
};

let rec skipWhitespace = (reader: Reader, pos) => {
  if (pos.index < reader.length) {
    let code = Char.codeAt(reader.source, pos.index);
    if (code == 32 || code == 10 || code == 13 || code == 9) {
      let next: Source.Position = .{
        index = pos.index + 1,
        line = if (code == 10) {pos.line + 1} else {pos.line},
        col = if (code == 10) {1} else {pos.col + 1}
      };
      skipWhitespace(reader, next)
    } else {
      pos
    }
  } else {
    pos
  }
};

let rec advance = (reader: Reader, pos, amount) => {
  if (amount <= 0) {
    pos
  } else {
    let ch = match(peekByOne(reader, pos.index)) {
      Some(value) => {value},
      None => {""}
    };
    advance(reader, bumpPosition(pos, ch), amount - 1)
  }
};

let rec readWhile = (reader: Reader, pos, keepGoing) => {
  match(peekByOne(reader, pos.index)) {
    Some(ch) => {
      if (keepGoing(ch, pos)) {
        let (rest, endPos) = readWhile(reader, bumpPosition(pos, ch), keepGoing);
        (ch ++ rest, endPos)
      } else {
        printPos(reader, pos);
        ?;
        ("", pos)
      }
    },
    None => {("", pos)}
  }
};
