from "../../../../SubsetML/src/subset_result.wm" import * as R;
from "./model.wm" import * as M;
from "./plan.wm" import * as Plan;
from "./host.wm" import * as H;

let serve = (definition: M.Definition) => {
  let result = R.andThen(H.arguments(), (args) => {
    match(args) {
      ["describe"] => { H.writeStdout(Plan.line(["package", definition.name, definition.description])) },
      ["make", version, upstreamRef] => { H.writeStdout(Plan.encode(definition.name, definition.make(version, upstreamRef))) },
      _ => { R.Err("usage: package describe | make VERSION REF") }
    }
  });
  match(result) {
    R.Ok(_) => { H.exit(true) },
    R.Err(message) => { let _ = H.writeStderr(message ++ "\n"); H.exit(false) }
  }
};

