from "basis/result.wm" import * as R;
from "basis/won.wm" import * as Won;
from "basis/won_value.wm" import * as W;
from "./model.wm" import * as M;
from "./io.wm" import * as I;

// The package <-> manager protocol: one WON document per command. Encoders run in
// the package process and decoders in the manager; `protocol` detects a stale package.
let protocol = "1";

let text = (value) => { W.Text(value) };
let tag = (name, fields) => { W.Tag(name, [], W.Record(fields)) };
let wrapped = (name, value) => { W.Tag(name, [], text(value)) };
let bare = (name) => { W.Tag(name, [], W.Null) };
let document = (name, fields) => { W.Tag(name, [("protocol", W.Number(protocol))], W.Record(fields)) };
let write = (value) => { Won.encode(value) };

let modeValue = match { M.Exec => { bare("Exec") }, M.Data => { bare("Data") } };
let argumentValue = match {
  M.Literal(value) => { wrapped("Literal", value) }, M.Input(path) => { wrapped("Input", path) },
  M.Work(path) => { wrapped("Work", path) }, M.Out(path) => { wrapped("Out", path) }
};
let operationValue = match {
  M.Build(program, args) => { tag("Build", [("program", text(program)), ("args", W.List(I.map(args, argumentValue)))]) },
  M.Install(source, dest, mode) => { tag("Install", [("source", text(source)), ("dest", text(dest)), ("mode", modeValue(mode))]) },
  M.InstallTree(source, dest, mode) => { tag("InstallTree", [("source", text(source)), ("dest", text(dest)), ("mode", modeValue(mode))]) },
  M.Launcher(image, dest) => { tag("Launcher", [("image", text(image)), ("dest", text(dest))]) }
};
let sourceValue = (source: M.Source) => { W.Record([("file", text(source.file)), ("path", text(source.path))]) };

let describe = (name, description) => {
  write(document("Package", [("name", text(name)), ("description", text(description))]))
};
let encode = (name, pkg: M.Package) => {
  write(document("Plan", [
    ("name", text(name)), ("version", text(pkg.version)),
    ("sources", W.List(I.map(pkg.sources, sourceValue))),
    ("install", W.List(I.map(pkg.install, operationValue)))
  ]))
};

// Decoders read through Won's access chains and report a path on the first problem.
let field = (found, key) => { Won.text(Won.get(found, key)) };
let payloadField = (found, key) => { Won.text(Won.get(Won.payload(found), key)) };
let unexpected = (found, kind) => { R.andThen(found, (node) => { Won.mismatch(node, kind) }) };
let list = (found, f) => { R.andThen(Won.items(found), (nodes) => { I.traverse(nodes, (node) => { f(R.Ok(node)) }) }) };

// A document's root tag, after checking its name and protocol.
let opened = (source, name) => {
  let found = Won.read(source);
  R.andThen(Won.tagName(found), (actual) => {
    R.andThen(Won.number(Won.attribute(found, "protocol")), (version) => {
      if (actual == name && version == protocol) { Won.payload(found) } else {
        unexpected(found, name ++ "<protocol = " ++ protocol ++ ">")
      }
    })
  })
};

let mode = (found) => {
  R.andThen(Won.tagName(found), (name) => {
    match(name) { "Exec" => { R.Ok(M.Exec) }, "Data" => { R.Ok(M.Data) }, _ => { unexpected(found, "Exec or Data") } }
  })
};
let argument = (found) => {
  R.andThen(Won.tagName(found), (name) => {
    R.andThen(Won.text(Won.payload(found)), (value) => {
      match(name) {
        "Literal" => { R.Ok(M.Literal(value)) }, "Input" => { R.Ok(M.Input(value)) },
        "Work" => { R.Ok(M.Work(value)) }, "Out" => { R.Ok(M.Out(value)) },
        _ => { unexpected(found, "Literal, Input, Work or Out") }
      }
    })
  })
};
let placement = (found, make) => {
  R.andThen(payloadField(found, "source"), (source) => {
    R.andThen(payloadField(found, "dest"), (dest) => {
      R.map(mode(Won.get(Won.payload(found), "mode")), (m) => { make(source, dest, m) })
    })
  })
};
let operation = (found) => {
  R.andThen(Won.tagName(found), (name) => {
    match(name) {
      "Build" => {
        R.andThen(payloadField(found, "program"), (program) => {
          R.map(list(Won.get(Won.payload(found), "args"), argument), (args) => { M.Build(program, args) })
        })
      },
      "Install" => { placement(found, (source, dest, m) => { M.Install(source, dest, m) }) },
      "InstallTree" => { placement(found, (source, dest, m) => { M.InstallTree(source, dest, m) }) },
      "Launcher" => {
        R.andThen(payloadField(found, "image"), (image) => {
          R.map(payloadField(found, "dest"), (dest) => { M.Launcher(image, dest) })
        })
      },
      _ => { unexpected(found, "Build, Install, InstallTree or Launcher") }
    }
  })
};
let source = (found) => {
  R.andThen(field(found, "file"), (file) => { R.map(field(found, "path"), (path) => { M.Source(file, path) }) })
};

let decode = (text) => {
  let body = opened(text, "Plan");
  R.mapErr(
    R.andThen(field(body, "name"), (name) => {
      R.andThen(field(body, "version"), (version) => {
        R.andThen(list(Won.get(body, "sources"), source), (sources) => {
          R.map(list(Won.get(body, "install"), operation), (install) => { M.Plan(name, version, sources, install) })
        })
      })
    }),
    Won.problemText
  )
};
