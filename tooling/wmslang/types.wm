record GpuSpanDto = {
  id: Real64,
  path: String,
  line: Real64,
  col: Real64,
  start: Real64,
  end: Real64,
};

record GpuTypeDto = {
  id: Real64,
  kind: String,
  name: String,
  representation: String,
  width: Real64,
  items: Js.Array<Real64>,
  params: Js.Array<Real64>,
  result: Real64,
};

record GpuBindingDto = {
  id: Real64,
  name: String,
  typeId: Real64,
  definitionExprId: Real64,
  spanId: Real64,
  scope: String,
};

record GpuParamDto = {
  bindingId: Real64,
  name: String,
  typeId: Real64,
};

record GpuExprDto = {
  id: Real64,
  kind: String,
  typeId: Real64,
  spanId: Real64,
  bindingId: Real64,
  name: String,
  operator: String,
  numberValue: Real64,
  boolValue: Bool,
  children: Js.Array<Real64>,
  capability: String,
};

record GpuRootDto = {
  regionId: Real64,
  functionId: Real64,
  bindingId: Real64,
};

record GpuFunctionDto = {
  id: Real64,
  regionId: Real64,
  bindingId: Real64,
  name: String,
  params: Js.Array<GpuParamDto>,
  resultTypeId: Real64,
  bodyExprId: Real64,
  spanId: Real64,
  capability: String,
};

record GpuElaborationInputDto = {
  schemaVersion: Real64,
  roots: Js.Array<GpuRootDto>,
  functions: Js.Array<GpuFunctionDto>,
  bindings: Js.Array<GpuBindingDto>,
  types: Js.Array<GpuTypeDto>,
  expressions: Js.Array<GpuExprDto>,
  spans: Js.Array<GpuSpanDto>,
};

record TypedGpuExprDto = {
  id: Real64,
  kind: String,
  typeId: Real64,
  spanId: Real64,
  bindingId: Real64,
  name: String,
  operator: String,
  numberValue: Real64,
  boolValue: Bool,
  children: Js.Array<Real64>,
  capability: String,
};

record TypedGpuFunctionDto = {
  id: Real64,
  regionId: Real64,
  bindingId: Real64,
  name: String,
  params: Js.Array<GpuParamDto>,
  resultTypeId: Real64,
  bodyExprId: Real64,
  spanId: Real64,
  capability: String,
};

record GpuCaptureDto = {
  regionId: Real64,
  bindingId: Real64,
  typeId: Real64,
  spanId: Real64,
  category: String,
};

record GpuRepresentationFactDto = {
  typeId: Real64,
  representation: String,
};

record GpuSpecializationDto = {
  id: Real64,
  functionId: Real64,
  bindingId: Real64,
  name: String,
  paramTypeIds: Js.Array<Real64>,
  resultTypeId: Real64,
  paramRepresentations: Js.Array<String>,
  resultRepresentation: String,
  typeFacts: Js.Array<GpuRepresentationFactDto>,
};

record GpuRootSpecializationDto = {
  regionId: Real64,
  specializationId: Real64,
};

record GpuSpecializedCallDto = {
  callerSpecializationId: Real64,
  expressionId: Real64,
  targetSpecializationId: Real64,
};

record GpuIrParamDto = {
  bindingId: Real64,
  name: String,
  typeId: Real64,
  representation: String,
};

record GpuIrExprDto = {
  id: Real64,
  specializationId: Real64,
  sourceExprId: Real64,
  kind: String,
  typeId: Real64,
  representation: String,
  spanId: Real64,
  bindingId: Real64,
  name: String,
  operator: String,
  numberValue: Real64,
  boolValue: Bool,
  children: Js.Array<Real64>,
  capability: String,
  valueKind: String,
  callTargetSpecializationId: Real64,
};

record GpuIrFunctionDto = {
  specializationId: Real64,
  functionId: Real64,
  bindingId: Real64,
  name: String,
  params: Js.Array<GpuIrParamDto>,
  resultTypeId: Real64,
  resultRepresentation: String,
  bodyExprId: Real64,
  spanId: Real64,
};

record GpuDiagnosticDto = {
  code: String,
  message: String,
  spanId: Real64,
};

record GpuCompilationOutputDto = {
  schemaVersion: Real64,
  functions: Js.Array<TypedGpuFunctionDto>,
  captures: Js.Array<GpuCaptureDto>,
  specializations: Js.Array<GpuSpecializationDto>,
  rootSpecializations: Js.Array<GpuRootSpecializationDto>,
  calls: Js.Array<GpuSpecializedCallDto>,
  irFunctions: Js.Array<GpuIrFunctionDto>,
  irExpressions: Js.Array<GpuIrExprDto>,
  types: Js.Array<GpuTypeDto>,
  expressions: Js.Array<TypedGpuExprDto>,
  diagnostics: Js.Array<GpuDiagnosticDto>,
};

-- Schema 2 is the deliberately small static-fragment vertical slice. The H0
-- records above remain available to the separate compileGpu entry point while
-- the slice is brought up atomically.

record GpuSliceSpanDto = {
  id: Real64,
  path: String,
  line: Real64,
  col: Real64,
  start: Real64,
  end: Real64,
};

record GpuSliceTypeDto = {
  id: Real64,
  kind: String,
  typeNameId: Real64,
  items: Js.Array<Real64>,
  params: Js.Array<Real64>,
  result: Real64,
};

record GpuSliceShaderTypeDto = {
  id: Real64,
  kind: String,
  typeNameId: Real64,
  items: Js.Array<Real64>,
  params: Js.Array<Real64>,
  result: Real64,
};

record GpuSliceTypeEvidenceDto = {
  typeId: Real64,
  semanticKind: String,
  shaderKind: String,
  reason: String,
};

record GpuSliceAdtDto = {
  typeNameId: Real64,
  name: String,
  constructorIds: Js.Array<Real64>,
  spanId: Real64,
};

record GpuSliceConstructorDto = {
  id: Real64,
  typeNameId: Real64,
  name: String,
  tag: Real64,
  payloadTypeId: Real64,
  spanId: Real64,
};

record GpuSlicePatternDto = {
  id: Real64,
  context: String,
  kind: String,
  typeId: Real64,
  ownerFunctionId: Real64,
  bindingId: Real64,
  constructorId: Real64,
  children: Js.Array<Real64>,
  spanId: Real64,
};

record GpuSliceParamDto = {
  id: Real64,
  patternId: Real64,
  typeId: Real64,
  declaredIndex: Real64,
  spanId: Real64,
};

record GpuSliceLetDto = {
  id: Real64,
  patternId: Real64,
  valueExprId: Real64,
  declaredIndex: Real64,
  spanId: Real64,
};

record GpuSliceMatchArmDto = {
  id: Real64,
  patternId: Real64,
  bodyExprId: Real64,
  declaredIndex: Real64,
  spanId: Real64,
};

record GpuSliceBlockItemDto = {
  id: Real64,
  blockExprId: Real64,
  declaredIndex: Real64,
  kind: String,
  expressionId: Real64,
  letId: Real64,
  spanId: Real64,
};

record GpuSliceBlockDto = {
  expressionId: Real64,
  itemIds: Js.Array<Real64>,
  resultExprId: Real64,
};

record GpuSliceMatchDto = {
  expressionId: Real64,
  valueExprId: Real64,
  armIds: Js.Array<Real64>,
};

record GpuSliceExprDto = {
  id: Real64,
  kind: String,
  typeId: Real64,
  spanId: Real64,
  ownerFunctionId: Real64,
  bindingId: Real64,
  functionId: Real64,
  constructorId: Real64,
  semanticId: String,
  operatorId: String,
  builtinName: String,
  resourceOperation: String,
  numberValue: Real64,
  numberKind: String,
  boolValue: Bool,
  index: Real64,
  children: Js.Array<Real64>,
};

record GpuSliceBuiltinCatalogIdentityDto = {
  schemaVersion: Real64,
  slangVersion: String,
  sourceSha256: String,
};

record GpuSliceBuiltinOverloadDto = {
  id: Real64,
  name: String,
  params: Js.Array<String>,
  result: String,
  sourceSignature: String,
};

record GpuSliceBuiltinCatalogDto = {
  identity: GpuSliceBuiltinCatalogIdentityDto,
  overloads: Js.Array<GpuSliceBuiltinOverloadDto>,
};

record GpuSliceFunctionDto = {
  id: Real64,
  bindingId: Real64,
  sourceBindingId: Real64,
  name: String,
  typeId: Real64,
  paramIds: Js.Array<Real64>,
  resultTypeId: Real64,
  bodyExprId: Real64,
  recursionGroupId: Real64,
  spanId: Real64,
};

record GpuSliceOccurrenceTypeDto = {
  kind: String,
  sourceId: Real64,
  typeId: Real64,
  shaderTypeId: Real64,
  spanId: Real64,
  representationEvidence: String,
  representation: String,
};

record GpuSliceBuiltinSelectionDto = {
  expressionId: Real64,
  overloadId: Real64,
};

record GpuSliceTypeElaborationOutputDto = {
  schemaVersion: Real64,
  shaderTypes: Js.Array<GpuSliceTypeDto>,
  typeEvidence: Js.Array<GpuSliceTypeEvidenceDto>,
  occurrences: Js.Array<GpuSliceOccurrenceTypeDto>,
  builtinSelections: Js.Array<GpuSliceBuiltinSelectionDto>,
};

record GpuSliceRootDto = {
  functionId: Real64,
  selectorSpanId: Real64,
  environmentId: Real64,
};

record GpuSliceEnvironmentFieldDto = {
  id: Real64,
  environmentId: Real64,
  name: String,
  declaredIndex: Real64,
  kind: String,
  binding: Real64,
  typeId: Real64,
  spanId: Real64,
};

record GpuSliceEnvironmentDto = {
  id: Real64,
  recordId: Real64,
  typeNameId: Real64,
  name: String,
  bindingId: Real64,
  fieldIds: Js.Array<Real64>,
  spanId: Real64,
};

record GpuSliceRecursionGroupDto = {
  id: Real64,
  memberFunctionIds: Js.Array<Real64>,
  spanId: Real64,
};

record GpuSliceRecursiveReferenceDto = {
  expressionId: Real64,
  groupId: Real64,
  targetFunctionId: Real64,
  relation: String,
  invocation: String,
  spanId: Real64,
};

record GpuSliceElaborationInputDto = {
  schemaVersion: Real64,
  sourcePath: String,
  builtinCatalog: GpuSliceBuiltinCatalogDto,
  root: GpuSliceRootDto,
  environments: Js.Array<GpuSliceEnvironmentDto>,
  environmentFields: Js.Array<GpuSliceEnvironmentFieldDto>,
  functions: Js.Array<GpuSliceFunctionDto>,
  types: Js.Array<GpuSliceTypeDto>,
  adts: Js.Array<GpuSliceAdtDto>,
  constructors: Js.Array<GpuSliceConstructorDto>,
  patterns: Js.Array<GpuSlicePatternDto>,
  params: Js.Array<GpuSliceParamDto>,
  lets: Js.Array<GpuSliceLetDto>,
  matchArms: Js.Array<GpuSliceMatchArmDto>,
  blockItems: Js.Array<GpuSliceBlockItemDto>,
  blocks: Js.Array<GpuSliceBlockDto>,
  matches: Js.Array<GpuSliceMatchDto>,
  expressions: Js.Array<GpuSliceExprDto>,
  recursionGroups: Js.Array<GpuSliceRecursionGroupDto>,
  recursiveReferences: Js.Array<GpuSliceRecursiveReferenceDto>,
  spans: Js.Array<GpuSliceSpanDto>,
};

record GpuSliceDiagnosticRelatedDto = {
  spanId: Real64,
  label: String,
};

record GpuSliceDiagnosticDto = {
  code: String,
  message: String,
  spanId: Real64,
  related: Js.Array<GpuSliceDiagnosticRelatedDto>,
};

record GpuSliceIrExprDto = {
  id: Real64,
  functionId: Real64,
  sourceExprId: Real64,
  kind: String,
  typeId: Real64,
  spanId: Real64,
  bindingId: Real64,
  patternId: Real64,
  targetFunctionId: Real64,
  constructorId: Real64,
  semanticId: String,
  operatorId: String,
  builtinName: String,
  builtinOverloadId: Real64,
  resourceOperation: String,
  numberValue: Real64,
  numberKind: String,
  boolValue: Bool,
  index: Real64,
  children: Js.Array<Real64>,
  armIds: Js.Array<Real64>,
};

record GpuSliceIrMatchArmDto = {
  id: Real64,
  sourceArmId: Real64,
  patternId: Real64,
  bodyExprId: Real64,
  spanId: Real64,
};

record GpuSliceIrFunctionDto = {
  functionId: Real64,
  bindingId: Real64,
  name: String,
  paramIds: Js.Array<Real64>,
  resultTypeId: Real64,
  bodyExprId: Real64,
  recursionGroupId: Real64,
  spanId: Real64,
};

record GpuSliceAdtLayoutDto = {
  id: Real64,
  typeId: Real64,
  typeNameId: Real64,
  fieldIds: Js.Array<Real64>,
  spanId: Real64,
};

record GpuSliceAdtFieldDto = {
  id: Real64,
  layoutId: Real64,
  constructorId: Real64,
  tag: Real64,
  typeId: Real64,
  spanId: Real64,
};

record GpuSliceLoweringSeedDto = {
  adtLayouts: Js.Array<GpuSliceAdtLayoutDto>,
  adtFields: Js.Array<GpuSliceAdtFieldDto>,
};

record GpuSliceLoweredLocalDto = {
  id: Real64,
  functionId: Real64,
  kind: String,
  typeId: Real64,
  bindingId: Real64,
  mutable: Bool,
  spanId: Real64,
};

record GpuSliceLoweredAtomDto = {
  id: Real64,
  functionId: Real64,
  kind: String,
  typeId: Real64,
  sourceExprId: Real64,
  spanId: Real64,
  localId: Real64,
  numberValue: Real64,
  numberKind: String,
  boolValue: Bool,
};

record GpuSliceLoweredOperationDto = {
  id: Real64,
  functionId: Real64,
  kind: String,
  typeId: Real64,
  sourceExprId: Real64,
  spanId: Real64,
  targetFunctionId: Real64,
  constructorId: Real64,
  layoutId: Real64,
  fieldId: Real64,
  operatorId: String,
  semanticId: String,
  builtinName: String,
  builtinOverloadId: Real64,
  resourceOperation: String,
  index: Real64,
  args: Js.Array<Real64>,
};

record GpuSliceLoweredStatementDto = {
  id: Real64,
  functionId: Real64,
  kind: String,
  sourceExprId: Real64,
  spanId: Real64,
  localId: Real64,
  operationId: Real64,
  atomId: Real64,
  conditionAtomId: Real64,
  thenBlockId: Real64,
  elseBlockId: Real64,
  scrutineeAtomId: Real64,
  layoutId: Real64,
  caseIds: Js.Array<Real64>,
  bodyBlockId: Real64,
  targetLocalIds: Js.Array<Real64>,
  valueAtomIds: Js.Array<Real64>,
  reason: String,
};

record GpuSliceLoweredBlockDto = {
  id: Real64,
  functionId: Real64,
  statementIds: Js.Array<Real64>,
};

record GpuSliceLoweredCaseDto = {
  id: Real64,
  functionId: Real64,
  constructorId: Real64,
  tag: Real64,
  blockId: Real64,
  spanId: Real64,
};

record GpuSliceLoweredFunctionDto = {
  functionId: Real64,
  physicalParamLocalIds: Js.Array<Real64>,
  loopParamLocalIds: Js.Array<Real64>,
  bodyBlockId: Real64,
  recursive: Bool,
  spanId: Real64,
};

record GpuSliceLoweredProgramDto = {
  functions: Js.Array<GpuSliceLoweredFunctionDto>,
  locals: Js.Array<GpuSliceLoweredLocalDto>,
  atoms: Js.Array<GpuSliceLoweredAtomDto>,
  operations: Js.Array<GpuSliceLoweredOperationDto>,
  statements: Js.Array<GpuSliceLoweredStatementDto>,
  blocks: Js.Array<GpuSliceLoweredBlockDto>,
  cases: Js.Array<GpuSliceLoweredCaseDto>,
};

record GpuSliceCompilationOutputDto = {
  schemaVersion: Real64,
  program: GpuSliceElaborationInputDto,
  shaderTypes: Js.Array<GpuSliceTypeDto>,
  typeEvidence: Js.Array<GpuSliceTypeEvidenceDto>,
  occurrences: Js.Array<GpuSliceOccurrenceTypeDto>,
  builtinSelections: Js.Array<GpuSliceBuiltinSelectionDto>,
  irFunctions: Js.Array<GpuSliceIrFunctionDto>,
  irExpressions: Js.Array<GpuSliceIrExprDto>,
  irMatchArms: Js.Array<GpuSliceIrMatchArmDto>,
  adtLayouts: Js.Array<GpuSliceAdtLayoutDto>,
  adtFields: Js.Array<GpuSliceAdtFieldDto>,
  loweredFunctions: Js.Array<GpuSliceLoweredFunctionDto>,
  loweredLocals: Js.Array<GpuSliceLoweredLocalDto>,
  loweredAtoms: Js.Array<GpuSliceLoweredAtomDto>,
  loweredOperations: Js.Array<GpuSliceLoweredOperationDto>,
  loweredStatements: Js.Array<GpuSliceLoweredStatementDto>,
  loweredBlocks: Js.Array<GpuSliceLoweredBlockDto>,
  loweredCases: Js.Array<GpuSliceLoweredCaseDto>,
  slangModule: String,
  callableName: String,
  slangSource: String,
  diagnostics: Js.Array<GpuSliceDiagnosticDto>,
};
