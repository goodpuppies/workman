from "./types.wm" import {
  GpuSliceBlockDto,
  GpuSliceElaborationInputDto,
  GpuSliceEnvironmentFieldDto,
  GpuSliceExprDto,
  GpuSliceFunctionDto,
  GpuSliceLetDto,
  GpuSliceParamDto,
  GpuSlicePatternDto,
  GpuSliceRootDto,
  GpuSliceTypeDto
};

record NumericContext = {
  expressionOffset: Number,
  fieldOffset: Number,
  types: List<GpuSliceTypeDto>,
  expressions: List<GpuSliceExprDto>,
  patterns: List<GpuSlicePatternDto>,
  params: List<GpuSliceParamDto>,
  lets: List<GpuSliceLetDto>,
  blocks: List<GpuSliceBlockDto>,
  functions: List<GpuSliceFunctionDto>,
  environmentFields: List<GpuSliceEnvironmentFieldDto>,
  exprNodes: Map.Map<Number, Number>,
  patternNodes: Map.Map<Number, Number>,
  patternByBinding: Map.Map<Number, Number>,
  lanes: Map.Map<Number, List<Number>>,
};

record NumericEvidence = {
  representation: String,
  spanId: Number,
};

let numberEqual = (left: Number, right: Number) => {
  !(left < right) && !(left > right)
};

let rec listLength = match(items, length) => {
  ([], Var(length)) => { length },
  ([_, ..rest], Var(length)) => { listLength(rest, length + 1) }
};

let rec findType = match(items, id) => {
  ([], Var(id)) => { Panic("missing numeric semantic type") },
  ([Var(item), ..rest], Var(id)) => {
    let exact: GpuSliceTypeDto = item;
    if (numberEqual(exact.id, id)) { exact } else { findType(rest, id) }
  }
};

let rec allNumberTypes = match(typeIds, types) => {
  ([], Var(types)) => { true },
  ([Var(typeId), ..rest], Var(types)) => {
    let gpuType = findType(types, typeId);
    gpuType.kind == "number" && allNumberTypes(rest, types)
  }
};

let numericType = (typeId, context: NumericContext) => {
  let gpuType = findType(context.types, typeId);
  if (gpuType.kind == "number") {
    true
  } else {
    if (gpuType.kind == "tuple") {
      let items = Js.Array.toList(gpuType.items);
      let width = listLength(items, 0);
      width >= 2 && width <= 4 && allNumberTypes(items, context.types)
    } else {
      false
    }
  }
};

let computeExpressionNode = (expression: GpuSliceExprDto, context: NumericContext) => {
  if (numericType(expression.typeId, context)) { expression.id } else { -1 }
};

let expressionNode = (expression: GpuSliceExprDto, context: NumericContext) => {
  match(Map.get(context.exprNodes, expression.id)) {
    Some(node) => { node },
    None => { computeExpressionNode(expression, context) }
  }
};

let computePatternNode = (pattern: GpuSlicePatternDto, context: NumericContext) => {
  if (numericType(pattern.typeId, context)) {
    context.expressionOffset + pattern.id
  } else {
    -1
  }
};

let patternNode = (pattern: GpuSlicePatternDto, context: NumericContext) => {
  match(Map.get(context.patternNodes, pattern.id)) {
    Some(node) => { node },
    None => { computePatternNode(pattern, context) }
  }
};

let boundPatternNode = (context: NumericContext, bindingId, ownerFunctionId) => {
  match(Map.get(context.patternByBinding, bindingId * 1000000 + ownerFunctionId)) {
    Some(node) => { node },
    None => { -1 }
  }
};

let lookupLanes = (context: NumericContext, expressionId) => {
  match(Map.get(context.lanes, expressionId)) {
    Some(lanes) => { lanes },
    None => { [] }
  }
};

let fieldNode = (field: GpuSliceEnvironmentFieldDto, context: NumericContext) => {
  if (numericType(field.typeId, context)) { context.fieldOffset + field.id } else { -1 }
};

let evidence = (representations, node) => {
  if (node < 0) {
    None
  } else {
    Map.get(representations, node)
  }
};

let representation = (representations, node) => {
  match(evidence(representations, node)) {
    Some(value) => { value.representation },
    None => { "" }
  }
};

let numericConflict = (left: NumericEvidence, right: NumericEvidence) => {
  Panic(
    "WM_GPU_NUMERIC_CONFLICT|" ++ Text.of(left.spanId) ++ "|" ++
      Text.of(right.spanId) ++ "|" ++ left.representation ++ "|" ++
      right.representation
  )
};

let setEvidence = (representations, node, value: NumericEvidence) => {
  if (node < 0 || value.representation == "") {
    (representations, false)
  } else {
    match(evidence(representations, node)) {
      None => { (Map.set(representations, node, value), true) },
      Some(previous) => {
        if (previous.representation == value.representation) {
          (representations, false)
        } else {
          numericConflict(previous, value)
        }
      }
    }
  }
};

let setRepresentation = (representations, node, value, spanId) => {
  let item: NumericEvidence = .{ representation = value, spanId = spanId };
  setEvidence(representations, node, item)
};

let rec combinedEvidence = match(nodes, representations, combined) => {
  ([], Var(representations), Var(combined)) => { combined },
  ([Var(node), ..rest], Var(representations), Var(combined)) => {
    match(evidence(representations, node)) {
      None => { combinedEvidence(rest, representations, combined) },
      Some(value) => {
        match(combined) {
          None => { combinedEvidence(rest, representations, Some(value)) },
          Some(previous) => {
            if (previous.representation == value.representation) {
              combinedEvidence(rest, representations, combined)
            } else {
              numericConflict(previous, value)
            }
          }
        }
      }
    }
  }
};

let rec setGroup = match(nodes, value, representations, changed) => {
  ([], Var(value), Var(representations), Var(changed)) => { (representations, changed) },
  ([Var(node), ..rest], Var(value), Var(representations), Var(changed)) => {
    let (next, itemChanged) = match(value) {
      Some(item) => { setEvidence(representations, node, item) },
      None => { (representations, false) }
    };
    setGroup(rest, value, next, changed || itemChanged)
  }
};

let mergeGroup = (nodes, representations) => {
  let value = combinedEvidence(nodes, representations, None);
  setGroup(nodes, value, representations, false)
};

let rec findPatternByBinding = match(patterns, bindingId, ownerFunctionId) => {
  ([], Var(bindingId), Var(ownerFunctionId)) => { None },
  ([Var(pattern), ..rest], Var(bindingId), Var(ownerFunctionId)) => {
    let exact: GpuSlicePatternDto = pattern;
    if (
      numberEqual(exact.bindingId, bindingId) &&
      numberEqual(exact.ownerFunctionId, ownerFunctionId)
    ) {
      Some(exact)
    } else {
      findPatternByBinding(rest, bindingId, ownerFunctionId)
    }
  }
};

let rec findParam = match(params, id) => {
  ([], Var(id)) => { Panic("missing numeric function parameter") },
  ([Var(param), ..rest], Var(id)) => {
    let exact: GpuSliceParamDto = param;
    if (numberEqual(exact.id, id)) { exact } else { findParam(rest, id) }
  }
};

let rec findPattern = match(patterns, id) => {
  ([], Var(id)) => { Panic("missing numeric pattern") },
  ([Var(pattern), ..rest], Var(id)) => {
    let exact: GpuSlicePatternDto = pattern;
    if (numberEqual(exact.id, id)) { exact } else { findPattern(rest, id) }
  }
};

let rec findFunction = match(functions, id) => {
  ([], Var(id)) => { Panic("missing numeric function") },
  ([Var(fn), ..rest], Var(id)) => {
    let exact: GpuSliceFunctionDto = fn;
    if (numberEqual(exact.id, id)) { exact } else { findFunction(rest, id) }
  }
};

let rec findExpression = match(expressions, id) => {
  ([], Var(id)) => { Panic("missing numeric expression") },
  ([Var(expression), ..rest], Var(id)) => {
    let exact: GpuSliceExprDto = expression;
    if (numberEqual(exact.id, id)) { exact } else { findExpression(rest, id) }
  }
};

let rec findBlock = match(blocks, expressionId) => {
  ([], Var(expressionId)) => { Panic("missing numeric block") },
  ([Var(block), ..rest], Var(expressionId)) => {
    let exact: GpuSliceBlockDto = block;
    if (numberEqual(exact.expressionId, expressionId)) {
      exact
    } else {
      findBlock(rest, expressionId)
    }
  }
};

let rec findEnvironmentField = match(fields, declaredIndex) => {
  ([], Var(declaredIndex)) => { Panic("missing numeric environment field") },
  ([Var(field), ..rest], Var(declaredIndex)) => {
    let exact: GpuSliceEnvironmentFieldDto = field;
    if (numberEqual(exact.declaredIndex, declaredIndex)) {
      exact
    } else {
      findEnvironmentField(rest, declaredIndex)
    }
  }
};
let rec laneContains = match(ids, id) => {
  ([], Var(_id)) => { false },
  ([Var(head), ..rest], Var(id)) => {
    if (numberEqual(head, id)) { true } else { laneContains(rest, id) }
  }
};

let rec childLaneNodes = match(ids, exprNodes) => {
  ([], Var(_exprNodes)) => { [] },
  ([Var(id), ..rest], Var(exprNodes)) => {
    let node = match(Map.get(exprNodes, id)) { Some(n) => { n }, None => { -1 } };
    [node, ..childLaneNodes(rest, exprNodes)]
  }
};

let lookupMemoLanes = (memo, expressionId) => {
  match(Map.get(memo, expressionId)) { Some(lanes) => { lanes }, None => { [] } }
};

let rec patternLaneNodes = match(ids, context) => {
  ([], Var(_context)) => { [] },
  ([Var(id), ..rest], Var(context)) => {
    let exactContext: NumericContext = context;
    let child = findPattern(exactContext.patterns, id);
    [patternNode(child, exactContext), ..patternLaneNodes(rest, exactContext)]
  }
};

let rec mergeLanePairs = match(left, right, representations, changed) => {
  ([], [], Var(representations), Var(changed)) => { (representations, changed) },
  ([Var(a), ..restA], [Var(b), ..restB], Var(representations), Var(changed)) => {
    let (next, pairChanged) = mergeGroup([a, b], representations);
    mergeLanePairs(restA, restB, next, changed || pairChanged)
  },
  (_, _, Var(representations), Var(changed)) => { (representations, changed) }
};

let rec findLetForPattern = match(lets, patternId) => {
  ([], Var(_patternId)) => { None },
  ([Var(binding), ..rest], Var(patternId)) => {
    let exact: GpuSliceLetDto = binding;
    if (numberEqual(exact.patternId, patternId)) {
      Some(exact)
    } else {
      findLetForPattern(rest, patternId)
    }
  }
};

let rec laneForMemo = (
  expressionId,
  context: NumericContext,
  exprNodes,
  memo,
  visited,
  depth
) => {
  match(Map.get(memo, expressionId)) {
    Some(_lanes) => { memo },
    None => {
      if (numberEqual(depth, 0)) {
        Map.set(memo, expressionId, [])
      } else {
        if (laneContains(visited, expressionId)) {
          Map.set(memo, expressionId, [])
        } else {
          laneForUncached(expressionId, context, exprNodes, memo, [expressionId, ..visited], depth - 1)
        }
      }
    }
  }
}
and laneForUncached = (
  expressionId,
  context: NumericContext,
  exprNodes,
  memo,
  visited,
  depth
) => {
  let expression = findExpression(context.expressions, expressionId);
  if (expression.kind == "tuple") {
    Map.set(memo, expressionId, childLaneNodes(Js.Array.toList(expression.children), exprNodes))
  } else {
    if (expression.kind == "if") {
      match(Js.Array.toList(expression.children)) {
        [Var(_cond), Var(thenId), Var(elseId)] => {
          let afterThen = laneForMemo(thenId, context, exprNodes, memo, visited, depth);
          let afterElse = laneForMemo(elseId, context, exprNodes, afterThen, visited, depth);
          Map.set(afterElse, expressionId, lookupMemoLanes(afterElse, thenId))
        },
        _ => { Map.set(memo, expressionId, []) }
      }
    } else {
      if (expression.kind == "block") {
        let block = findBlock(context.blocks, expression.id);
        let afterResult = laneForMemo(block.resultExprId, context, exprNodes, memo, visited, depth);
        Map.set(afterResult, expressionId, lookupMemoLanes(afterResult, block.resultExprId))
      } else {
        if (expression.kind == "call") {
          let target = findFunction(context.functions, expression.functionId);
          let body = findExpression(context.expressions, target.bodyExprId);
          let afterBody = laneForMemo(body.id, context, exprNodes, memo, visited, depth);
          Map.set(afterBody, expressionId, lookupMemoLanes(afterBody, body.id))
        } else {
          if (expression.kind == "var") {
            match(
              findPatternByBinding(
                context.patterns,
                expression.bindingId,
                expression.ownerFunctionId
              )
            ) {
              Some(pattern) => {
                match(findLetForPattern(context.lets, pattern.id)) {
                  Some(binding) => {
                    let afterValue = laneForMemo(
                      binding.valueExprId,
                      context,
                      exprNodes,
                      memo,
                      visited,
                      depth
                    );
                    Map.set(afterValue, expressionId, lookupMemoLanes(afterValue, binding.valueExprId))
                  },
                  None => { Map.set(memo, expressionId, []) }
                }
              },
              None => { Map.set(memo, expressionId, []) }
            }
          } else {
            if (expression.kind == "copy") {
              match(Js.Array.toList(expression.children)) {
                [Var(childId)] => {
                  let afterChild = laneForMemo(childId, context, exprNodes, memo, visited, depth);
                  Map.set(afterChild, expressionId, lookupMemoLanes(afterChild, childId))
                },
                _ => { Map.set(memo, expressionId, []) }
              }
            } else {
              Map.set(memo, expressionId, [])
            }
          }
        }
      }
    }
  }
};

let rec foldExprNodes = match(items, context, nodes) => {
  ([], Var(_context), Var(nodes)) => { nodes },
  ([Var(expression), ..rest], Var(context), Var(nodes)) => {
    let exactExpression: GpuSliceExprDto = expression;
    let exactContext: NumericContext = context;
    foldExprNodes(
      rest,
      exactContext,
      Map.set(
        nodes,
        exactExpression.id,
        computeExpressionNode(exactExpression, exactContext)
      )
    )
  }
};

let rec foldPatternNodes = match(items, context, nodes) => {
  ([], Var(_context), Var(nodes)) => { nodes },
  ([Var(pattern), ..rest], Var(context), Var(nodes)) => {
    let exactPattern: GpuSlicePatternDto = pattern;
    let exactContext: NumericContext = context;
    foldPatternNodes(
      rest,
      exactContext,
      Map.set(nodes, exactPattern.id, computePatternNode(exactPattern, exactContext))
    )
  }
};

let rec foldPatternBindings = match(items, context, bound) => {
  ([], Var(_context), Var(bound)) => { bound },
  ([Var(pattern), ..rest], Var(context), Var(bound)) => {
    let exactPattern: GpuSlicePatternDto = pattern;
    let exactContext: NumericContext = context;
    if (exactPattern.bindingId < 0) {
      foldPatternBindings(rest, exactContext, bound)
    } else {
      let key = exactPattern.bindingId * 1000000 + exactPattern.ownerFunctionId;
      match(Map.get(bound, key)) {
        Some(_node) => { foldPatternBindings(rest, exactContext, bound) },
        None => {
          foldPatternBindings(
            rest,
            exactContext,
            Map.set(bound, key, computePatternNode(exactPattern, exactContext))
          )
        }
      }
    }
  }
};

let rec buildAllLanes = match(items, context, exprNodes, memo) => {
  ([], Var(_context), Var(_exprNodes), Var(memo)) => { memo },
  ([Var(expression), ..rest], Var(context), Var(exprNodes), Var(memo)) => {
    let exactExpression: GpuSliceExprDto = expression;
    let exactContext: NumericContext = context;
    buildAllLanes(
      rest,
      exactContext,
      exprNodes,
      laneForMemo(exactExpression.id, exactContext, exprNodes, memo, [], 256)
    )
  }
};

let buildNumericCaches = (context: NumericContext) => {
  let exprNodes = foldExprNodes(context.expressions, context, Map.empty(Map.numberCompare));
  let patternNodes = foldPatternNodes(context.patterns, context, Map.empty(Map.numberCompare));
  let patternByBinding = foldPatternBindings(
    context.patterns,
    context,
    Map.empty(Map.numberCompare)
  );
  let lanes = buildAllLanes(
    context.expressions,
    context,
    exprNodes,
    Map.empty(Map.numberCompare)
  );
  .{
    ..context,
    exprNodes = exprNodes,
    patternNodes = patternNodes,
    patternByBinding = patternByBinding,
    lanes = lanes,
  }
};

let rec numericChildNodes = match(children, context, nodes) => {
  ([], Var(context), Var(nodes)) => { nodes },
  ([Var(childId), ..rest], Var(context), Var(nodes)) => {
    let exactContext: NumericContext = context;
    let child = findExpression(exactContext.expressions, childId);
    let node = expressionNode(child, exactContext);
    numericChildNodes(
      rest,
      exactContext,
      if (node < 0) { nodes } else { [node, ..nodes] }
    )
  }
};

let ownAndChildren = (expression: GpuSliceExprDto, context: NumericContext) => {
  let own = expressionNode(expression, context);
  let children = numericChildNodes(Js.Array.toList(expression.children), context, []);
  if (own < 0) { children } else { [own, ..children] }
};

let rec mergeArguments = match(argumentIds, paramIds, context, representations, changed) => {
  ([], _, Var(context), Var(representations), Var(changed)) => { (representations, changed) },
  (_, [], Var(context), Var(representations), Var(changed)) => { (representations, changed) },
  (
    [Var(argumentId), ..argumentRest], [Var(paramId), ..paramRest], Var(context),
    Var(representations), Var(changed)
  ) => {
    let exactContext: NumericContext = context;
    let argument = findExpression(exactContext.expressions, argumentId);
    let param = findParam(exactContext.params, paramId);
    let pattern = findPattern(exactContext.patterns, param.patternId);
    let (next, pairChanged) = if (pattern.kind == "tuple") {
      let (withSingle, singleChanged) = mergeGroup(
        [expressionNode(argument, exactContext), patternNode(pattern, exactContext)],
        representations
      );
      let (merged, lanesChanged) = mergeLanePairs(
        patternLaneNodes(Js.Array.toList(pattern.children), exactContext),
        lookupLanes(exactContext, argument.id),
        withSingle,
        false
      );
      (merged, singleChanged || lanesChanged)
    } else {
      mergeGroup(
        [expressionNode(argument, exactContext), patternNode(pattern, exactContext)],
        representations
      )
    };
    mergeArguments(argumentRest, paramRest, exactContext, next, changed || pairChanged)
  }
};

let applyExpression = (expression: GpuSliceExprDto, context: NumericContext, representations) => {
  if (expression.kind == "var") {
    mergeGroup(
      [
        expressionNode(expression, context),
        boundPatternNode(context, expression.bindingId, expression.ownerFunctionId),
      ],
      representations
    )
  } else {
    if (expression.kind == "uniform") {
      let field = findEnvironmentField(context.environmentFields, expression.index);
      mergeGroup([expressionNode(expression, context), fieldNode(field, context)], representations)
    } else {
      if (expression.kind == "tuple") {
        if (numberEqual(expressionNode(expression, context), -1)) {
          (representations, false)
        } else {
          mergeGroup(ownAndChildren(expression, context), representations)
        }
      } else {
        if (
          expression.kind == "project" || expression.kind == "copy" ||
          expression.kind == "binary" ||
          expression.kind == "unary" || expression.kind == "builtin"
        ) {
          mergeGroup(ownAndChildren(expression, context), representations)
        } else {
          if (expression.kind == "if") {
            let (withOwn, ownChanged) = mergeGroup(
              ownAndChildren(expression, context),
              representations
            );
            let own = expressionNode(expression, context);
            if (numberEqual(own, -1)) {
              match(Js.Array.toList(expression.children)) {
                [Var(_cond), Var(thenId), Var(elseId)] => {
                  let (merged, pairChanged) = mergeLanePairs(
                    lookupLanes(context, thenId),
                    lookupLanes(context, elseId),
                    withOwn,
                    false
                  );
                  (merged, ownChanged || pairChanged)
                },
                _ => { (withOwn, ownChanged) }
              }
            } else {
              (withOwn, ownChanged)
            }
          } else {
            if (expression.kind == "block") {
              let block = findBlock(context.blocks, expression.id);
              let result = findExpression(context.expressions, block.resultExprId);
              mergeGroup(
                [expressionNode(expression, context), expressionNode(result, context)],
                representations
              )
            } else {
              if (expression.kind == "call") {
                let target = findFunction(context.functions, expression.functionId);
                let body = findExpression(context.expressions, target.bodyExprId);
                let (withResult, resultChanged) = mergeGroup(
                  [expressionNode(expression, context), expressionNode(body, context)],
                  representations
                );
                mergeArguments(
                  Js.Array.toList(expression.children),
                  Js.Array.toList(target.paramIds),
                  context,
                  withResult,
                  resultChanged
                )
              } else {
                (representations, false)
              }
            }
          }
        }
      }
    }
  }
};

let rec expressionSweep = match(expressions, context, representations, changed) => {
  ([], Var(context), Var(representations), Var(changed)) => { (representations, changed) },
  ([Var(expression), ..rest], Var(context), Var(representations), Var(changed)) => {
    let exactExpression: GpuSliceExprDto = expression;
    let exactContext: NumericContext = context;
    let (next, itemChanged) = applyExpression(
      exactExpression,
      exactContext,
      representations
    );
    expressionSweep(rest, exactContext, next, changed || itemChanged)
  }
};

let rec patternSweep = match(patterns, context, representations, changed) => {
  ([], Var(context), Var(representations), Var(changed)) => { (representations, changed) },
  ([Var(pattern), ..rest], Var(context), Var(representations), Var(changed)) => {
    let exactPattern: GpuSlicePatternDto = pattern;
    let exactContext: NumericContext = context;
    let childNodes = exactPattern.children :> Js.Array.toList :> mapPatternNodes(exactContext, []);
    let own = patternNode(exactPattern, exactContext);
    -- Vector patterns share one representation across lanes. Product
    -- patterns carry independent lane representations; merging children
    -- would equate unrelated scalars.
    let nodes = if (numberEqual(own, -1)) { [] } else { [own, ..childNodes] };
    let (next, itemChanged) = if (exactPattern.kind == "tuple") {
      mergeGroup(nodes, representations)
    } else {
      (representations, false)
    };
    patternSweep(rest, exactContext, next, changed || itemChanged)
  }
}
and mapPatternNodes = match(ids, context, nodes) => {
  ([], Var(context), Var(nodes)) => { nodes },
  ([Var(id), ..rest], Var(context), Var(nodes)) => {
    let exactContext: NumericContext = context;
    let pattern = findPattern(exactContext.patterns, id);
    let node = patternNode(pattern, exactContext);
    mapPatternNodes(rest, exactContext, if (node < 0) { nodes } else { [node, ..nodes] })
  }
};

let rec letSweep = match(lets, context, representations, changed) => {
  ([], Var(context), Var(representations), Var(changed)) => { (representations, changed) },
  ([Var(binding), ..rest], Var(context), Var(representations), Var(changed)) => {
    let exactBinding: GpuSliceLetDto = binding;
    let exactContext: NumericContext = context;
    let pattern = findPattern(exactContext.patterns, exactBinding.patternId);
    let value = findExpression(exactContext.expressions, exactBinding.valueExprId);
    let (next, itemChanged) = if (pattern.kind == "tuple") {
      let (withSingle, singleChanged) = mergeGroup(
        [patternNode(pattern, exactContext), expressionNode(value, exactContext)],
        representations
      );
      let (merged, lanesChanged) = mergeLanePairs(
        patternLaneNodes(Js.Array.toList(pattern.children), exactContext),
        lookupLanes(exactContext, value.id),
        withSingle,
        false
      );
      (merged, singleChanged || lanesChanged)
    } else {
      mergeGroup(
        [patternNode(pattern, exactContext), expressionNode(value, exactContext)],
        representations
      )
    };
    letSweep(rest, exactContext, next, changed || itemChanged)
  }
};

let rec seedExpressions = match(expressions, context, representations) => {
  ([], Var(context), Var(representations)) => { representations },
  ([Var(expression), ..rest], Var(context), Var(representations)) => {
    let exactExpression: GpuSliceExprDto = expression;
    let exactContext: NumericContext = context;
    let explicit = if (exactExpression.semanticId == "gpu.i32") {
      "i32"
    } else {
      if (exactExpression.semanticId == "gpu.f32") {
        "f32"
      } else {
        exactExpression.numberKind
      }
    };
    let (next, _changed) = setRepresentation(
      representations,
      expressionNode(exactExpression, exactContext),
      explicit,
      exactExpression.spanId
    );
    let withResourceResult = if (exactExpression.kind == "resource-call") {
      let (updated, _resourceChanged) = setRepresentation(
        next,
        expressionNode(exactExpression, exactContext),
        "f32",
        exactExpression.spanId
      );
      updated
    } else {
      next
    };
    let withResourceCoordinate = if (exactExpression.kind == "resource-call") {
      let coordinateId = match(Js.Array.toList(exactExpression.children)) {
        [_texture, _sampler, id] => { id },
        [_texture, id] => { id },
        _ => { Panic("GPU resource call has invalid coordinate arity") }
      };
      let coordinate = findExpression(exactContext.expressions, coordinateId);
      let coordinateRepresentation = if (exactExpression.resourceOperation == "load") {
        "i32"
      } else {
        "f32"
      };
      let (updated, _coordinateChanged) = setRepresentation(
        withResourceResult,
        expressionNode(coordinate, exactContext),
        coordinateRepresentation,
        coordinate.spanId
      );
      updated
    } else {
      withResourceResult
    };
    seedExpressions(rest, exactContext, withResourceCoordinate)
  }
};

let seedFragmentAbi = (input: GpuSliceElaborationInputDto, context: NumericContext, representations) => {
  let root = findFunction(context.functions, input.root.functionId);
  let firstParamId = match(Js.Array.toList(root.paramIds)) {
    [id, .._] => { id },
    [] => { Panic("fragment root has no coordinate parameter") }
  };
  let param = findParam(context.params, firstParamId);
  let pattern = findPattern(context.patterns, param.patternId);
  let body = findExpression(context.expressions, root.bodyExprId);
  let (withCoord, _coordChanged) = setRepresentation(
    representations,
    patternNode(pattern, context),
    "f32",
    pattern.spanId
  );
  let (withResult, _resultChanged) = setRepresentation(
    withCoord,
    expressionNode(body, context),
    "f32",
    body.spanId
  );
  withResult
};

let rec solveFixedPoint = (context: NumericContext, representations) => {
  let (afterExpressions, expressionChanged) = expressionSweep(
    context.expressions,
    context,
    representations,
    false
  );
  let (afterPatterns, patternChanged) = patternSweep(
    context.patterns,
    context,
    afterExpressions,
    false
  );
  let (afterLets, letChanged) = letSweep(
    context.lets,
    context,
    afterPatterns,
    false
  );
  if (expressionChanged || patternChanged || letChanged) {
    solveFixedPoint(context, afterLets)
  } else {
    afterLets
  }
};

let rec ensureExpressionsResolved = match(expressions, context, representations) => {
  ([], Var(context), Var(representations)) => { void },
  ([Var(expression), ..rest], Var(context), Var(representations)) => {
    let node = expressionNode(expression, context);
    if (node >= 0 && representation(representations, node) == "") {
      Panic(
        "WM_GPU_NUMERIC_UNRESOLVED|" ++ Text.of(expression.spanId) ++
          "|expression " ++ Text.of(expression.id)
      )
    } else {
      ensureExpressionsResolved(rest, context, representations)
    }
  }
};

let rec ensurePatternsResolved = match(patterns, context, representations) => {
  ([], Var(context), Var(representations)) => { void },
  ([Var(pattern), ..rest], Var(context), Var(representations)) => {
    let node = patternNode(pattern, context);
    if (node >= 0 && representation(representations, node) == "") {
      Panic(
        "WM_GPU_NUMERIC_UNRESOLVED|" ++ Text.of(pattern.spanId) ++
          "|pattern " ++ Text.of(pattern.id)
      )
    } else {
      ensurePatternsResolved(rest, context, representations)
    }
  }
};

let rec ensureFieldsResolved = match(fields, context, representations) => {
  ([], Var(context), Var(representations)) => { void },
  ([Var(field), ..rest], Var(context), Var(representations)) => {
    let node = fieldNode(field, context);
    if (node >= 0 && representation(representations, node) == "") {
      Panic(
        "WM_GPU_NUMERIC_UNRESOLVED|" ++ Text.of(field.spanId) ++
          "|environment field " ++ field.name
      )
    } else {
      ensureFieldsResolved(rest, context, representations)
    }
  }
};

let solveSliceNumericRepresentations = (input: GpuSliceElaborationInputDto) => {
  let expressions = Js.Array.toList(input.expressions);
  let patterns = Js.Array.toList(input.patterns);
  let expressionOffset = listLength(expressions, 0);
  let context: NumericContext = .{
    expressionOffset = expressionOffset,
    fieldOffset = expressionOffset + listLength(patterns, 0),
    types = Js.Array.toList(input.types),
    expressions = expressions,
    patterns = patterns,
    params = Js.Array.toList(input.params),
    lets = Js.Array.toList(input.lets),
    blocks = Js.Array.toList(input.blocks),
    functions = Js.Array.toList(input.functions),
    environmentFields = Js.Array.toList(input.environmentFields),
    exprNodes = Map.empty(Map.numberCompare),
    patternNodes = Map.empty(Map.numberCompare),
    patternByBinding = Map.empty(Map.numberCompare),
    lanes = Map.empty(Map.numberCompare),
  };
  let cached = buildNumericCaches(context);
  let seeded = seedExpressions(expressions, cached, Map.empty(Map.numberCompare));
  let solved = solveFixedPoint(cached, seedFragmentAbi(input, cached, seeded));
  ensureExpressionsResolved(expressions, cached, solved);
  ensurePatternsResolved(patterns, cached, solved);
  ensureFieldsResolved(cached.environmentFields, cached, solved);
  solved
};

let expressionRepresentation = (representations, expressionId) => {
  representation(representations, expressionId)
};

let patternRepresentation = (representations, expressionCount, patternId) => {
  representation(representations, expressionCount + patternId)
};
