let make = (version, _) => { Package(version, [], [Symlink(file(package("private-wm", "0.4.1"), ".local/bin/private-wm"), ".local/bin/private-twin")], []) };
let definition: Definition = .{
  name = "private-twin", description = "private dependency fixture", homepage = "", license = "MIT",
  target = Host, scope = User, versions, hosts = [], policy = defaultPolicy, make
};
let main = () => { serve(definition) };
