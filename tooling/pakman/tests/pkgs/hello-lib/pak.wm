-- Test fixture: a package other fixtures depend on.
from "pakman/model.wm" import *;
from "pakman/package.wm" import { serve };

let versions = () => { Task.succeed([Candidate("1.0", "2020-01-01T00:00:00Z", "stable", [], "")]) };

let make = (version, _) => {
  Package(version, [], [WriteText("usr/share/hello-lib/greeting", lit("hello from hello-lib\n"), Data)], [])
};

let definition: Definition = .{
  name = "hello-lib",
  description = "fixture: provides a file",
  homepage = "",
  license = "MIT",
  target = Host,
  scope = System,
  versions,
  hosts = [],
  policy = defaultPolicy,
  make
};

let main = () => { serve(definition) };
