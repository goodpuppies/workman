-- The WON a package prints for `make`, read back by pakman.

from "../../testman/test.wm" import *;
from "pakman/model.wm" import *;
from "pakman/plan.wm" import { encodePlan, decodePlan, decodeRef };
from "pakman/won.wm" import * as D;

let printed = (pkg: Package) => { Result.getOr(D.encode(encodePlan(pkg)), "") };

-- Prints a package's plan, then reads it back as pakman does.
let throughWon = (pkg: Package) => { decodePlan(printed(pkg)) };

let everyStep = Package(
  "1.0",
  [source("app.deb", "https://example.org/app.deb"), source("icon.png", "https://example.org/icon.png")],
  [
    Extract(Unpack(["app.deb", "data.tar.xz"], ["opt", "usr/bin"], "", 0)),
    extract("app.deb", "opt/app", 1),
    debPayload("app.deb"),
    ExtractPayload(["outer.zip", "app.deb"], ["payload.tar.xz", "payload.tar.zst"], "opt/app"),
    Install("icon.png", "usr/share/icons/hicolor/128x128/apps/app.png", Data),
    Symlink(Own("opt/app/app"), "usr/bin/app"),
    Symlink(Of("hello-lib", "usr/share/hello-lib/greeting"), "usr/share/app/greeting"),
    WriteText("opt/app/app.ini", lines(["[System]", "UserMode=1"]), Data),
    WriteText("usr/bin/app-run", cat([lit("#!/bin/sh\nexec "), ref(Own("opt/app/app")), lit(" \"$@\"\n")]), Exec),
    Build("compile", ["/usr/bin/cc"]),
    BuildCommand(CommandBuild(file(package("wm", "~0.4.1"), ".local/bin/wm"), ["compile", "app/main.wm", "--executable", "-o", "app"], "source.tar", 1, "app", ".local/bin/app", Exec)),
    MakeDir("var/lib/app")
  ],
  [Base("/usr/lib/libgtk-3.so.0"), Of("hello-lib", "usr/share/hello-lib/greeting")]
);

let tests = [
  test("package programs cannot forge manager-bound store references", () => {
    assertErr(decodeRef(D.read("StorePath{store = \"/unselected/tree\" path = \"bin/tool\"}")) :> Result.mapErr(D.message))
      :> Task.andThen((message) => { assertContains(message, "expected Own, Of, Instance or Base") })
  }),
  test("private dependency references survive the sandbox protocol", () => {
    let pkg = Package("1.0.0", [], [
      WriteText(".local/bin/app", cat([lit("exec "), shellRef(file(package("wm", "~0.4.1"), ".local/bin/wm"))]), Exec)
    ], [file(package("deno", "2.8.0"), ".local/bin/deno")]);
    assertOk(throughWon(pkg))
      :> Task.andThen((back) => { assertEqual(printed(back), printed(pkg)) })
  }),
  test("a plan survives printing and reading back", () => {
    assertOk(throughWon(everyStep))
      :> Task.andThen((back) => { assertEqual(printed(back), printed(everyStep)) })
  }),
  test("non-ASCII text survives printing and reading back", () => {
    let pkg = Package("1.0", [], [WriteText("usr/share/app/name", lit("Grüße — 日本 😀\n"), Data)], []);
    assertOk(throughWon(pkg))
      :> Task.andThen((back) => { checks([assertEqual(printed(back), printed(pkg)), assertContains(printed(back), "Grüße — 日本 😀")]) })
  }),
  test("sources and requirements come back unchanged", () => {
    assertOk(throughWon(everyStep))
      :> Task.andThen((back: Package) => {
        checks([
          assertEqual(back.version, "1.0"),
          assertEqual(back.sources, everyStep.sources),
          assertEqual(List.length(back.install), List.length(everyStep.install)),
          assertEqual(List.length(back.requires), 2)
        ])
      })
  }),
  test("an unknown install step is refused", () => {
    assertErr(decodePlan("Plan<protocol = 11>{version = \"1\" sources = [] requires = [] install = [Chmod(\"x\")]}"))
      :> Task.andThen((message) => { assertContains(message, "install[0]: expected an install step") })
  }),
  test("a plan from an older protocol is refused", () => {
    assertErr(decodePlan("Plan<protocol = 10>{version = \"1\" sources = [] requires = [] install = []}"))
      :> Task.andThen((message) => { assertContains(message, "expected Plan<protocol = 11>") })
  })
];
