-- Choosing a version: selectors, channels, the minimum-age gate, and holding
-- back packages whose upstream only offers its newest build.

from "../../testman/test.wm" import *;
from "pakman/model.wm" import { Candidate, Host, System, Package, source, Checksum };
from "../src/packages.wm" import { PackageInfo };
from "../src/lock.wm" import { LockEntry, LockedSource };
from "../src/resolve.wm" import { parseSelector, trackFor, choose, chooseWithForce, refreshSources, Default, Latest, Channel, Exact };

from "./support.wm" import { withTempDir };
from "../src/paths.wm" import { paths };
from "../src/io.wm" import { writeText, readText };

let info = (onlyLatest) => {
  let i: PackageInfo = .{
    name = "demo", description = "", homepage = "", license = "", target = Host, scope = System,
    channel = "stable", minAgeDays = 3, onlyLatest, hosts = [], program = ""
  };
  i
};

-- Published long ago, or far in the future (always younger than the gate).
let old = (version, channel) => { Candidate(version, "2020-01-01T00:00:00Z", channel, [], "") };
let young = (version, channel) => { Candidate(version, "2999-01-01T00:00:00Z", channel, [], "") };

let lockedAt = (version) => { Some(LockEntry("demo", version, "", "ref-" ++ version, [])) };

let candidates = [young("3.0", "stable"), old("2.0", "stable"), old("1.0", "stable"), old("9.0", "dev")];

-- assertEqual can't take a variant type yet (see markdown/issues/
-- equality-through-imported-generic-function-rejects-user-types.md), so
-- selectors are compared by description.
let describe = match(selector) => {
  Default => { "default" },
  Latest => { "latest" },
  Channel(name) => { "channel " ++ name },
  Exact(version) => { "exact " ++ version }
};

let selects = (text, expected) => { assertEqual(describe(parseSelector(text, candidates)), expected) };

let picked = (result) => { result :> Result.map((c: Candidate) => { c.version }) };

let tests = [
  test("a matching published checksum verifies a reused remote pin", () => {
    withTempDir((root) => {
      let pkg = Package("1.0", [source("app", "https://invalid.invalid/app")], [], []);
      let candidate = Candidate("1.0", "2020-01-01T00:00:00Z", "stable", [Checksum("https://invalid.invalid/app", "existing-pin")], "");
      refreshSources(paths(root), pkg, candidate, [LockedSource("app", "https://invalid.invalid/app", "existing-pin", false)])
        :> Task.andThen((sources) => {
          match(sources) {
            [locked] => { assert(locked.verified, "matching checksum was not recorded") },
            _ => { fail("unexpected source list") }
          }
        })
    })
  }),
  test("same-version resolution includes a new local input and preserves remote pins", () => {
    withTempDir((root) => {
      let p = .{ ..paths(root), tmp = root ++ "/tmp", sources = root ++ "/cache" };
      let pkg = Package("1.0", [source("app", "https://invalid.invalid/app"), source("patch", "file://" ++ root ++ "/patch")], [], []);
      let previous = [LockedSource("app", "https://invalid.invalid/app", "existing-pin", true), LockedSource("removed", "https://invalid.invalid/removed", "removed-pin", false)];
      writeText(root ++ "/patch", "new local input", 420)
        :> Monad.via Task (_) => { refreshSources(p, pkg, old("1.0", "stable"), previous) }
        :> Task.andThen((sources) => {
          match(sources) {
            [remote, local] => {
              checks([assertEqual(remote.sha256, "existing-pin"), assertEqual(local.file, "patch")])
                :> Task.andThen((_) => { readText(p.sources ++ "/" ++ local.sha256) })
                :> Task.andThen((text) => { assertEqual(text, "new local input") })
            },
            _ => { fail("resolution did not follow the current source list") }
          }
        })
    })
  }),
  test("resolving again refreshes an edited local input at the same URL", () => {
    withTempDir((root) => {
      let p = .{ ..paths(root), tmp = root ++ "/tmp", sources = root ++ "/cache" };
      let pkg = Package("1.0", [source("patch", "file://" ++ root ++ "/patch")], [], []);
      writeText(root ++ "/patch", "first", 420)
        :> Monad.via Task (_) => { refreshSources(p, pkg, old("1.0", "stable"), []) }
        :> Task.andThen((first) => {
          writeText(root ++ "/patch", "second", 420)
            :> Monad.via Task (_) => { refreshSources(p, pkg, old("1.0", "stable"), first) }
            :> Task.andThen((second) => {
              match(first, second) {
                ([before], [after]) => { assert(before.sha256 != after.sha256, "local bytes were not refreshed") },
                _ => { fail("unexpected source list") }
              }
            })
        })
    })
  }),
  test("an empty selector or 'default' means the default channel", () => {
    checks([selects("", "default"), selects("default", "default")])
  }),
  test("'latest' follows the age-gated default channel", () => {
    checks([
      selects("latest", "latest"),
      assertEqual(picked(choose(info(false), candidates, None, Latest)), Ok("2.0"))
    ])
  }),
  test("a selector naming a channel follows that channel", () => {
    selects("dev", "channel dev")
  }),
  test("any other selector is an exact version", () => {
    selects("1.0", "exact 1.0")
  }),
  test("the lock's track records the selector", () => {
    checks([
      assertEqual(trackFor(Default), ""),
      assertEqual(trackFor(Channel("dev")), "dev"),
      assertEqual(trackFor(Exact("1.0")), "")
    ])
  }),
  test("by default, the newest old-enough version in the default channel", () => {
    assertEqual(picked(choose(info(false), candidates, None, Default)), Ok("2.0"))
  }),
  test("by default, nothing when every version is too young", () => {
    assertErr(choose(info(false), [young("3.0", "stable")], None, Default))
      :> Task.andThen((message) => { assertContains(message, "minimum age of 3 days") })
  }),
  test("an exact young version fails with an age explanation and force hint", () => {
    assertErr(choose(info(false), candidates, None, Exact("3.0")))
      :> Task.andThen((message) => { checks([
        assertContains(message, "minimum age of 3 days"),
        assertContains(message, "install --force demo@3.0")
      ]) })
  }),
  test("an old exact version is allowed and force permits a young exact version", () => {
    checks([
      assertEqual(picked(choose(info(false), candidates, None, Exact("2.0"))), Ok("2.0")),
      assertEqual(picked(chooseWithForce(info(false), candidates, None, Exact("3.0"), true)), Ok("3.0"))
    ])
  }),
  test("an exact version upstream doesn't have is an error", () => {
    assertErr(choose(info(false), candidates, None, Exact("4.0")))
      :> Task.andThen((message) => { assertContains(message, "has no version 4.0") })
  }),
  test("a channel applies the same age gate as the default", () => {
    checks([
      assertEqual(picked(choose(info(false), candidates, None, Channel("dev"))), Ok("9.0")),
      assertEqual(picked(choose(info(false), candidates, None, Channel("stable"))), Ok("2.0"))
    ])
  }),
  test("only-latest upstream: a first install takes the newest, however young", () => {
    assertEqual(picked(choose(info(true), [young("3.0", "stable")], None, Default)), Ok("3.0"))
  }),
  test("only-latest upstream: an installed version is held until the newest is old enough", () => {
    let held = choose(info(true), [young("3.0", "stable")], lockedAt("2.0"), Default);
    checks([
      assertEqual(picked(held), Ok("2.0")),
      assertEqual(held :> Result.map((c: Candidate) => { c.ref }), Ok("ref-2.0"))
    ])
  }),
  test("only-latest upstream: once old enough, the newest replaces the installed one", () => {
    assertEqual(picked(choose(info(true), [old("3.0", "stable")], lockedAt("2.0"), Default)), Ok("3.0"))
  })
];
