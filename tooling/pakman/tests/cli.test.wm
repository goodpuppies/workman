-- End to end: `wm pakman` installing the test packages in tests/pkgs into
-- throwaway roots, and refusing the broken ones.

from "../../testman/test.wm" import *;
from "../src/io.wm" import { readText, exists, mkdirp, writeText, runCapture };
from "./support.wm" import { withTempDir, pakman, readLink, Run };

let succeeds = (run: Run) => {
  if (run.code == 0) { pass() } else { fail("wm pakman failed:\n" ++ run.output) }
};

-- Succeeds with the output of a command that should fail.
let refuses = (run: Run) => {
  if (run.code == 0) { fail("wm pakman should have failed:\n" ++ run.output) } else { Task.succeed(run.output) }
};

let install = (root, name) => { pakman(["install", "--root", root, name]) };

let tests = [
  test("--pin cannot use the onlyLatest first-install age exception", () => {
    withTempDir((root) => {
      pakman(["install", "--pin", "hello-only-latest@latest", "--root", root])
        :> Task.andThen(refuses)
        :> Task.andThen((output) => { assertContains(output, "install --force --pin hello-only-latest@2.0") })
        :> Task.andThen((_) => { exists(root ++ "/usr/share/hello-only-latest/version") })
        :> Task.andThen((placed) => { assert(!placed, "young pin was installed") })
    })
  }),
  test("a young exact version is refused, even with --pin, without changing the installed generation", () => {
    withTempDir((root) => {
      install(root, "hello-young@1.0")
        :> Task.andThen(succeeds)
        :> Task.andThen((_) => { install(root, "hello-young@2.0") })
        :> Task.andThen(refuses)
        :> Task.andThen((output) => { checks([
          assertContains(output, "minimum age of 3 days"),
          assertContains(output, "install --force hello-young@2.0")
        ]) })
        :> Task.andThen((_) => { pakman(["install", "--pin", "hello-young@2.0", "--root", root]) })
        :> Task.andThen(refuses)
        :> Task.andThen((output) => { assertContains(output, "minimum age of 3 days") })
        :> Task.andThen((_) => { readText(root ++ "/usr/share/hello-young/version") })
        :> Task.andThen((version) => { assertEqual(version, "1.0") })
    })
  }),
  test("an explicit version follows updates unless --pin is given", () => {
    withTempDir((root) => {
      pakman(["install", "--force", "hello-young@2.0", "--root", root])
        :> Task.andThen(succeeds)
        :> Task.andThen((_) => { pakman(["update", "--root", root]) })
        :> Task.andThen(succeeds)
        :> Task.andThen((_) => { readText(root ++ "/usr/share/hello-young/version") })
        :> Task.andThen((version) => { assertEqual(version, "1.0") })
    })
  }),
  test("--pin holds an explicit version on update; plain reinstall releases it and may downgrade", () => {
    withTempDir((root) => {
      pakman(["install", "--force", "--pin", "hello-young@2.0", "--root", root])
        :> Task.andThen((run) => { checks([succeeds(run), assertContains(run.output, "2.0 (pinned)")]) })
        :> Task.andThen((_) => { pakman(["update", "--root", root]) })
        :> Task.andThen(succeeds)
        :> Task.andThen((_) => { readText(root ++ "/usr/share/hello-young/version") })
        :> Task.andThen((version) => { assertEqual(version, "2.0") })
        :> Task.andThen((_) => { install(root, "hello-young") })
        :> Task.andThen(succeeds)
        :> Task.andThen((_) => { readText(root ++ "/usr/share/hello-young/version") })
        :> Task.andThen((version) => { assertEqual(version, "1.0") })
    })
  }),
  test("latest and stable both select old-enough releases; force is temporary for either", () => {
    withTempDir((root) => {
      install(root, "hello-young@latest")
        :> Task.andThen(succeeds)
        :> Task.andThen((_) => { readText(root ++ "/usr/share/hello-young/version") })
        :> Task.andThen((version) => { assertEqual(version, "1.0") })
        :> Task.andThen((_) => { pakman(["install", "--force", "hello-young@stable", "--root", root]) })
        :> Task.andThen(succeeds)
        :> Task.andThen((_) => { readText(root ++ "/usr/share/hello-young/version") })
        :> Task.andThen((version) => { assertEqual(version, "2.0") })
        :> Task.andThen((_) => { install(root, "hello-young@stable") })
        :> Task.andThen(succeeds)
        :> Task.andThen((_) => { readText(root ++ "/usr/share/hello-young/version") })
        :> Task.andThen((version) => { assertEqual(version, "1.0") })
    })
  }),
  test("--pin is rejected outside install", () => {
    pakman(["resolve", "--pin", "hello-young@2.0"])
      :> Task.andThen(refuses)
      :> Task.andThen((output) => { assertContains(output, "--pin is only supported by install") })
  }),
  test("force latest installs a young release and follows the default channel", () => {
    withTempDir((root) => {
      pakman(["install", "--force", "hello-young@latest", "--root", root])
        :> Task.andThen((run) => { checks([succeeds(run), assertContains(run.output, "2.0 (follows default)")]) })
        :> Task.andThen((_) => { readText(root ++ "/usr/share/hello-young/version") })
        :> Task.andThen((version) => { assertEqual(version, "2.0") })
    })
  }),
  test("force skips age filtering only for this install and preserves default tracking", () => {
    withTempDir((root) => {
      install(root, "hello-young")
        :> Task.andThen(succeeds)
        :> Task.andThen((_) => { readText(root ++ "/usr/share/hello-young/version") })
        :> Task.andThen((version) => { assertEqual(version, "1.0") })
        :> Task.andThen((_) => { pakman(["--force", "install", "hello-young", "--root", root]) })
        :> Task.andThen(succeeds)
        :> Task.andThen((_) => { readText(root ++ "/usr/share/hello-young/version") })
        :> Task.andThen((version) => { assertEqual(version, "2.0") })
        :> Task.andThen((_) => { pakman(["update", "--root", root]) })
        :> Task.andThen(succeeds)
        :> Task.andThen((_) => { readText(root ++ "/usr/share/hello-young/version") })
        :> Task.andThen((version) => { assertEqual(version, "1.0") })
    })
  }),
  test("force is rejected outside install", () => {
    pakman(["resolve", "--force", "hello-young"])
      :> Task.andThen(refuses)
      :> Task.andThen((output) => { assertContains(output, "--force is only supported by install") })
  }),
  test("force cannot bypass checksum verification", () => {
    withTempDir((root) => {
      pakman(["install", "--force", "hello-bad-checksum@latest", "--root", root])
        :> Task.andThen(refuses)
        :> Task.andThen((output) => { assertContains(output, "upstream publishes 0000") })
    })
  }),
  test("force cannot overwrite unowned files", () => {
    withTempDir((root) => {
      let theirs = root ++ "/usr/share/hello-young/version";
      Task|mkdirp(root ++ "/usr/share/hello-young"), writeText(theirs, "mine", 420)|
        :> Task.andThen((_) => { pakman(["install", "--force", "hello-young@latest", "--root", root]) })
        :> Task.andThen(refuses)
        :> Task.andThen((output) => { assertContains(output, "exists and pakman did not install it") })
        :> Task.andThen((_) => { readText(theirs) })
        :> Task.andThen((text) => { assertEqual(text, "mine") })
    })
  }),
  test("a failed callback cannot activate its partial output", () => {
    withTempDir((root) => {
      install(root, "hello-build-fail")
        :> Task.andThen(refuses)
        :> Task.andThen((output) => { assertContains(output, "intentional build failure") })
        :> Task.andThen((_) => { exists(root ++ "/usr/bin/partial") })
        :> Task.andThen((placed) => { assert(!placed, "partial build was installed") })
    })
  }),
  test("package code compiles, checks and stages a native program offline", () => {
    withTempDir((root) => {
      install(root, "hello-build")
        :> Task.andThen(succeeds)
        :> Task.andThen((_) => { runCapture(root ++ "/usr/bin/hello-build", []) })
        :> Task.andThen((text) => { assertEqual(text, "built by Workman\n") })
    })
  }),
  test("install places a package and the package it depends on", () => {
    withTempDir((root) => {
      install(root, "hello-app")
        :> Task.andThen(succeeds)
        :> Task.andThen((_) => {
          Task|readText(root ++ "/usr/bin/hello-app"), readLink(root ++ "/usr/share/hello-app/greeting"),
            readText(root ++ "/usr/share/hello-app/greeting")|
        })
        :> Task.andThen((script, link, greeting) => {
          checks([
            -- System packages refer to each other at their real paths, under /.
            assertEqual(script, "#!/bin/sh\ncat /usr/share/hello-lib/greeting\n"),
            assertEqual(link, "../hello-lib/greeting"),
            assertEqual(greeting, "hello from hello-lib\n")
          ])
        })
    })
  }),
  test("refuses a package that uses a file its dependency doesn't install", () => {
    withTempDir((root) => {
      install(root, "hello-broken")
        :> Task.andThen(refuses)
        :> Task.andThen((output) => { assertContains(output, "which hello-lib does not install") })
        :> Task.andThen((_) => { exists(root ++ "/usr/share/hello-broken") })
        :> Task.andThen((placed) => { assert(!placed, "hello-broken was installed anyway") })
    })
  }),
  test("an unknown package suggests the packages holding its letters in order", () => {
    withTempDir((root) => {
      install(root, "hlap")
        :> Task.andThen(refuses)
        :> Task.andThen((output) => { assertContains(output, "unknown package hlap, did you mean hello-app?") })
    })
  }),
  test("refuses a package that needs a host file that's missing", () => {
    withTempDir((root) => {
      install(root, "hello-needs-host")
        :> Task.andThen(refuses)
        :> Task.andThen((output) => { assertContains(output, "/nonexistent/libnope.so.1") })
    })
  }),
  test("refuses a download that doesn't match the checksum upstream publishes", () => {
    withTempDir((root) => {
      install(root, "hello-bad-checksum")
        :> Task.andThen(refuses)
        :> Task.andThen((output) => { assertContains(output, "upstream publishes 0000") })
    })
  }),
  test("refuses to overwrite a file it didn't install", () => {
    withTempDir((root) => {
      let theirs = root ++ "/usr/share/hello-lib/greeting";
      Task|mkdirp(root ++ "/usr/share/hello-lib"), writeText(theirs, "mine\n", 420)|
        :> Task.andThen((_) => { install(root, "hello-lib") })
        :> Task.andThen(refuses)
        :> Task.andThen((output) => { assertContains(output, "exists and pakman did not install it") })
        :> Task.andThen((_) => { readText(theirs) })
        :> Task.andThen((text) => { assertEqual(text, "mine\n") })
    })
  }),
  test("remove takes a package's files away", () => {
    withTempDir((root) => {
      install(root, "hello-lib")
        :> Task.andThen(succeeds)
        :> Task.andThen((_) => { pakman(["remove", "--root", root, "hello-lib"]) })
        :> Task.andThen(succeeds)
        :> Task.andThen((_) => { exists(root ++ "/usr/share/hello-lib") })
        :> Task.andThen((left) => { assert(!left, "usr/share/hello-lib is still there") })
    })
  }),
  test("rollback returns to the previous generation", () => {
    withTempDir((root) => {
      install(root, "hello-lib")
        :> Task.andThen(succeeds)
        :> Task.andThen((_) => { install(root, "hello-app") })
        :> Task.andThen(succeeds)
        :> Task.andThen((_) => { pakman(["rollback", "--root", root]) })
        :> Task.andThen(succeeds)
        :> Task.andThen((_) => { Task|exists(root ++ "/usr/bin/hello-app"), exists(root ++ "/usr/share/hello-lib/greeting")| })
        :> Task.andThen((app, lib) => {
          checks([assert(!app, "hello-app survived the rollback"), assert(lib, "hello-lib was rolled back too")])
        })
    })
  })
];
