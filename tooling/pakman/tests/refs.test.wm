-- References between packages: rendering them as paths, and symlink targets.

from "../../testman/test.wm" import *;
from "../src/model.wm" import { Own, Of, Base, Exec, Package, Symlink, WriteText, Data, lit, ref, cat, package, file, StorePath, shellRef, BuildCommand, CommandBuild };
from "../src/refs.wm" import { render, relativePath, symlinkTarget, dependencies, baseFiles, instances, mapRefs, storePaths, runtimePlan };

let tests = [
  test("command programs resolve as build dependencies, without entering the runtime closure", () => {
    let pkg = Package("1.0.0", [], [
      BuildCommand(CommandBuild(file(package("wm", "~0.4.1"), ".local/bin/wm"), ["compile", "app/main.wm", "--executable", "-o", "app"], "app.tar", 1, "app", ".local/bin/app", Exec))
    ], []);
    let bound = mapRefs(pkg, (_) => { StorePath("/store/wm", ".local/bin/wm") });
    checks([
      assertEqual(instances(pkg), [package("wm", "~0.4.1")]),
      assertEqual(storePaths(bound), ["/store/wm"]),
      assertEqual(storePaths(runtimePlan(bound)), [])
    ])
  }),
  test("shell arguments preserve spaces, quotes and metacharacters", () => {
    assertEqual(render("/home/a'b $x", shellRef(Own(".local/bin/wm"))), "'/home/a'\\''b $x/.local/bin/wm'")
  }),
  test("private dependencies are distinct from shared-root requirements", () => {
    let request = package("wm", "~0.4.1");
    let pkg = Package("1.0.0", [], [Symlink(file(request, ".local/bin/wm"), ".local/bin/app")], [file(request, "lib/api")]);
    checks([
      assertEqual(List.length(instances(pkg)), 1),
      assertEqual(dependencies(pkg), []),
      assertEqual(baseFiles(pkg), []),
      assertEqual(render("/home/u", ref(StorePath("/state/store/wm", ".local/bin/wm"))), "/state/store/wm/.local/bin/wm"),
      assertEqual(symlinkTarget(".local/bin/app", StorePath("/state/store/wm", ".local/bin/wm")), "/state/store/wm/.local/bin/wm")
    ])
  }),
  test("references render absolute under the scope's root", () => {
    checks([
      assertEqual(render("/", ref(Own("opt/zig/zig"))), "/opt/zig/zig"),
      assertEqual(render("/home/u", ref(Own(".local/bin/zig"))), "/home/u/.local/bin/zig"),
      assertEqual(render("/", ref(Base("/usr/lib/libfuse.so.2"))), "/usr/lib/libfuse.so.2")
    ])
  }),
  test("text mixes literals and references", () => {
    assertEqual(render("/home/u", cat([lit("Exec="), ref(Own(".local/bin/x")), lit(" %U")])), "Exec=/home/u/.local/bin/x %U")
  }),
  test("symlinks between a package's files are relative", () => {
    checks([
      assertEqual(relativePath("usr/bin/zig", "opt/zig/zig"), "../../opt/zig/zig"),
      assertEqual(relativePath(".local/bin/x", ".local/lib/x/x"), "../lib/x/x"),
      assertEqual(symlinkTarget("usr/bin/vesktop", Own("opt/Vesktop/vesktop")), "../../opt/Vesktop/vesktop")
    ])
  }),
  test("symlinks to host files stay absolute", () => {
    assertEqual(symlinkTarget("usr/lib/x.so", Base("/usr/lib/libx.so.1")), "/usr/lib/libx.so.1")
  }),
  test("dependencies and base files come from the references in a package", () => {
    let pkg = Package("1.0", [], [
      Symlink(Of("hello-lib", "usr/share/hello-lib/greeting"), "usr/share/app/greeting"),
      WriteText("usr/bin/app", cat([lit("run "), ref(Of("hello-lib", "usr/bin/x")), ref(Base("/usr/bin/sh"))]), Data)
    ], [Base("/usr/lib/libgtk-3.so.0")]);
    checks([
      assertEqual(dependencies(pkg), ["hello-lib"]),
      assertEqual(List.length(baseFiles(pkg)), 2)
    ])
  })
];
