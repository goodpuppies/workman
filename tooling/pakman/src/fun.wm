-- Small curried helpers for pipelines.

-- Option.filter as an Option.andThen stage: `opt :> Option.andThen(keepIf(predicate))`.
let keepIf = (predicate) => { (value) => { Option.filter(value, predicate) } };

-- A left fold where each step is a Task, run one after another.
let rec foldSeries = (items, acc, step) => {
  match(items) {
    [] => { Task.succeed(acc) },
    [item, ..rest] => { step(acc, item) :> Task.andThen((next) => { foldSeries(rest, next, step) }) }
  }
};

-- Drops a result, for `Task|...|` sequences run only for their effects.
let ignore = (_) => { void };

-- Removes repeats, keeping first occurrences in order.
let unique = (items) => {
  List.foldLeft(items, [], (seen, item) => {
    if (List.any(seen, (s) => { s == item })) { seen } else { List.revAppend(List.reverse(seen), [item]) }
  })
};

-- List operations that run in constant stack. std's List.map, filter, append
-- and concat recurse once per element outside tail position, which overflows
-- the JavaScript stack on real file lists (zig unpacks to ~20,000 files).
-- These are built from foldLeft and revAppend, which compile to loops.
let mapAll = (items, f) => { List.reverse(List.foldLeft(items, [], (acc, item) => { [f(item), ..acc] })) };

let filterAll = (items, keep) => {
  List.reverse(List.foldLeft(items, [], (acc, item) => { if (keep(item)) { [item, ..acc] } else { acc } }))
};

let appendAll = (left, right) => { List.revAppend(List.reverse(left), right) };

let concatAll = (lists) => {
  List.reverse(List.foldLeft(lists, [], (acc, items) => { List.revAppend(items, acc) }))
};
