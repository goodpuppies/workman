-- Deliberately small first subset: exact stable X.Y.Z and ~X.Y.Z.
from "basis/text.wm" import * as UnicodeText;
from "basis/int.wm" import * as Int;
from "basis/result.wm" import * as R;
from "pakman/model.wm" import { Candidate };

record Version = { major: I32, minor: I32, patch: I32 };

let component = (text: String) => {
  if (text != "0" && (UnicodeText.isPrefix(text, "0") :> R.getOr(false))) { None }
  else { R.toOption(Int.parseNatural(text)) }
};

let parse = (text: String) => {
  match(UnicodeText.fields(text, (scalar) => { scalar == (46: I32) })) {
    Ok([major, minor, patch]) => {
      match(component(major), component(minor), component(patch)) {
        (Some(a), Some(b), Some(c)) => { Some(Version(a, b, c)) },
        _ => { None }
      }
    },
    _ => { None }
  }
};

let matches = (selector, version) => {
  let patchRange = UnicodeText.isPrefix(selector, "~") :> Result.getOr(false);
  let base = if (patchRange) { UnicodeText.extract(selector, (1: I32), None) :> Result.getOr("") } else { selector };
  match(parse(base)) {
    None => { Err("unsupported dependency version " ++ selector ++ "; expected X.Y.Z or ~X.Y.Z") },
    Some(wanted) => {
      Ok(match(parse(version)) {
        None => { false },
        Some(actual) => {
          actual.major == wanted.major && actual.minor == wanted.minor
            && (if (patchRange) { actual.patch >= wanted.patch } else { actual.patch == wanted.patch })
        }
      })
    }
  }
};

-- Finder ordering is not necessarily numeric (2.8.10 must beat 2.8.9).
let newest = (candidates: List<Candidate>) => {
  List.foldLeft(candidates, None, (best: Option<Candidate>, candidate: Candidate) => {
    match(best) {
      None => { Some(candidate) },
      Some(previous) => {
        match(parse(candidate.version), parse(previous.version)) {
          (Some(a), Some(b)) => { if (a.patch > b.patch) { Some(candidate) } else { best } },
          _ => { best }
        }
      }
    }
  })
};
