-- Host operations with String errors that say what failed.

from js.module("./host.ts") import * as Host;
from js.module("./host.ts") import unsafe {
  envOr as envOrRaw: (String, String) -> String,
  nowSeconds as nowRaw: Void -> Number,
  isoToSeconds as isoRaw: String -> Number,
  dirname as dirnameRaw: String -> String,
  eprint as eprintRaw: String -> Void,
  confirmYes: String -> Bool,
  exit as exitRaw: Number -> Void,
  parseIntOr as parseIntRaw: (String, Number) -> Number,
  denoPath as denoPathRaw: Void -> String,
  prettyJson as prettyRaw: Js.Value -> String
};
from js.global("JSON") import unsafe { stringify as compactRaw: Js.Value -> String };
from "./fun.wm" import { mapAll };

-- Imports are never re-exported, so these are rebound here for other modules.
let envOr = (name, fallback) => { envOrRaw(name, fallback) };
let nowSeconds = () => { nowRaw() };
let isoToSeconds = (iso) => { isoRaw(iso) };
let dirname = (path) => { dirnameRaw(path) };
let eprint = (text) => { eprintRaw(text) };

let confirm = (question) => { confirmYes(question) };
let exit = (code) => { exitRaw(code) };
let parseIntOr = (text, fallback) => { parseIntRaw(text, fallback) };
let denoPath = () => { denoPathRaw() };

-- JSON rendering. Object keys keep the order they are written in, which the store hash relies on.
let compactJson = (value: Js.Value) => { compactRaw(value) };
let prettyJson = (value: Js.Value) => { prettyRaw(value) };
let jsonList = (items, f) => { Js.Array.fromList(mapAll(items, f)) };

let describe = (what) => {
  (error) => {
    match(error) {
      Js.Error(message) => { what ++ ": " ++ message },
      Js.Unknown => { what ++ ": unknown error" }
    }
  }
};

let args = () => { Host.argv() :> Result.map(Js.Array.toList) :> Result.withDefault([]) };

let fetchText = (url) => { Host.fetchText(url) :> Task.mapErr(describe("fetch " ++ url)) };
let download = (url, dest) => { Host.download(url, dest) :> Task.mapErr(describe("download " ++ url)) };
let sha256File = (path) => { Host.sha256File(path) :> Task.mapErr(describe("hash " ++ path)) };
let buildIdentity = (program, tools) => {
  Host.buildIdentity(program, Js.Array.fromList(tools)) :> Task.mapErr(describe("build identity"))
};
let runBuild = (program, id, version, upstreamRef, inputs, work, out, tools) => {
  Host.runBuild(program, id, version, upstreamRef, inputs, work, out, Js.Array.fromList(tools))
    :> Task.mapErr(describe("build " ++ id))
};
let sha256Text = (text) => { Host.sha256Text(text) :> Task.mapErr(describe("hash text")) };

let exists = (path) => { Host.exists(path) :> Task.mapErr(describe("stat " ++ path)) };
let mkdirp = (path) => { Host.mkdirp(path) :> Task.mapErr(describe("mkdir " ++ path)) };
let makeTempDir = (parent, prefix) => {
  Host.makeTempDir(parent, prefix) :> Task.mapErr(describe("mktemp in " ++ parent))
};
let readText = (path) => { Host.readText(path) :> Task.mapErr(describe("read " ++ path)) };
let readTextOr = (path, fallback) => {
  Host.readTextOr(path, fallback) :> Task.mapErr(describe("read " ++ path))
};
let writeText = (path, text, mode) => {
  Host.writeText(path, text, mode) :> Task.mapErr(describe("write " ++ path))
};
let copyFile = (source, dest, mode) => {
  Host.copyFile(source, dest, mode) :> Task.mapErr(describe("copy " ++ source ++ " to " ++ dest))
};
let symlink = (target, path) => {
  Host.symlink(target, path) :> Task.mapErr(describe("symlink " ++ path))
};
let linkOrCopy = (source, dest) => {
  Host.linkOrCopy(source, dest) :> Task.mapErr(describe("link " ++ dest))
};
let removeFile = (path) => { Host.removeFile(path) :> Task.mapErr(describe("remove " ++ path)) };
let removeTree = (path) => { Host.removeTree(path) :> Task.mapErr(describe("remove " ++ path)) };
let pruneEmptyDirs = (path, stop) => {
  Host.pruneEmptyDirs(path, stop) :> Task.mapErr(describe("prune " ++ path))
};
let rename = (source, dest) => {
  Host.rename(source, dest) :> Task.mapErr(describe("rename " ++ source))
};
let freeze = (root) => { Host.freeze(root) :> Task.mapErr(describe("freeze " ++ root)) };
let listDir = (path) => {
  Host.listDir(path) :> Task.map(Js.Array.toList) :> Task.mapErr(describe("list " ++ path))
};
let extract = (chain, members, dest, strip) => {
  Host.extract(Js.Array.fromList(chain), Js.Array.fromList(members), dest, strip)
    :> Task.mapErr(describe("extract into " ++ dest))
};
let extractPayload = (chain, choices, dest) => {
  Host.extract(Js.Array.fromList(chain), Js.Array.fromList([]), dest, 0, Js.Array.fromList(choices))
    :> Task.mapErr(describe("extract payload into " ++ dest))
};
let runCapture = (cmd, args) => {
  Host.runCapture(cmd, Js.Array.fromList(args)) :> Task.mapErr(describe(cmd))
};
let compileProgram = (source, compiled) => {
  Host.compileProgram(source, compiled) :> Task.mapErr(describe("compile"))
};
let copyPreserving = (source, dest) => {
  Host.copyPreserving(source, dest) :> Task.mapErr(describe("copy to " ++ dest))
};
let canWrite = (dir) => { Host.canWrite(dir) :> Task.mapErr(describe("check " ++ dir)) };
let runInteractive = (cmd, args) => {
  Host.runInteractive(cmd, Js.Array.fromList(args)) :> Task.mapErr(describe("run " ++ cmd))
};
let pacmanOwned = (root, paths) => {
  Host.pacmanOwned(root, Js.Array.fromList(paths))
    :> Task.map(Js.Array.toList)
    :> Task.mapErr(describe("read pacman's database under " ++ root))
};
let runQuiet = (cmd, args) => {
  Host.runQuiet(cmd, Js.Array.fromList(args)) :> Task.mapErr(describe("run " ++ cmd))
};

-- (path, linkTarget) for every file and symlink under root; linkTarget is "" for files.
let walkEntries = (root) => {
  -- An accumulator keeps this a loop: zig alone has ~20,000 entries.
  let rec pairs = (items, acc) => {
    match(items) {
      [path, target, ..rest] => { pairs(rest, [(path, target), ..acc]) },
      _ => { List.reverse(acc) }
    }
  };
  Host.walkEntries(root)
    :> Task.map((flat) => { pairs(Js.Array.toList(flat), []) })
    :> Task.mapErr(describe("walk " ++ root))
};

-- Runs tasks one after another, keeping their results.
let series = (items, f) => { Task.traverse(items, f) };

let each = (items, f) => { Task.traverse(items, f) :> Task.map((_) => { void }) };

let stageBuildInput = (source, inputs, name) => {
  Host.stageBuildInput(source, inputs, name) :> Task.mapErr(describe("stage input " ++ name))
};
