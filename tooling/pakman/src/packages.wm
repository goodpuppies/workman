-- Packages as programs.
--
-- Every <name>/pak.wm in WM's registered package directories (or an explicit
-- PAKMAN_PKGS override, with the sibling pak/paks as a legacy fallback) is a self-contained wm
-- program; there is no index. A package's folder can also hold its patches
-- and other files. pakman compiles each one on its own and talks to it through
-- plan.wm's protocol, running it as a separate Deno process with only the
-- permissions a command needs:
--   describe   no permissions
--   versions   network access to the hosts the package declared, nothing else
--   make       no permissions: building the plan is pure, and Deno enforces it
--   build      offline Bubblewrap host environment, invoked by store.wm

from js.module("./host.ts") import unsafe { pakmanRoot: Void -> String, hasLetters: (String, String) -> Bool, isRepository: String -> Bool, packageDirectories: String -> Js.Array<String> };
from js.module("./host.ts") import { repositoryRecipe, repositoryVersion, recipeSource, packageProgramPath, rememberRecipe, lockedRecipe } as Repository;
from "pakman/model.wm" import { Target, Scope, Candidate, Package, Source };
from "pakman/plan.wm" import *;
from "./paths.wm" import { Paths };
from "./lock.wm" import { LockEntry, entryText };
from "./io.wm" import { envOr, exists, listDir, series, runCapture, compileProgram, dirname, describe };
from "pakman/text.wm" import { join, concatMap };
from "pakman/fun.wm" import { mapAll, filterAll, appendAll, concatAll, unique };

let via = Monad.via;

record PackageInfo = {
  name: String,
  description: String,
  homepage: String,
  license: String,
  target: Target,
  scope: Scope,      -- System installs under /, User under the home directory
  channel: String,   -- the channel followed by default
  minAgeDays: Number,
  onlyLatest: Bool,  -- upstream offers only its newest build
  hosts: List<String>,
  program: String -- the compiled package program
};

-- pakman lives in <wm checkout>/tooling/pakman; packages default to a pak
-- repository beside the wm checkout (~/git/wm-mini -> ~/git/pak/paks).
let defaultPackageDir = () => { dirname(dirname(dirname(pakmanRoot()))) ++ "/pak/paks" };

let packageDirs = () => { packageDirectories(defaultPackageDir()) :> Js.Array.toList };

-- Runs one protocol command; its output is one WON document, decoded by the caller.
let call = (name, program, flags, command) => {
  runCapture("deno", appendAll(["run", "--no-prompt", "--quiet", ..flags], [program, ..command]))
    :> Task.mapErr((message) => { name ++ " " ++ join(command, " ") ++ " failed: " ++ message })
};

let invalid = (name, command) => { (message) => { name ++ " " ++ command ++ " printed " ++ message } };

let describeProgram = (name, program) => {
  call(name, program, [], ["describe"])
    :> Task.andThen((output) => { decodeInfo(output) :> Result.mapErr(invalid(name, "describe")) :> Task.fromResult })
    :> Task.andThen((i: Info) => {
      if (i.name == name || isRepository(name)) {
        Task.succeed(.{
          name,
          description = i.description,
          homepage = i.homepage,
          license = i.license,
          target = i.target,
          scope = i.scope,
          channel = i.channel,
          minAgeDays = i.minAgeDays,
          onlyLatest = i.onlyLatest,
          hosts = i.hosts,
          program
        }: PackageInfo)
      } else {
        Task.fail(name ++ ".wm describes a package called " ++ i.name)
      }
    })
};

let programFile = (dir, name) => { dir ++ "/" ++ name ++ "/pak.wm" };

-- Every package name in the package directories, without compiling anything.
let names = () => {
  let inDir = (dir) => {
    let isPackage = (name) => { exists(programFile(dir, name)) :> Task.map((found) => { if (found) { [name] } else { [] } }) };
    listDir(dir)
      :> via Task (entries) => { series(entries, isPackage) }
      :> Task.map(concatAll)
  };
  series(packageDirs(), inDir)
    :> Task.map((lists) => { unique(concatAll(lists)) })
};

-- "unknown package ogb, did you mean oscgoesbrrr?" for the packages holding the name's letters in order.
let unknown = (name, known) => {
  let matches = List.filter(known, (candidate) => { hasLetters(name, candidate) });
  if (matches == []) {
    "unknown package " ++ name
  } else {
    "unknown package " ++ name ++ ", did you mean " ++ join(matches, ", ") ++ "?"
  }
};

-- The first directory holding <name>/pak.wm wins.
let load = (paths: Paths, name) => {
  let rec find = (dirs) => {
    match(dirs) {
      [] => { names() :> Task.andThen((known) => { Task.fail(unknown(name, known)) }) },
      [dir, ..rest] => {
        let file = programFile(dir, name);
        exists(file) :> Task.andThen((found) => { if (found) { Task.succeed(file) } else { find(rest) } })
      }
    }
  };
  let source = if (isRepository(name)) {
    Repository.repositoryRecipe(paths.state, name, false) :> Task.mapErr(describe("repository " ++ name))
  } else { find(packageDirs()) };
  source
    :> Task.andThen((file) => {
      Repository.packageProgramPath(paths.state, name, file) :> Task.mapErr(describe("package cache"))
        :> Task.andThen((output) => { compileProgram(file, output) })
    })
    :> Task.andThen((program) => { describeProgram(name, program) })
};

let refresh = (paths: Paths, info: PackageInfo) => {
  if (!isRepository(info.name)) { Task.succeed(info) } else {
    Repository.repositoryRecipe(paths.state, info.name, true) :> Task.mapErr(describe("repository " ++ info.name))
      :> Task.andThen((_) => { load(paths, info.name) })
  }
};

let remember = (paths: Paths, info: PackageInfo, entry: LockEntry) => {
  Repository.rememberRecipe(paths.lockFile, info.name, entryText(entry), info.program)
    :> Task.mapErr(describe("record recipe"))
};

let forEntry = (paths: Paths, info: PackageInfo, entry: LockEntry) => {
  if (!isRepository(info.name)) { Task.succeed(info) } else {
    Repository.lockedRecipe(paths.lockFile, info.name, entryText(entry))
      :> Task.mapErr(describe("locked recipe; run pakman resolve " ++ info.name))
      :> Task.andThen((program) => { describeProgram(info.name, program) })
  }
};

let loadAll = (paths: Paths) => {
  names() :> Task.andThen((all) => { series(all, (n) => { load(paths, n) }) })
};

-- Upstream candidates, newest first, already filtered by the package's own rules.
let versions = (info: PackageInfo) => {
  let net = match(info.hosts) {
    [] => { [] },
    Var(hosts) => { ["--allow-net=" ++ join(hosts, ",")] }
  };
  call(info.name, info.program, ["--allow-env=GITHUB_TOKEN", ..net], ["versions"])
    :> Task.andThen((output) => { decodeCandidates(output) :> Result.mapErr(invalid(info.name, "versions")) :> Task.fromResult })
    :> Task.andThen((items) => {
      series(items, (candidate: Candidate) => {
        if (candidate.ref != "pak:self") { Task.succeed(candidate) } else {
          Repository.repositoryVersion(info.program) :> Task.mapErr(describe("repository candidate"))
            :> Task.andThen((fields) => {
              match(Js.Array.toList(fields)) {
                [revision, published] => { Task.succeed(Candidate(revision, published, candidate.channel, [], revision)) },
                _ => { Task.fail("invalid repository metadata") }
              }
            })
        }
      })
    })
};

-- The plan for one version. Runs with no permissions at all.
let make = (info: PackageInfo, version, ref) => {
  call(info.name, info.program, [], ["make", version, ref])
    :> Task.andThen((output) => { decodePlan(output) :> Result.mapErr(invalid(info.name, "make")) :> Task.fromResult })
    :> Task.andThen((pkg: Package) => {
      series(pkg.sources, (source: Source) => {
        Repository.recipeSource(info.program, source.url) :> Task.mapErr(describe("recipe source"))
          :> Task.map((url) => { Source(source.file, url) })
      }) :> Task.map((sources) => { .{ ..pkg, sources } })
    })
};
