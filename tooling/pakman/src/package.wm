-- The entry point for package programs.
--
-- A package file defines a `definition` and ends with
--   let main = () => { serve(definition) };
-- pakman then runs it as `<package> describe | versions | make <version> <ref>`.
-- Each command prints one JSON document (see plan.wm) on stdout.

from "./model.wm" import *;
from "./plan.wm" import { encodeInfo, encodeCandidates, encodePlan };
from "./io.wm" import { args, eprint, exit, compactJson };
from "./text.wm" import { join };
from "./fun.wm" import { filterAll };

let usage = "usage: <package>.wm describe | versions | make <version> <ref> | build <id> <version> <ref>";

let serveWithBuild = (def: Definition, build: BuildContext -> Task<Void, String>) => {
  let fail = (message) => { eprint(def.name ++ ": " ++ message); exit(1) };
  match(args()) {
    ["describe"] => { print(compactJson(encodeInfo(def))); Task.succeed(void) },
    ["versions"] => {
      def.versions()
        :> Task.map((candidates) => {
          let accepted = filterAll(candidates, (c: Candidate) => { def.policy.accept(c.version) });
          print(compactJson(encodeCandidates(accepted)))
        })
        :> Task.recover(fail)
    },
    ["build", id, version, upstreamRef] => {
      build(BuildContext(id, version, upstreamRef, "/inputs", "/work", "/out"))
        :> Task.recover(fail)
    },
    ["make", version, upstreamRef] => {
      print(compactJson(encodePlan(def.make(version, upstreamRef))));
      Task.succeed(void)
    },
    Var(other) => { fail(usage ++ " (got: " ++ join(other, " ") ++ ")"); Task.succeed(void) }
  }
};

-- Existing packages do not need a build callback.
let serve = (def: Definition) => {
  serveWithBuild(def, (_) => { Task.fail("this package has no build callback") })
};
