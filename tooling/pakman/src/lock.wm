-- pakman.lock: the versions and source hashes resolution chose.
--
-- Builds only ever read the lock, so they are reproducible until the next
-- `pakman resolve`.

from "./io.wm" import { mkdirp, dirname };
from "pakman/text.wm" import { before };
from "pakman/fun.wm" import { ignore };
from "pakman/won.wm" import * as D;
from "./won_file.wm" import * as WonFile;

-- `verified`: the hash matched a checksum upstream published, rather than
-- only being recorded from the first download.
record LockedSource = { file: String, url: String, sha256: String, verified: Bool };

-- `track` is the selector the version came from: "" follows the package's
-- default channel, a channel name follows that channel, anything else is an
-- exact version pin that `update` leaves alone.
-- `ref` is the candidate's ref, handed back to `make` on every build.
record LockEntry = { name: String, version: String, track: String, ref: String, sources: List<LockedSource> };

let protocol = 3;

let sourceValue = (s: LockedSource) => {
  D.record([("file", D.text(s.file)), ("url", D.text(s.url)), ("sha256", D.text(s.sha256)), ("verified", D.bool(s.verified))])
};

let entryValue = (e: LockEntry) => {
  D.record([
    ("name", D.text(e.name)), ("version", D.text(e.version)), ("track", D.text(e.track)),
    ("ref", D.text(e.ref)), ("sources", D.list(e.sources, sourceValue))
  ])
};

-- One entry as WON text: what a resolution identity and a recipe receipt key cover.
let entryText = (e: LockEntry) => { Result.getOr(D.encode(entryValue(e)), "") };

let decodeSource = (found) => {
  Result|D.field(found, "file"), D.field(found, "url"), D.field(found, "sha256"), D.boolField(found, "verified")|
    :> Result.map((file, url, sha256, verified) => { LockedSource(file, url, sha256, verified) })
};

let decodeEntry = (found) => {
  Result|D.field(found, "name"), D.field(found, "version"), D.field(found, "track"), D.field(found, "ref"),
    D.listField(found, "sources", decodeSource)|
    :> Result.map((name, version, track, ref, sources) => { LockEntry(name, version, track, ref, sources) })
};

-- A missing lock is empty.
let read = (path) => {
  WonFile.readFile(path) :> Task.andThen((file) => {
    match(file) {
      None => { Task.succeed([]) },
      Some(found) => {
        D.items(D.opened(found, "Lock", protocol), decodeEntry)
          :> Result.mapErr((problem) => { path ++ ": " ++ D.message(problem) ++ "; delete it and run `pakman resolve`" })
          :> Task.fromResult
      }
    }
  })
};

let write = (path, entries) => {
  Task|mkdirp(dirname(path)), WonFile.writeFile(path, D.document("Lock", protocol, D.list(entries, entryValue)))| :> Task.map(ignore)
};

let find = (entries: List<LockEntry>, name) => {
  List.find(entries, (e: LockEntry) => { e.name == name })
};

-- Replaces (or adds) the entry for entry.name, keeping entries sorted by name.
let rec upsert = (entries: List<LockEntry>, entry: LockEntry) => {
  match(entries) {
    [] => { [entry] },
    [first, ..rest] => {
      if (first.name == entry.name) {
        [entry, ..rest]
      } else {
        if (before(entry.name, first.name)) { [entry, first, ..rest] } else { [first, ..upsert(rest, entry)] }
      }
    }
  }
};

let versionOf = (entry: LockEntry) => { entry.version };

let trackOf = (entry: LockEntry) => { entry.track };
