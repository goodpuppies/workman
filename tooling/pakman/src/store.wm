-- Realization: build a locked package into an immutable store tree.
--
-- A store entry is <store>/<hash>-<name>-<version>/, a plain DESTDIR tree
-- relative to /, plus <entry>.json beside it listing its
-- files and dependencies. The hash covers everything that determines the
-- tree: name, version, target, requirements, source hashes and
-- install steps. It does not cover the machine that ran the build.

from "./model.wm" import *;
from "./packages.wm" import { PackageInfo, make };
from "./packages.wm" import * as Packages;
from "./instances.wm" import * as Instances;
from "./plan.wm" import { targetName, scopeName, opJson, refJson };
from "./refs.wm" import { render, symlinkTarget, dependencies, baseFiles, foreignFiles, instances, mapRefs, storePaths, refsOf, runtimePlan, resolvePath };
from "./lock.wm" import { LockEntry, LockedSource };
from "./paths.wm" import { Paths };
from "./io.wm" import *;
from "./fun.wm" import { ignore, mapAll, concatAll };
from js.module("./host.ts") import unsafe { packageStoreName: String -> String };

let via = Monad.via;

record StoreEntry = { name: String, version: String, path: String };

let modeBits = match(mode) => {
  Exec => { 493 }, -- 0755
  Data => { 420 }  -- 0644
};

-- What the store hash covers.
-- The scope root rendered references point into: / for System, the home
-- directory for User. It is a build input, since rendered text contains it.
let baseFor = (paths: Paths, def: PackageInfo) => {
  match(def.scope) { System => { "/" }, User => { if (paths.root == "/") { paths.home } else { paths.root } } }
};

let inputsJson = (base, def: PackageInfo, pkg: Package, sources: List<LockedSource>, builder, upstreamRef) => {
  let sourceJson = (s: LockedSource) => { JSON{ file: s.file, sha256: s.sha256 } };
  JSON{
    name: def.name,
    builder: builder,
    upstreamRef: upstreamRef,
    version: pkg.version,
    target: targetName(def.target),
    scope: scopeName(def.scope),
    base: base,
    requires: jsonList(pkg.requires, refJson),
    sources: jsonList(sources, sourceJson),
    install: jsonList(pkg.install, opJson)
  }
};

-- The lock must describe exactly the sources `make` asks for; otherwise the
-- definition changed since the last resolve.
let checkLock = (def: PackageInfo, pkg: Package, entry: LockEntry) => {
  let lockedFor = (src: Source) => {
    List.find(entry.sources, (l: LockedSource) => { l.file == src.file && l.url == src.url })
  };
  let stale = Err(def.name ++ ": pakman.lock does not match the definition; run `pakman resolve "
    ++ def.name ++ "`");
  if (List.length(pkg.sources) != List.length(entry.sources)) {
    stale
  } else {
    pkg.sources :> mapAll(lockedFor) :> Option.collectList :> match {
      Some(sources) => { Ok(sources) },
      None => { stale }
    }
  }
};

-- Makes sure a locked source is in the cache with the right contents,
-- downloading it if it is missing. Cached files are re-hashed on every build,
-- so a corrupted cache fails the build instead of reaching the store.
let ensureSource = (paths: Paths, src: LockedSource) => {
  let cached = paths.sources ++ "/" ++ src.sha256;
  let partial = paths.tmp ++ "/" ++ src.sha256 ++ ".download";
  let requireCachedHash = via Task (sha) => {
    if (sha == src.sha256) {
      Task.succeed(cached)
    } else {
      Task.fail(cached ++ " is corrupted (sha256 " ++ sha ++ "); delete it to download it again")
    }
  };
  let keepDownload = via Task (sha) => {
    if (sha == src.sha256) {
      rename(partial, cached)
    } else {
      removeFile(partial)
        :> via Task => { Task.fail(src.url ++ ": sha256 is " ++ sha ++ ", pakman.lock expects " ++ src.sha256) }
    }
  };
  let downloadVerified = () => {
    Task|mkdirp(paths.tmp), mkdirp(paths.sources), download(src.url, partial), sha256File(partial)|
      :> Task.map((_, _, _, sha) => { sha })
      :> keepDownload
      :> Task.map((_) => { cached })
  };
  let useCacheOrDownload = via Task (present) => {
    if (present) { sha256File(cached) :> requireCachedHash } else { downloadVerified() }
  };
  exists(cached)
    :> useCacheOrDownload
};

-- One install step, writing into `out`. Curried so it can be handed to `each`.
let runOp = (out, base, sourcePath, def: PackageInfo, entry: LockEntry, inputs, work) => {
  (op) => {
    let parent = (rel) => { mkdirp(dirname(out ++ "/" ++ rel)) };
    match(op) {
      Install(file, dest, mode) => {
        Task|parent(dest), copyFile(sourcePath(file), out ++ "/" ++ dest, modeBits(mode))| :> Task.map(ignore)
      },
      Extract(unpack) => {
        let chain = match(unpack.archive) {
          [file, ..inner] => { [sourcePath(file), ..inner] },
          [] => { [] }
        };
        extract(chain, unpack.members, out ++ "/" ++ unpack.dest, unpack.strip)
      },
      ExtractPayload(archives, choices, dest) => {
        let chain = match(archives) {
          [file, ..inner] => { [sourcePath(file), ..inner] },
          [] => { [] }
        };
        extractPayload(chain, choices, out ++ "/" ++ dest)
      },
      Symlink(target, path) => {
        Task|parent(path), symlink(symlinkTarget(path, target), out ++ "/" ++ path)| :> Task.map(ignore)
      },
      WriteText(dest, contents, mode) => {
        Task|parent(dest), writeText(out ++ "/" ++ dest, render(base, contents), modeBits(mode))| :> Task.map(ignore)
      },
      MakeDir(path) => { mkdirp(out ++ "/" ++ path) },
      BuildCommand(build) => {
        let trees = match(build.program) { StorePath(tree, _) => { [tree] }, _ => { [] } };
        runBuildCommand(resolvePath(base, build.program), trees, build.arguments, sourcePath(build.source),
          build.strip, build.output, out, build.dest, modeBits(build.mode), work)
      },
      Build(id, tools) => { runBuild(def.program, id, entry.version, entry.ref, inputs, work, out, tools) }
    }
  }
};

-- The store entry's manifest: its files and the dependency edges found in its plan.
let manifestJson = (def: PackageInfo, pkg: Package, hash, files: List<(String, String)>) => {
  let fileJson = (path, target) => { JSON{ path: path, link: target } };
  let foreignJson = (name, path) => { JSON{ pkg: name, path: path } };
  let runtime = runtimePlan(pkg);
  let privateUses = refsOf(runtime) :> List.mapPartial(match {
    StorePath(tree, path) => { Some(JSON{ tree: tree, path: path }) }, _ => { None }
  });
  JSON{
    name: def.name,
    version: pkg.version,
    hash: hash,
    depends: Js.Array.fromList(dependencies(pkg)),
    instances: Js.Array.fromList(storePaths(runtime)),
    buildInstances: Js.Array.fromList(storePaths(pkg)),
    instanceUses: Js.Array.fromList(privateUses),
    base: Js.Array.fromList(baseFiles(pkg)),
    uses: jsonList(foreignFiles(pkg), foreignJson),
    files: jsonList(files, fileJson)
  }
};

-- Builds into a temporary directory, then renames into the store, so a store
-- path either exists completely or not at all.
let build = (paths: Paths, def: PackageInfo, pkg: Package, sources: List<LockedSource>, entry: LockEntry, hash, storePath, base) => {
  let sourcePath = (file) => {
    sources
      :> List.find((s: LockedSource) => { s.file == file })
      :> Option.map((s: LockedSource) => { paths.sources ++ "/" ++ s.sha256 })
      :> Option.withDefault(paths.sources ++ "/missing-" ++ file)
  };
  let populate = via Task (work) => {
    let out = work ++ "/out";
    let inputs = work ++ "/inputs";
    let stage = (s: LockedSource) => {
      stageBuildInput(sourcePath(s.file), inputs, s.file)
    };
    -- Only this step needs an earlier result (the file list); the rest run in order for their effects.
    let finish = via Task (files) => {
      Task|
        writeText(storePath ++ ".json", prettyJson(manifestJson(def, pkg, hash, files)), 420),
        freeze(out),
        rename(out, storePath),
        removeTree(work)
      | :> Task.map(ignore)
    };
    let buildSources = if (List.any(pkg.install, match { Build(_, _) => { true }, _ => { false } })) { sources } else { [] };
    Task|mkdirp(out), mkdirp(inputs), each(buildSources, stage),
      each(pkg.install, runOp(out, base, sourcePath, def, entry, inputs, work)), walkEntries(out)|
      :> Task.map((_, _, _, _, files) => { files })
      :> finish
      :> Task.map((_) => { Ok(void) })
      :> Task.recover((message) => { Err(message) })
      :> via Task (outcome) => {
        match(outcome) {
          Ok(_) => { Task.succeed(void) },
          Err(message) => { removeTree(work) :> via Task (_) => { Task.fail(message) } }
        }
      }
  };
  makeTempDir(paths.tmp, packageStoreName(def.name) ++ "-")
    :> populate
};

-- Realizes one plan against its lock entry. Curried so `realize` can pass it to Task.andThen.
let realizePlanWith = (paths: Paths, def: PackageInfo, entry: LockEntry, privateInstance: Bool) => {
  (pkg: Package) => {
    let hashInputs = via Task (sources) => {
      let tools = pkg.install :> List.mapPartial(match { Build(_, tools) => { Some(tools) }, _ => { None } }) :> concatAll;
      let identity = if (List.length(List.filter(pkg.install, match { Build(_, _) => { true }, _ => { false } })) == 0) {
        -- Even without a callback, private instance identity includes its recipe.
        if (privateInstance) { sha256File(def.program) } else { Task.succeed("") }
      } else { buildIdentity(def.program, tools) };
      let commandIdentity = if (List.any(pkg.install, match { BuildCommand(_) => { true }, _ => { false } })) {
        commandBuildIdentity()
      } else { Task.succeed("") };
      Task|identity, commandIdentity| :> Task.map((recipe, backend) => { recipe ++ backend }) :> via Task (builder) => { sha256Text(compactJson(inputsJson(if (privateInstance) { "@private" } else { baseFor(paths, def) }, def, pkg, sources, builder, entry.ref))) }
        :> Task.map((fullHash) => { (sources, fullHash :> .slice(0, 32) :> Result.withDefault(fullHash)) })
    };
    let locate = via Task (sources, hash) => {
      let storePath = paths.store ++ "/" ++ hash ++ "-" ++ packageStoreName(def.name) ++ "-" ++ packageStoreName(pkg.version);
      exists(storePath) :> Task.map((built) => { (sources, hash, storePath, built) })
    };
    let buildIfMissing = via Task (sources, hash, storePath, built) => {
      if (built) {
        Task.succeed(storePath)
      } else {
        Task|
          mkdirp(paths.store),
          series(sources, (s) => { ensureSource(paths, s) }),
          build(paths, def, pkg, sources, entry, hash, storePath, if (privateInstance) { storePath } else { baseFor(paths, def) })
        | :> Task.map((_) => { storePath })
      }
    };
    checkLock(def, pkg, entry)
      :> Task.fromResult
      :> hashInputs
      :> locate
      :> buildIfMissing
      :> Task.map((storePath) => { StoreEntry(def.name, pkg.version, storePath) })
  }
};

-- Backward-compatible entrypoint for callers realizing an already-bound plan.
let realizePlan = (paths, def, entry) => { realizePlanWith(paths, def, entry, false) };

-- Build children first from the saved graph. No upstream discovery during build.
let rec realizeNode = (paths: Paths, graph: Instances.Graph, id, ancestors: List<String>, privateInstance: Bool) => {
  if (List.any(ancestors, (parent) => { parent == id })) { Task.fail("cyclic instance graph") } else {
    Instances.find(graph, id) :> Task.fromResult
      :> Task.andThen((node: Instances.Node) => {
        Packages.describeProgram(node.name, node.program) :> Monad.via Task (info: PackageInfo) => {
          sha256File(info.program) :> Monad.via Task (hash) => {
            if (hash != node.programHash) {
              Task.fail(node.name ++ ": recipe changed; run pakman resolve before building")
            } else {
              let child = (edge: Instances.Edge) => {
                realizeNode(paths, graph, edge.node, [id, ..ancestors], true)
                  :> Task.map((stored) => { (edge, stored) })
              };
              series(node.edges, child) :> Monad.via Task (children) => {
                let bind = match {
                  Instance(name, selector, path) => {
                    match(List.find(children, (pair) => {
                      let (edge, _) = pair;
                      let selected: Instances.Edge = edge;
                      selected.name == name && selected.selector == selector
                    })) {
                      Some((_, Var(stored))) => { let selected: StoreEntry = stored; StorePath(selected.path, path) },
                      None => { Panic("missing instance binding " ++ name ++ "@" ++ selector) }
                    }
                  },
                  Var(other) => { other }
                };
                make(info, node.entry.version, node.entry.ref) :> Monad.via Task (plan: Package) => {
                  let bound = mapRefs(plan, bind);
                  let uses = refsOf(bound) :> List.mapPartial(match {
                    StorePath(tree, path) => { Some((tree, path)) }, _ => { None }
                  });
                  each(uses, (tree, path) => { checkInstanceFile(tree, path) })
                    :> Monad.via Task (_) => { realizePlanWith(paths, info, node.entry, privateInstance)(bound) }
                }
              }
            }
          }
        }
      })
  }
};

-- Realizes a locked package and its private closure. Legacy Of dependencies
-- are still installed by the CLI's existing shared-root path.
let realize = (paths: Paths, def: PackageInfo, entry: LockEntry) => {
  Packages.forEntry(paths, def, entry) :> Monad.via Task (selected: PackageInfo) => {
    make(selected, entry.version, entry.ref) :> Monad.via Task (plan: Package) => {
    if (instances(plan) == []) { realizePlan(paths, selected, entry)(plan) } else {
      Instances.read(paths, selected, entry)
        :> Task.andThen((graph: Instances.Graph) => { realizeNode(paths, graph, graph.root, [], false) })
    }
    }
  }
};
