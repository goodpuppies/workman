-- Where pakman keeps things.
--
-- State follows WM's XDG layout. Nothing needs root until a
-- generation is installed into a real prefix. PAKMAN_STATE overrides it.
--
-- Each install root is an environment with its own generations and its own
-- lock, so `zig@0.14.1` in one root doesn't change the version in another.

from "./io.wm" import { envOr };
from js.module("./host.ts") import unsafe { pakmanStateDirectory: Void -> String };

record Paths = {
  root: String,     -- selected installation root (including --root overrides)
  home: String,     -- the root User-scope packages install into
  state: String,
  sources: String,  -- downloads, by sha256
  store: String,    -- built DESTDIR trees, by input hash
  tmp: String,
  profiles: String, -- one directory per install root: generations and its lock
  lockFile: String  -- the lock for the root these paths were made for
};

-- The directory for one install root under `profiles`.
let profileDirOf = (profiles, root) => {
  profiles ++ "/" ++ (root :> .replaceAll("/", "_") :> Result.getOr(root))
};

let paths = (root) => {
  let home = envOr("HOME", "/root");
  let state = pakmanStateDirectory();
  .{
    root,
    home,
    state,
    sources = state ++ "/sources",
    store = state ++ "/store",
    tmp = state ++ "/tmp",
    profiles = state ++ "/profiles",
    lockFile = envOr("PAKMAN_LOCK", profileDirOf(state ++ "/profiles", root) ++ "/pakman.lock")
  }: Paths
};
