-- The protocol between package programs and pakman.
--
-- A package program prints one WON document per command. Encoders run in the
-- package process, decoders in pakman; keeping both here means the two sides
-- can't drift apart. Every document's root tag carries `protocol` so a stale
-- compiled package is detected instead of misread.

from "./model.wm" import *;
from "./refs.wm" import { parts };
from "./won.wm" import * as D;

let protocol = 11;

let targetName = match(target) => {
  Host => { "Host" },
  Ps2 => { "Ps2" }
};

let scopeName = match(scope) => {
  System => { "System" },
  User => { "User" }
};

let modeName = match(mode) => {
  Exec => { "Exec" },
  Data => { "Data" }
};

-- ---------------------------------------------------------------------------
-- Encoding

let sourceValue = (s: Source) => { D.record([("file", D.text(s.file)), ("url", D.text(s.url))]) };

let refValue = match(ref) => {
  Own(path) => { D.wrap("Own", D.text(path)) },
  Of(name, path) => { D.tag("Of", [("package", D.text(name)), ("path", D.text(path))]) },
  Instance(name, selector, path) => {
    D.tag("Instance", [("package", D.text(name)), ("selector", D.text(selector)), ("path", D.text(path))])
  },
  StorePath(store, path) => { D.tag("StorePath", [("store", D.text(store)), ("path", D.text(path))]) },
  Base(path) => { D.wrap("Base", D.text(path)) }
};

-- Text travels as a flat list of parts.
let partValue = match(part) => {
  Lit(text) => { D.wrap("Lit", D.text(text)) },
  Ref(path) => { D.wrap("Ref", refValue(path)) },
  ShellRef(path) => { D.wrap("Shell", refValue(path)) },
  _ => { D.wrap("Lit", D.text("")) }
};

let textValue = (text) => { D.list(parts(text), partValue) };

let modeValue = (mode) => { D.bare(modeName(mode)) };

let opValue = match(op) => {
  Install(file, dest, mode) => {
    D.tag("Install", [("source", D.text(file)), ("path", D.text(dest)), ("mode", modeValue(mode))])
  },
  Extract(unpack) => {
    D.tag("Extract", [
      ("archive", D.strings(unpack.archive)), ("members", D.strings(unpack.members)),
      ("path", D.text(unpack.dest)), ("strip", D.int(unpack.strip))
    ])
  },
  ExtractPayload(chain, choices, dest) => {
    D.tag("ExtractPayload", [("archive", D.strings(chain)), ("members", D.strings(choices)), ("path", D.text(dest))])
  },
  Symlink(target, path) => { D.tag("Symlink", [("target", refValue(target)), ("path", D.text(path))]) },
  WriteText(dest, contents, mode) => {
    D.tag("Write", [("path", D.text(dest)), ("mode", modeValue(mode)), ("text", textValue(contents))])
  },
  BuildCommand(build) => {
    D.tag("BuildCommand", [
      ("program", refValue(build.program)), ("arguments", D.strings(build.arguments)),
      ("source", D.text(build.source)), ("strip", D.int(build.strip)), ("output", D.text(build.output)),
      ("path", D.text(build.dest)), ("mode", modeValue(build.mode))
    ])
  },
  Build(id, tools) => { D.tag("Build", [("id", D.text(id)), ("tools", D.strings(tools))]) },
  MakeDir(path) => { D.wrap("MakeDir", D.text(path)) }
};

-- `describe`: everything pakman needs to know without running any package code.
let encodeInfo = (def: Definition) => {
  D.document("Package", protocol, D.record([
    ("name", D.text(def.name)),
    ("description", D.text(def.description)),
    ("homepage", D.text(def.homepage)),
    ("license", D.text(def.license)),
    ("target", D.bare(targetName(def.target))),
    ("scope", D.bare(scopeName(def.scope))),
    ("channel", D.text(def.policy.channel)),
    ("minAgeDays", D.int(def.policy.minAgeDays)),
    ("onlyLatest", D.bool(def.policy.onlyLatest)),
    ("hosts", D.strings(def.hosts))
  ]))
};

-- `versions`: candidates newest first, already filtered by the package's own
-- `accept` rule. pakman applies the minimum age itself, so no package can skip it.
let encodeCandidates = (candidates: List<Candidate>) => {
  let checksumValue = (c: Checksum) => { D.record([("url", D.text(c.url)), ("sha256", D.text(c.sha256))]) };
  let candidateValue = (c: Candidate) => {
    D.record([
      ("version", D.text(c.version)), ("published", D.text(c.published)), ("channel", D.text(c.channel)),
      ("checksums", D.list(c.checksums, checksumValue)), ("ref", D.text(c.ref))
    ])
  };
  D.document("Candidates", protocol, D.list(candidates, candidateValue))
};

-- `make <version>`: the plan pakman builds from.
let encodePlan = (pkg: Package) => {
  D.document("Plan", protocol, D.record([
    ("version", D.text(pkg.version)),
    ("sources", D.list(pkg.sources, sourceValue)),
    ("install", D.list(pkg.install, opValue)),
    ("requires", D.list(pkg.requires, refValue))
  ]))
};

-- ---------------------------------------------------------------------------
-- Decoding

let decodeTarget = (found) => {
  D.tagName(found) :> Result.andThen((name) => {
    match(name) { "Host" => { Ok(Host) }, "Ps2" => { Ok(Ps2) }, _ => { D.problem(found, "Host or Ps2") } }
  })
};

let decodeScope = (found) => {
  D.tagName(found) :> Result.andThen((name) => {
    match(name) { "System" => { Ok(System) }, "User" => { Ok(User) }, _ => { D.problem(found, "System or User") } }
  })
};

let decodeMode = (found) => {
  D.tagName(found) :> Result.andThen((name) => {
    match(name) { "Exec" => { Ok(Exec) }, "Data" => { Ok(Data) }, _ => { D.problem(found, "Exec or Data") } }
  })
};

let decodeSource = (found) => {
  Result|D.field(found, "file"), D.field(found, "url")| :> Result.map((file, url) => { Source(file, url) })
};

-- StorePath is manager-owned; package programs cannot supply it.
let decodeRef = (found) => {
  let body = D.payload(found);
  D.tagName(found) :> Result.andThen((name) => {
    match(name) {
      "Own" => { D.textOf(body) :> Result.map(Own) },
      "Of" => { Result|D.field(body, "package"), D.field(body, "path")| :> Result.map((pkg, path) => { Of(pkg, path) }) },
      "Instance" => {
        Result|D.field(body, "package"), D.field(body, "selector"), D.field(body, "path")|
          :> Result.map((pkg, selector, path) => { Instance(pkg, selector, path) })
      },
      "Base" => { D.textOf(body) :> Result.map(Base) },
      _ => { D.problem(found, "Own, Of, Instance or Base") }
    }
  })
};

let decodePart = (found) => {
  let body = D.payload(found);
  D.tagName(found) :> Result.andThen((name) => {
    match(name) {
      "Lit" => { D.textOf(body) :> Result.map(Lit) },
      "Ref" => { decodeRef(body) :> Result.map(Ref) },
      "Shell" => { decodeRef(body) :> Result.map(ShellRef) },
      _ => { D.problem(found, "Lit, Ref or Shell") }
    }
  })
};

let decodeText = (found) => { D.items(found, decodePart) :> Result.map(Cat) };

let decodeOp = (found) => {
  let body = D.payload(found);
  let text = (key) => { D.field(body, key) };
  let strings = (key) => { D.stringsField(body, key) };
  let mode = () => { decodeMode(D.get(body, "mode")) };
  D.tagName(found) :> Result.andThen((name) => {
    match(name) {
      "Install" => {
        Result|text("source"), text("path"), mode()| :> Result.map((source, dest, m) => { Install(source, dest, m) })
      },
      "Extract" => {
        Result|strings("archive"), strings("members"), text("path"), D.intField(body, "strip")|
          :> Result.map((archive, members, dest, strip) => { Extract(Unpack(archive, members, dest, strip)) })
      },
      "ExtractPayload" => {
        Result|strings("archive"), strings("members"), text("path")|
          :> Result.map((chain, choices, dest) => { ExtractPayload(chain, choices, dest) })
      },
      "Symlink" => {
        Result|decodeRef(D.get(body, "target")), text("path")| :> Result.map((target, path) => { Symlink(target, path) })
      },
      "Write" => {
        Result|text("path"), decodeText(D.get(body, "text")), mode()|
          :> Result.map((dest, contents, m) => { WriteText(dest, contents, m) })
      },
      "MakeDir" => { D.textOf(body) :> Result.map(MakeDir) },
      "Build" => { Result|text("id"), strings("tools")| :> Result.map((id, tools) => { Build(id, tools) }) },
      "BuildCommand" => {
        Result|decodeRef(D.get(body, "program")), strings("arguments"), text("source"), D.intField(body, "strip"),
          text("output"), text("path"), mode()|
          :> Result.map((program, arguments, source, strip, output, dest, m) => {
            BuildCommand(CommandBuild(program, arguments, source, strip, output, dest, m))
          })
      },
      _ => { D.problem(found, "an install step") }
    }
  })
};

-- What `describe` reports.
record Info = {
  name: String,
  description: String,
  homepage: String,
  license: String,
  target: Target,
  scope: Scope,
  channel: String,
  minAgeDays: Number,
  onlyLatest: Bool,
  hosts: List<String>
};

let decodeInfo = (source) => {
  let body = D.opened(D.read(source), "Package", protocol);
  let text = (key) => { D.field(body, key) };
  Result|text("name"), text("description"), text("homepage"), text("license"),
    decodeTarget(D.get(body, "target")), decodeScope(D.get(body, "scope")), text("channel"),
    D.intField(body, "minAgeDays"), D.boolField(body, "onlyLatest"), D.stringsField(body, "hosts")|
    :> Result.map((name, description, homepage, license, target, scope, channel, minAgeDays, onlyLatest, hosts) => {
      Info(name, description, homepage, license, target, scope, channel, minAgeDays, onlyLatest, hosts)
    })
    :> Result.mapErr(D.message)
};

let decodeCandidates = (source) => {
  let checksum = (found) => {
    Result|D.field(found, "url"), D.field(found, "sha256")| :> Result.map((url, sha256) => { Checksum(url, sha256) })
  };
  let candidate = (found) => {
    Result|D.field(found, "version"), D.field(found, "published"), D.field(found, "channel"),
      D.listField(found, "checksums", checksum), D.field(found, "ref")|
      :> Result.map((version, published, channel, checksums, ref) => { Candidate(version, published, channel, checksums, ref) })
  };
  D.items(D.opened(D.read(source), "Candidates", protocol), candidate) :> Result.mapErr(D.message)
};

let decodePlan = (source) => {
  let body = D.opened(D.read(source), "Plan", protocol);
  Result|D.field(body, "version"), D.listField(body, "sources", decodeSource),
    D.listField(body, "install", decodeOp), D.listField(body, "requires", decodeRef)|
    :> Result.map((version, sources, install, requires) => { Package(version, sources, install, requires) })
    :> Result.mapErr(D.message)
};
