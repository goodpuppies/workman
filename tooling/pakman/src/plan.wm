-- The protocol between package programs and pakman.
--
-- A package program prints one JSON document per command. Encoders run in the
-- package process, decoders in pakman; keeping both here means the two sides
-- can't drift apart. Every document carries `protocol` so a stale compiled
-- package is detected instead of misread.

from "./model.wm" import *;
from "./io.wm" import { jsonList };
from "./refs.wm" import { parts };
from "./fun.wm" import { mapAll };

let protocol = 10;

let targetName = match(target) => {
  Host => { "host" },
  Ps2 => { "ps2" }
};

let scopeName = match(scope) => {
  System => { "system" },
  User => { "user" }
};

let decodeScope = (name) => {
  match(name) {
    "system" => { Ok(System) },
    "user" => { Ok(User) },
    _ => { Err("unknown scope " ++ name) }
  }
};

let modeName = match(mode) => {
  Exec => { "exec" },
  Data => { "data" }
};

-- `describe`: everything pakman needs to know without running any package code.
let encodeInfo = (def: Definition) => {
  JSON{
    protocol: protocol,
    name: def.name,
    description: def.description,
    homepage: def.homepage,
    license: def.license,
    target: targetName(def.target),
    scope: scopeName(def.scope),
    channel: def.policy.channel,
    minAgeDays: def.policy.minAgeDays,
    onlyLatest: def.policy.onlyLatest,
    hosts: Js.Array.fromList(def.hosts)
  }
};

-- `versions`: candidates newest first, already filtered by the package's own
-- `accept` rule. pakman applies the minimum age itself, so no package can skip it.
let encodeCandidates = (candidates: List<Candidate>) => {
  let checksumJson = (c: Checksum) => { JSON{ url: c.url, sha256: c.sha256 } };
  let candidateJson = (c: Candidate) => {
    JSON{ version: c.version, published: c.published, channel: c.channel, checksums: jsonList(c.checksums, checksumJson), ref: c.ref }
  };
  JSON{ protocol: protocol, candidates: jsonList(candidates, candidateJson) }
};

-- References and text travel as a flat list of parts, one uniform shape:
--   { kind: "lit" | "own" | "of" | "base", value, pkg }
let refJson = match(ref) => {
  Own(path) => { JSON{ kind: "own", value: path, pkg: "" } },
  Of(name, path) => { JSON{ kind: "of", value: path, pkg: name } },
  Instance(name, selector, path) => { JSON{ kind: "instance", value: path, pkg: name ++ "@" ++ selector } },
  StorePath(store, path) => { JSON{ kind: "store", value: path, pkg: store } },
  Base(path) => { JSON{ kind: "base", value: path, pkg: "" } }
};

let partJson = match(part) => {
  Lit(text) => { JSON{ kind: "lit", value: text, pkg: "" } },
  Ref(path) => { refJson(path) },
  ShellRef(path) => {
    match(path) {
      Own(value) => { JSON{ kind: "shell-own", value: value, pkg: "" } },
      Of(name, value) => { JSON{ kind: "shell-of", value: value, pkg: name } },
      Instance(name, selector, value) => { JSON{ kind: "shell-instance", value: value, pkg: name ++ "@" ++ selector } },
      StorePath(store, value) => { JSON{ kind: "shell-store", value: value, pkg: store } },
      Base(value) => { JSON{ kind: "shell-base", value: value, pkg: "" } }
    }
  },
  _ => { JSON{ kind: "lit", value: "", pkg: "" } }
};

let textJson = (text) => { jsonList(parts(text), partJson) };

-- Install steps share one flat shape so the decoder can check them with a single record.
let opJson = match(op) => {
  Install(file, dest, mode) => {
    JSON{ op: "install", path: dest, source: file, mode: modeName(mode), strip: 0, archive: JSON[], members: JSON[], parts: JSON[] }
  },
  Extract(unpack) => {
    JSON{
      op: "extract", path: unpack.dest, source: "", mode: "", strip: unpack.strip,
      archive: Js.Array.fromList(unpack.archive), members: Js.Array.fromList(unpack.members), parts: JSON[]
    }
  },
  ExtractPayload(chain, choices, dest) => {
    JSON{ op: "extract-payload", path: dest, source: "", mode: "", strip: 0,
      archive: Js.Array.fromList(chain), members: Js.Array.fromList(choices), parts: JSON[] }
  },
  Symlink(target, path) => {
    JSON{ op: "symlink", path: path, source: "", mode: "", strip: 0, archive: JSON[], members: JSON[], parts: jsonList([target], refJson) }
  },
  WriteText(dest, contents, mode) => {
    JSON{ op: "write", path: dest, source: "", mode: modeName(mode), strip: 0, archive: JSON[], members: JSON[], parts: textJson(contents) }
  },
  BuildCommand(build) => {
    JSON{ op: "build-command", path: build.dest, source: build.source, mode: modeName(build.mode), strip: build.strip,
      archive: Js.Array.fromList([build.output]), members: Js.Array.fromList(build.arguments), parts: jsonList([build.program], refJson) }
  },
  Build(id, tools) => {
    JSON{ op: "build", path: "", source: id, mode: "", strip: 0, archive: Js.Array.fromList(tools), members: JSON[], parts: JSON[] }
  },
  MakeDir(path) => {
    JSON{ op: "mkdir", path: path, source: "", mode: "", strip: 0, archive: JSON[], members: JSON[], parts: JSON[] }
  }
};

-- `make <version>`: the plan pakman builds from.
let encodePlan = (pkg: Package) => {
  let sourceJson = (s: Source) => { JSON{ file: s.file, url: s.url } };
  JSON{
    protocol: protocol,
    version: pkg.version,
    sources: jsonList(pkg.sources, sourceJson),
    install: jsonList(pkg.install, opJson),
    requires: jsonList(pkg.requires, refJson)
  }
};

-- Decoded shapes. Json.assert's target is fixed where it is called, so the
-- asserts live in packages.wm next to each command.

record InfoJson = {
  protocol: Number,
  name: String,
  description: String,
  homepage: String,
  license: String,
  target: String,
  scope: String,
  channel: String,
  minAgeDays: Number,
  onlyLatest: Bool,
  hosts: Js.Array<String>
};

record CandidateJson = { version: String, published: String, channel: String, checksums: Js.Array<Checksum>, ref: String };
record CandidatesJson = { protocol: Number, candidates: Js.Array<CandidateJson> };

let decodeCandidate = (c: CandidateJson) => {
  Candidate(c.version, c.published, c.channel, Js.Array.toList(c.checksums), c.ref)
};

record PartJson = { kind: String, value: String, pkg: String };

record OpJson = {
  op: String, path: String, source: String, mode: String, strip: Number,
  archive: Js.Array<String>, members: Js.Array<String>, parts: Js.Array<PartJson>
};

record PlanJson = {
  protocol: Number,
  version: String,
  sources: Js.Array<Source>,
  install: Js.Array<OpJson>,
  requires: Js.Array<PartJson>
};

let decodeTarget = (name) => {
  match(name) {
    "host" => { Ok(Host) },
    "ps2" => { Ok(Ps2) },
    _ => { Err("unknown target " ++ name) }
  }
};

let decodeMode = (name) => {
  match(name) {
    "exec" => { Ok(Exec) },
    "data" => { Ok(Data) },
    _ => { Err("unknown file mode " ++ name) }
  }
};

let decodeRef = (p: PartJson) => {
  match(p.kind) {
    "own" => { Ok(Own(p.value)) },
    "of" => { Ok(Of(p.pkg, p.value)) },
    "instance" => {
      let at = p.pkg :> .lastIndexOf("@") :> Result.getOr(0 - 1);
      if (at <= 0) { Err("invalid package instance request " ++ p.pkg) } else {
        let name = p.pkg :> .slice(0, at) :> Result.getOr("");
        let selector = p.pkg :> .slice(at + 1) :> Result.getOr("");
        Ok(Instance(name, selector, p.value))
      }
    },
    -- StorePath is manager-owned; package programs cannot supply it.
    "base" => { Ok(Base(p.value)) },
    _ => { Err("expected a file reference, got " ++ p.kind) }
  }
};

let decodePart = (p: PartJson) => {
  if (p.kind :> .startsWith("shell-") :> Result.getOr(false)) {
    let kind = p.kind :> .slice(6) :> Result.getOr("");
    decodeRef(.{ ..p, kind }) :> Result.map(ShellRef)
  } else { match(p.kind) {
    "lit" => { Ok(Lit(p.value)) },
    _ => { decodeRef(p) :> Result.map(Ref) }
  } }
};

let decodeText = (items) => {
  items :> Js.Array.toList :> mapAll(decodePart) :> Result.collectList :> Result.map(Cat)
};

let decodeSymlinkTarget = (items) => {
  match(Js.Array.toList(items)) {
    [only] => { decodeRef(only) },
    _ => { Err("a symlink needs exactly one target") }
  }
};

let decodeOp = (o: OpJson) => {
  match(o.op) {
    "install" => { decodeMode(o.mode) :> Result.map((mode) => { Install(o.source, o.path, mode) }) },
    "extract" => { Ok(Extract(Unpack(Js.Array.toList(o.archive), Js.Array.toList(o.members), o.path, o.strip))) },
    "extract-payload" => { Ok(ExtractPayload(Js.Array.toList(o.archive), Js.Array.toList(o.members), o.path)) },
    "symlink" => { decodeSymlinkTarget(o.parts) :> Result.map((target) => { Symlink(target, o.path) }) },
    "write" => {
      Result|decodeText(o.parts), decodeMode(o.mode)|
        :> Result.map((contents, mode) => { WriteText(o.path, contents, mode) })
    },
    "mkdir" => { Ok(MakeDir(o.path)) },
    "build" => { Ok(Build(o.source, Js.Array.toList(o.archive))) },
    "build-command" => {
      match(Js.Array.toList(o.archive), Js.Array.toList(o.parts)) {
        ([output], [program]) => {
          Result|decodeRef(program), decodeMode(o.mode)| :> Result.map((ref, mode) => {
            BuildCommand(CommandBuild(ref, Js.Array.toList(o.members), o.source, o.strip, output, o.path, mode))
          })
        },
        _ => { Err("a command build needs exactly one output and program reference") }
      }
    },
    _ => { Err("unknown install step " ++ o.op) }
  }
};

let decodePlan = (plan: PlanJson) => {
  let install = plan.install :> Js.Array.toList :> mapAll(decodeOp) :> Result.collectList;
  let requires = plan.requires :> Js.Array.toList :> mapAll(decodeRef) :> Result.collectList;
  Result|install, requires|
    :> Result.map((ops, refs) => { Package(plan.version, Js.Array.toList(plan.sources), ops, refs) })
};
