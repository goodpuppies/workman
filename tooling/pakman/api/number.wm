-- Pakman's legacy unsigned Number boundary; the shared parser works in I32.
from "basis/int32.wm" import * as SubsetInt32;
from "basis/text.wm" import * as UnicodeText;
from "basis/result.wm" import * as R;

-- ECMAScript whitespace, including BOM, preserving the previous config policy.
let isSpace = (c: Int32.Int) => {
  (c >= (9: Int32.Int) && c <= (13: Int32.Int)) || c == (32: Int32.Int) || c == (160: Int32.Int)
    || c == (5760: Int32.Int) || (c >= (8192: Int32.Int) && c <= (8202: Int32.Int))
    || c == (8232: Int32.Int) || c == (8233: Int32.Int) || c == (8239: Int32.Int)
    || c == (8287: Int32.Int) || c == (12288: Int32.Int) || c == (65279: Int32.Int)
};

-- Full input, digits only after trimming. Overflow returns the caller's fallback.
let parseIntOr = (text: String, fallback: Real64.Real) => {
  match(UnicodeText.trim(text, isSpace)) {
    Err(_) => { fallback },
    Ok(trimmed) => { R.getOr(R.map(SubsetInt32.parseNatural(trimmed), Int32.toReal64), fallback) }
  }
};
