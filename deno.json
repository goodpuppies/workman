{
  "nodeModulesDir": "manual",
  "minimumDependencyAge": 0,
  "name": "@goodpuppies/workman",
  "version": "0.9.1",
  "license": "MIT",
  "exports": {
    ".": "./src/cli.ts"
  },
  "publish": {
    "include": [
      "README.md",
      "LICENSE",
      "deno.json",
      "package.json",
      "src/",
      "std/",
      "subml-basis/",
      "host/",
      "tooling/pakman/pakman.wm",
      "tooling/pakman/api/",
      "tooling/pakman/src/",
      "tooling/testman/runner.wm",
      "tooling/testman/test.wm",
      "tooling/tuiman/document.ts",
      "tooling/wmslang/*.wm"
    ],
    "exclude": [
      "subml-basis/translator/",
      "src/generated/deno_types.d.ts.txt"
    ]
  },
  "tasks": {
    "release:stage": "deno run -A scripts/release.ts",
    "generate-assets": "deno run --allow-read --allow-write --allow-run scripts/generate_assets.ts",
    "byte-type:build": "deno run -A scripts/build_byte_type.ts",
    "c-header:build": "deno run -A scripts/build_c_header_extractor.ts",
    "c-header:check": "deno run --allow-read scripts/check_c_header_extractor.ts",
    "generate": "deno run -A scripts/generate.ts",
    "src-wm:build": "deno run -A scripts/build_src_wm.ts",
    "check": "deno run -A node_modules/typescript/bin/tsc -p . --runExternalCode",
    "test": "deno test --parallel --allow-read --allow-write --allow-run --allow-env --allow-sys=homedir --allow-ffi --allow-net=127.0.0.1,github.com,release-assets.githubusercontent.com tests",
    "test:known-issues": "WM_KNOWN_ISSUES=1 deno test --allow-read --allow-write --allow-run --allow-env --allow-sys=homedir --allow-ffi --allow-net=127.0.0.1,github.com,release-assets.githubusercontent.com --filter \"known issue\" tests",
    "publish": "deno task generate && deno task publish:vscode",
    "publish:vscode": "npm --prefix editors/vscode ci --include=dev && npm --prefix editors/vscode run package",
    "install": "deno run --allow-read --allow-write --allow-env scripts/install.ts",
    "compile": "deno run -A src/main.ts",
    "frontend-v2:build": "deno run -A scripts/build_frontend_v2.ts",
    "frontend-v2:build-library": "deno run -A src/main.ts compile-library tooling/frontend-v2/compiler_frontend.wm tooling/frontend-v2/frontend-v2.generated.mjs",
    "frontend-v2:grammar-report": "deno run --allow-read --allow-env scripts/frontend_v2_generation_report.ts src/grammar.peggy",
    "frontend-v2:generate-recognizer": "deno run --allow-read --allow-write scripts/generate_frontend_v2_recognizer.ts src/grammar.peggy tooling/frontend-v2/generated",
    "frontend-v2:update-semantic-golden": "deno run --allow-read --allow-write --allow-run=git scripts/update_frontend_v2_semantic_golden.ts",
    "frontend-v2:format": "deno run --allow-read --allow-write --allow-env scripts/frontend_v2_format.ts",
    "wmslang:builtins": "deno run -A scripts/generate_wmslang_builtin_catalog.ts",
    "wmslang:builtins:check": "deno run -A scripts/generate_wmslang_builtin_catalog.ts --check",
    "wmslang:build": "deno run -A src/main.ts compile-library tooling/wmslang/compiler.wm tooling/wmslang/wmslang.generated.mjs",
    "profile:webhook": "deno run -A scripts/profile_typecheck.ts examples/webhook.wm",
    "profile:webhook:cpu": "deno run -A --cpu-prof --cpu-prof-flamegraph --cpu-prof-md --cpu-prof-dir=profiles --cpu-prof-name=webhook-typecheck.cpuprofile scripts/profile_typecheck.ts examples/webhook.wm",
    "profile:frontend-v2": "deno run -A scripts/profile_frontend_v2.ts surface 1",
    "profile:frontend-v2:cpu": "deno run -A --cpu-prof --cpu-prof-flamegraph --cpu-prof-md --cpu-prof-dir=profiles --cpu-prof-name=frontend-v2.cpuprofile scripts/profile_frontend_v2.ts surface 1",
    "profile:lsp-typing": "deno run -A scripts/profile_lsp_typing.ts",
    "profile:lsp-typing:cpu": "deno run -A scripts/profile_lsp_typing.ts --cpu-profile",
    "wm": "deno run -A src/main.ts",
    "release:version": "deno run --allow-read --allow-write scripts/release_version.ts"
  },
  "imports": {
    "#problems-client": "./src/problems_client.ts",
    "byte_type": "./src/vendor/byte_type/mod.ts",
    "./src/module_scope.wm": "./src/generated/wm/src/module_scope.wm.js",
    "./src/name_suggestion.wm": "./src/generated/wm/src/name_suggestion.wm.js",
    "./tooling/problems/app.wm": "./src/generated/wm/tooling/problems/app.wm.js",
    "./tooling/tuiman/diagnostic.wm": "./src/generated/wm/tooling/tuiman/diagnostic.wm.js"
  },
  "fmt": {
    "lineWidth": 100
  },
  "compilerOptions": {
    "lib": [
      "deno.window"
    ]
  }
}
