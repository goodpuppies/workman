-- A repository-native recipe provides the source snapshot containing itself.
-- The manager replaces these markers with its recorded revision/date/archive.
from "../std/task.wm" import * as Task;
from "./model.wm" import { Candidate, Source };

let versions = () => { Task.succeed([Candidate("self", "", "source", [], "pak:self")]) };
let source = (name) => { Source(name, "pak:self") };
-- Files next to a recipe, e.g. a small runtime adapter maintained with the pak.
let resource = (name, path) => { Source(name, "pak:recipe/" ++ path) };
