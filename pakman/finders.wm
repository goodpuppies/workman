-- Upstream version finders.

from "std/json.wm" import * as Document;
from "basis/text.wm" import * as UnicodeText;
from "./text.wm" import { scalarText };
from "../std/list.wm" import * as List;
from "../std/monad.wm" import * as Monad;
from "../std/option.wm" import * as Option;
from "../std/result.wm" import * as Result;
from "../std/task.wm" import * as Task;
from js.global("JSON") import { parse } as JSON;
from "./io.wm" import { fetchText, headInfo, series };
from "./model.wm" import { Checksum, Candidate };
from js.module("./js/recipe.ts") import unsafe {
  jsonTextOr as jsonTextRaw: (Js.Value, String) -> String,
  jsonKeys as jsonKeysRaw: Js.Value -> Js.Array<String>,
  captures as capturesRaw: (String, String) -> Js.Array<String>,
  capturesAll as capturesAllRaw: (String, String) -> Js.Array<Js.Array<String>>,
  jsonHasField: (Js.Value, String) -> Bool,
  jsonField as jsonFieldRaw: (Js.Value, String) -> Js.Value
};
from "./fun.wm" import { mapAll, filterAll };

-- The full match of `pattern` in `text` followed by its capture groups, or [] when it does not match.
let captures = (pattern, text) => { Js.Array.toList(capturesRaw(pattern, text)) };

-- Every match of `pattern` in `text`, each as its full match followed by its capture groups.
let capturesAll = (pattern, text) => { capturesAllRaw(pattern, text) :> Js.Array.toList :> mapAll(Js.Array.toList) };

-- Dynamic JSON, for documents a WM record can't describe (object keys that are data,
-- such as version numbers, or names like "x86_64-linux").
let jsonKeys = (value: Js.Value) => { Js.Array.toList(jsonKeysRaw(value)) };
let jsonField = (value: Js.Value, key) => {
  if (jsonHasField(value, key)) { Ok(jsonFieldRaw(value, key)) } else { Err("JSON: missing field " ++ key) }
};
let jsonTextOr = (value: Js.Value, fallback) => { jsonTextRaw(value, fallback) };

record ReleaseAsset = { name: String, url: String, sha256: String };
record Release = { tag: String, prerelease: Bool, published: String, assets: List<ReleaseAsset> };

let via = Monad.via;

-- Legacy JS-value entry point for recipes using Json.assert. New source decoders
-- use fetchDocument and the checked std/json.wm accessors below.
let fetchJson = (url) => {
  let parse = via Task (text) => {
    JSON.parse(text) :> Result.mapErr((_) => { "invalid JSON from " ++ url }) :> Task.fromResult
  };
  fetchText(url) :> parse
};

let fetchDocument = (url) => {
  fetchText(url) :> Task.andThen((text) => {
    Document.read(text)
      :> Result.mapErr((problem) => { url ++ ": " ++ Document.problemText(problem) })
      :> Task.fromResult
  })
};

let textField = (found, key) => { Document.get(found, key) :> Document.text };
let boolField = (found, key) => { Document.get(found, key) :> Document.boolean };

let decodeAsset = (found) => {
  Result.andThen(textField(found, "name"), (name) => {
    Result.map(textField(found, "browser_download_url"), (url) => {
      let digest = textField(found, "digest") :> Result.getOr("");
      let sha256 = if (UnicodeText.isPrefix(digest, "sha256:") :> Result.getOr(false)) {
        UnicodeText.extract(digest, (7: I32), None) :> Result.getOr("")
      } else { "" };
      ReleaseAsset(name, url, sha256)
    })
  })
};

record PublishedRelease = { release: Release, draft: Bool };
let decodeRelease = (found) => {
  Result.andThen(textField(found, "tag_name"), (tag) => {
    Result.andThen(textField(found, "published_at"), (published) => {
      Result.andThen(boolField(found, "prerelease"), (prerelease) => {
        Result.andThen(boolField(found, "draft"), (draft) => {
          Result.map(Document.items(Document.get(found, "assets"), decodeAsset), (assets) => {
            PublishedRelease(Release(tag, prerelease, published, assets), draft)
          })
        })
      })
    })
  })
};
let decodeReleases = (found) => {
  Document.items(found, decodeRelease) :> Result.map((releases) => {
    releases :> filterAll((r: PublishedRelease) => { !r.draft }) :> mapAll((r: PublishedRelease) => { r.release })
  })
};

let githubReleases = (repo) => {
  let url = "https://api.github.com/repos/" ++ repo ++ "/releases?per_page=50";
  fetchDocument(url) :> Task.andThen((document) => {
    decodeReleases(Ok(document)) :> Result.mapErr(Document.problemText) :> Task.fromResult
  })
};

record GithubTag = { name: String, sha: String };
let decodeGithubTag = (found) => {
  Result.andThen(textField(found, "name"), (name) => {
    textField(Document.get(found, "commit"), "sha") :> Result.map((sha) => { GithubTag(name, sha) })
  })
};
let githubTagCandidates = (repo, versionOf) => {
  let url = "https://api.github.com/repos/" ++ repo;
  fetchDocument(url ++ "/tags?per_page=100") :> Task.andThen((document) => {
    Document.items(Ok(document), decodeGithubTag) :> Result.mapErr(Document.problemText) :> Task.fromResult
  }) :> Task.andThen((items) => {
    let selected = items :> List.mapPartial((tag: GithubTag) => {
      versionOf(tag.name) :> Option.map((version) => { (version, tag.sha) })
    });
    series(selected, (version, sha) => {
      fetchDocument(url ++ "/commits/" ++ sha) :> Task.andThen((document) => {
        textField(Document.get(Document.get(Ok(document), "commit"), "committer"), "date")
          :> Result.mapErr(Document.problemText) :> Task.fromResult
      }) :> Task.map((date) => { Candidate(version, date, "stable", [], sha) })
    })
  })
};

let hasAsset = (release: Release, name) => {
  List.any(release.assets, (asset: ReleaseAsset) => { asset.name == name })
};
let releaseChecksums = (release: Release) => {
  release.assets :> filterAll((asset: ReleaseAsset) => { asset.sha256 != "" })
    :> mapAll((asset: ReleaseAsset) => { Checksum(asset.url, asset.sha256) })
};

-- Extract the first capture, or the whole match if the pattern has no group.
-- This is a string operation, independent of a release provider.
let matchText = (pattern) => (text) => {
  match(captures(pattern, text)) {
    [_, captured, .._] => { Some(captured) },
    [whole] => { Some(whole) },
    _ => { None }
  }
};

record ReleaseOptions = {
  versionOf: String -> Option<String>,
  accept: Release -> Bool,
  assets: String -> List<String>,
  channel: String,
  -- What `make` gets back for this release; None drops the release.
  ref: (Release, String) -> Option<String>
};

-- Common release rules, independent of where the releases were fetched.
-- Override fields with record spread; no network access happens here.
let stableReleases: ReleaseOptions = .{
  versionOf = matchText "^v(\\d+\\.\\d+\\.\\d+)$",
  accept = (release: Release) => { !release.prerelease },
  assets = (_) => { [] },
  channel = "stable",
  ref = (_, _) => { Some("") }
};

let releaseCandidates = (options: ReleaseOptions) => {
  let candidate = (release: Release) => {
    options.versionOf(release.tag)
      :> Option.andThen((version) => {
        let missingAsset = List.any(options.assets(version), (name) => { !hasAsset(release, name) });
        if (options.accept(release) && !missingAsset) {
          options.ref(release, version)
            :> Option.map((ref) => { Candidate(version, release.published, options.channel, releaseChecksums(release), ref) })
        } else { None }
      })
  };
  (releases: List<Release>) => { releases :> List.mapPartial(candidate) }
};

-- Where `url` finally redirects to, and its Last-Modified date ("" if unknown):
-- for downloads whose version only shows in the redirect target.
let redirectTarget = (url) => {
  let pair = (parts) => {
    match(parts) {
      [final, modified] => { Ok((final, modified)) },
      _ => { Err("HEAD " ++ url ++ ": unexpected response") }
    }
  };
  headInfo(url)
    :> Task.andThen((parts) => { pair(parts) :> Task.fromResult })
};

record Tag = { name: String, published: String };
let decodeGitlabTag = (found) => {
  Result.andThen(textField(found, "name"), (name) => {
    textField(Document.get(found, "commit"), "committed_date") :> Result.map((date) => { Tag(name, date) })
  })
};

-- Encode the slash-separated project identity in a GitLab API path.
let projectPath = (project: String) => {
  match(UnicodeText.translate(project, (scalar) => {
    if (scalar == (47: I32)) { "%2F" } else { scalarText(scalar) }
  })) {
    Ok(path) => { path },
    Err(_) => { Panic("invalid Unicode project path") }
  }
};

-- Tags of a GitLab project (`group/name` on `host`), newest first, dated by
-- their commit.
let gitlabTags = (host, project) => {
  let url = "https://" ++ host ++ "/api/v4/projects/" ++ projectPath(project)
    ++ "/repository/tags?per_page=50";
  fetchDocument(url) :> Task.andThen((document) => {
    Document.items(Ok(document), decodeGitlabTag) :> Result.mapErr(Document.problemText) :> Task.fromResult
  })
};
