{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "workman",
  "scopeName": "source.workman",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#imports" },
    { "include": "#declarations" },
    { "include": "#bindings" },
    { "include": "#json" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#functions" },
    { "include": "#fields" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.workman",
          "match": "--.*$"
        },
        {
          "name": "comment.line.double-slash.workman",
          "match": "//.*$"
        },
        {
          "name": "comment.block.workman",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            { "include": "#block-comment" }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.workman",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#scalar-escapes" },
            {
              "name": "invalid.illegal.escape.workman",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.other.backtick.workman",
          "begin": "`",
          "end": "`",
          "patterns": [
            { "include": "#scalar-escapes" },
            {
              "name": "constant.character.escape.workman",
              "match": "\\\\[`$]"
            },
            {
              "name": "invalid.illegal.escape.workman",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "begin": "(?<![A-Za-z0-9_'])(from)(?![A-Za-z0-9_'])",
          "beginCaptures": {
            "1": { "name": "keyword.control.import.from.workman" }
          },
          "end": "(?=;)|$",
          "name": "meta.import.workman",
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            {
              "name": "keyword.control.import.workman",
              "match": "(?<![A-Za-z0-9_'])(import|as)(?![A-Za-z0-9_'])"
            },
            {
              "name": "storage.modifier.import.workman",
              "match": "(?<![A-Za-z0-9_'])(type|unsafe)(?![A-Za-z0-9_'])"
            },
            {
              "name": "support.module.js-target.workman",
              "match": "(?<![A-Za-z0-9_'])js\\.(?:global|module)(?![A-Za-z0-9_'])"
            },
            {
              "name": "variable.other.import.member.workman",
              "match": "(?<![A-Za-z0-9_'])[a-zA-Z_][A-Za-z0-9_']*(?![A-Za-z0-9_'])"
            },
            { "include": "#types" },
            { "include": "#operators" },
            { "include": "#punctuation" }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "begin": "(?<![A-Za-z0-9_'])(type)\\s+([A-Z][A-Za-z0-9_']*)(?![A-Za-z0-9_'])",
          "beginCaptures": {
            "1": { "name": "storage.type.type.workman" },
            "2": { "name": "entity.name.type.alias.workman" }
          },
          "end": "(?=;)|$",
          "name": "meta.type.declaration.workman",
          "patterns": [
            { "include": "#typeparameters" },
            {
              "match": "(=)|(\\|)",
              "captures": {
                "1": { "name": "keyword.operator.assignment.workman" },
                "2": { "name": "keyword.operator.type.constructor.workman" }
              }
            },
            { "include": "#types" },
            { "include": "#comments" },
            { "include": "#punctuation" }
          ]
        },
        {
          "begin": "(?<![A-Za-z0-9_'])(record)\\s+([A-Z][A-Za-z0-9_']*)(?![A-Za-z0-9_'])",
          "beginCaptures": {
            "1": { "name": "storage.type.type.workman" },
            "2": { "name": "entity.name.type.workman" }
          },
          "end": "(?=;)|$",
          "name": "meta.record.declaration.workman",
          "patterns": [
            { "include": "#typeparameters" },
            { "include": "#types" },
            { "include": "#comments" },
            { "include": "#operators" },
            { "include": "#punctuation" }
          ]
        }
      ]
    },
    "bindings": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_'])(let)\\s+(?:(rec)\\s+)?(?:([a-z_][A-Za-z0-9_']*)|([A-Z][A-Za-z0-9_']*)|(_))(?![A-Za-z0-9_'])",
          "captures": {
            "1": { "name": "storage.type.workman" },
            "2": { "name": "storage.modifier.recursive.workman" },
            "3": { "name": "variable.other.constant.workman" },
            "4": { "name": "entity.name.type.constructor.workman" },
            "5": { "name": "variable.language.wildcard.workman" }
          }
        },
        {
          "name": "storage.modifier.binding.workman",
          "match": "(?<![A-Za-z0-9_'])and(?![A-Za-z0-9_'])"
        }
      ]
    },
    "json": {
      "patterns": [
        {
          "name": "support.type.json.workman",
          "match": "(?<![A-Za-z0-9_'])JSON(?![A-Za-z0-9_'])(?=\\s*[\\{\\[])"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.workman",
          "match": "(?<![A-Za-z0-9_'])(if|else|match)(?![A-Za-z0-9_'])"
        },
        {
          "name": "storage.type.workman",
          "match": "(?<![A-Za-z0-9_'])(let|type|record)(?![A-Za-z0-9_'])"
        },
        {
          "name": "storage.modifier.workman",
          "match": "(?<![A-Za-z0-9_'])(rec|and|unsafe)(?![A-Za-z0-9_'])"
        },
        {
          "name": "keyword.control.import.workman",
          "match": "(?<![A-Za-z0-9_'])(from|import|as)(?![A-Za-z0-9_'])"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.panic.workman",
          "match": "(?<![A-Za-z0-9_'])Panic(?![A-Za-z0-9_'])(?=\\s*\\()"
        },
        {
          "name": "support.function.pattern-var.workman",
          "match": "(?<![A-Za-z0-9_'])Var(?![A-Za-z0-9_'])(?=\\s*\\()"
        },
        {
          "name": "support.type.json.workman",
          "match": "(?<![A-Za-z0-9_'])JSON(?![A-Za-z0-9_'])"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.workman",
          "match": "(?<![A-Za-z0-9_'])[a-z_][A-Za-z0-9_']*(?![A-Za-z0-9_'])(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.constructor.workman",
          "match": "(?<![A-Za-z0-9_'])[A-Z][A-Za-z0-9_']*(?![A-Za-z0-9_'])(?=\\s*\\()"
        }
      ]
    },
    "fields": {
      "patterns": [
        {
          "name": "variable.object.property.workman",
          "match": "(?<=\\.)(?<![A-Za-z0-9_'])[a-zA-Z_][A-Za-z0-9_']*(?![A-Za-z0-9_'])"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.workman",
          "match": "(?<![A-Za-z0-9_'])(Number|Int|Char|String|Bool|Void|Float)(?![A-Za-z0-9_'])"
        },
        {
          "name": "support.type.js.workman",
          "match": "(?<![A-Za-z0-9_'])Js\\.[A-Z][A-Za-z0-9_']*(?![A-Za-z0-9_'])"
        },
        {
          "name": "entity.name.type.workman",
          "match": "(?<![A-Za-z0-9_'])[A-Z][A-Za-z0-9_']*(?![A-Za-z0-9_'])"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.workman",
          "match": "(?<![A-Za-z0-9_'])(true|false)(?![A-Za-z0-9_'])"
        },
        {
          "name": "constant.language.void.workman",
          "match": "(?<![A-Za-z0-9_'])void(?![A-Za-z0-9_'])"
        },
        {
          "name": "constant.numeric.float.workman",
          "match": "(?<![A-Za-z0-9_'])-?[0-9]+(?:\\.[0-9]+(?:[eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)(?![A-Za-z0-9_'])"
        },
        {
          "name": "constant.numeric.integer.workman",
          "match": "(?<![A-Za-z0-9_'])-?(?:0x[0-9a-fA-F]+|[0-9]+)(?![A-Za-z0-9_'])"
        },
        {
          "name": "variable.language.wildcard.workman",
          "match": "(?<![A-Za-z0-9_'])_(?![A-Za-z0-9_'])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.workman",
          "match": "=>"
        },
        {
          "name": "keyword.operator.pipe.workman",
          "match": ":>"
        },
        {
          "name": "keyword.operator.spread.workman",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.workman",
          "match": "<=|>=|==|!="
        },
        {
          "name": "keyword.operator.logical.workman",
          "match": "&&|\\|\\|"
        },
        {
          "name": "keyword.operator.assignment.workman",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.workman",
          "match": "\\+\\+|\\+|-|[*/]|%"
        },
        {
          "name": "keyword.operator.comparison.workman",
          "match": "<|>"
        },
        {
          "name": "keyword.operator.misc.workman",
          "match": "!|:|\\|"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.workman",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.workman",
          "match": ","
        },
        {
          "name": "punctuation.definition.block.workman",
          "match": "[{}]"
        },
        {
          "name": "punctuation.definition.group.workman",
          "match": "[()]"
        },
        {
          "name": "punctuation.definition.list.workman",
          "match": "[\\[\\]]"
        }
      ]
    },
    "typeparameters": {
      "patterns": [
        {
          "begin": "<",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.typeparameters.begin.workman" }
          },
          "end": ">",
          "endCaptures": {
            "0": { "name": "punctuation.definition.typeparameters.end.workman" }
          },
          "name": "meta.type.parameters.workman",
          "patterns": [
            { "include": "#types" },
            { "include": "#comments" },
            { "include": "#punctuation" }
          ]
        }
      ]
    },
    "block-comment": {
      "name": "comment.block.workman",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [
        { "include": "#block-comment" }
      ]
    },
    "string-gap": {
      "name": "constant.character.escape.workman",
      "begin": "\\\\(?=[ \\t\\r\\n\\v\\f])",
      "end": "\\\\",
      "patterns": [
        {
          "name": "invalid.illegal.string-gap.workman",
          "match": "[^ \\t\\r\\n\\v\\f]"
        }
      ]
    },
    "scalar-escapes": {
      "patterns": [
        { "include": "#string-gap" },
        {
          "name": "constant.character.escape.workman",
          "match": "\\\\(?:[abtnvfr\"'\\\\]|\\^[@-_]|[0-9]{3}|u(?![dD][89a-fA-F])[0-9a-fA-F]{4}|u\\{(?!0*[dD][89a-fA-F][0-9a-fA-F]{2}\\})(?:0[0-9a-fA-F]{5}|10[0-9a-fA-F]{4}|[0-9a-fA-F]{1,5})\\})"
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "constant.character.workman",
          "begin": "(?<![A-Za-z0-9_'])'",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.character.begin.workman" }
          },
          "end": "'|(?=$)",
          "endCaptures": {
            "0": { "name": "punctuation.definition.character.end.workman" }
          },
          "patterns": [
            { "include": "#scalar-escapes" },
            {
              "name": "invalid.illegal.escape.workman",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.workman",
          "match": "(?<![A-Za-z0-9_'])[a-z_][A-Za-z0-9_']*(?![A-Za-z0-9_'])"
        }
      ]
    }
  }
}
