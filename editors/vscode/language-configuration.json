{
  "comments": {
    "lineComment": ["--", "//"],
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["<", ">"],
    ["\"", "\""],
    ["`", "`"]
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["<", ">"],
    ["\"", "\""],
    ["`", "`"],
    ["'", "'"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(--|//)\\s*region\\b",
      "end": "^\\s*(--|//)\\s*endregion\\b"
    }
  },
  "wordPattern": "-?(?:0x[0-9a-fA-F]+|[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)|[A-Za-z_][A-Za-z0-9_']*"
}
