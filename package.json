{
  "name": "@goodpuppies/workman",
  "version": "0.9.2",
  "private": true,
  "type": "module",
  "description": "Workman language tools and experimental TypeScript content mapper",
  "license": "MIT",
  "typescript": {
    "contentMapper": {
      "exec": [
        "deno",
        "run",
        "-A",
        "--config",
        "./deno.json",
        "./src/content_mapper/server.ts"
      ],
      "compilerOptions": [],
      "dynamicConfig": true
    }
  },
  "exports": {
    "./vite": {
      "types": "./src/integrations/vite.d.mts",
      "import": "./src/integrations/vite.mjs"
    },
    "./interop": {
      "types": "./src/integrations/interop.d.mts",
      "import": "./src/integrations/interop.mjs"
    },
    "./bun": {
      "types": "./src/integrations/bun.d.mts",
      "import": "./src/integrations/bun.mjs"
    }
  },
  "scripts": {
    "release:smoke": "node scripts/release_smoke.mjs",
    "release:pack": "node scripts/release_pack.mjs"
  },
  "dependencies": {
    "esbuild": "0.25.12",
    "peggy": "^5.0.6",
    "tsrs": "7.1.0-beta.tsrs5"
  },
  "devDependencies": {
    "@goodpuppies/workman": "file:.",
    "@std/assert": "npm:@jsr/std__assert@^1.0.19",
    "@types/deno": "2.7.0",
    "@types/node": "26.1.1",
    "@webgpu/types": "0.1.64",
    "typescript": "7.1.0-beta",
    "typescript-api": "npm:@typescript/typescript6@^6.0.2"
  }
}
