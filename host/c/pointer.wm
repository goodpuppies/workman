// Raw C pointers. Allocation and release come from the imported C library.
from js.module("./js/pointer.js") import unsafe {
  cast as primCast: Ptr<a> -> Ptr<b>,
  offset as primOffset: (Ptr<t>, Real64.Real) -> Ptr<t>,
  equals as primEquals: (Ptr<a>, Ptr<b>) -> Bool,
  // The backing bytes have no signedness; infer the pointee from the C call.
  fromString as primFromString: String -> Ptr<t>,
  fromBytes as primFromBytes: bytes -> Ptr<t>,
  getPointer as primGetPointer: (Ptr<a>, Real64.Real) -> Option<Ptr<b>>,
  distance as primDistance: (Ptr<a>, Ptr<b>) -> Real64.Real,
  toString as primToString: Ptr<t> -> String,
  byteLength as primByteLength: String -> Real64.Real,
  readUtf8 as primReadUtf8: (Ptr<t>, Real64.Real) -> String,
  writeUtf8 as primWriteUtf8: (Ptr<t>, Real64.Real, String) -> Real64.Real,
  getU8 as primGetU8: (Ptr<t>, Real64.Real) -> Real64.Real,
  setU8 as primSetU8: (Ptr<t>, Real64.Real, Real64.Real) -> Void,
  getU32 as primGetU32: (Ptr<t>, Real64.Real) -> Real64.Real,
  getI32 as primGetI32: (Ptr<t>, Real64.Real) -> Real64.Real,
  setU32 as primSetU32: (Ptr<t>, Real64.Real, Real64.Real) -> Void,
  setI32 as primSetI32: (Ptr<t>, Real64.Real, Real64.Real) -> Void,
};
let cast = (pointer) => { primCast(pointer) };
let offset = primOffset;
let equals = primEquals;
let fromString = primFromString;
// The address of a JS typed array, such as a Uint8Array. Keep the array alive while C uses it.
let fromBytes = (bytes) => { primFromBytes(bytes) };
let toString = primToString;
let byteLength = primByteLength;
let readUtf8 = primReadUtf8;
let writeUtf8 = primWriteUtf8;
let getU8 = primGetU8;
let setU8 = primSetU8;
let getU32 = primGetU32;
let getI32 = primGetI32;
let setU32 = primSetU32;
let setI32 = primSetI32;

// Read a native pointer-sized slot (for C out parameters); null becomes None.
let getPointer = (pointer, start) => { primGetPointer(pointer, start) };
let distance = primDistance;
