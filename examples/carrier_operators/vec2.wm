-- A monomorphic carrier: Vec2 always carries Number, in and out.
--
-- Exporting `carrier` alongside top-level `succeed`, `map`, and `map2`
-- registers the type `succeed` returns. That is the whole registration; there
-- is no declaration syntax and nothing the compiler knows about Vec2.

record Vec2 = { x: Number, y: Number };

let zero = Vec2(0, 0);

-- `succeed` injects a pure operand. For a vector that means broadcasting a
-- scalar across the lanes, which is what makes `v * 3` work.
let succeed = (s: Number) => {
  Vec2(s, s)
};

let map = (v: Vec2, f) => {
  Vec2(f(v.x), f(v.y))
};

let map2 = (a: Vec2, b: Vec2, f) => {
  Vec2(f(a.x, b.x), f(a.y, b.y))
};

-- No `fn` and no `andThen`: a fixed-size vector has no success to check and
-- nothing to short-circuit, so this is a Monad.Applicative rather than a
-- Monad.Carrier. Vec2 gets operators without `via Vec2 f` or `Vec2|...|`.
let carrier = .{
  succeed = succeed,
  map = map,
  map2 = map2,
};

-- Reductions leave the payload type, so they stay ordinary functions.
let dot = (a: Vec2, b: Vec2) => {
  a.x * b.x + a.y * b.y
};
