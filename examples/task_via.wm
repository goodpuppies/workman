-- Compare ordinary Elm-style Task threading with functions created via Task.
--
-- The async edge here is real JavaScript: Deno.readTextFile returns a Promise,
-- which wm-mini reflects as Task<String, Js.Error>.

from js.global("Deno") import { readTextFile };

let via = Monad.via; -- alias from std
--looks like
--let via = (x) => { 
--    (f) => {
--        x.fn(f) -- means (#fn x)(f)
--    }
--};

--#region manual
let readFileManual = (path) => {
  readTextFile(path)
    :> Task.mapErr((_) => { "could not read " ++ path })
};

let titlePrefixManual = (text) => {
  text
    :> .slice(0, 9)
    :> Result.mapErr((_) => { "could not slice title" })
    :> Task.fromResult
};
--#endregion

--#region "colored"
let readFile = via Task (path) => {
  readTextFile(path)
    :> Task.mapErr((_) => { "could not read " ++ path })
};

let titlePrefix = via Task (text) => {
  text
    :> .slice(0, 9)
    :> Result.mapErr((_) => { "could not slice title" })
    :> Task.fromResult
};

let label = via Task (title) => {
  ("via: " ++ title) :> Task.succeed
};

let summarize = via Task (text, title) => {
  let source = text
    :> .slice(0, 9)
    :> Result.withDefault("unknown");

  ("via tuple sugar: " ++ title ++ " from " ++ source) :> Task.succeed
};
--#endregion

let elmStyle = (path) => {
  path
    :> Task.succeed
    :> Task.andThen((resolvedPath) => {
      readFileManual(resolvedPath)
        :> Task.andThen((text) => {
          titlePrefixManual(text)
            :> Task.andThen((title) => {
              ("elm-style: " ++ title) :> Task.succeed
            })
        })
    })
};

let viaStyle = (path) => {
  -- These lets name Task handles, not awaited values. Functions created via Task
  -- make each step consume the previous Task directly, so the shape is closer
  -- to do-notation, Rust ?, or let% style code than nested Task.andThen.
  -- despite this theres no magic going on, just simple vanilla sml currying
  let path =  Task.succeed(path);
  let text = readFile(path);
  let title = titlePrefix(text);
  let labeled = label(title);

  labeled
};

let viaTupleStyle = (path) => {
  -- `|...|` turns multiple Task handles into one Task containing a tuple,
  -- which lines up with `via Task (text, title) => ...`.
  let path = Task.succeed(path);
  let text = readFile(path);
  let title = titlePrefix(text);

  summarize(|text, title|)
};

