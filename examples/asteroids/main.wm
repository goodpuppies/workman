from js.module("raylib") import * as Raylib;

from "./trig.wm" import { floorReal, degrees };
from "./rng.wm" import * as Rng;
from "./game.wm" import {
  Game, Input, Shape, Hull, Rock, Shot, Readout, Banner,
  Tone, Loud, Plain, Faint, AsteroidSize, Large, Medium, Small,
  newGame, stepGame, radiusOf, scene, screenW, screenH
};

let via = Monad.via;
let viaError = (inject) => { Monad.viaError Result inject };

type AppError =
  | RaylibError<Js.Error>
  | RenderError<Js.Error>;

record Color = { r: Number, g: Number, b: Number, a: Number };

let raylibpath = "./libraylib.so";
let title = "Asteroids - Workman";
let seed = Rng.Seed(20260823);

let keySpace = 32;
let keyRight = 262;
let keyLeft  = 263;
let keyUp    = 265;
let keyEnter = 257;
let keyW = 87;
let keyA = 65;
let keyD = 68;

let black  = Color(0,   0,   0,   255);
let white  = Color(255, 255, 255, 255);
let gray   = Color(130, 130, 130, 255);
let yellow = Color(253, 249, 0,   255);
let red    = Color(230, 41,  55,  255);
let dim    = Color(90,  96,  110, 255);

let toneColor = match(tone) => {
  Loud => { red },
  Plain => { white },
  Faint => { dim },
};

let sidesOf = match(size) => {
  Large => { 9 },
  Medium => { 7 },
  Small => { 6 },
};

let shotRadius = 2;
let hudMargin = 10;
let outlineWidth = 1.5;

let bit = (b: Bool) => {
  if (b) { 1 } else { 0 }
};

let eitherDown = (k1: Number, k2: Number) => {
  Raylib.IsKeyDown(k1) || Raylib.IsKeyDown(k2)
};

let axis = (positive: Number, negative: Number, altPositive: Number, altNegative: Number) => {
  Result|eitherDown(positive, altPositive), eitherDown(negative, altNegative)|
    :> Result.map((forward, back) => { bit(forward) - bit(back) })
};

let readInput = () => {
  Result|
    axis(keyRight, keyLeft, keyD, keyA),
    eitherDown(keyUp, keyW),
    Raylib.IsKeyDown(keySpace),
    Raylib.IsKeyPressed(keyEnter)
  | :> Result.map(Input)
};

let draw = match(shape) => {
  Hull(nose, left, right) => {
    Raylib.H.DrawTriangleLines(nose, left, right, white)
  },
  Rock(at, size, rotation) => {
    Raylib.H.DrawPolyLinesEx(
      at, sidesOf(size), radiusOf(size), degrees(rotation), outlineWidth, gray
    )
  },
  Shot(at) => {
    Raylib.H.DrawCircleV(at, shotRadius, yellow)
  },
  Readout(text, y, textSize, tone) => {
    Raylib.H.DrawText(text, hudMargin, y, textSize, toneColor(tone))
  },
  Banner(text, y, textSize, tone) => {
    let width = Raylib.H.MeasureText(text, textSize);
    let centerX = ((screenW - width) / 2) :> Result.map(floorReal);
    via Result Raylib.H.DrawText Result|
      Ok(text), centerX, Ok(y), Ok(textSize), Ok(toneColor(tone))
    |
  },
};

let render = (g: Game) => {
  Result|
    Raylib.BeginDrawing(),
    Raylib.H.ClearBackground(black),
    scene(g) :> Result.traverse(draw),
    Raylib.DrawFPS(screenW - 90, hudMargin),
    Raylib.EndDrawing()
  |
};

let frame = (g: Game) => {
  let read = viaError RenderError () => {
    Result|Raylib.GetFrameTime(), readInput()|
  };
  let step = viaError RenderError (dt, input) => {
    let stepped = stepGame(g, input, dt);
    render(stepped) :> Result.map( (_) => { stepped })
  };

  Ok(void)
    :> read
    :> step
};

let rec loop = (g: Game) => {
  match(Raylib.WindowShouldClose()) {
    Err(e) => { Err(RenderError(e)) },
    Ok(true) => { Ok(void) },
    Ok(false) => {
      match(frame(g)) {
        Err(e) => { Err(e) },
        Ok(next) => { loop(next) },
      }
    },
  }
};

let startup = viaError RaylibError () => {
  Result|
    Raylib.loadRaylib(raylibpath),
    Raylib.H.InitWindow(screenW, screenH, title),
    Raylib.SetTargetFPS(60)
  |
};

let shutdown = viaError RaylibError () => {
  Result|
    Raylib.CloseWindow(),
    Raylib.unloadRaylib()
  |
};

let main = () => {
  match(Ok(void) :> startup) {
    Ok(_) => {
      match(Result|loop(newGame(seed)), Ok(void) :> shutdown|) {
        Ok(_) => {},
        Err(e) => { print(e) },
      }
    },
    Err(e) => { print(e) },
  }
};
