-- trig.wm
-- Pure sine and cosine. Range-reduce to [-pi, pi], then evaluate the Taylor
-- series in nested (Horner) form. Good to ~1e-5 over the full circle, which is
-- far more than a ship heading needs.

let pi = 3.141592653589793;
let twoPi = 6.283185307179586;

-- Truncate toward zero (the JS `% 1` trick), then correct to a true floor so
-- negative inputs behave.
let truncate = (x: Number) => {
  x - (x % 1)
};

let floorReal = (x: Number) => {
  let t = truncate(x);
  if (t > x) { t - 1 } else { t }
};

let round = (x: Number) => {
  floorReal(x + 0.5)
};

let reduce = (x: Number) => {
  x - round(x / twoPi) * twoPi
};

let sinReduced = (x: Number) => {
  let x2 = x * x;
  x * (1 - x2 / 6 *
      (1 - x2 / 20 *
      (1 - x2 / 42 *
      (1 - x2 / 72 *
      (1 - x2 / 110 *
      (1 - x2 / 156))))))
};

let cosReduced = (x: Number) => {
  let x2 = x * x;
  1 - x2 / 2 *
      (1 - x2 / 12 *
      (1 - x2 / 30 *
      (1 - x2 / 56 *
      (1 - x2 / 90 *
      (1 - x2 / 132)))))
};

let sin = (x: Number) => {
  sinReduced(reduce(x))
};

let cos = (x: Number) => {
  cosReduced(reduce(x))
};

-- Radians to degrees, for the raylib draw calls that take an angle.
let degrees = (radians: Number) => {
  radians * 180 / pi
};
