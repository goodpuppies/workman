from "std/list.wm" import * as List;
from "pakman/project.wm" import { command, watch, Wm, Exec };

let browserBuild = [
  Wm(["compile", "src/main.wm", "dist/main.mjs"]),
  Exec("deno", ["bundle", "--platform=browser", "dist/main.mjs", "-o", "dist/app.js"])
];

let commands = [
  command("build", browserBuild),
  watch(["src", "serve.wm", "index.html", "reload.js", "deno.json", "deno.lock"],
    command("dev", List.append(browserBuild, [Wm(["run", "serve.wm"])]))),
  command("serve", [Wm(["run", "serve.wm"])]),
  command("test", [Wm(["test", "view.test.wm"])])
];
