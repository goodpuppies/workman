from js.global("Deno") import unsafe { serve, readTextFileSync };
from js.global("crypto") import unsafe { randomUUID: Void -> String };
from js.global import unsafe { URL, Response };

let main = () => {
  let html = readTextFileSync("index.html");
  let script = readTextFileSync("dist/app.js");
  let revision = randomUUID();
  let reload = "const revision = '" ++ revision ++ "';\n" ++ readTextFileSync("reload.js");
  serve(JSON{ hostname: "127.0.0.1", port: 5173 }, (request, _) => {
    let url = URL.new(request.url);
    match(url.pathname) {
      "/" => { Response.new(html, JSON{ headers: JSON{ "content-type": "text/html; charset=utf-8", "cache-control": "no-store" } }) },
      "/app.js" => { Response.new(script, JSON{ headers: JSON{ "content-type": "text/javascript; charset=utf-8", "cache-control": "no-store" } }) },
      "/reload.js" => { Response.new(reload, JSON{ headers: JSON{ "content-type": "text/javascript; charset=utf-8", "cache-control": "no-store" } }) },
      "/__wm/revision" => { Response.new(revision, JSON{ headers: JSON{ "cache-control": "no-store" } }) },
      _ => { Response.new("Not found", JSON{ status: 404 }) },
    }
  })
};
