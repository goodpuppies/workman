from "./app.wm" import { app };
from js.module("react-dom/client") import unsafe { createRoot };
from js.global("document") import unsafe { getElementById };

let main = () => {
  let container = getElementById("root");
  match(container) {
    Some(mount) => {
      let root = createRoot(mount);
      root.render(app)
    },
    None => { Panic("Missing #root mount element") },
  }
};
