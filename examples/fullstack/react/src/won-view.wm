from "basis/won_value.wm" import * as W;
from "basis/text.wm" import * as Utf8;
from js.module("react") import unsafe {
  createElement,
  createElement as createComponent: ((Js.Value -> DOMElement<Js.Value, Element>), Js.Value) -> DOMElement<Js.Value, Element>,
  cloneElement: (DOMElement<Js.Value, Element>, Js.Value) -> DOMElement<Js.Value, Element>
};
from js.module("react") import type { DOMElement };

from js.global import type { Element };

type View = DOMElement<Js.Value, Element>;

-- Register components once (outside rendering). Cloning their element preserves
-- React's component type across parent renders, including the FFI callback adapter.
type Component = View;

record Bindings = {
  text: String -> String,
  action: String -> Void,
  component: String -> Component,
};
let emptyBindings = Bindings(
  (name) => { Panic("WON view: unknown text binding " ++ name) },
  (name) => { Panic("WON view: unknown action " ++ name) },
  (name) => { Panic("WON view: unknown component " ++ name) }
);
-- Declarative named bindings. Later entries override earlier ones of the same kind/name.
type Binding =
  | TextBinding<String, Void -> String>
  | ActionBinding<String, Void -> Void>
  | ComponentBinding<String, Component>;
let text = (name, read) => { TextBinding(name, read) };
let action = (name, run) => { ActionBinding(name, run) };
let namedComponent = (name, value) => { ComponentBinding(name, value) };

let rec readText = (entries, name) => {
  match(entries) {
    [] => { emptyBindings.text(name) },
    [TextBinding(key, read), ..rest] => {
      if (key == name) { read() } else { readText(rest, name) }
    },
    [_, ..rest] => { readText(rest, name) },
  }
};
let rec runAction = (entries, name) => {
  match(entries) {
    [] => { emptyBindings.action(name) },
    [ActionBinding(key, run), ..rest] => {
      if (key == name) { run() } else { runAction(rest, name) }
    },
    [_, ..rest] => { runAction(rest, name) },
  }
};
let rec findComponent = (entries, name) => {
  match(entries) {
    [] => { emptyBindings.component(name) },
    [ComponentBinding(key, value), ..rest] => {
      if (key == name) { value } else { findComponent(rest, name) }
    },
    [_, ..rest] => { findComponent(rest, name) },
  }
};
let bindings = (entries: List<Binding>) => {
  let ordered = List.reverse(entries);
  Bindings(
    (name) => { readText(ordered, name) },
    (name) => { runAction(ordered, name) },
    (name) => { findComponent(ordered, name) }
  )
};

record EventProps<child> = {
  key: String,
  className: String,
  children: Js.Array<child>,
  onClick: Js.Value -> Void,
};

let string = match {
  W.Text(bytes) => { Utf8.fromUtf8(bytes) :> Result.debug },
  _ => { Panic("WON view: expected text") },
};

let attribute = (attributes, name) => {
  List.find(attributes, (entry) => { let (key, _) = entry; key == name })
};

let textAttribute = (attributes, name) => {
  match(attribute(attributes, name)) {
    Some(entry) => { let (_, value) = entry; string(value) },
    None => { "" },
  }
};

let click = (attributes) => {
  match(attribute(attributes, "onClick")) {
    Some(entry) => {
      let (_, value) = entry;
      match(value) {
        W.Tag("Action", [], body) => { Some(string(body)) },
        _ => { Panic("WON view: onClick must be Action(\"name\")") },
      }
    },
    None => { None },
  }
};

let validateAttributes = (attributes) => {
  List.map(attributes, (entry) => {
    let (key, _) = entry;
    if (key == "className" || key == "onClick" || key == "href") { void }
    else { Panic("WON view: unsupported property " ++ key) }
  });
  void
};

let textNode = (path, value) => {
  let tag = "span";
  createElement(tag, JSON{ key: path, children: value })
};

let rec indexed = (items, index) => {
  match(items) {
    [] => { [] },
    [item, ..rest] => { [(index, item), ..indexed(rest, index + 1)] },
  }
};

let rec renderAt = (bindings: Bindings, path: String, value: W.Value): View => {
  match(value) {
    W.Text(_) => { textNode(path, string(value)) },
    W.Tag("Bind", [], body) => { textNode(path, bindings.text(string(body))) },
    W.Tag("Component", attributes, body) => {
      match(attributes) {
        [] => { cloneElement(bindings.component(string(body)), JSON{ key: path }) },
        _ => { Panic("WON view: Component does not accept attributes") },
      }
    },
    W.Tag(tag, attributes, body) => {
      validateAttributes(attributes);
      let children = match(body) {
        W.List(items) => { List.map(indexed(items, 0), (entry) => { let (index, child) = entry; renderAt(bindings, path ++ "." ++ Text.of(index), child) }) },
        W.Null => { [] },
        _ => { [renderAt(bindings, path ++ ".0", body)] },
      };
      let classes = textAttribute(attributes, "className");
      let nodes = Js.Array.fromList(children);
      let tree = match(click(attributes)) {
        Some(action) => {
          createElement(tag, .{
            key = path,
            className = classes,
            children = nodes,
            onClick = (_) => { bindings.action(action) },
          })
        },
        None => {
          createElement(tag, JSON{ key: path, className: classes, children: nodes })
        },
      };
      match(attribute(attributes, "href")) {
        Some(entry) => { let (_, value) = entry; cloneElement(tree, JSON{ href: string(value) }) },
        None => { tree },
      }
    },
    _ => { Panic("WON view: expected an element tag, Component, Bind, or text") },
  }
};

let render = (bindings, template) => {
  match(template) {
    W.List([root]) => { renderAt(bindings, "view", root) },
    W.List(_) => { Panic("WON view: expected one root element") },
    _ => { renderAt(bindings, "view", template) },
  }
};

-- React supplies props; these helpers adapt zero-argument WM drawing functions.
-- Register once outside rendering to preserve the component's React type.
let componentWith = (draw: Void -> (Bindings, W.Value)): Component => {
  let wrapped = (_) => {
    let (bindings, template) = draw();
    render(bindings, template)
  };
  createComponent(wrapped, JSON{})
};
let component = (draw: Void -> W.Value): Component => {
  componentWith () => { (emptyBindings, draw()) }
};
