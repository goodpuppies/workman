-- @no-prelude

// This file defines the complete Result pattern itself. The directive above

type Result<T, E> = Ok<T> | Err<E>;

record ViaCarrier<A, B> = { fn: A -> B };

record ResultCarrier<A, B, E> = {
  fn: (A -> Result<B, E>) -> Result<A, E> -> Result<B, E>,
  andThen: (Result<A, E>, A -> Result<B, E>) -> Result<B, E>,
  map: (Result<A, E>, A -> B) -> Result<B, E>
};

let andThen = (result, f) => {
  match(result) {
    Ok(value) => { f(value) },
    Err(error) => { Err(error) }
  }
};

// Create a Result structure with a carrier function adapter.
let Var(Result) = .{
  fn = (f) => {
    (result) => {
      result :> andThen(f)
    }
  },
  map = (result, f) => {
    match(result) {
      Ok(value) => { Ok(f(value)) },
      Err(error) => { Err(error) }
    }
  },
  andThen = andThen,
};

// Create/call a function via a carrier's `fn` function.
// arg1 a Carrier structure that has an `fn` function
// arg2 a lambda function to adapt
let via = (x) => {
  (f) => {
    x.fn(f)
  }
};

// Adapt print via Result so that it can print a Result<String,E>.
let printOk = via Result (value) => {
  print(value);
  Ok(void)
};

let calculate = (input) => {
  // Notice the curried application here: "(via Result)((number...".
  let requirePositive = via Result (number) => {
    if (number > 0) {
      Ok(number)
    } else {
      Err("number must be positive")
    }
  };

  let double = via Result (number) => {
    Ok(number * 2)
  };

  let divide100By = via Result (number) => {
    if (number == 0) {
      Err("cannot divide by zero")
    } else {
      Ok(100 / number)
    }
  };

  Ok(input)
    :> requirePositive
    :> double
    :> divide100By
};

// Result|x,y,...| is (Result<T,E>,Result<T,E>,...) -> Result<(T,T,...),E> // uses andThen + map under the hood
let main = () => {
  match(Result|
    printOk(calculate(10)),
    printOk(calculate(-2))
  |) {
    Ok(_) => { void },
    Err(error) => { print(error) }
  }
};
