-- HTTP server using the wm-mini router library

from js.global import unsafe { Date };
from js.global import type { Request, Response };
// Use the synchronous, request-only handler form of Deno.serve.
from js.module("./deno.js") import unsafe {
  serve: (Js.Value, Request -> Response) -> Js.Object
};
from js.global("console") import unsafe { log };
from "../http.wm" import { get, response, dispatch };

let routes = [
  get("/", (req) => {
    response("Hello from Workman!", JSON{status: 200})
  }),
  get("/health", (req) => {
    response("{\"status\":\"ok\"}", JSON{status: 200})
  }),
  get("/time", (req) => {
    let date = Date.new();
    let now = match(date.toISOString()) {
      Ok(value) => { value },
      Err(_) => { "unknown" },
    };
    response("{\"time\":\"" ++ now ++ "\"}", JSON{status: 200})
  })
];

let main = () => {
  log("Starting server on http://127.0.0.1:8080");
  serve(JSON{hostname: "127.0.0.1", port: 8080}, dispatch(routes));
};
