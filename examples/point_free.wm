// ============================================================
// WM point-free programming showcase
// ============================================================

// Curried, data-last
let add = a => b => a + b;
let multiply = a => b => a * b;

// Tupled, data-first
let clamp = (x, low, high) =>
  match {
    =(x < low) => { low },
    =(x > high) => { high },
    _ => { x }
  } true;

let between = (x, low, high) =>
  x > low && x < high;

let prefix = (text, label) => label ++ text;

// Ordinary unary
let double = x => x * 2;

// Higher-order, curried
let tap = effect => value => {
  effect(value);
  value
};

// ------------------------------------------------------------
// 1. Mixed calling conventions and callback composition
// ------------------------------------------------------------

let process ==>:>
  add 5
  :> multiply 3
  :> clamp(0, 100)
  :> (tap => :> Text.of :> prefix("Intermediate: ") :> print)
  :> double
  :> Text.of
  :> prefix("Result: ");

let results = [1, 5, 10, 20, 50]
  :> List.map(process);

// ["Result: 36", "Result: 60", "Result: 90",
//  "Result: 150", "Result: 200"]


// ------------------------------------------------------------
// 2. Inline point-free callbacks
// ------------------------------------------------------------

let formatted = [10, 20, 30, 40]
  :> List.map(=>
    :> add 5
    :> double
    :> Text.of
    :> prefix("Value: ")
  );

// ["Value: 30", "Value: 50",
//  "Value: 70", "Value: 90"]


// ------------------------------------------------------------
// 3. Data-first predicates without forwarding lambdas
// ------------------------------------------------------------

let filtered = [5, 15, 25, 50, 110]
  :> List.filter(=> :> between(10, 100))
  :> List.map(=> :> multiply 2);

// [30, 50, 100]


// ------------------------------------------------------------
// 4. Nested point-free mapping
// ------------------------------------------------------------

let groups = [
  [1, 20, 200],
  [5, 50, 500],
  [10, 100, 1000]
];

let nested = groups
  :> List.map(=>
    :> List.map(=>
      :> clamp(0, 100)
      :> double
    )
  );

// [
//   [2, 40, 200],
//   [10, 100, 200],
//   [20, 200, 200]
// ]


// ------------------------------------------------------------
// 5. Immutable record transformations
// ------------------------------------------------------------

// Example record API: named records with copy/update helpers.
// These helpers are illustrative and can be replaced with WM's
// preferred record construction/update operations.

record User = {score:Number, level:Number};

let getScore = user => user.score;
let getLevel = user => user.level;

let setScore = (user, transform) => {
  .{
    score = transform(user.score),
    level = user.level
  }
};

let setLevel = (user, transform) => {
  .{
    score = user.score,
    level = transform(user.level)
  }
};

let updateUser ==>
  :> setScore(=> :> add 10)
  :> setLevel(=> :> add 1);


// ------------------------------------------------------------
// 6. Higher-order fallback handling
// ------------------------------------------------------------

// An example using Option-style constructors.
let withDefault = (fallback, f) => value =>
  match(f(value)) {
    Some(x) => { x },
    None => { fallback }
  };


// ------------------------------------------------------------
// 7. Point-free composition of the whole workflow
// ------------------------------------------------------------

let processGroups ==>
  :> List.map(=>
    :> List.filter(=> :> between(10, 100))
    :> List.map(=>
      :> add 5
      :> multiply 3
      :> clamp(0, 100)
      :> double
      :> Text.of
      :> prefix("Result: ")
    )
  );

let finalResults = groups :> processGroups;