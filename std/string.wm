from "basis/text.wm" import * as UnicodeText;
from "basis/string.wm" import * as Strings;
from "basis/list.wm" import * as Lists;
from "basis/result.wm" import * as Results;

// `String` is the SubsetML Basis `String` plus `toList` and `isSubsequence`
// (markdown/basis-authority-plan.md).
export from "basis/string.wm" import *;

// Portable byte-string convenience. Any conversion error returns an empty list.
let toList = (value: String) => {
  Results.getOr(
    Results.andThen(Strings.fromNative(value), (chars) => { Lists.traverse(chars, Strings.str) }),
    []
  )
};

// Does the pattern appear in order, allowing gaps? Comparisons use Unicode scalars.
let isSubsequence = (text: String, pattern: String) => {
  let rec search = (chars, wanted) => {
    match(chars, wanted) {
      (_, []) => { true },
      ([], _) => { false },
      ([c, ..rest], [next, ..tail]) => {
        search(rest, if (c == next) { tail } else { wanted })
      }
    }
  };
  Results.andThen(UnicodeText.explode(text), (chars) => {
    Results.map(UnicodeText.explode(pattern), (wanted) => { search(chars, wanted) })
  })
};

// @int64-counts
// Default counts and indices are Int64; shared Basis functions retain explicit 32 suffixes.
from "./list.wm" import * as WideList;

let size = value => Results.map(Strings.fromNative(value), WideList.length);

let extract = (value, start: Int64.Int, count: Option<Int64.Int>) => {
  Results.andThen(Results.mapErr(Strings.fromNative(value), Strings.StringError), bytes => {
    Results.andThen(Results.mapErr(WideList.drop(bytes, start), _ => Strings.InvalidIndex), rest => {
      let selected = match(count) {
        None => Ok(rest),
        Some(size) => Results.mapErr(WideList.take(rest, size), _ => Strings.InvalidIndex)
      };
      Results.andThen(selected, chosen => Results.mapErr(Strings.toNative(chosen), Strings.StringError))
    })
  })
};

let substring = (value, start: Int64.Int, count: Int64.Int) => extract(value, start, Some(count));
