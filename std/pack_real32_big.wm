from "./basis.wm" import * as Basis;
from js.module("./js/byte_vector.js") import unsafe {
  length as vectorLength: Word8Vector.Vector -> Real64.Real,
  sliceLength: Word8VectorSlice.Slice -> Real64.Real,
  packSubVec as primSubVec: (String, Bool, Word8Vector.Vector, Real64.Real) -> Real32.Real,
  packSubSlice as primSubSlice: (String, Bool, Word8VectorSlice.Slice, Real64.Real) -> Real32.Real,
  pack as primPack: (String, Bool, Real32.Real) -> Word8Vector.Vector
};

let bytesPerElem: Real64.Real = 4;

let isBigEndian = true;

let subVec = (vector, index: Real64.Real) => {
  if (index >= 0 && index % 1 == 0 && (index + 1) * 4 <= vectorLength(vector)) {
    Ok(primSubVec("real32", true, vector, index))
  } else {
    Err(Basis.Subscript)
  }
};

let subSlice = (slice, index: Real64.Real) => {
  if (index >= 0 && index % 1 == 0 && (index + 1) * 4 <= sliceLength(slice)) {
    Ok(primSubSlice("real32", true, slice, index))
  } else {
    Err(Basis.Subscript)
  }
};

let pack = (value) => { primPack("real32", true, value) };
