// Basis `MATH` over `Real64.Real`, the JavaScript double. Each function is the matching `Math` member:
// out-of-domain arguments give NaN and never raise, as the spec says.
from js.global("Math") import unsafe {
  PI: Real64.Real,
  E: Real64.Real,
  sqrt as primSqrt: Real64.Real -> Real64.Real,
  sin as primSin: Real64.Real -> Real64.Real,
  cos as primCos: Real64.Real -> Real64.Real,
  tan as primTan: Real64.Real -> Real64.Real,
  asin as primAsin: Real64.Real -> Real64.Real,
  acos as primAcos: Real64.Real -> Real64.Real,
  atan as primAtan: Real64.Real -> Real64.Real,
  atan2 as primAtan2: (Real64.Real, Real64.Real) -> Real64.Real,
  exp as primExp: Real64.Real -> Real64.Real,
  pow as primPow: (Real64.Real, Real64.Real) -> Real64.Real,
  log as primLog: Real64.Real -> Real64.Real,
  log10 as primLog10: Real64.Real -> Real64.Real,
  sinh as primSinh: Real64.Real -> Real64.Real,
  cosh as primCosh: Real64.Real -> Real64.Real,
  tanh as primTanh: Real64.Real -> Real64.Real
};

let pi = PI;
let e = E;
let sqrt = primSqrt;
let sin = primSin;
let cos = primCos;
let tan = primTan;
let asin = primAsin;
let acos = primAcos;
let atan = primAtan;
let atan2 = primAtan2;
let exp = primExp;
let pow = primPow;
let ln = primLog;
let log10 = primLog10;
let sinh = primSinh;
let cosh = primCosh;
let tanh = primTanh;
