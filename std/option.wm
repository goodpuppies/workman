from "../basis/basis.wm" import * as Basis;

let map = match(option, f) => {
  (Some(value), f) => { Some(f(value)) },
  (None, _) => { None }
};

let andThen = match(option, f) => {
  (Some(value), f) => { f(value) },
  (None, _) => { None }
};

let withDefault = match(option, fallback) => {
  (Some(value), _) => { value },
  (None, fallback) => { fallback }
};

let map2 = match(a, b, f) => {
  (Some(left), Some(right), f) => { Some(f(left, right)) },
  (None, _, _) => { None },
  (_, None, _) => { None }
};

let rec traverse = match(items, f) => {
  ([], _) => { Some([]) },
  ([item, ..rest], f) => {
    match(f(item)) {
      None => { None },
      Some(value) => {
        match(traverse(rest, f)) {
          None => { None },
          Some(values) => { Some([value, ..values]) }
        }
      }
    }
  }
};

let collectList = (items) => {
  traverse(items, (item) => { item })
};

// Basis `OPTION` functions with no existing Workman name. `getOpt` is `withDefault` and
// `mapPartial` is `andThen`. Arguments come data-first so pipes work.

let isSome = match(option) => {
  Some(_) => { true },
  None => { false }
};

let valOf = match(option) => {
  Some(value) => { Ok(value) },
  None => { Err(Basis.Option) }
};

let filter = (value, predicate) => {
  if (predicate(value)) { Some(value) } else { None }
};

let join = match(option) => {
  Some(inner) => { inner },
  None => { None }
};

let app = match(option, f) => {
  (Some(value), f) => { f(value) },
  (None, _) => { void }
};

let compose = (f, g) => {
  (value) => { map(g(value), f) }
};

let composePartial = (f, g) => {
  (value) => { andThen(g(value), f) }
};
