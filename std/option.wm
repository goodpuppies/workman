from "basis/option.wm" import * as SubsetOption;

// `Option` is the SubsetML Basis `Option` plus the additions below, which the Basis doesn't
// define. A name the Basis exports is never redefined here (markdown/basis-authority-plan.md).
export from "basis/option.wm" import *;

let map2 = match(a, b, f) => {
  (Some(left), Some(right), f) => { Some(f(left, right)) },
  (None, _, _) => { None },
  (_, None, _) => { None }
};

let rec traverse = match(items, f) => {
  ([], _) => { Some([]) },
  ([item, ..rest], f) => {
    match(f(item)) {
      None => { None },
      Some(value) => {
        match(traverse(rest, f)) {
          None => { None },
          Some(values) => { Some([value, ..values]) }
        }
      }
    }
  }
};

let collectList = (items) => {
  traverse(items, (item) => { item })
};

let join = match(option) => {
  Some(inner) => { inner },
  None => { None }
};

let forEach = match(option, f) => {
  (Some(value), f) => { f(value) },
  (None, _) => { void }
};

let compose = (f, g) => {
  (value) => { SubsetOption.map(g(value), f) }
};

let composePartial = (f, g) => {
  (value) => { SubsetOption.andThen(g(value), f) }
};
