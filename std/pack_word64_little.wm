from "./basis.wm" import * as Basis;
from js.module("./js/byte_vector.js") import unsafe {
  length as vectorLength: Word8Vector.Vector -> Number,
  sliceLength: Word8VectorSlice.Slice -> Number,
  packSubVec as primSubVec: (String, Bool, Word8Vector.Vector, Number) -> Word64.Word,
  packSubSlice as primSubSlice: (String, Bool, Word8VectorSlice.Slice, Number) -> Word64.Word,
  pack as primPack: (String, Bool, Word64.Word) -> Word8Vector.Vector
};

let bytesPerElem = 8;

let isBigEndian = false;

let subVec = (vector, index: Number) => {
  if (index >= 0 && index % 1 == 0 && (index + 1) * 8 <= vectorLength(vector)) {
    Ok(primSubVec("word64", false, vector, index))
  } else {
    Err(Basis.Subscript)
  }
};

let subSlice = (slice, index: Number) => {
  if (index >= 0 && index % 1 == 0 && (index + 1) * 8 <= sliceLength(slice)) {
    Ok(primSubSlice("word64", false, slice, index))
  } else {
    Err(Basis.Subscript)
  }
};

let pack = (value) => { primPack("word64", false, value) };
