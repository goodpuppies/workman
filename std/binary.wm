    Err(error) => { Err(error) },
    Ok(part) => { Ok(Float64.toNumber(PackReal64Big.subSlice(part, 0))) }
  }
};

let asciiZ = (bytes, offset) => {
  let available = Word8VectorSlice.length(bytes);
  let rec find = (index) => {
    if (index >= available) {
      Err(UnterminatedAscii(offset))
    } else {
      if (Word8.toNumber(Word8VectorSlice.sub(bytes, index)) == 0) {
        match(take(bytes, offset, index - offset)) {
          Err(error) => { Err(error) },
          Ok(part) => { Ok(Byte.bytesToString(Word8VectorSlice.vector(part))) }
        }
      } else {
        find(index + 1)
      }
    }
  };
  if (offset >= 0 && offset % 1 == 0 && offset < available) {
    find(offset)
  } else {
    bounds(offset, 1, available)
  }
};

let cursor = (bytes) => {
  Cursor{ bytes = bytes, offset = 0 }
};

let cursorAt = (bytes, offset) => {
  if (
    offset >= 0 && offset % 1 == 0 &&
    offset <= Word8VectorSlice.length(bytes)
  ) {
    Ok(Cursor{ bytes = bytes, offset = offset })
  } else {
    bounds(offset, 0, Word8VectorSlice.length(bytes))
  }
};

let position = (cursor: Cursor<bytes>) => { cursor.offset };

let remaining = (cursor: Cursor<bytes>) => {
  Word8VectorSlice.length(cursor.bytes) - cursor.offset
};

let skip = (cursor: Cursor<bytes>, width: Number) => {
  match(take(cursor.bytes, cursor.offset, width)) {
    Err(error) => { Err(error) },
    Ok(_) => { Ok(Cursor{ bytes = cursor.bytes, offset = cursor.offset + width }) }
  }
};

let readU8 = (cursor: Cursor<bytes>) => {
  match(u8(cursor.bytes, cursor.offset)) {
    Err(error) => { Err(error) },
    Ok(value) => {
      Ok((value, Cursor{ bytes = cursor.bytes, offset = cursor.offset + 1 }))
    }
  }
};

let readU16le = (cursor: Cursor<bytes>) => {
  match(u16le(cursor.bytes, cursor.offset)) {
    Err(error) => { Err(error) },
    Ok(value) => {
      Ok((value, Cursor{ bytes = cursor.bytes, offset = cursor.offset + 2 }))
    }
  }
};

