from "../basis/byte.wm" import * as Byte;
from "../basis/float32.wm" import * as Float32;
from "../basis/float64.wm" import * as Float64;
from "../basis/pack_real32_big.wm" import * as PackReal32Big;
from "../basis/pack_real32_little.wm" import * as PackReal32Little;
from "../basis/pack_real64_big.wm" import * as PackReal64Big;
from "../basis/pack_real64_little.wm" import * as PackReal64Little;
from "../basis/pack_word16_big.wm" import * as PackWord16Big;
from "../basis/pack_word16_little.wm" import * as PackWord16Little;
from "../basis/pack_word32_big.wm" import * as PackWord32Big;
from "../basis/pack_word32_little.wm" import * as PackWord32Little;
from "../basis/pack_word64_big.wm" import * as PackWord64Big;
from "../basis/pack_word64_little.wm" import * as PackWord64Little;
from "../basis/word8.wm" import * as Word8;
from "../basis/word8_vector_slice.wm" import * as Word8VectorSlice;

type Error =
  | Bounds<Number, Number, Number>
  | UnterminatedAscii<Number>;

record Cursor<Bytes> = {
  bytes: Bytes,
  offset: Number
};

let bounds = (offset, width, available) => {
  Err(Bounds(offset, width, available))
};

let take = (bytes, offset: Number, width: Number) => {
  match(Word8VectorSlice.subslice(bytes, offset, Some(width))) {
    Ok(part) => { Ok(part) },
    Err(_) => { bounds(offset, width, Word8VectorSlice.length(bytes)) }
  }
};

// Read element 0 of a part returned by `take`. The part is exactly one element wide, so the read
// can't fail; its `Result` is mapped to `Bounds` only to keep the error type.
let readFirst = (read, part, offset, convert) => {
  match(read(part, 0)) {
    Ok(value) => { Ok(convert(value)) },
    Err(_) => { bounds(offset, Word8VectorSlice.length(part), Word8VectorSlice.length(part)) }
  }
};

let u8 = (bytes, offset) => {
  match(take(bytes, offset, 1)) {
    Err(error) => { Err(error) },
    Ok(part) => { readFirst(Word8VectorSlice.sub, part, offset, (byte) => { byte }) }
  }
};

let u16le = (bytes, offset) => {
  match(take(bytes, offset, PackWord16Little.bytesPerElem)) {
    Err(error) => { Err(error) },
    Ok(part) => { readFirst(PackWord16Little.subSlice, part, offset, (word) => { word }) }
  }
};

let u16be = (bytes, offset) => {
  match(take(bytes, offset, PackWord16Big.bytesPerElem)) {
    Err(error) => { Err(error) },
    Ok(part) => { readFirst(PackWord16Big.subSlice, part, offset, (word) => { word }) }
  }
};

let u32le = (bytes, offset) => {
  match(take(bytes, offset, PackWord32Little.bytesPerElem)) {
    Err(error) => { Err(error) },
    Ok(part) => { readFirst(PackWord32Little.subSlice, part, offset, (word) => { word }) }
  }
};

let u32be = (bytes, offset) => {
  match(take(bytes, offset, PackWord32Big.bytesPerElem)) {
    Err(error) => { Err(error) },
    Ok(part) => { readFirst(PackWord32Big.subSlice, part, offset, (word) => { word }) }
  }
};

let u64le = (bytes, offset) => {
  match(take(bytes, offset, PackWord64Little.bytesPerElem)) {
