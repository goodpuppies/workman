let f32le = (bytes, offset) => {
  match(take(bytes, offset, PackReal32Little.bytesPerElem)) {
    Err(error) => { Err(error) },
    Ok(part) => { Ok(Float32.toNumber(PackReal32Little.subSlice(part, 0))) }
  }
};

let f32be = (bytes, offset) => {
  match(take(bytes, offset, PackReal32Big.bytesPerElem)) {
    Err(error) => { Err(error) },
    Ok(part) => { Ok(Float32.toNumber(PackReal32Big.subSlice(part, 0))) }
