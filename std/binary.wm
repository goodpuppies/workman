type Error =
  | Bounds<Number, Number, Number>
  | UnterminatedAscii<Number>;

record Cursor<Bytes> = {
  bytes: Bytes,
  offset: Number
};

let bounds = (offset, width, available) => {
  Err(Bounds(offset, width, available))
};

let take = (bytes, offset: Number, width: Number) => {
  let available = Word8VectorSlice.length(bytes);
  if (
    offset >= 0 && offset % 1 == 0 &&
    width >= 0 && width % 1 == 0 &&
    offset <= available && width <= available - offset
  ) {
    Ok(Word8VectorSlice.subslice(bytes, offset, Some(width)))
  } else {
    bounds(offset, width, available)
  }
};

let u8 = (bytes, offset) => {
  match(take(bytes, offset, 1)) {
    Err(error) => { Err(error) },
    Ok(part) => { Ok(Word8VectorSlice.sub(part, 0)) }
  }
};

let u16le = (bytes, offset) => {
  match(take(bytes, offset, PackWord16Little.bytesPerElem)) {
    Err(error) => { Err(error) },
    Ok(part) => { Ok(PackWord16Little.subSlice(part, 0)) }
  }
};

let u16be = (bytes, offset) => {
  match(take(bytes, offset, PackWord16Big.bytesPerElem)) {
    Err(error) => { Err(error) },
    Ok(part) => { Ok(PackWord16Big.subSlice(part, 0)) }
  }
};

let u32le = (bytes, offset) => {
  match(take(bytes, offset, PackWord32Little.bytesPerElem)) {
    Err(error) => { Err(error) },
    Ok(part) => { Ok(PackWord32Little.subSlice(part, 0)) }
  }
};

let u32be = (bytes, offset) => {
  match(take(bytes, offset, PackWord32Big.bytesPerElem)) {
    Err(error) => { Err(error) },
    Ok(part) => { Ok(PackWord32Big.subSlice(part, 0)) }
