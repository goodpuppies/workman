  }
};

let f32le = (bytes, offset) => {
  match(take(bytes, offset, PackReal32Little.bytesPerElem)) {
    Err(error) => { Err(error) },
    Ok(part) => { readFirst(PackReal32Little.subSlice, part, offset, Float32.toNumber) }
  }
};

let f32be = (bytes, offset) => {
  match(take(bytes, offset, PackReal32Big.bytesPerElem)) {
    Err(error) => { Err(error) },
    Ok(part) => { readFirst(PackReal32Big.subSlice, part, offset, Float32.toNumber) }
  }
};

let f64le = (bytes, offset) => {
  match(take(bytes, offset, PackReal64Little.bytesPerElem)) {
