from "basis/list_pair.wm" import * as SubsetListPair;
from "basis/list.wm" import * as SubsetList;
from "basis/result.wm" import * as SubsetResult;

// `ListPair` is the SubsetML Basis `ListPair` plus the operations below, which the Basis doesn't
// define. Like the Basis's `zip` and `map`, each checks the lengths first and returns
// `Err(UnequalLengths)` without calling `f` when they differ (markdown/basis-authority-plan.md).
export from "basis/list_pair.wm" import *;

let forEach = (left, right, f) => {
  SubsetResult.map(SubsetListPair.zip(left, right), (pairs) => {
    SubsetList.forEach(pairs, (pair) => { let (a, b) = pair; f(a, b) })
  })
};

let foldLeft = (left, right, initial, f) => {
  SubsetResult.map(SubsetListPair.zip(left, right), (pairs) => {
    SubsetList.foldLeft(pairs, initial, (pair, acc) => { let (a, b) = pair; f(a, b, acc) })
  })
};

let foldRight = (left, right, initial, f) => {
  SubsetResult.map(SubsetListPair.zip(left, right), (pairs) => {
    SubsetList.foldRight(pairs, initial, (pair, acc) => { let (a, b) = pair; f(a, b, acc) })
  })
};

let all = (left, right, predicate) => {
  SubsetResult.map(SubsetListPair.zip(left, right), (pairs) => {
    SubsetList.all(pairs, (pair) => { let (a, b) = pair; predicate(a, b) })
  })
};

let exists = (left, right, predicate) => {
  SubsetResult.map(SubsetListPair.zip(left, right), (pairs) => {
    SubsetList.exists(pairs, (pair) => { let (a, b) = pair; predicate(a, b) })
  })
};
