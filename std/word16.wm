from "basis/numeric.wm" import * as Numeric;
from js.module("./js/word.js") import unsafe {
  word16FromNumber: Real64.Real -> Word16.Word,
  smallWordToNumber as primToReal64: Word16.Word -> Real64.Real,
  word16Notb: Word16.Word -> Word16.Word,
  word16Andb: (Word16.Word, Word16.Word) -> Word16.Word,
  word16Orb: (Word16.Word, Word16.Word) -> Word16.Word,
  word16Xorb: (Word16.Word, Word16.Word) -> Word16.Word,
  word16Add: (Word16.Word, Word16.Word) -> Word16.Word,
  word16Sub: (Word16.Word, Word16.Word) -> Word16.Word,
  word16Mul: (Word16.Word, Word16.Word) -> Word16.Word,
  word16Div: (Word16.Word, Word16.Word) -> Word16.Word,
  word16Mod: (Word16.Word, Word16.Word) -> Word16.Word,
  word16ShiftLeft: (Word16.Word, Real64.Real) -> Word16.Word,
  word16ShiftRight: (Word16.Word, Real64.Real) -> Word16.Word,
  word16ShiftRightArithmetic: (Word16.Word, Real64.Real) -> Word16.Word
};

/** The type a bare `Word16` names in annotations (docs/modules.md). */
type Self = Word16.Word;

let wordSize: Real64.Real = 16;
let fromReal64 = word16FromNumber;
let toReal64 = primToReal64;
let andb = word16Andb;
let orb = word16Orb;
let xorb = word16Xorb;
let notb = word16Notb;
let shiftLeft = word16ShiftLeft;
let shiftRight = word16ShiftRight;
let shiftRightArithmetic = word16ShiftRightArithmetic;
let add = word16Add;
let sub = word16Sub;
let mul = word16Mul;
let div = word16Div;
let mod = word16Mod;


/** Default arithmetic dictionary; bare Word16 in value position selects carrier. */
let math: Numeric.Arithmetic<Word16.Word> = .{
  zero = 0, one = 1,
  add = (a: Word16.Word, b: Word16.Word) => a + b,
  mul = (a: Word16.Word, b: Word16.Word) => a * b
};
let carrier = math;
