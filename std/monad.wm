record Carrier<
  ViaArg,
  ViaResult,
  ViaErrArg,
  ViaErrResult,
  SucceedArg,
  SucceedResult,
  MapCarrier,
  MapTransform,
  MapResult,
  Map2Left,
  Map2Right,
  Map2Combine,
  Map2Result,
  AndThenCarrier,
  AndThenTransform,
  AndThenResult,
  MapErrCarrier,
  MapErrTransform,
  MapErrResult,
> = {
  via: ViaArg -> ViaResult,
  viaErr: ViaErrArg -> ViaErrResult,
  succeed: SucceedArg -> SucceedResult,
  map: (MapCarrier, MapTransform) -> MapResult,
  map2: (Map2Left, Map2Right, Map2Combine) -> Map2Result,
  andThen: (AndThenCarrier, AndThenTransform) -> AndThenResult,
  mapErr: (MapErrCarrier, MapErrTransform) -> MapErrResult,
};

// The subset a lifted operator needs: inject a pure operand, and combine two
// carriers componentwise. A type with no lawful andThen -- a fixed-size vector,
// say -- can register this without pretending to be a monad.
record Applicative<
  SucceedArg,
  SucceedResult,
  MapCarrier,
  MapTransform,
  MapResult,
  Map2Left,
  Map2Right,
  Map2Combine,
  Map2Result,
> = {
  succeed: SucceedArg -> SucceedResult,
  map: (MapCarrier, MapTransform) -> MapResult,
  map2: (Map2Left, Map2Right, Map2Combine) -> Map2Result,
};

let via = (domain) => {
  (f) => {
    domain.via(f)
  }
};

let viaErr = (domain) => {
  (inject) => {
    (f) => {
      domain.viaErr(inject)(f)
    }
  }
};

// The stage functions take the carrier value first, so a pipeline supplies it:
// `value :> Monad.map(Result, f)`. `via` and `viaErr` above stay curried
// because they build a stage rather than being one.

let map = (wrapped, domain, transform) => {
  domain.map(wrapped, transform)
};

let mapErr = (wrapped, domain, transform) => {
  domain.mapErr(wrapped, transform)
};

// `via(domain)(f)` as a stage is `andThen(wrapped, domain, f)` applied directly.
let andThen = (wrapped, domain, transform) => {
  domain.andThen(wrapped, transform)
};

// Applies a carrier-returning function to each item in order and collects the
// results in one carrier. Each item runs only after the previous one succeeded,
// so the first failure stops the traversal. The loop is a self tail call that
// chains through andThen, so long lists do not grow the stack.
let traverse = (items, domain, f) => {
  let rec go = match(rest, acc) => {
    ([], _) => { acc },
    ([item, ..tail], _) => {
      go(tail, domain.andThen(acc, (values) => {
        domain.map(f(item), (value) => { [value, ..values] })
      }))
    }
  };
  let rec reverse = match(rest, acc) => {
    ([], _) => { acc },
    ([value, ..tail], _) => { reverse(tail, [value, ..acc]) }
  };
  domain.andThen(go(items, domain.succeed([])), (values) => {
    domain.succeed(reverse(values, []))
  })
};
