record Carrier<
  ViaArg,
  ViaResult,
  ViaErrorArg,
  ViaErrorResult,
  SucceedArg,
  SucceedResult,
  MapCarrier,
  MapTransform,
  MapResult,
  Map2Left,
  Map2Right,
  Map2Combine,
  Map2Result,
  AndThenCarrier,
  AndThenTransform,
  AndThenResult,
  MapErrCarrier,
  MapErrTransform,
  MapErrResult,
> = {
  via: ViaArg -> ViaResult,
  viaError: ViaErrorArg -> ViaErrorResult,
  succeed: SucceedArg -> SucceedResult,
  map: (MapCarrier, MapTransform) -> MapResult,
  map2: (Map2Left, Map2Right, Map2Combine) -> Map2Result,
  andThen: (AndThenCarrier, AndThenTransform) -> AndThenResult,
  mapErr: (MapErrCarrier, MapErrTransform) -> MapErrResult,
};

// The subset a lifted operator needs: inject a pure operand, and combine two
// carriers componentwise. A type with no lawful andThen -- a fixed-size vector,
// say -- can register this without pretending to be a monad.
record Applicative<
  SucceedArg,
  SucceedResult,
  MapCarrier,
  MapTransform,
  MapResult,
  Map2Left,
  Map2Right,
  Map2Combine,
  Map2Result,
> = {
  succeed: SucceedArg -> SucceedResult,
  map: (MapCarrier, MapTransform) -> MapResult,
  map2: (Map2Left, Map2Right, Map2Combine) -> Map2Result,
};

let via = (domain) => {
  (f) => {
    domain.via(f)
  }
};

let viaError = (domain) => {
  (inject) => {
    (f) => {
      domain.viaError(inject)(f)
    }
  }
};

let map = (domain) => {
  (transform) => {
    (wrapped) => {
      domain.map(wrapped, transform)
    }
  }
};

let mapErr = (domain) => {
  (transform) => {
    (wrapped) => {
      domain.mapErr(wrapped, transform)
    }
  }
};
