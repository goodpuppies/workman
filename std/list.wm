from "basis/order.wm" import { Less, Equal, Greater };
from "basis/list.wm" import * as SubsetList;

// `List` is the SubsetML Basis `List` plus the additions below, which the Basis doesn't define.
// A name the Basis exports is never redefined here (markdown/basis-authority-plan.md).
export from "basis/list.wm" import *;

let collectWith = (empty, combine, items) => {
  SubsetList.foldRight(items, empty, combine)
};

private let rec joinRaw = match(items) => {
  [] => { "" },
  ([head, ..[]]) => { `${head}` },
  ([head, ..rest]) => {
    `${head}` ++ ", " ++ joinRaw(rest)
  }
};

let toString = (items) => {
  "[" ++ joinRaw(items) ++ "]"
};

let toStringRender = (items, render) => {
  toString(SubsetList.map(items, render))
};

let getItem = match(items) => {
  [head, ..rest] => { Some((head, rest)) },
  [] => { None }
};

let rec findMap = match(items, f) => {
  ([], _) => { None },
  ([head, ..rest], _) => {
    match(f(head)) {
      Some(value) => { Some(value) },
      None => { findMap(rest, f) }
    }
  }
};

let rec compareWith = match(left, right, compare) => {
  ([], [], _) => { Equal },
  ([], _, _) => { Less },
  (_, [], _) => { Greater },
  ([a, ..restA], [b, ..restB], _) => {
    match(compare(a, b)) {
      Equal => { compareWith(restA, restB, compare) },
      Less => { Less },
      Greater => { Greater }
    }
  }
};
