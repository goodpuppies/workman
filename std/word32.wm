from "basis/numeric.wm" import * as Numeric;
from js.module("./js/word.js") import unsafe {
  word32FromNumber: Real64.Real -> Word32.Word,
  smallWordToNumber as primToReal64: Word32.Word -> Real64.Real,
  word32Notb: Word32.Word -> Word32.Word,
  word32Andb: (Word32.Word, Word32.Word) -> Word32.Word,
  word32Orb: (Word32.Word, Word32.Word) -> Word32.Word,
  word32Xorb: (Word32.Word, Word32.Word) -> Word32.Word,
  word32Add: (Word32.Word, Word32.Word) -> Word32.Word,
  word32Sub: (Word32.Word, Word32.Word) -> Word32.Word,
  word32Mul: (Word32.Word, Word32.Word) -> Word32.Word,
  word32Div: (Word32.Word, Word32.Word) -> Word32.Word,
  word32Mod: (Word32.Word, Word32.Word) -> Word32.Word,
  word32ShiftLeft: (Word32.Word, Real64.Real) -> Word32.Word,
  word32ShiftRight: (Word32.Word, Real64.Real) -> Word32.Word,
  word32ShiftRightArithmetic: (Word32.Word, Real64.Real) -> Word32.Word
};

/** The type a bare `Word32` names in annotations (docs/modules.md). */
type Self = Word32.Word;

let wordSize: Real64.Real = 32;
let fromReal64 = word32FromNumber;
let toReal64 = primToReal64;
let andb = word32Andb;
let orb = word32Orb;
let xorb = word32Xorb;
let notb = word32Notb;
let shiftLeft = word32ShiftLeft;
let shiftRight = word32ShiftRight;
let shiftRightArithmetic = word32ShiftRightArithmetic;
let add = word32Add;
let sub = word32Sub;
let mul = word32Mul;
let div = word32Div;
let mod = word32Mod;


/** Default arithmetic dictionary; bare Word32 in value position selects carrier. */
let math: Numeric.Arithmetic<Word32.Word> = .{
  zero = 0, one = 1,
  add = (a: Word32.Word, b: Word32.Word) => a + b,
  mul = (a: Word32.Word, b: Word32.Word) => a * b
};
let carrier = math;
