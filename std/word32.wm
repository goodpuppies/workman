  word32FromNumber: Number -> Word32.Word,
  smallWordToNumber as primToNumber: Word32.Word -> Number,
  word32Notb: Word32.Word -> Word32.Word,
  word32Andb: (Word32.Word, Word32.Word) -> Word32.Word,
  word32Orb: (Word32.Word, Word32.Word) -> Word32.Word,
  word32Xorb: (Word32.Word, Word32.Word) -> Word32.Word,
  word32Add: (Word32.Word, Word32.Word) -> Word32.Word,
  word32Sub: (Word32.Word, Word32.Word) -> Word32.Word,
  word32Mul: (Word32.Word, Word32.Word) -> Word32.Word,
  word32Div: (Word32.Word, Word32.Word) -> Word32.Word,
  word32Mod: (Word32.Word, Word32.Word) -> Word32.Word,
  word32ShiftLeft: (Word32.Word, Number) -> Word32.Word,
  word32ShiftRight: (Word32.Word, Number) -> Word32.Word,
  word32ShiftRightArithmetic: (Word32.Word, Number) -> Word32.Word
};

let wordSize = 32;
let fromNumber = word32FromNumber;
let toNumber = primToNumber;
let andb = word32Andb;
let orb = word32Orb;
let xorb = word32Xorb;
let notb = word32Notb;
let shiftLeft = word32ShiftLeft;
let shiftRight = word32ShiftRight;
