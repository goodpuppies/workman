// Basis `GENERAL`, without `exn`, the exceptions and `ref` (`markdown/core-design.md`). The
// expected-outcome exceptions are `Basis.Error` constructors instead. `Order` is the spec's `order`,
// capitalized (BD11).
type Order = Less | Equal | Greater;

// Function composition: `o(f, g)` is `(x) => f(g(x))`.
let o = (f, g) => {
  (value) => { f(g(value)) }
};

// Both arguments are evaluated, left first; the result is the first.
let before = (value, _: Void) => { value };

let ignore = (_) => { void };
