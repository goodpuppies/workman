// General helpers, without `exn`, the exceptions and `ref` (`markdown/core-design.md`). The order
// type is the SubsetML Basis's: `from "basis/order.wm" import { Order, Less, Equal, Greater };`.

// Function composition: `o(f, g)` is `(x) => f(g(x))`.
let o = (f, g) => {
  (value) => { f(g(value)) }
};

// Both arguments are evaluated, left first; the result is the first.
let before = (value, _: Void) => { value };

let ignore = (_) => { void };
