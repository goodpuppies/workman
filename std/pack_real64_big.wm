from "./basis.wm" import * as Basis;
from js.module("./js/byte_vector.js") import unsafe {
  length as vectorLength: Word8Vector.Vector -> Number,
  sliceLength: Word8VectorSlice.Slice -> Number,
  packSubVec as primSubVec: (String, Bool, Word8Vector.Vector, Number) -> Float64.Real,
  packSubSlice as primSubSlice: (String, Bool, Word8VectorSlice.Slice, Number) -> Float64.Real,
  pack as primPack: (String, Bool, Float64.Real) -> Word8Vector.Vector
};

let bytesPerElem = 8;

let isBigEndian = true;

let subVec = (vector, index: Number) => {
  if (index >= 0 && index % 1 == 0 && (index + 1) * 8 <= vectorLength(vector)) {
    Ok(primSubVec("real64", true, vector, index))
  } else {
    Err(Basis.Subscript)
  }
};

let subSlice = (slice, index: Number) => {
  if (index >= 0 && index % 1 == 0 && (index + 1) * 8 <= sliceLength(slice)) {
    Ok(primSubSlice("real64", true, slice, index))
  } else {
    Err(Basis.Subscript)
  }
};

let pack = (value) => { primPack("real64", true, value) };
