from "./basis.wm" import * as Basis;
from "basis/order.wm" import { Less, Equal, Greater };

// `Real64` is the SubsetML Basis `Real64` (equal, rem, toString) plus the JS-backed math below. A
// name the Basis exports is never redefined here (markdown/basis-authority-plan.md).
export from "basis/real64.wm" import *;

from js.global("Math") import unsafe {
  abs as primAbs: Real64.Real -> Real64.Real,
  floor as primFloor: Real64.Real -> Real64.Real,
  ceil as primCeil: Real64.Real -> Real64.Real,
  trunc as primTrunc: Real64.Real -> Real64.Real,
  pow as primPow: (Real64.Real, Real64.Real) -> Real64.Real
};
from js.global("Number") import unsafe {
  MAX_VALUE: Real64.Real,
  MIN_VALUE: Real64.Real,
  isFinite as primIsFinite: Real64.Real -> Bool,
  isNaN as primIsNaN: Real64.Real -> Bool
};
from js.module("./js/real.js") import unsafe {
  signBit as primSignBit: Real64.Real -> Bool,
  copySign as primCopySign: (Real64.Real, Real64.Real) -> Real64.Real,
  toManExp as primToManExp: Real64.Real -> (Real64.Real, Real64.Real),
  fromManExp as primFromManExp: (Real64.Real, Real64.Real) -> Real64.Real,
  nextAfter as primNextAfter: (Real64.Real, Real64.Real) -> Real64.Real,
  isNormal as primIsNormal: Real64.Real -> Bool,
  roundHalfEven: Real64.Real -> Real64.Real
};

// Basis `REAL` over `Real64.Real`, the JavaScript double. Left out until
// their dependencies exist: the conversions through `StringCvt` and `IEEEReal` (`fmt`, `toString`,
// `scan`, `fromString`, `toDecimal`, `fromDecimal`, `toInt`, `class`, `compareReal`), the
// `LargeInt`/`LargeReal` conversions, the operators, which are `Real64.Real`'s own, and `fromInt`,
// which is `Int32.toReal64`. `floor`,
// `ceil`, `trunc` and `round` return `Err(Basis.Domain)` on NaN and panic with `Overflow` on an
// infinity. Arguments come data-first.

/** The type a bare `Real64` names in annotations (docs/modules.md). */
type Self = Real64.Real;

// The spec's anonymous records `{man, exp}` and `{whole, frac}`, named because Workman records are
// nominal.
record ManExp = { man: Real64.Real, exp: Real64.Real };
record Split = { whole: Real64.Real, frac: Real64.Real };

let radix: Real64.Real = 2;
let precision: Real64.Real = 53;
let maxFinite = MAX_VALUE;
let minPos = MIN_VALUE;
let minNormalPos = primPow(2, -1022);
let posInf = 1 / 0;
let negInf = -1 / 0;

let abs = primAbs;

let isNan = primIsNaN;

let isFinite = primIsFinite;

let isNormal = primIsNormal;

let min = (x: Real64.Real, y: Real64.Real) => {
  if (primIsNaN(x)) { y } else { if (primIsNaN(y)) { x } else { if (y < x) { y } else { x } } }
};

let max = (x: Real64.Real, y: Real64.Real) => {
  if (primIsNaN(x)) { y } else { if (primIsNaN(y)) { x } else { if (y > x) { y } else { x } } }
};

let sign = (x: Real64.Real) => {
  if (primIsNaN(x)) {
    Err(Basis.Domain)
  } else {
    Ok(if (x < 0) { -1 } else { if (x > 0) { 1 } else { 0 } })
  }
};

let signBit = primSignBit;

let sameSign = (x: Real64.Real, y: Real64.Real) => { primSignBit(x) == primSignBit(y) };

let copySign = primCopySign;

let compare = (x: Real64.Real, y: Real64.Real) => {
  if (primIsNaN(x) || primIsNaN(y)) {
    Err(Basis.Unordered)
  } else {
    Ok(if (x < y) { Less } else { if (x > y) { Greater } else { Equal } })
  }
};

let unordered = (x: Real64.Real, y: Real64.Real) => { primIsNaN(x) || primIsNaN(y) };

let toManExp = (x: Real64.Real) => {
  let (man, exp) = primToManExp(x);
  .{ man = man, exp = exp }
};

let fromManExp = (parts: ManExp) => { primFromManExp(parts.man, parts.exp) };

let split = (x: Real64.Real) => {
  let whole = if (primIsFinite(x)) { primTrunc(x) } else { x };
  let frac = if (primIsFinite(x)) { x - whole } else { if (primIsNaN(x)) { x } else { primCopySign(0, x) } };
  .{ whole = whole, frac = primCopySign(frac, x) }
};

let realMod = (x: Real64.Real) => {
  let parts: Split = split(x);
  parts.frac
};

let nextAfter = primNextAfter;

let checkFloat = (x: Real64.Real) => {
  if (primIsNaN(x)) {
    Panic("Div: Real.checkFloat of NaN")
  } else {
    if (primIsFinite(x)) { x } else { Panic("Overflow: Real.checkFloat of an infinity") }
  }
};

let realFloor = primFloor;
let realCeil = primCeil;
let realTrunc = primTrunc;
let realRound = roundHalfEven;

let floor = (x: Real64.Real) => {
  if (primIsNaN(x)) { Err(Basis.Domain) } else {
    if (primIsFinite(x)) { Ok(primFloor(x)) } else { Panic("Overflow: Real.floor of an infinity") }
  }
};

let ceil = (x: Real64.Real) => {
  if (primIsNaN(x)) { Err(Basis.Domain) } else {
    if (primIsFinite(x)) { Ok(primCeil(x)) } else { Panic("Overflow: Real.ceil of an infinity") }
  }
};

let trunc = (x: Real64.Real) => {
  if (primIsNaN(x)) { Err(Basis.Domain) } else {
    if (primIsFinite(x)) { Ok(primTrunc(x)) } else { Panic("Overflow: Real.trunc of an infinity") }
  }
};

let round = (x: Real64.Real) => {
  if (primIsNaN(x)) { Err(Basis.Domain) } else {
    if (primIsFinite(x)) { Ok(roundHalfEven(x)) } else { Panic("Overflow: Real.round of an infinity") }
  }
};
