from "./monad.wm" import { Carrier };
from "../host/js/debug.wm" import * as Debug;
from "basis/result.wm" import * as SubsetResult;
from "basis/list.wm" import * as SubsetList;

// `Result` is the SubsetML Basis `Result` plus WM's carrier record, the multi-argument maps and
// the list helpers. A name the Basis exports is never redefined here
// (markdown/basis-authority-plan.md).
export from "basis/result.wm" import *;

let succeed = (value) => {
  Ok(value)
};

let toBool = match(r) => {
  Ok(v) => {
    match(v) {
      true => {true},
      false => {false}
    }
  },
  Err(_) => {false}
};

let map2 = match(a, b, f) => {
  (Ok(left), Ok(right), f) => { Ok(f(left, right)) },
  (Err(error), _, _) => { Err(error) },
  (_, Err(error), _) => { Err(error) }
};

let carrier = .{
  via = SubsetResult.via,
  viaError = SubsetResult.viaError,
  succeed = succeed,
  map = SubsetResult.map,
  mapErr = SubsetResult.mapErr,
  map2 = map2,
  andThen = SubsetResult.andThen,
};

let debug = match(result) => {
  Ok(value) => { value },
  Err(error) => { 
    print(Debug.errorMessage(error));
    ?
  }
};

let map3 = match(a, b, c, f) => {
  (Ok(av), Ok(bv), Ok(cv), f) => { Ok(f(av, bv, cv)) },
  (Err(error), _, _, _) => { Err(error) },
  (_, Err(error), _, _) => { Err(error) },
  (_, _, Err(error), _) => { Err(error) }
};

let map4 = match(a, b, c, d, f) => {
  (Ok(av), Ok(bv), Ok(cv), Ok(dv), f) => { Ok(f(av, bv, cv, dv)) },
  (Err(error), _, _, _, _) => { Err(error) },
  (_, Err(error), _, _, _) => { Err(error) },
  (_, _, Err(error), _, _) => { Err(error) },
  (_, _, _, Err(error), _) => { Err(error) }
};

let traverse = SubsetList.traverse;

let all = (items) => {
  items :> Js.Array.toList :> traverse((item) => { item }) :> SubsetResult.map(Js.Array.fromList)
};

let collectList = (items) => {
  traverse(items, (item) => { item })
};

// Keep the original Result on success or an existing error. Only test Ok values;
// a rejected value uses the supplied error, with the same error type as value.
let filter = (value, predicate, error) => {
  match(value) {
    Ok(x) => { if (predicate(x)) { value } else { Err(error) } },
    Err(_) => { value }
  }
};
