from "./monad.wm" import { Carrier };

let succeed = (value) => {
  Ok(value)
};

let map = match(result, f) => {
  (Ok(value), f) => { Ok(f(value)) },
  (Err(error), _) => { Err(error) }
};

let andThen = match(result, f) => {
  (Ok(value), f) => { f(value) },
  (Err(error), _) => { Err(error) }
};

let toBool = match(r) => {
  Ok(v) => {
    match(v) {
      true => {true},
      false => {false}
    }
  },
  Err(_) => {false}
};

let fn = (f) => {
  (result) => {
    result :> andThen(f)
  }
};

let mapErr = match(result, f) => {
  (Ok(value), _) => { Ok(value) },
  (Err(error), f) => { Err(f(error)) }
};

let fnError = (inject) => {
  (f) => {
    fn((value) => {
      f(value) :> mapErr(inject)
    })
  }
};

let map2 = match(a, b, f) => {
  (Ok(left), Ok(right), f) => { Ok(f(left, right)) },
  (Err(error), _, _) => { Err(error) },
  (_, Err(error), _) => { Err(error) }
};

let carrier = .{
  fn = fn,
  fnError = fnError,
  succeed = succeed,
  map = map,
  map2 = map2,
  andThen = andThen,
};

let withDefault = match(result, fallback) => {
  (Ok(value), _) => { value },
  (Err(_), fallback) => { fallback }
};

let debug = match(result) => {
  Ok(value) => { value },
  Err(error) => { 
    print(Debug.errorMessage(error));
    ?
  }
};

let map3 = match(a, b, c, f) => {
  (Ok(av), Ok(bv), Ok(cv), f) => { Ok(f(av, bv, cv)) },
  (Err(error), _, _, _) => { Err(error) },
  (_, Err(error), _, _) => { Err(error) },
  (_, _, Err(error), _) => { Err(error) }
};

let map4 = match(a, b, c, d, f) => {
  (Ok(av), Ok(bv), Ok(cv), Ok(dv), f) => { Ok(f(av, bv, cv, dv)) },
  (Err(error), _, _, _, _) => { Err(error) },
  (_, Err(error), _, _, _) => { Err(error) },
  (_, _, Err(error), _, _) => { Err(error) },
  (_, _, _, Err(error), _) => { Err(error) }
};

let rec reverseAcc = match(items, acc) => {
  ([], acc) => { acc },
  ([head, ..rest], acc) => {
    reverseAcc(rest, [head, ..acc])
  }
};

let reverse = (items) => {
  reverseAcc(items, [])
};

let rec traverseAcc = match(items, f, acc) => {
  ([], _, acc) => { Ok(reverse(acc)) },
  ([item, ..rest], f, acc) => {
    match(f(item)) {
      Err(error) => { Err(error) },
      Ok(value) => {
        traverseAcc(rest, f, [value, ..acc])
      }
    }
  }
};

let traverse = (items, f) => {
  traverseAcc(items, f, [])
};

let all = (items) => {
  items :> Js.Array.toList :> traverse((item) => { item }) :> map(Js.Array.fromList)
};

let collectList = (items) => {
  traverse(items, (item) => { item })
};
