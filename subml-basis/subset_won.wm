/* @subsetml
from "./subset_won_value.sml" import * as SubsetWonValue;
from "./subset_won_parser.sml" import * as SubsetWonParser;
from "./subset_won_syntax.sml" import * as SubsetWonSyntax;
from "./subset_result.sml" import * as SubsetResult;
from "./subset_list.sml" import * as SubsetList;
from "./subset_string.sml" import * as SubsetString;
from "./subset_natural.sml" import * as SubsetNatural;
*/

// Public portable WON encoding and decoding API.

from "./subset_won_value.wm" import * as SubsetWonValue;
from "./subset_won_parser.wm" import * as SubsetWonParser;
from "./subset_string.wm" import * as SubsetString;
from "./subset_list.wm" import * as SubsetList;
from "./subset_won_syntax.wm" import * as SubsetWonSyntax;
from "./subset_result.wm" import * as SubsetResult;
from "./subset_natural.wm" import * as SubsetNatural;

type Value = SubsetWonValue.Value;
type Error = SubsetWonValue.Error;
type Node = SubsetWonValue.Node;
type Problem = SubsetWonValue.Problem;

let decode = SubsetWonParser.decode;

// Preserve field order and number spelling; each shape has one wire spelling.
let rec render = (value) => {
  let fieldsText = (fields) => {
    SubsetString.concatWith(
      SubsetList.map(
        fields,
        (key, item) => { SubsetWonSyntax.keyText(key) ++ " = " ++ render(item) }
      ),
      " "
    )
  };

  match(value) {
    SubsetWonValue.Null => { "null" },
    SubsetWonValue.Boolean(true) => { "true" },
    SubsetWonValue.Boolean(false) => { "false" },
    SubsetWonValue.Number(spelling) => { spelling },
    SubsetWonValue.Text(content) => { SubsetWonSyntax.quote(content) },
    SubsetWonValue.Blob(items) => {
      let content = SubsetString.concat(SubsetList.map(items, SubsetWonSyntax.hexByte));
      "x\"" ++ content ++ "\""
    },
    SubsetWonValue.List(items) => {
      let content = SubsetString.concatWith(SubsetList.map(items, render), " ");
      "[" ++ content ++ "]"
    },
    SubsetWonValue.Record(fields) => { "{" ++ fieldsText(fields) ++ "}" },
    SubsetWonValue.Tag(name, attrs, body) => {
      let attributes = match(attrs) {
        [] => { "" },
        _ => { "<" ++ fieldsText(attrs) ++ ">" }
      };
      let payload = match(body) {
        SubsetWonValue.Null => { "" },
        SubsetWonValue.List(_) => { render(body) },
        SubsetWonValue.Record(_) => { render(body) },
        _ => { "(" ++ render(body) ++ ")" }
      };
      name ++ attributes ++ payload
    }
  }
};

// Reuse the parser's validation instead of maintaining a second grammar.
let encode = (value) => {
  let source = render(value);
  let checkRoundTrip = SubsetResult.via((parsed) => {
    if (parsed == value) { SubsetResult.Ok(source) } else { SubsetResult.Err("value cannot be represented as WON") }
  });

  checkRoundTrip(SubsetResult.mapError(decode(source), (error: Error) => { error.message }))
};

// Access steps take and return a Result, so a chain is checked once at its end:
// SubsetWon.read(source) :> SubsetWon.get("server") :> SubsetWon.get("port") :> SubsetWon.number
let pathText = (path) => {
  match(path) {
    [] => { "document" },
    _ => { SubsetString.concat(SubsetList.reverse(path)) }
  }
};

let keyStep = (path, key) => {
  match(path) {
    [] => { [SubsetWonSyntax.keyText(key)] },
    _ => { ["." ++ SubsetWonSyntax.keyText(key), ..path] }
  }
};

let mismatch = (node: Node, kind) => {
  SubsetResult.Err(SubsetWonValue.Mismatch(pathText(node.path), kind))
};

let lookup = (fields, key, path) => {
  match(SubsetList.find(
    fields,
    (entry) => {
      let (name, _) = entry;
      name == key
    }
  )) {
    Some(entry) => {
      let (_, item) = entry;
      SubsetResult.Ok(SubsetWonValue.makeNode(path, item))
    },
    None => { SubsetResult.Err(SubsetWonValue.Missing(pathText(path))) }
  }
};

let root = (value) => { SubsetResult.Ok(SubsetWonValue.makeNode([], value)) };

let read = (source) => {
  SubsetResult.map(
    SubsetResult.mapError(decode(source), SubsetWonValue.Malformed),
    (value) => { SubsetWonValue.makeNode([], value) }
  )
};

let get = (found, key) => {
  SubsetResult.andThen(
    found,
    (node: Node) => {
      match(node.value) {
        SubsetWonValue.Record(fields) => { lookup(fields, key, keyStep(node.path, key)) },
        _ => { mismatch(node, "record") }
      }
    }
  )
};

let attribute = (found, key) => {
  SubsetResult.andThen(
    found,
    (node: Node) => {
      match(node.value) {
        SubsetWonValue.Tag(_, attrs, _) => {
          lookup(attrs, key, ["<" ++ SubsetWonSyntax.keyText(key) ++ ">", ..node.path])
        },
        _ => { mismatch(node, "tag") }
      }
    }
  )
};

let indexStep = (path, position) => {
  [
    "[" ++ SubsetResult.getOr(SubsetNatural.toString(position), "?") ++ "]",
    ..path
  ]
};

let index = (found, position) => {
  SubsetResult.andThen(
    found,
    (node: Node) => {
      match(node.value) {
        SubsetWonValue.List(items) => {
          let path = indexStep(node.path, position);
          match(SubsetList.at(items, position)) {
            SubsetResult.Ok(item) => { SubsetResult.Ok(SubsetWonValue.makeNode(path, item)) },
            SubsetResult.Err(_) => { SubsetResult.Err(SubsetWonValue.Missing(pathText(path))) }
          }
        },
        _ => { mismatch(node, "list") }
      }
    }
  )
};

// A tag's payload keeps the tag's path: `view[0]` is the first child of `view`.
let payload = (found) => {
  SubsetResult.andThen(
    found,
    (node: Node) => {
      match(node.value) {
        SubsetWonValue.Tag(_, _, body) => { SubsetResult.Ok(SubsetWonValue.makeNode(node.path, body)) },
        _ => { mismatch(node, "tag") }
      }
    }
  )
};

let tagName = (found) => {
  SubsetResult.andThen(
    found,
    (node: Node) => {
      match(node.value) {
        SubsetWonValue.Tag(name, _, _) => { SubsetResult.Ok(name) },
        _ => { mismatch(node, "tag") }
      }
    }
  )
};

let items = (found) => {
  SubsetResult.andThen(
    found,
    (node: Node) => {
      match(node.value) {
        SubsetWonValue.List(values) => {
          let rec go = (rest, position, acc) => {
            match(rest) {
              [] => { SubsetList.reverse(acc) },
              [item, ..tail] => {
                go(
                  tail,
                  position + (1: I32),
                  [SubsetWonValue.makeNode(indexStep(node.path, position), item), ..acc]
                )
              }
            }
          };
          SubsetResult.Ok(go(values, (0: I32), []))
        },
        _ => { mismatch(node, "list") }
      }
    }
  )
};

let entries = (found) => {
  SubsetResult.andThen(
    found,
    (node: Node) => {
      match(node.value) {
        SubsetWonValue.Record(fields) => {
          SubsetResult.Ok(SubsetList.map(
            fields,
            (key, item) => {
              (key, SubsetWonValue.makeNode(keyStep(node.path, key), item))
            }
          ))
        },
        _ => { mismatch(node, "record") }
      }
    }
  )
};

let text = (found) => {
  SubsetResult.andThen(
    found,
    (node: Node) => {
      match(node.value) {
        SubsetWonValue.Text(content) => { SubsetResult.Ok(content) },
        _ => { mismatch(node, "text") }
      }
    }
  )
};

// The exact spelling; numeric conversion is the caller's choice.
let number = (found) => {
  SubsetResult.andThen(
    found,
    (node: Node) => {
      match(node.value) {
        SubsetWonValue.Number(spelling) => { SubsetResult.Ok(spelling) },
        _ => { mismatch(node, "number") }
      }
    }
  )
};

let boolean = (found) => {
  SubsetResult.andThen(
    found,
    (node: Node) => {
      match(node.value) {
        SubsetWonValue.Boolean(flag) => { SubsetResult.Ok(flag) },
        _ => { mismatch(node, "boolean") }
      }
    }
  )
};

let blob = (found) => {
  SubsetResult.andThen(
    found,
    (node: Node) => {
      match(node.value) {
        SubsetWonValue.Blob(bytes) => { SubsetResult.Ok(bytes) },
        _ => { mismatch(node, "blob") }
      }
    }
  )
};

let value = (found) => { SubsetResult.map(found, (node: Node) => { node.value }) };

// Ends a chain: anything missing along it becomes None. Present null stays a value.
let optional = (found) => {
  match(found) {
    SubsetResult.Ok(result) => { SubsetResult.Ok(Some(result)) },
    SubsetResult.Err(SubsetWonValue.Missing(_)) => { SubsetResult.Ok(None) },
    SubsetResult.Err(problem) => { SubsetResult.Err(problem) }
  }
};

let problemText = (problem) => {
  match(problem) {
    SubsetWonValue.Malformed(error) => {
      "byte " ++ SubsetResult.getOr(SubsetNatural.toString(error.offset), "?") ++ ": " ++ error.message
    },
    SubsetWonValue.Missing(path) => { path ++ ": missing" },
    SubsetWonValue.Mismatch(path, kind) => { path ++ ": expected " ++ kind }
  }
};
