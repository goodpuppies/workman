// Workman/JS implementation of the real primitives. Workman's `%` on a Real64 is JS's
// remainder, and a template shows a Real64 as JS's Number#toString does. Both numeric types are
// JS numbers, so an Int32 is already its real, and an integral real in range is already its int.
from js.global import unsafe { Number as numberOf: Int32.Int -> Real64.Real };
from js.global("Math") import unsafe { trunc as truncate: Real64.Real -> Int32.Int };
