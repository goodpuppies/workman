type Result<a, e> = Ok<a> | Err<e>;

let map = (value, f) => {
  match(value) {
    Ok(x) => { Ok(f(x)) },
    Err(error) => { Err(error) }
  }
};

let mapErr = (value, f) => {
  match(value) {
    Ok(x) => { Ok(x) },
    Err(error) => { Err(f(error)) }
