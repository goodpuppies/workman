from "./subset_result.wm" import * as SubsetResult;
from js.module("./js/subset_host.js") import unsafe {
  canonicalPath as rawCanonicalPath: String -> (Bool, String),
  readFile as rawReadFile: String -> (Bool, String),
  writeFile as rawWriteFile: (String, String) -> (Bool, String),
  writeStdout as rawWriteStdout: String -> (Bool, String),
  writeStderr as rawWriteStderr: String -> (Bool, String),
  argumentCount: Void -> Number,
