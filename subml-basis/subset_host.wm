  getEnv as rawGetEnv: String -> (Bool, String),
  exit as rawExit: Number -> Void,
  terminate as rawTerminate: Number -> Void
};
let convert = (result) => {
  let (succeeded, text) = result;
  if (succeeded) { SubsetResult.Ok(text) } else { SubsetResult.Err(text) }
};
let done = (result) => {
