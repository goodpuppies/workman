// Public WON values and byte-offset decoding errors.

type Value =
  | Null
  | Boolean<Bool>
  | Number<String>
  | Text<List<Char>>
  | Blob<List<Char>>
  | List<List<Value>>
  | Record<List<(String, Value)>>
  | Tag<String, List<(String, Value)>, Value>;

record Error = {offset: I32, message: String};
let makeError = (offset, message) => { (.{ offset = offset, message = message }: Error) };

// A value reached by access, with its reversed path for reporting problems.
record Node = {path: List<String>, value: Value};
let makeNode = (path, value) => { (.{ path = path, value = value }: Node) };
type Problem = Malformed<Error> | Missing<String> | Mismatch<String, String>;
