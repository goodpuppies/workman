/* @subsetml
from "./subset_unicode.sml" import * as SubsetUnicode;
from "./subset_list.sml" import * as SubsetList;
from "./subset_result.sml" import * as SubsetResult;
from "./subset_text_host.sml" import * as SubsetTextHost;
from "./subset_char.sml" import * as SubsetChar;
from "./subset_utf16.sml" import * as SubsetUtf16;
from "./subset_utf8.sml" import * as SubsetUtf8;
*/

/* Lossless UTF-16 units, including lone surrogates. Strict codecs remain separate.
   Tree/Source constructors are implementation representations; use the checked builders. */

from "./subset_unicode.wm" import * as SubsetUnicode;
from "./subset_list.wm" import * as SubsetList;
from "./subset_result.wm" import * as SubsetResult;
from "./subset_text_host.wm" import * as SubsetTextHost;
from "./subset_char.wm" import * as SubsetChar;
from "./subset_utf16.wm" import * as SubsetUtf16;
from "./subset_utf8.wm" import * as SubsetUtf8;

type Error = InvalidUnit<I32> | InvalidIndex | UnicodeError<SubsetUnicode.Error>;
type Tree = Empty | Unit<I32> | Branch<I32, Tree, Tree>;
type Source = | Source<Tree, I32, I32>;

let treeLength = match {
  Empty => { (0: I32) },
  Unit(code) => { (1: I32) },
  Branch(size, left, right) => { size }
};
let length = match {
  Source(tree, start, count) => { count }
};
let isUnit = (code: I32) => {
  if (if (code >= (0: I32)) { code <= (65535: I32) } else { false }) {
    let (whole, residue) = SubsetUnicode.split(code, (1: I32));
    residue <= (0: I32)
  } else { false }
};

let fromUnits = (units) => {
  let join = (left, right) => { Branch(treeLength(left) + treeLength(right), left, right) };
  let rec push = (tree, stack) => {
    match(stack) {
      [] => { [tree] },
      [previous, ..rest] => {
        if (treeLength(previous) <= treeLength(tree)) { push(join(previous, tree), rest) } else { [tree, ..stack] }
      }
    }
  };
  let rec build = match {
    ([], Var(index), Var(stack)) => {
      let tree = SubsetList.foldLeft(stack, Empty, (tree, acc) => { join(tree, acc) });
      SubsetResult.Ok(Source(tree, (0: I32), index))
    },
    ([code, ..rest], Var(index), Var(stack)) => {
      if (isUnit(code)) { build(rest, index + (1: I32), push(Unit(code), stack)) } else { SubsetResult.Err(InvalidUnit(index)) }
    }
  };
  build(units, (0: I32), [])
};

/* Native means storage units, not implicit UTF-8 decoding. JS supplies UTF-16 units;
   the SML adapter supplies byte values. Decode native UTF-8 file bytes explicitly. */
let fromNativeUnits = (text) => { fromUnits(SubsetTextHost.codes(text)) };

// NONE means no unit at this index: outside the view.
let peek = match {
  (Source(tree, start, count), (Var(index): I32)) => {
    if (if (index >= (0: I32)) { index < count } else { false }) {
      let rec go = match {
        (Empty, Var(offset)) => { None },
        (Unit(code), Var(offset)) => {
          if (if (offset <= (0: I32)) { offset >= (0: I32) } else { false }) { Some(code) } else { None }
        },
        (Branch(size, left, right), Var(offset)) => {
          if (offset < treeLength(left)) { go(left, offset) } else { go(right, offset - treeLength(left)) }
        }
      };
      go(tree, start + index)
    } else { None }
  }
};

let at = (source, index) => {
  match(peek(source, index)) {
    Some(code) => { SubsetResult.Ok(code) },
    None => { SubsetResult.Err(InvalidIndex) }
  }
};

// Views retain the original tree; slicing does not copy or decode source spelling.
let slice = (source, offset: I32, count: I32) => {
  let boundary = (index) => {
    if (if (index >= (0: I32)) { index <= length(source) } else { false }) {
      if (index >= length(source)) { true } else { SubsetResult.isOk(at(source, index)) }
    } else { false }
  };
  let Source(tree, start, size) = source;
  if (if (if (count >= (0: I32)) { boundary(offset) } else { false }) { count <= size - offset } else { false }) { SubsetResult.Ok(Source(tree, start + offset, count)) } else { SubsetResult.Err(InvalidIndex) }
};

let toUnits = match {
  Source(tree, start, count) => {
    let finish = start + count;
    let rec collect = (node, base, acc) => {
      if (if (base >= finish) { true } else { base + treeLength(node) <= start }) { acc } else {
        match(node) {
          Empty => { acc },
          Unit(code) => { [code, ..acc] },
          Branch(size, left, right) => {
            collect(left, base, collect(right, base + treeLength(left), acc))
          }
        }
      }
    };
    collect(tree, (0: I32), [])
  }
};

/* Raw UTF-16 bytes validate byte values and pairing, but not surrogate pairing.
   Errors retain byte offsets, including the final byte of an odd-length input. */
let fromUtf16Bytes = (bytes, order) => {
  let invalid = (reason, offset) => {
    SubsetResult.Err(UnicodeError(SubsetUnicode.Error(reason, offset)))
  };
  let rec read = match {
    ([], Var(offset), Var(acc)) => { fromUnits(SubsetList.reverse(acc)) },
    ([last], Var(offset), Var(acc)) => { invalid(SubsetUnicode.OddLength, offset) },
    ([first, second, ..rest], Var(offset), Var(acc)) => {
      match(SubsetChar.toCode(first)) {
        SubsetResult.Err(error) => { invalid(SubsetUnicode.InvalidByte, offset) },
        SubsetResult.Ok(a) => {
          match(SubsetChar.toCode(second)) {
            SubsetResult.Err(error) => { invalid(SubsetUnicode.InvalidByte, offset + (1: I32)) },
            SubsetResult.Ok(b) => {
              let code = match(order) {
                SubsetUtf16.LittleEndian => { a + b * (256: I32) },
                SubsetUtf16.BigEndian => { a * (256: I32) + b }
              };
              read(rest, offset + (2: I32), [code, ..acc])
            }
          }
        }
      }
    }
  };
  read(bytes, (0: I32), [])
};

let toUtf16Bytes = (source, order) => {
  let rec encode = match {
    ([], Var(offset), Var(acc)) => { SubsetResult.Ok(SubsetList.reverse(acc)) },
    ([code, ..rest], Var(offset), Var(acc)) => {
      match(SubsetUnicode.encodeCodes(SubsetUtf16.unitCodes(code, order), offset)) {
        SubsetResult.Err(error) => { SubsetResult.Err(UnicodeError(error)) },
        SubsetResult.Ok(bytes) => {
          encode(rest, offset + (2: I32), SubsetList.reverseAppend(bytes, acc))
        }
      }
    }
  };
  encode(toUnits(source), (0: I32), [])
};

let fromScalars = (scalars) => {
  SubsetResult.andThen(
    SubsetResult.mapErr(SubsetUtf16.encode(scalars, SubsetUtf16.LittleEndian), UnicodeError),
    (bytes) => { fromUtf16Bytes(bytes, SubsetUtf16.LittleEndian) }
  )
};
let toScalars = (source) => {
  SubsetResult.andThen(
    toUtf16Bytes(source, SubsetUtf16.LittleEndian),
    (bytes) => {
      SubsetResult.mapErr(SubsetUtf16.decode(bytes, SubsetUtf16.LittleEndian), UnicodeError)
    }
  )
};
let fromUtf8 = (bytes) => {
  SubsetResult.andThen(SubsetResult.mapErr(SubsetUtf8.decode(bytes), UnicodeError), fromScalars)
};
let toUtf8 = (source) => {
  SubsetResult.andThen(
    toScalars(source),
    (scalars) => {
      SubsetResult.mapErr(SubsetUtf8.encode(scalars), UnicodeError)
    }
  )
};
