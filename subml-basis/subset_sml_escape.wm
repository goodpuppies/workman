let escapeByte = (c) => {
  match(SubsetList.find(spellings, (byte, spelling) => { byte == c })) {
    None => { SubsetResult.Err(NonByte((0: I32))) },
    Some(entry) => {
      let (byte, spelling) = entry;
      SubsetResult.Ok(spelling)
    }
  }
};

let escapeBytes = (bytes) => {
  let rec go = match {
    ([], Var(offset), Var(parts)) => {
      SubsetResult.Ok(SubsetString.concat(SubsetList.reverse(parts)))
    },
    ([c, ..rest], Var(offset), Var(parts)) => {
      match(escapeByte(c)) {
        SubsetResult.Err(error) => { SubsetResult.Err(NonByte(offset)) },
        SubsetResult.Ok(spelling) => { go(rest, offset + (1: I32), [spelling, ..parts]) }
      }
    }
  };
  go(bytes, (0: I32), [])
};

let escapeString = (value) => {
  match(SubsetString.fromNative(value)) {
    SubsetResult.Err(SubsetString.NonByte(offset)) => { SubsetResult.Err(NonByte(offset)) },
    SubsetResult.Ok(bytes) => { escapeBytes(bytes) }
  }
};
