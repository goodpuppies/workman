/* @subsetml
from "./subset_result.sml" import * as SubsetResult;
from "./subset_list.sml" import * as SubsetList;
from "./subset_char.sml" import * as SubsetChar;
from "./subset_text_host.sml" import * as SubsetTextHost;
from "./subset_bytes.sml" import * as SubsetBytes;
*/

// Native byte-string boundary. Extraction and reconstruction are SubsetTextHost primitives.

from "./subset_result.wm" import * as SubsetResult;
from "./subset_list.wm" import * as SubsetList;
from "./subset_char.wm" import * as SubsetChar;
from "./subset_text_host.wm" import * as SubsetTextHost;
from "./subset_bytes.wm" import * as SubsetBytes;

type Error = | NonByte<I32>;
let fromNative = (value) => {
  let rec go = match {
    ([], Var(offset), Var(bytes)) => { SubsetResult.Ok(SubsetList.reverse(bytes)) },
    ([code, ..rest], Var(offset), Var(bytes)) => {
      match(SubsetChar.fromCode(code)) {
        SubsetResult.Err(error) => { SubsetResult.Err(NonByte(offset)) },
        SubsetResult.Ok(c) => { go(rest, offset + (1: I32), [c, ..bytes]) }
      }
    }
  };
  go(SubsetTextHost.codes(value), (0: I32), [])
};

let compare = (left, right) => {
  SubsetResult.andThen(
    fromNative(left),
    (xs) => {
      SubsetResult.andThen(
        fromNative(right),
        (ys) => {
          SubsetBytes.compareWith(xs, ys, (offset) => { NonByte(offset) })
        }
      )
    }
  )
};

let rec concat = (pieces) => {
  match(pieces) {
    [] => { "" },
    [value] => { value },
    [first, second, ..rest] => {
      let rec pairs = match {
        ([], Var(acc)) => { SubsetList.reverse(acc) },
        ([value], Var(acc)) => { SubsetList.reverse([value, ..acc]) },
        ([left, right, ..tail], Var(acc)) => { pairs(tail, [left ++ right, ..acc]) }
      };
      concat(pairs(pieces, []))
    }
  }
};

let concatWith = (pieces, separator) => {
  match(pieces) {
    [] => { "" },
    [first, ..rest] => {
      let rec go = match {
        ([], Var(acc)) => { concat(SubsetList.reverse(acc)) },
        ([piece, ..tail], Var(acc)) => { go(tail, [piece, separator, ..acc]) }
      };
      go(rest, [first])
    }
  }
};

let toNative = (bytes) => {
  let rec go = match {
    ([], Var(offset), Var(codes)) => {
      SubsetResult.Ok(SubsetTextHost.fromCodes(SubsetList.reverse(codes)))
    },
    ([c, ..rest], Var(offset), Var(codes)) => {
      match(SubsetChar.toCode(c)) {
        SubsetResult.Err(error) => { SubsetResult.Err(NonByte(offset)) },
        SubsetResult.Ok(code) => { go(rest, offset + (1: I32), [code, ..codes]) }
      }
    }
  };
  go(bytes, (0: I32), [])
};
